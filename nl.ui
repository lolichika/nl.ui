local function BuildConsoleUI()
    local win = NL._window
    if not win or DevConsole.frame then return end

    local frame = New("Frame", {
        Name = "DevConsole",
        AnchorPoint = Vector2.new(0.5, 1),
        Position = UDim2.new(0.5, 0, 1, 500),
        Size = UDim2.new(0, 720, 0, 340),
        BackgroundColor3 = NL.Theme.Popout,
        BorderSizePixel = 0,
        Visible = false,
        ZIndex = 810,
        Parent = win._screen,
    })
    Round(frame, 10)
    Stroke(frame, NL.Theme.StrokeLight)
    New("UIStroke", {
        Color = Color3.new(0, 0, 0),
        Thickness = 6,
        Transparency = 0.7,
        Parent = frame,
    })

    -- верхняя полоска акцента
    local accentBar = New("Frame", {
        Size = UDim2.new(1, 0, 0, 3),
        BackgroundColor3 = NL.Theme.Success,
        BorderSizePixel = 0,
        ZIndex = 811,
        Parent = frame,
    })
    Round(accentBar, 2)

    -- хедер
    local header = New("Frame", {
        Position = UDim2.new(0, 0, 0, 3),
        Size = UDim2.new(1, 0, 0, 30),
        BackgroundColor3 = NL.Theme.Header,
        BorderSizePixel = 0,
        ZIndex = 811,
        Parent = frame,
    })

    -- три точки как в macOS
    for i = 1, 3 do
        local dotColors = {
            Color3.fromRGB(255, 95, 86),
            Color3.fromRGB(255, 189, 46),
            Color3.fromRGB(39, 201, 63),
        }
        local dot = New("Frame", {
            Position = UDim2.new(0, 10 + (i - 1) * 16, 0.5, -5),
            Size = UDim2.new(0, 10, 0, 10),
            BackgroundColor3 = dotColors[i],
            BorderSizePixel = 0,
            ZIndex = 812,
            Parent = header,
        })
        Circle(dot)
    end

    New("TextLabel", {
        Text = "dev console",
        Font = NL.Theme.FontMono,
        TextSize = 11,
        TextColor3 = NL.Theme.Success,
        TextXAlignment = Enum.TextXAlignment.Center,
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        ZIndex = 812,
        Parent = header,
    })

    local clearBtn = New("TextButton", {
        Text = "CLEAR",
        Font = NL.Theme.FontBold,
        TextSize = 9,
        TextColor3 = NL.Theme.TextDim,
        BackgroundTransparency = 1,
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -10, 0.5, 0),
        Size = UDim2.new(0, 60, 0, 20),
        ZIndex = 812,
        Parent = header,
    })

    clearBtn.MouseEnter:Connect(function()
        Tween(clearBtn, 0.1, { TextColor3 = NL.Theme.Error })
    end)
    clearBtn.MouseLeave:Connect(function()
        Tween(clearBtn, 0.1, { TextColor3 = NL.Theme.TextDim })
    end)
    clearBtn.MouseButton1Click:Connect(function()
        DevConsole.entries = {}
        if DevConsole._refresh then DevConsole._refresh() end
    end)

    -- log scroll
    local logScroll = New("ScrollingFrame", {
        Position = UDim2.new(0, 8, 0, 40),
        Size = UDim2.new(1, -16, 1, -90),
        BackgroundColor3 = NL.Theme.Background,
        BorderSizePixel = 0,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = NL.Theme.Success,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        ZIndex = 811,
        Parent = frame,
    })
    Round(logScroll, 6)
    Padding(logScroll, 8, 10, 8, 10)
    VLayout(logScroll, 2)

    -- строка ввода
    local inputLine = New("Frame", {
        Position = UDim2.new(0, 8, 1, -46),
        Size = UDim2.new(1, -16, 0, 36),
        BackgroundColor3 = NL.Theme.List,
        BorderSizePixel = 0,
        ZIndex = 811,
        Parent = frame,
    })
    Round(inputLine, 6)
    Stroke(inputLine, NL.Theme.Stroke)

    -- prompt
    New("TextLabel", {
        Text = "$",
        Font = NL.Theme.FontMono,
        TextSize = 14,
        TextColor3 = NL.Theme.Success,
        Position = UDim2.new(0, 10, 0.5, -9),
        Size = UDim2.new(0, 16, 1, 0),
        BackgroundTransparency = 1,
        ZIndex = 812,
        Parent = inputLine,
    })

    local input = New("TextBox", {
        Text = "",
        PlaceholderText = "help для списка команд",
        Font = NL.Theme.FontMono,
        TextSize = 12,
        TextColor3 = NL.Theme.TextGreen,
        PlaceholderColor3 = NL.Theme.TextDim,
        TextXAlignment = Enum.TextXAlignment.Left,
        ClearTextOnFocus = false,
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 30, 0, 0),
        Size = UDim2.new(1, -40, 1, 0),
        ZIndex = 812,
        Parent = inputLine,
    })

    DevConsole.frame = frame
    DevConsole.logScroll = logScroll
    DevConsole.input = input

    -- обновление
    local function refresh()
        for _, c in ipairs(logScroll:GetChildren()) do
            if c:IsA("GuiObject") then c:Destroy() end
        end

        for i, entry in ipairs(DevConsole.entries) do
            local color = NL.Theme.Text
            if entry.level == "warn" then color = NL.Theme.Warning
            elseif entry.level == "error" then color = NL.Theme.Error
            elseif entry.level == "success" then color = NL.Theme.Success
            elseif entry.level == "cmd" then color = NL.Theme.Accent
            end

            New("TextLabel", {
                Text = "[" .. entry.time .. "] " .. entry.text,
                Font = NL.Theme.FontMono,
                TextSize = 11,
                TextColor3 = color,
                TextXAlignment = Enum.TextXAlignment.Left,
                TextWrapped = true,
                Size = UDim2.new(1, 0, 0, 14),
                AutomaticSize = Enum.AutomaticSize.Y,
                BackgroundTransparency = 1,
                LayoutOrder = i,
                ZIndex = 812,
                Parent = logScroll,
            })
        end

        task.defer(function()
            logScroll.CanvasSize = UDim2.new(0, 0, 0, #DevConsole.entries * 18 + 10)
            logScroll.CanvasPosition = Vector2.new(0, math.max(0, logScroll.CanvasSize.Y.Offset - logScroll.AbsoluteSize.Y))
        end)
    end

    DevConsole._refresh = refresh

    input.FocusLost:Connect(function(enter)
        if enter then
            DevConsole:Execute(input.Text)
            input.Text = ""
            pcall(function() input:CaptureFocus() end)
        end
    end)

    refresh()
end

function DevConsole:Open()
    BuildConsoleUI()
    if not self.frame then return end
    self.visible = true
    self.frame.Visible = true

    self.frame.Position = UDim2.new(0.5, 0, 1, 500)
    Tween(self.frame, 0.3, {
        Position = UDim2.new(0.5, 0, 1, -20),
    }, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)

    if self._refresh then self._refresh() end
    pcall(function() self.input:CaptureFocus() end)
end

function DevConsole:Close()
    if not self.frame then return end
    self.visible = false
    pcall(function() self.input:ReleaseFocus() end)

    Tween(self.frame, 0.25, {
        Position = UDim2.new(0.5, 0, 1, 500),
    }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)

    task.delay(0.27, function()
        if not self.visible then self.frame.Visible = false end
    end)
end

function DevConsole:Toggle()
    if self.visible then self:Close() else self:Open() end
end

-- хоткей F8
Connect(UserInputService.InputBegan, function(input, processed)
    if processed then return end
    if input.KeyCode == Enum.KeyCode.F8 then
        DevConsole:Toggle()
    end
end)

--// ═══════════════════════════════════════════════════════════════════════
--//  §166 · DEV CONSOLE · КОМАНДЫ
--// ═══════════════════════════════════════════════════════════════════════

DevConsole:Register("help", function()
    DevConsole:Info("=== Команды ===")
    for name, entry in pairs(DevConsole.commands) do
        DevConsole:Info("  " .. name .. " — " .. entry.desc)
    end
end, "Список команд")

DevConsole:Register("clear", function()
    DevConsole.entries = {}
    if DevConsole._refresh then DevConsole._refresh() end
end, "Очистить")

DevConsole:Register("theme", function(name)
    if not name then DevConsole:Warn("theme <name>"); return end
    NL.Themes:Apply(name, true)
    DevConsole:Success("Тема: " .. name)
end, "Сменить тему")

DevConsole:Register("notify", function(_, ...)
    local args = { ... }
    NL:Notify("Console", table.concat(args, " "), 3, "info")
end, "Уведомление")

DevConsole:Register("wh", function()
    if NL.WallHack.State._enabled then
        NL.WallHack:Stop()
        DevConsole:Info("WallHack off")
    else
        NL.WallHack:Start()
        DevConsole:Info("WallHack on")
    end
end, "Toggle WallHack")

DevConsole:Register("aim", function()
    if NL.AimHold.State._enabled then NL.AimHold:Stop(); DevConsole:Info("Aim off")
    else NL.AimHold:Start(); DevConsole:Info("Aim on") end
end, "Toggle Aim")

DevConsole:Register("tb", function()
    if NL.TriggerBot.State._enabled then NL.TriggerBot:Stop(); DevConsole:Info("TB off")
    else NL.TriggerBot:Start(); DevConsole:Info("TB on") end
end, "Toggle Trigger Bot")

DevConsole:Register("night", function()
    if NL.NightMode.State._enabled then NL.NightMode:Stop(); DevConsole:Info("Night off")
    else NL.NightMode:Start(); DevConsole:Info("Night on") end
end, "Toggle Night Mode")

DevConsole:Register("shake", function()
    if NL.ShakeRemover.State._enabled then NL.ShakeRemover:Stop(); DevConsole:Info("Shake off")
    else NL.ShakeRemover:Start(); DevConsole:Info("Shake on") end
end, "Toggle Shake")

DevConsole:Register("fps", function()
    DevConsole:Info("FPS: " .. tostring(NL.Performance.fps) .. " · avg: " .. tostring(NL.Performance:AvgFPS()))
end, "Показать FPS")

DevConsole:Register("ping", function()
    local ping = 0
    pcall(function()
        local i = Stats.Network.ServerStatsItem:FindFirstChild("Data Ping")
        if i then ping = math.floor(i:GetValue()) end
    end)
    DevConsole:Info("Ping: " .. ping .. " ms")
end, "Показать ping")

DevConsole:Register("uptime", function()
    DevConsole:Info("Uptime: " .. NL.Session:Uptime())
end, "Аптайм")

DevConsole:Register("players", function()
    local list = Players:GetPlayers()
    DevConsole:Info("Игроков: " .. #list)
    for _, p in ipairs(list) do
        DevConsole:Info("  · " .. p.Name)
    end
end, "Список игроков")

DevConsole:Register("save", function(name)
    NL.Config.Save(name or NL.Config.State.selected)
    DevConsole:Success("Сохранено")
end, "Сохранить конфиг")

DevConsole:Register("load", function(name)
    NL.Config.Load(name or NL.Config.State.selected)
    DevConsole:Success("Загружено")
end, "Загрузить конфиг")

DevConsole:Register("preset", function(action, slot)
    slot = tonumber(slot) or 1
    if action == "save" then
        NL.UIPreset.Save(slot)
        DevConsole:Success("Слот " .. slot .. " сохранён")
    elseif action == "load" then
        NL.UIPreset.Load(slot)
        DevConsole:Success("Слот " .. slot .. " загружен")
    else
        DevConsole:Warn("preset save|load <1-9>")
    end
end, "UI-пресеты")

DevConsole:Register("destroy", function()
    NL:Destroy()
end, "Выгрузить UI")

--// ═══════════════════════════════════════════════════════════════════════
--//  §167 · DEBUG OVERLAY · ЯДРО
--// ═══════════════════════════════════════════════════════════════════════

local DebugOverlay = {
    _enabled = false,
    frame = nil,
    labels = {},
    bars = {},
    _conn = nil,
}

NL.DebugOverlay = DebugOverlay

--// ═══════════════════════════════════════════════════════════════════════
--//  §168 · DEBUG OVERLAY · UI
--// ═══════════════════════════════════════════════════════════════════════

function DebugOverlay:Enable()
    if self._enabled then return end
    self._enabled = true

    local win = NL._window
    if not win then return end

    if not self.frame then
        -- контейнер
        local f = New("Frame", {
            Name = "DebugOverlay",
            AnchorPoint = Vector2.new(0, 0),
            Position = UDim2.new(0, 12, 0, 320),
            Size = UDim2.new(0, 240, 0, 160),
            BackgroundColor3 = NL.Theme.Background,
            BackgroundTransparency = 0.15,
            BorderSizePixel = 0,
            ZIndex = 830,
            Parent = win._screen,
        })
        Round(f, 8)
        Stroke(f, NL.Theme.StrokeLight)
        Padding(f, 10, 12, 10, 12)
        VLayout(f, 6)

        self.frame = f

        -- заголовок
        local title = New("TextLabel", {
            Text = "▸ DEBUG HUD",
            Font = NL.Theme.FontBold,
            TextSize = 10,
            TextColor3 = NL.Theme.Accent,
            TextXAlignment = Enum.TextXAlignment.Left,
            Size = UDim2.new(1, 0, 0, 14),
            BackgroundTransparency = 1,
            ZIndex = 831,
            Parent = f,
        })

        -- разделитель
        local div = New("Frame", {
            Size = UDim2.new(1, 0, 0, 1),
            BackgroundColor3 = NL.Theme.Divider,
            BorderSizePixel = 0,
            ZIndex = 831,
            Parent = f,
        })

        -- строки данных
        local function makeRow(key, label)
            local row = New("Frame", {
                Size = UDim2.new(1, 0, 0, 16),
                BackgroundTransparency = 1,
                ZIndex = 831,
                Parent = f,
            })

            New("TextLabel", {
                Text = label,
                Font = NL.Theme.FontMono,
                TextSize = 10,
                TextColor3 = NL.Theme.TextDim,
                TextXAlignment = Enum.TextXAlignment.Left,
                Size = UDim2.new(0.5, 0, 1, 0),
                BackgroundTransparency = 1,
                ZIndex = 832,
                Parent = row,
            })

            local val = New("TextLabel", {
                Text = "—",
                Font = NL.Theme.FontMono,
                TextSize = 10,
                TextColor3 = NL.Theme.Text,
                TextXAlignment = Enum.TextXAlignment.Right,
                Size = UDim2.new(0.5, 0, 1, 0),
                Position = UDim2.new(0.5, 0, 0, 0),
                BackgroundTransparency = 1,
                ZIndex = 832,
                Parent = row,
            })

            self.labels[key] = val
        end

        makeRow("fps", "FPS")
        makeRow("ping", "Ping")
        makeRow("players", "Players")
        makeRow("uptime", "Uptime")
        makeRow("position", "Position")

        self.frame.Visible = true
    end

    -- цикл обновления
    self._conn = RunService.Heartbeat:Connect(function()
        if not self._enabled then return end

        if self.labels["fps"] then
            self.labels["fps"].Text = tostring(NL.Performance.fps)
        end
        if self.labels["ping"] then
            local ping = 0
            pcall(function()
                local i = Stats.Network.ServerStatsItem:FindFirstChild("Data Ping")
                if i then ping = math.floor(i:GetValue()) end
            end)
            self.labels["ping"].Text = ping .. " ms"
        end
        if self.labels["players"] then
            self.labels["players"].Text = tostring(#Players:GetPlayers())
        end
        if self.labels["uptime"] then
            self.labels["uptime"].Text = NL.Session:Uptime()
        end
        if self.labels["position"] and LocalPlayer and LocalPlayer.Character then
            local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                local p = hrp.Position
                self.labels["position"].Text = string.format("%.0f, %.0f, %.0f", p.X, p.Y, p.Z)
            end
        end
    end)
end

function DebugOverlay:Disable()
    self._enabled = false
    if self._conn then self._conn:Disconnect(); self._conn = nil end
    if self.frame then self.frame.Visible = false end
end

function DebugOverlay:Toggle()
    if self._enabled then self:Disable() else self:Enable() end
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §169-170 · KEYBIND MANAGER
--// ═══════════════════════════════════════════════════════════════════════

local KeybindManager = {
    _list = {},
}

function KeybindManager:Register(name, key, mode, callback)
    table.insert(self._list, {
        name = name,
        key = key,
        mode = mode or "toggle",
        callback = callback,
    })
end

function KeybindManager:GetAll()
    local copy = {}
    for _, k in ipairs(self._list) do
        table.insert(copy, k)
    end
    return copy
end

NL.KeybindManager = KeybindManager

--// ═══════════════════════════════════════════════════════════════════════
--//  §171-172 · TELEMETRY
--// ═══════════════════════════════════════════════════════════════════════

local Telemetry = {
    _fpsHistory = {},
    _pingHistory = {},
    _maxHistory = 60,
    _conn = nil,
}

function Telemetry:Start()
    if self._conn then return end
    self._conn = task.spawn(function()
        while true do
            task.wait(1)
            table.insert(self._fpsHistory, NL.Performance.fps)
            while #self._fpsHistory > self._maxHistory do
                table.remove(self._fpsHistory, 1)
            end

            local ping = 0
            pcall(function()
                local i = Stats.Network.ServerStatsItem:FindFirstChild("Data Ping")
                if i then ping = math.floor(i:GetValue()) end
            end)
            table.insert(self._pingHistory, ping)
            while #self._pingHistory > self._maxHistory do
                table.remove(self._pingHistory, 1)
            end
        end
    end)
end

function Telemetry:GetFPSHistory() return self._fpsHistory end
function Telemetry:GetPingHistory() return self._pingHistory end

Telemetry:Start()
NL.Telemetry = Telemetry

--// ═══════════════════════════════════════════════════════════════════════
--//  §173-174 · ELEMENT INSPECTOR
--// ═══════════════════════════════════════════════════════════════════════

function NL:PrintElementTree()
    DevConsole:Info("=== Дерево UI ===")
    local win = NL._window
    if not win then return end
    for _, tab in ipairs(win._tabs) do
        DevConsole:Info("▸ " .. tab.Name)
        for _, col in ipairs(tab._columns) do
            for _, group in ipairs(col.groups) do
                DevConsole:Info("  · " .. (group.Name or "?"))
                for _, el in ipairs(group._elements) do
                    DevConsole:Info("    - " .. tostring(el.Name) .. " (" .. tostring(el._type) .. ")")
                end
            end
        end
    end
end

DevConsole:Register("tree", function()
    NL:PrintElementTree()
end, "Дерево UI")

--// ═══════════════════════════════════════════════════════════════════════
--//  §175 · LOADER SPINNER
--// ═══════════════════════════════════════════════════════════════════════

function EffectsAdv.LoaderSpinner(parent, size)
    size = size or 24

    local container = New("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(0, size, 0, size),
        Parent = parent,
    })

    local spinner = New("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.5, 0, 0.5, 0),
        Size = UDim2.new(1, -2, 1, -2),
        BackgroundTransparency = 1,
        Parent = container,
    })

    local stroke = New("UIStroke", {
        Color = NL.Theme.Accent,
        Thickness = 2,
        Transparency = 0,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        Parent = spinner,
    })

    Circle(spinner)

    -- arc через UIGradient с прозрачностью
    local grad = New("UIGradient", {
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, NL.Theme.Accent),
            ColorSequenceKeypoint.new(0.5, NL.Theme.Accent),
            ColorSequenceKeypoint.new(1, NL.Theme.AccentBright),
        }),
        Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0),
            NumberSequenceKeypoint.new(0.5, 1),
            NumberSequenceKeypoint.new(1, 1),
        }),
        Rotation = 0,
        Parent = spinner,
    })

    task.spawn(function()
        while container.Parent do
            grad.Rotation = (grad.Rotation + 8) % 360
            task.wait(0.02)
        end
    end)

    return container
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §176 · MARQUEE TEXT
--// ═══════════════════════════════════════════════════════════════════════

function EffectsAdv.Marquee(label, speed)
    if not label then return end
    speed = speed or 30

    local clip = New("Frame", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        ClipsDescendants = true,
        Parent = label.Parent,
        ZIndex = label.ZIndex,
        Position = label.Position,
    })

    label.Parent = clip
    label.Size = UDim2.new(0, 200, 1, 0)
    label.Position = UDim2.new(0, 0, 0, 0)

    task.spawn(function()
        while clip.Parent do
            local textW = label.TextBounds.X
            local clipW = clip.AbsoluteSize.X
            if textW > clipW then
                local distance = textW + 20
                local time = distance / speed
                label.Position = UDim2.new(0, clipW, 0, 0)
                Tween(label, time, {
                    Position = UDim2.new(0, -textW - 20, 0, 0),
                }, Enum.EasingStyle.Linear)
                task.wait(time + 0.3)
            else
                label.Position = UDim2.new(0, 0, 0, 0)
                task.wait(1)
            end
        end
    end)

    return clip
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §177 · TYPEWRITER
--// ═══════════════════════════════════════════════════════════════════════

function EffectsAdv.Typewriter(label, text, speed, onComplete)
    if not label then return end
    speed = speed or 0.03

    text = tostring(text)
    label.Text = ""

    task.spawn(function()
        for i = 1, #text do
            if not label.Parent then return end
            label.Text = text:sub(1, i)
            task.wait(speed)
        end
        if onComplete then SafeCall(onComplete) end
    end)
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §178 · GLOW BUTTON
--// ═══════════════════════════════════════════════════════════════════════

function EffectsAdv.GlowButton(parent, text, callback)
    local btn = New("TextButton", {
        Text = text,
        Font = NL.Theme.FontBold,
        TextSize = 12,
        TextColor3 = NL.Theme.Text,
        BackgroundColor3 = NL.Theme.Element,
        AutoButtonColor = false,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 32),
        Parent = parent,
    })
    Round(btn, 6)

    local glow = New("UIStroke", {
        Color = NL.Theme.Accent,
        Thickness = 1,
        Transparency = 0.7,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        Parent = btn,
    })

    btn.MouseEnter:Connect(function()
        Tween(btn, 0.2, { BackgroundColor3 = NL.Theme.Accent })
        Tween(glow, 0.2, { Thickness = 3, Transparency = 0 })
        Tween(btn, 0.2, { TextColor3 = Color3.fromRGB(255, 255, 255) })
    end)
    btn.MouseLeave:Connect(function()
        Tween(btn, 0.3, { BackgroundColor3 = NL.Theme.Element })
        Tween(glow, 0.3, { Thickness = 1, Transparency = 0.7 })
        Tween(btn, 0.3, { TextColor3 = NL.Theme.Text })
    end)

    btn.MouseButton1Down:Connect(function()
        EffectsAdv.Ripple(btn, NL.Theme.AccentBright)
    end)
    btn.MouseButton1Click:Connect(function()
        PlaySound()
        if callback then SafeCall(callback) end
    end)

    return btn
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §179 · RIPPLE RIPPLE
--// ═══════════════════════════════════════════════════════════════════════

function EffectsAdv.RippleCascade(target, count, delayPer)
    count = count or 3
    delayPer = delayPer or 0.08
    for i = 1, count do
        task.delay((i - 1) * delayPer, function()
            EffectsAdv.Ripple(target, NL.Theme.AccentBright)
        end)
    end
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §180 · PARTICLE FIELD
--// ═══════════════════════════════════════════════════════════════════════

function EffectsAdv.ParticleField(parent, count)
    count = count or 20
    local container = New("Frame", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Parent = parent,
    })

    for i = 1, count do
        local p = New("Frame", {
            Position = UDim2.new(math.random(), 0, math.random(), 0),
            Size = UDim2.new(0, 2, 0, 2),
            BackgroundColor3 = NL.Theme.Accent,
            BackgroundTransparency = math.random(50, 90) / 100,
            BorderSizePixel = 0,
            ZIndex = -1,
            Parent = container,
        })
        Circle(p)

        task.spawn(function()
            while p.Parent do
                local targetY = p.Position.Y.Scale - 0.3
                Tween(p, 8 + math.random() * 4, {
                    Position = UDim2.new(p.Position.X.Scale, 0, targetY, 0),
                }, Enum.EasingStyle.Linear)

                task.wait(8)

                p.Position = UDim2.new(math.random(), 0, 1, 0)
                p.BackgroundTransparency = math.random(50, 90) / 100
            end
        end)
    end

    return container
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §181 · GRADIENT BORDER
--// ═══════════════════════════════════════════════════════════════════════

function EffectsAdv.GradientBorder(target)
    if not target then return end

    local border = New("Frame", {
        Size = UDim2.new(1, 2, 1, 2),
        Position = UDim2.new(0, -1, 0, -1),
        BackgroundColor3 = NL.Theme.Accent,
        BorderSizePixel = 0,
        ZIndex = target.ZIndex - 1,
        Parent = target,
    })
    Round(border, 10)

    local grad = New("UIGradient", {
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, NL.Theme.Accent),
            ColorSequenceKeypoint.new(0.5, NL.Theme.AccentBright),
            ColorSequenceKeypoint.new(1, NL.Theme.Accent),
        }),
        Rotation = 0,
        Parent = border,
    })

    task.spawn(function()
        while border.Parent do
            grad.Rotation = (grad.Rotation + 1) % 360
            task.wait(0.03)
        end
    end)

    return border
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §182 · SCANLINE EFFECT
--// ═══════════════════════════════════════════════════════════════════════

function EffectsAdv.ScanlineEffect(target)
    if not target then return end

    local scan = New("Frame", {
        Size = UDim2.new(1, 0, 0, 3),
        Position = UDim2.new(0, 0, 0, 0),
        BackgroundColor3 = NL.Theme.Accent,
        BackgroundTransparency = 0.7,
        BorderSizePixel = 0,
        ZIndex = 900,
        Parent = target,
    })

    task.spawn(function()
        while scan.Parent do
            scan.Position = UDim2.new(0, 0, 0, 0)
            Tween(scan, 2.5, {
                Position = UDim2.new(0, 0, 1, -3),
            }, Enum.EasingStyle.Linear)
            task.wait(2.6)
        end
    end)

    return scan
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §183 · CHROMATIC ABERRATION (эффект RGB split)
--// ═══════════════════════════════════════════════════════════════════════

function EffectsAdv.ChromaticAberration(target, intensity)
    if not target then return end
    intensity = intensity or 2

    local oldStroke = target:FindFirstChildOfClass("UIStroke")
    local hadStroke = oldStroke ~= nil
    if hadStroke then oldStroke.Transparency = 1 end

    local rStroke = New("UIStroke", {
        Color = Color3.fromRGB(255, 100, 100),
        Thickness = 1,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        Parent = target,
    })

    local bStroke = New("UIStroke", {
        Color = Color3.fromRGB(100, 100, 255),
        Thickness = 1,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        Parent = target,
    })

    -- анимированный сдвиг — через позицию самого элемента
    local oldPos = target.Position

    return {
        Stop = function()
            if rStroke and rStroke.Parent then rStroke:Destroy() end
            if bStroke and bStroke.Parent then bStroke:Destroy() end
            if hadStroke and oldStroke.Parent then oldStroke.Transparency = 0 end
        end,
    }
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §184 · SCREEN FLASH
--// ═══════════════════════════════════════════════════════════════════════

function EffectsAdv.ScreenFlash(color, duration)
    local win = NL._window
    if not win then return end

    local flash = New("Frame", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundColor3 = color or NL.Theme.Accent,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ZIndex = 9999,
        Parent = win._screen,
    })

    Tween(flash, 0.08, { BackgroundTransparency = 0.4 })
    task.delay(duration or 0.2, function()
        Tween(flash, 0.3, { BackgroundTransparency = 1 })
        task.delay(0.35, function()
            pcall(function() flash:Destroy() end)
        end)
    end)
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §185 · CONFETTI BURST
--// ═══════════════════════════════════════════════════════════════════════

function EffectsAdv.ConfettiBurst(position, count)
    local win = NL._window
    if not win then return end

    count = count or 40
    local colors = {
        NL.Theme.Accent, NL.Theme.AccentBright,
        NL.Theme.Success, NL.Theme.Warning,
        Color3.fromRGB(255, 100, 100),
        Color3.fromRGB(100, 200, 255),
    }

    for i = 1, count do
        local color = colors[math.random(1, #colors)]
        local p = New("Frame", {
            Position = UDim2.new(0, position.X, 0, position.Y),
            Size = UDim2.new(0, math.random(3, 6), 0, math.random(3, 6)),
            BackgroundColor3 = color,
            BorderSizePixel = 0,
            ZIndex = 9998,
            Parent = win._screen,
        })
        Round(p, 1)

        local angle = math.random() * math.pi * 2
        local distance = math.random(50, 200)
        local dx = math.cos(angle) * distance
        local dy = math.sin(angle) * distance

        Tween(p, 0.8 + math.random() * 0.4, {
            Position = UDim2.new(0, position.X + dx, 0, position.Y + dy),
            Rotation = math.random(-360, 360),
            Size = UDim2.new(0, 1, 0, 1),
            BackgroundTransparency = 1,
        }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

        task.delay(1.3, function()
            pcall(function() p:Destroy() end)
        end)
    end
end

