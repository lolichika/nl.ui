            end,
        },
    })
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §87 · SCREEN SHAKE REMOVER · BindToRenderStep
--// ═══════════════════════════════════════════════════════════════════════

local ShakeRemover = {
    _enabled = false,
    _renderBinding = "NL_NoShake",
    _disabledScripts = {},
    _charConns = {},
    _blockCount = 0,
    _lastCF = nil,
    _mouseMoved = false,
    _mouseConn = nil,
    _positionFilter = false,
    _sensitivity = 0.003,
}

-- отслеживание мыши
local function SetupMouseTracking()
    if ShakeRemover._mouseConn then
        ShakeRemover._mouseConn:Disconnect()
    end
    ShakeRemover._mouseConn = UserInputService.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement then
            ShakeRemover._mouseMoved = true
        end
    end)
end

-- отключить shake-скрипты в контейнере
local function DisableShakeScriptsFor(root)
    if not root then return end
    local keywords = { "shake", "recoil", "camerashake", "jitter" }
    for _, s in ipairs(root:GetDescendants()) do
        if s:IsA("LocalScript") or s:IsA("Script") then
            local n = s.Name:lower()
            for _, kw in ipairs(keywords) do
                if n:find(kw) then
                    pcall(function() s.Disabled = true end)
                    table.insert(ShakeRemover._disabledScripts, s)
                    break
                end
            end
        end
    end
end

local function DisableShakeInCharacter(char)
    if not char then return end
    DisableShakeScriptsFor(char)
end

-- основная функция-антишака
local function AntiShakeStep()
    if not ShakeRemover._enabled then return end

    local cam = Workspace.CurrentCamera
    if not cam then return end

    -- CameraOffset reset
    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            local off = hum.CameraOffset
            if off.X ~= 0 or off.Y ~= 0 or off.Z ~= 0 then
                hum.CameraOffset = Vector3.new(0, 0, 0)
            end
        end
    end

    -- мышь двигалась в этом кадре?
    local movedThisFrame = ShakeRemover._mouseMoved
    ShakeRemover._mouseMoved = false

    if ShakeRemover._lastCF and not movedThisFrame then
        local curLook = cam.CFrame.LookVector
        local oldLook = ShakeRemover._lastCF.LookVector
        local rotDelta = (curLook - oldLook).Magnitude

        if rotDelta > ShakeRemover._sensitivity then
            local pos = cam.CFrame.Position
            cam.CFrame = CFrame.lookAt(pos, pos + oldLook)
            ShakeRemover._blockCount = ShakeRemover._blockCount + 1

            if ShakeRemover._positionFilter then
                local posDelta = (pos - ShakeRemover._lastCF.Position).Magnitude
                if posDelta > 1 and posDelta < 5 then
                    cam.CFrame = CFrame.new(
                        ShakeRemover._lastCF.Position,
                        ShakeRemover._lastCF.Position + oldLook
                    )
                end
            end
        end
    end

    ShakeRemover._lastCF = cam.CFrame
end

-- стоп
local function StopShakeRemover()
    ShakeRemover._enabled = false

    pcall(function()
        RunService:UnbindFromRenderStep(ShakeRemover._renderBinding)
    end)

    if ShakeRemover._mouseConn then
        ShakeRemover._mouseConn:Disconnect()
        ShakeRemover._mouseConn = nil
    end

    for _, c in ipairs(ShakeRemover._charConns) do
        pcall(function() c:Disconnect() end)
    end
    ShakeRemover._charConns = {}

    for _, s in ipairs(ShakeRemover._disabledScripts) do
        pcall(function() s.Disabled = false end)
    end
    ShakeRemover._disabledScripts = {}
    ShakeRemover._blockCount = 0
    ShakeRemover._lastCF = nil
end

-- старт
local function StartShakeRemover()
    StopShakeRemover()
    ShakeRemover._enabled = true

    DisableShakeScriptsFor(LocalPlayer:FindFirstChild("PlayerScripts"))
    DisableShakeScriptsFor(LocalPlayer:FindFirstChild("PlayerGui"))

    if LocalPlayer.Character then
        DisableShakeInCharacter(LocalPlayer.Character)
    end

    table.insert(ShakeRemover._charConns,
        LocalPlayer.CharacterAdded:Connect(function(char)
            task.wait(0.4)
            if ShakeRemover._enabled then
                DisableShakeInCharacter(char)
            end
        end)
    )

    SetupMouseTracking()

    pcall(function()
        RunService:BindToRenderStep(
            ShakeRemover._renderBinding,
            Enum.RenderPriority.Character.Value + 1,
            AntiShakeStep
        )
    end)
end

FeatureRegistry:Register("ShakeRemover", StopShakeRemover)
NL.ShakeRemover = {
    Start = StartShakeRemover,
    Stop  = StopShakeRemover,
    State = ShakeRemover,
}

--// ═══════════════════════════════════════════════════════════════════════
--//  §88 · SCREEN SHAKE · UI
--// ═══════════════════════════════════════════════════════════════════════

local function BuildShakeUI(group)
    if not group then return end

    group:AddToggle("Enabled", {
        Flag = "shake_enabled",
        Default = false,
        Tooltip = "Убирает тряску камеры через BindToRenderStep (без хуков)",
        Callback = function(on)
            if on then
                StartShakeRemover()
                NL:Notify("Shake Remover", "Активен", 2, "success")
            else
                StopShakeRemover()
            end
        end,
    })

    group:AddSlider("Sensitivity", {
        Flag = "shake_sens",
        Min = 0.001,
        Max = 0.05,
        Default = 0.003,
        Decimals = 3,
        Tooltip = "Порог детекта (меньше = строже)",
        Callback = function(v)
            ShakeRemover._sensitivity = v
        end,
    })

    group:AddToggle("Position Filter", {
        Flag = "shake_posfilter",
        Default = false,
        Tooltip = "Дополнительно блокировать position-скачки",
        Callback = function(on)
            ShakeRemover._positionFilter = on
        end,
    })

    group:AddButton("Показать статистику", {
        Callback = function()
            NL:Notify("Shake Remover",
                "Заблокировано: " .. ShakeRemover._blockCount, 3, "info")
        end,
    })
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §89 · OPTIMIZATION · ЯДРО
--// ═══════════════════════════════════════════════════════════════════════

local Optimize = {
    _particles   = false,
    _legacyFx    = false,
    _decals      = false,
    _sounds      = false,
    _postFx      = false,
    _shadows     = false,
    _renderDist  = false,
    _savedData   = {},
    _renderDistVal = 500,
}

-- безопасная проверка (не трогаем GUI)
local function IsSafeToModify(obj)
    if not obj or not obj.Parent then return false end
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if pg and obj:IsDescendantOf(pg) then return false end
    return true
end

-- скан чанками (не фризит GUI)
local function SafeScanWorkspace(filterFn, workFn)
    task.spawn(function()
        local list = Workspace:GetDescendants()
        for i = 1, #list do
            local obj = list[i]
            local ok, pass = pcall(filterFn, obj)
            if ok and pass then
                pcall(workFn, obj)
            end
            if i % 200 == 0 then
                task.wait()
            end
        end
    end)
end

-- Particles
local function DisableParticles()
    Optimize._particles = true
    SafeScanWorkspace(
        function(o)
            return o:IsA("ParticleEmitter") and o.Enabled and IsSafeToModify(o)
        end,
        function(o)
            table.insert(Optimize._savedData, { obj = o, enabled = true, kind = "particle" })
            o.Enabled = false
        end
    )
end

local function EnableParticles()
    local keep = {}
    for _, e in ipairs(Optimize._savedData) do
        if e.kind == "particle" then
            if e.obj and e.obj.Parent then
                pcall(function() e.obj.Enabled = e.enabled end)
            end
        else
            table.insert(keep, e)
        end
    end
    Optimize._savedData = keep
    Optimize._particles = false
end

-- Legacy FX
local function DisableLegacyFx()
    Optimize._legacyFx = true
    SafeScanWorkspace(
        function(o)
            return (o:IsA("Smoke") or o:IsA("Fire") or o:IsA("Sparkles"))
                and o.Enabled and IsSafeToModify(o)
        end,
        function(o)
            table.insert(Optimize._savedData, { obj = o, enabled = true, kind = "legacyfx" })
            o.Enabled = false
        end
    )
end

local function EnableLegacyFx()
    local keep = {}
    for _, e in ipairs(Optimize._savedData) do
        if e.kind == "legacyfx" then
            if e.obj and e.obj.Parent then
                pcall(function() e.obj.Enabled = e.enabled end)
            end
        else
            table.insert(keep, e)
        end
    end
    Optimize._savedData = keep
    Optimize._legacyFx = false
end

-- Decals
local function DisableDecals()
    Optimize._decals = true
    SafeScanWorkspace(
        function(o)
            return (o:IsA("Decal") or o:IsA("Texture")) and IsSafeToModify(o)
        end,
        function(o)
            table.insert(Optimize._savedData, {
                obj = o, transparency = o.Transparency, kind = "decal",
            })
            o.Transparency = 1
        end
    )
end

local function EnableDecals()
    local keep = {}
    for _, e in ipairs(Optimize._savedData) do
        if e.kind == "decal" then
            if e.obj and e.obj.Parent then
                pcall(function() e.obj.Transparency = e.transparency or 0 end)
            end
        else
            table.insert(keep, e)
        end
    end
    Optimize._savedData = keep
    Optimize._decals = false
end

-- Sounds
local function DisableSounds()
    Optimize._sounds = true
    SafeScanWorkspace(
        function(o)
            return o:IsA("Sound") and o.Playing and IsSafeToModify(o)
        end,
        function(o)
            table.insert(Optimize._savedData, { obj = o, kind = "sound" })
            o.Playing = false
            o.Volume = 0
        end
    )
end

local function EnableSounds()
    local keep = {}
    for _, e in ipairs(Optimize._savedData) do
        if e.kind == "sound" then
            if e.obj and e.obj.Parent then
                pcall(function() e.obj.Volume = 1 end)
            end
        else
            table.insert(keep, e)
        end
    end
    Optimize._savedData = keep
    Optimize._sounds = false
end

-- Post-FX
local function DisablePostFx()
    Optimize._postFx = true
    local classes = {
        "BloomEffect", "BlurEffect", "ColorCorrectionEffect",
        "SunRaysEffect", "DepthOfFieldEffect",
    }
    for _, obj in ipairs(Lighting:GetDescendants()) do
        for _, cls in ipairs(classes) do
            if obj:IsA(cls) and obj.Enabled then
                table.insert(Optimize._savedData, { obj = obj, kind = "postfx" })
                pcall(function() obj.Enabled = false end)
                break
            end
        end
    end
end

local function EnablePostFx()
    local keep = {}
    for _, e in ipairs(Optimize._savedData) do
        if e.kind == "postfx" then
            if e.obj and e.obj.Parent then
                pcall(function() e.obj.Enabled = true end)
            end
        else
            table.insert(keep, e)
        end
    end
    Optimize._savedData = keep
    Optimize._postFx = false
end

-- Shadows
local function DisableShadows()
    Optimize._shadows = true
    SafeScanWorkspace(
        function(o)
            return o:IsA("BasePart") and o.CastShadow and IsSafeToModify(o)
        end,
        function(o)
            table.insert(Optimize._savedData, { obj = o, kind = "shadow" })
            o.CastShadow = false
        end
    )
end

local function EnableShadows()
    local keep = {}
    for _, e in ipairs(Optimize._savedData) do
        if e.kind == "shadow" then
            if e.obj and e.obj.Parent then
                pcall(function() e.obj.CastShadow = true end)
            end
        else
            table.insert(keep, e)
        end
    end
    Optimize._savedData = keep
    Optimize._shadows = false
end

-- Render Distance
local function SetRenderDistance(dist)
    Optimize._renderDistVal = dist
    Optimize._renderDist = true
    pcall(function()
        local us = UserSettings()
        if us and us.Rendering then
            us.Rendering.ViewDistance = dist
        end
    end)
end

local function ResetRenderDistance()
    Optimize._renderDist = false
    pcall(function()
        local us = UserSettings()
        if us and us.Rendering then
            us.Rendering.ViewDistance = 1000
        end
    end)
end

local function StopOptimize()
    EnableParticles()
    EnableLegacyFx()
    EnableDecals()
    EnableSounds()
    EnablePostFx()
    EnableShadows()
    ResetRenderDistance()
end

FeatureRegistry:Register("Optimize", StopOptimize)
NL.Optimize = {
    DisableParticles = DisableParticles,
    EnableParticles  = EnableParticles,
    DisableLegacyFx  = DisableLegacyFx,
    EnableLegacyFx   = EnableLegacyFx,
    DisableDecals    = DisableDecals,
    EnableDecals     = EnableDecals,
    DisableSounds    = DisableSounds,
    EnableSounds     = EnableSounds,
    DisablePostFx    = DisablePostFx,
    EnablePostFx     = EnablePostFx,
    DisableShadows   = DisableShadows,
    EnableShadows    = EnableShadows,
    SetRenderDistance = SetRenderDistance,
    ResetRenderDistance = ResetRenderDistance,
    State = Optimize,
}

--// ═══════════════════════════════════════════════════════════════════════
--//  §90 · OPTIMIZATION · UI
--// ═══════════════════════════════════════════════════════════════════════

local function BuildOptimizeUI(group)
    if not group then return end

    group:AddToggle("Particles", {
        Flag = "opt_particles",
        Default = false,
        Tooltip = "Отключить все ParticleEmitter (FPS)",
        Callback = function(on)
            if on then DisableParticles() else EnableParticles() end
        end,
    })

    group:AddToggle("Smoke / Fire / Sparkles", {
        Flag = "opt_legacyfx",
        Default = false,
        Tooltip = "Устаревшие эффекты",
        Callback = function(on)
            if on then DisableLegacyFx() else EnableLegacyFx() end
        end,
    })

    group:AddToggle("Decals & Textures", {
        Flag = "opt_decals",
        Default = false,
        Tooltip = "Наклейки и текстуры",
        Callback = function(on)
            if on then DisableDecals() else EnableDecals() end
        end,
    })

    group:AddToggle("Sounds", {
        Flag = "opt_sounds",
        Default = false,
        Tooltip = "Глушить все звуки",
        Callback = function(on)
            if on then DisableSounds() else EnableSounds() end
        end,
    })

    group:AddToggle("Post-Processing", {
        Flag = "opt_postfx",
        Default = false,
        Tooltip = "Bloom, Blur, DOF, SunRays",
        Callback = function(on)
            if on then DisablePostFx() else EnablePostFx() end
        end,
    })

    group:AddToggle("Shadows", {
        Flag = "opt_shadows",
        Default = false,
        Tooltip = "Тени всех объектов",
        Callback = function(on)
            if on then DisableShadows() else EnableShadows() end
        end,
    })

    group:AddToggle("Render Distance", {
        Flag = "opt_renderdist",
        Default = false,
        Tooltip = "Снизить дальность прогрузки",
        Callback = function(on)
            if on then SetRenderDistance(Optimize._renderDistVal) else ResetRenderDistance() end
        end,
    })

    group:AddSlider("Distance", {
        Flag = "opt_renderdistval",
        Min = 100,
        Max = 1000,
        Default = 500,
        Suffix = " st",
        Callback = function(v)
            Optimize._renderDistVal = v
            if Optimize._renderDist then SetRenderDistance(v) end
        end,
    })

    group:AddButtonRow({
        {
            Text = "MAX FPS",
            Callback = function()
                DisableParticles()
                DisableLegacyFx()
                DisableDecals()
                DisableSounds()
                DisablePostFx()
                DisableShadows()
                SetRenderDistance(300)
                NL:Notify("Optimize", "MAX FPS применён", 3, "success")
            end,
        },
        {
            Text = "Откатить",
            Callback = function()
                EnableParticles()
                EnableLegacyFx()
                EnableDecals()
                EnableSounds()
                EnablePostFx()
                EnableShadows()
                ResetRenderDistance()
                NL:Notify("Optimize", "Откат", 2, "info")
            end,
        },
    })
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §91 · ASSEMBLER · COMBAT ВКЛАДКА
--// ═══════════════════════════════════════════════════════════════════════

function NL:BuildCombatTab(tab)
    if not tab then return end

    local aimGroup = tab:CreateGroup("Aim Hold")
    BuildAimHoldUI(aimGroup)

    local tbGroup = tab:CreateGroup("Trigger Bot")
    BuildTriggerBotUI(tbGroup)

    return tab
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §92 · ASSEMBLER · VISUALS ВКЛАДКА
--// ═══════════════════════════════════════════════════════════════════════

function NL:BuildVisualsTab(tab)
    if not tab then return end

    local whGroup = tab:CreateGroup("WallHack")
    BuildWallHackUI(whGroup)

    local nightGroup = tab:CreateGroup("Night Mode")
    BuildNightModeUI(nightGroup)

    return tab
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §93 · ASSEMBLER · REMOVALS ВКЛАДКА
--// ═══════════════════════════════════════════════════════════════════════

function NL:BuildRemovalsTab(tab)
    if not tab then return end

    local shakeGroup = tab:CreateGroup("Screen Shake")
    BuildShakeUI(shakeGroup)

    local optGroup = tab:CreateGroup("Optimization")
    BuildOptimizeUI(optGroup)

    return tab
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §94 · ХУКИ НА РЕСПАВН
--// ═══════════════════════════════════════════════════════════════════════

if LocalPlayer then
    Connect(LocalPlayer.CharacterAdded, function()
        task.wait(0.4)

        -- WallHack пересбор
        if WallHack._enabled then
            for hum, _ in pairs(WallHack._data) do
                RemoveHighlight(hum)
            end
            WallHack._data = {}
            ScanHumanoids()
        end

        -- Shake пересбор
        if ShakeRemover._enabled and LocalPlayer.Character then
            DisableShakeInCharacter(LocalPlayer.Character)
        end
    end)
end

