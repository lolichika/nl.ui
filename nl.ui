       §114 · UI Polish · shadows + drop-shadow обёртка
       §115 · UI Polish · gradient texts
       §116 · UI Polish · scroll fade (градиенты на краях скролла)
       §117 · UI Polish · focus rings
       §118 · UI Polish · skeleton loading
       §119 · Экспорт API
═══════════════════════════════════════════════════════════════════════════ ]]

-- проверка загрузки предыдущих частей
if not NL or not NL.Features or not NL.GameFeatures then
    error("[NL] Часть 5 не загружена")
end
-- Roblox сервисы (для использования внутри этой части)
local Players          = game:GetService("Players")
local RunService       = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local TweenService     = game:GetService("TweenService")
local HttpService      = game:GetService("HttpService")
local SoundService     = game:GetService("SoundService")
local Debris           = game:GetService("Debris")
local Stats            = game:GetService("Stats")
local Lighting         = game:GetService("Lighting")
local Workspace        = game:GetService("Workspace")
local CoreGui          = game:GetService("CoreGui")
local LocalPlayer      = Players.LocalPlayer
-- ссылки
local New = NL._util.New
local Round = NL._util.Round
local Circle = NL._util.Circle
local Stroke = NL._util.Stroke
local Gradient = NL._util.Gradient
local Padding = NL._util.Padding
local HLayout = NL._util.HLayout
local VLayout = NL._util.VLayout
local Tween = NL._util.Tween
local Connect = NL._util.Connect
local SafeCall = NL._util.SafeCall
local PlaySound = NL._util.PlaySound

local Num = NL.Num
local Color = NL.Color
local Str = NL.Str
local Icon = NL.Icon
local Effects = NL.Effects
local Cache = NL._util.Cache
local Theme = NL.Theme
local Settings = NL.Settings

--// ═══════════════════════════════════════════════════════════════════════
--//  §96 · NOTIFICATION PRIORITY QUEUE
--// ═══════════════════════════════════════════════════════════════════════

local NotifyAdvanced = {
    queue      = {},
    active     = {},
    history    = {},
    holders    = {},       -- [position] = Frame
    maxActive  = 5,
    maxHistory = 200,
    groupingEnabled = true,
    groupWindow = 2.0,      -- сек, окно для склейки одинаковых
    soundEnabled = true,
}

-- приоритеты (меньше = важнее)
local PRIORITY = {
    critical = 0,
    error    = 1,
    warning  = 2,
    success  = 3,
    info     = 4,
    debug    = 5,
}

-- позиции держателя
local HOLDER_POSITIONS = {
    ["top-right"]     = { Anchor = Vector2.new(1, 0), Pos = UDim2.new(1, -16, 0, 16), Align = Enum.VerticalAlignment.Top, HAlign = Enum.HorizontalAlignment.Right, Dir = 1 },
    ["top-left"]      = { Anchor = Vector2.new(0, 0), Pos = UDim2.new(0, 16, 0, 16), Align = Enum.VerticalAlignment.Top, HAlign = Enum.HorizontalAlignment.Left, Dir = -1 },
    ["bottom-right"]  = { Anchor = Vector2.new(1, 1), Pos = UDim2.new(1, -16, 1, -16), Align = Enum.VerticalAlignment.Bottom, HAlign = Enum.HorizontalAlignment.Right, Dir = 1 },
    ["bottom-left"]   = { Anchor = Vector2.new(0, 1), Pos = UDim2.new(0, 16, 1, -16), Align = Enum.VerticalAlignment.Bottom, HAlign = Enum.HorizontalAlignment.Left, Dir = -1 },
    ["top-center"]    = { Anchor = Vector2.new(0.5, 0), Pos = UDim2.new(0.5, 0, 0, 16), Align = Enum.VerticalAlignment.Top, HAlign = Enum.HorizontalAlignment.Center, Dir = 1 },
    ["bottom-center"] = { Anchor = Vector2.new(0.5, 1), Pos = UDim2.new(0.5, 0, 1, -16), Align = Enum.VerticalAlignment.Bottom, HAlign = Enum.HorizontalAlignment.Center, Dir = -1 },
}

-- текущая позиция держателя
NotifyAdvanced.currentPosition = "top-right"

-- получить или создать держатель
local function GetHolder(position)
    position = position or NotifyAdvanced.currentPosition
    if NotifyAdvanced.holders[position] and NotifyAdvanced.holders[position].Parent then
        return NotifyAdvanced.holders[position]
    end
    local win = NL._window
    if not win then return nil end

    local posConfig = HOLDER_POSITIONS[position] or HOLDER_POSITIONS["top-right"]

    local holder = New("Frame", {
        Name = "Notifications_" .. position,
        AnchorPoint = posConfig.Anchor,
        Position = posConfig.Pos,
        Size = UDim2.new(0, 300, 0, 0),
        BackgroundTransparency = 1,
        ZIndex = 500,
        Parent = win._screen,
    })

    local layout = New("UIListLayout", {
        Padding = UDim.new(0, 8),
        HorizontalAlignment = posConfig.HAlign,
        VerticalAlignment = posConfig.Align,
        SortOrder = Enum.SortOrder.LayoutOrder,
        Parent = holder,
    })

    NotifyAdvanced.holders[position] = holder
    return holder
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §97 · NOTIFICATION GROUPING
--// ═══════════════════════════════════════════════════════════════════════

-- найти существующее уведомление с тем же title+text для группировки
local function FindGroupCandidate(title, text)
    if not NotifyAdvanced.groupingEnabled then return nil end
    local now = tick()
    for _, entry in ipairs(NotifyAdvanced.active) do
        if entry.title == title and entry.text == text
        and (now - entry.createdAt) < NotifyAdvanced.groupWindow then
            return entry
        end
    end
    return nil
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §98 · NOTIFICATION HISTORY
--// ═══════════════════════════════════════════════════════════════════════

local function PushHistory(entry)
    table.insert(NotifyAdvanced.history, {
        title = entry.title,
        text = entry.text,
        type = entry.type or "info",
        time = os.time(),
        count = 1,
    })
    while #NotifyAdvanced.history > NotifyAdvanced.maxHistory do
        table.remove(NotifyAdvanced.history, 1)
    end
end

function NotifyAdvanced:GetHistory()
    local copy = {}
    for i, e in ipairs(NotifyAdvanced.history) do
        copy[i] = e
    end
    return copy
end

function NotifyAdvanced:ClearHistory()
    NotifyAdvanced.history = {}
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §99 · NOTIFICATION ADVANCED · карточка
--// ═══════════════════════════════════════════════════════════════════════

-- создать карточку
local function CreateNotifyCard(entry)
    local holder = GetHolder(entry.position)
    if not holder then return end

    local ntype   = entry.type or "info"
    local accent  = entry.accent or ({
        info    = NL.Theme.Accent,
        success = NL.Theme.Success,
        error   = NL.Theme.Error,
        warning = NL.Theme.Warning,
        critical = Color3.fromRGB(255, 60, 60),
        debug   = NL.Theme.TextDim,
    })[ntype] or NL.Theme.Accent

    local iconName = ({
        info    = "Dot",
        success = "Check",
        error   = "Close",
        warning = "Bell",
        critical = "Bell",
        debug   = "Code",
    })[ntype] or "Dot"

    -- содержимое карточки
    local titleText = tostring(entry.title or "")
    local bodyText  = tostring(entry.text or "")
    local hasBody   = #bodyText > 0

    -- рассчитать высоту
    local cardH = 56
    if hasBody and #bodyText > 40 then
        cardH = 72
    elseif not hasBody then
        cardH = 44
    end

    -- обёртка для списка
    local wrapper = New("Frame", {
        Size = UDim2.new(1, 0, 0, cardH),
        BackgroundTransparency = 1,
        LayoutOrder = -math.floor(tick() * 1000),
        Parent = holder,
    })

    -- карточка
    local card = New("Frame", {
        Position = UDim2.new(0, 320 * (HOLDER_POSITIONS[entry.position or NotifyAdvanced.currentPosition] or HOLDER_POSITIONS["top-right"]).Dir, 0, 0),
        Size = UDim2.new(1, 0, 0, cardH),
        BackgroundColor3 = NL.Theme.Popout,
        BorderSizePixel = 0,
        ClipsDescendants = false,
        Parent = wrapper,
    })
    Round(card, 8)
    local cardStroke = Stroke(card, NL.Theme.StrokeLight)

    -- drop shadow
    New("UIStroke", {
        Color = Color3.new(0, 0, 0),
        Thickness = 4,
        Transparency = 0.75,
        Parent = card,
    })

    -- акцентная полоска слева
    local accentBar = New("Frame", {
        Position = UDim2.new(0, 0, 0, 8),
        Size = UDim2.new(0, 3, 1, -16),
        BackgroundColor3 = accent,
        BorderSizePixel = 0,
        ZIndex = 3,
        Parent = card,
    })
    Round(accentBar, 2)

    -- иконка
    local iconBg = New("Frame", {
        Position = UDim2.new(0, 12, 0, 12),
        Size = UDim2.new(0, 22, 0, 22),
        BackgroundColor3 = accent,
        BackgroundTransparency = 0.85,
        BorderSizePixel = 0,
        ZIndex = 3,
        Parent = card,
    })
    Round(iconBg, 11)

    local ico = Icon.new(iconName, iconBg, 13, accent)
    ico.Position = UDim2.new(0.5, -6.5, 0.5, -6.5)

    -- заголовок
    local titleLabel = New("TextLabel", {
        Text = titleText,
        Font = NL.Theme.FontBold,
        TextSize = 12,
        TextColor3 = NL.Theme.Text,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Position = UDim2.new(0, 42, 0, 10),
        Size = UDim2.new(1, -52, 0, 14),
        BackgroundTransparency = 1,
        ZIndex = 3,
        Parent = card,
    })

    -- тело
    local bodyLabel = nil
    if hasBody then
        bodyLabel = New("TextLabel", {
            Text = bodyText,
            Font = NL.Theme.Font,
            TextSize = 11,
            TextColor3 = NL.Theme.TextSub,
            TextWrapped = true,
            TextXAlignment = Enum.TextXAlignment.Left,
            Position = UDim2.new(0, 42, 0, 27),
            Size = UDim2.new(1, -52, 0, cardH - 34),
            BackgroundTransparency = 1,
            ZIndex = 3,
            Parent = card,
        })
    end

    -- прогресс-бар
    local progress = New("Frame", {
        Position = UDim2.new(0, 0, 1, -2),
        Size = UDim2.new(1, 0, 0, 2),
        BackgroundColor3 = accent,
        BackgroundTransparency = 0.4,
        BorderSizePixel = 0,
        ZIndex = 4,
        Parent = card,
    })

    -- счётчик группировки
    local countBadge = nil
    if entry.count and entry.count > 1 then
        countBadge = New("TextLabel", {
            Text = "×" .. entry.count,
            Font = NL.Theme.FontBold,
            TextSize = 10,
            TextColor3 = accent,
            TextXAlignment = Enum.TextXAlignment.Right,
            AnchorPoint = Vector2.new(1, 0),
            Position = UDim2.new(1, -10, 0, 10),
            Size = UDim2.new(0, 40, 0, 12),
            BackgroundTransparency = 1,
            ZIndex = 4,
            Parent = card,
        })
    end

    -- кнопка закрытия (крестик)
    local closeBtn = New("TextButton", {
        Text = "",
        BackgroundTransparency = 1,
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, -6, 0, 6),
        Size = UDim2.new(0, 18, 0, 18),
        Visible = false,
        ZIndex = 5,
        Parent = card,
    })
    local closeIc = Icon.new("Close", closeBtn, 10, NL.Theme.TextDim)
    closeIc.Position = UDim2.new(0.5, -5, 0.5, -5)

    -- состояние
    local alive = true
    local dismissTime = nil
    local progressTween = nil

    -- dismiss
    local function dismiss()
        if not alive then return end
        alive = false

        local dir = (HOLDER_POSITIONS[entry.position or NotifyAdvanced.currentPosition] or HOLDER_POSITIONS["top-right"]).Dir
        Tween(card, 0.25, {
            Position = UDim2.new(0, 320 * dir, 0, 0),
            BackgroundTransparency = 1,
        }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
        Tween(titleLabel, 0.25, { TextTransparency = 1 })
        if bodyLabel then Tween(bodyLabel, 0.25, { TextTransparency = 1 }) end

        task.delay(0.27, function()
            pcall(function() wrapper:Destroy() end)
        end)

        -- убираем из активных
        for i, e in ipairs(NotifyAdvanced.active) do
            if e.wrapper == wrapper then
                table.remove(NotifyAdvanced.active, i)
                break
            end
        end
    end

    entry.dismiss = dismiss

    -- обновить count (при группировке)
    entry.updateCount = function(newCount)
        if countBadge then
            countBadge.Text = "×" .. newCount
        else
            countBadge = New("TextLabel", {
                Text = "×" .. newCount,
                Font = NL.Theme.FontBold,
                TextSize = 10,
                TextColor3 = accent,
                TextXAlignment = Enum.TextXAlignment.Right,
                AnchorPoint = Vector2.new(1, 0),
                Position = UDim2.new(1, -10, 0, 10),
                Size = UDim2.new(0, 40, 0, 12),
                BackgroundTransparency = 1,
                ZIndex = 4,
                Parent = card,
            })
        end
        -- сбросить таймер
        if dismissTime then
            task.cancel(dismissTime)
        end
        if progressTween then progressTween:Cancel() end
        progress.Size = UDim2.new(1, 0, 0, 2)
        progressTween = Tween(progress, entry.duration or 4, {
            Size = UDim2.new(0, 0, 0, 2),
        }, Enum.EasingStyle.Linear)
        dismissTime = task.delay(entry.duration or 4, dismiss)
    end

    -- hover → показать крестик
    card.MouseEnter:Connect(function()
        if closeBtn then closeBtn.Visible = true end
    end)
    card.MouseLeave:Connect(function()
        if closeBtn and not closeBtn:IsDescendantOf(card) then return end
        if closeBtn then closeBtn.Visible = false end
    end)
    closeBtn.MouseButton1Click:Connect(function()
        dismiss()
    end)

    -- клик → dismiss
    card.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            -- только если не на крестике
            local pos = input.Position
            local absPos = closeBtn.AbsolutePosition
            local absSize = closeBtn.AbsoluteSize
            if pos.X < absPos.X or pos.X > absPos.X + absSize.X
            or pos.Y < absPos.Y or pos.Y > absPos.Y + absSize.Y then
                dismiss()
            end
        end
    end)

    -- анимация появления
    local dir = (HOLDER_POSITIONS[entry.position or NotifyAdvanced.currentPosition] or HOLDER_POSITIONS["top-right"]).Dir
    Tween(card, 0.3, {
        Position = UDim2.new(0, 0, 0, 0),
    }, Enum.EasingStyle.Quint)

    -- прогресс
    progressTween = Tween(progress, entry.duration or 4, {
        Size = UDim2.new(0, 0, 0, 2),
    }, Enum.EasingStyle.Linear)

    -- авто-dismiss
    dismissTime = task.delay(entry.duration or 4, dismiss)

    -- звук
    if NotifyAdvanced.soundEnabled then
        local soundVol = ({ info = 0.2, success = 0.25, error = 0.3, warning = 0.28, critical = 0.4 })[ntype] or 0.2
        PlaySound(NL.Settings.SoundNotify, soundVol)
    end

    entry.wrapper = wrapper
    entry.card = card
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §100 · NOTIFICATION · публичное API
--// ═══════════════════════════════════════════════════════════════════════

-- убрать самые старые активные
local function TrimActive()
    while #NotifyAdvanced.active >= NotifyAdvanced.maxActive do
        local oldest = NotifyAdvanced.active[1]
        if oldest and oldest.dismiss then
            oldest.dismiss()
        end
        table.remove(NotifyAdvanced.active, 1)
    end
end

-- основной метод показа
function NotifyAdvanced:Show(title, text, duration, ntype, position, opts)
    opts = opts or {}

    -- группировка
    local grouped = FindGroupCandidate(tostring(title), tostring(text))
    if grouped and grouped.updateCount then
        grouped.count = (grouped.count or 1) + 1
        grouped.updateCount(grouped.count)
        PushHistory(grouped)
        return grouped
    end

    -- обрезка
    TrimActive()

    -- сформировать entry
    local entry = {
        title = tostring(title or ""),
        text = tostring(text or ""),
        duration = math.max(1, tonumber(duration) or NL.Settings.NotificationDuration),
        type = ntype or "info",
        position = position or NotifyAdvanced.currentPosition,
        createdAt = tick(),
        count = 1,
        accent = opts.Accent,
    }

    -- сохранить в активных
    table.insert(NotifyAdvanced.active, entry)

    -- создать карточку
    CreateNotifyCard(entry)

    -- в историю
    PushHistory(entry)

    return entry
end

-- смена позиции держателя
function NotifyAdvanced:SetPosition(pos)
    if not HOLDER_POSITIONS[pos] then return end
    self.currentPosition = pos
end

-- переключить группировку
function NotifyAdvanced:SetGrouping(enabled)
    self.groupingEnabled = enabled
end

-- переключить звук
function NotifyAdvanced:SetSound(enabled)
    self.soundEnabled = enabled
end

-- очистить все активные
function NotifyAdvanced:ClearAll()
    for _, entry in ipairs(self.active) do
        if entry.dismiss then entry.dismiss() end
    end
    self.active = {}
end

-- обёртка NL:Notify
local BaseNotify6 = NL.Notify
NL.Notify = function(self, title, text, duration, ntype, position, opts)
    -- вызываем продвинутый вариант
    NotifyAdvanced:Show(title, text, duration, ntype, position, opts)
end

NL.NotifyAdvanced = NotifyAdvanced
NL.Notify = NL.Notify   -- сохраняем публичное имя

--// ═══════════════════════════════════════════════════════════════════════
--//  §101 · NOTIFICATION SOUND & ANIMATIONS (уже встроено)
--// ═══════════════════════════════════════════════════════════════════════

-- вспомогательные функции для разных типов уведомлений

function NL:NotifyInfo(title, text, duration)
    return NotifyAdvanced:Show(title, text, duration or 4, "info")
end

function NL:NotifySuccess(title, text, duration)
    return NotifyAdvanced:Show(title, text, duration or 3, "success")
end

function NL:NotifyWarning(title, text, duration)
    return NotifyAdvanced:Show(title, text, duration or 4, "warning")
end

function NL:NotifyError(title, text, duration)
    return NotifyAdvanced:Show(title, text, duration or 5, "error")
end

function NL:NotifyCritical(title, text, duration)
    return NotifyAdvanced:Show(title, text, duration or 6, "critical")
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §102 · TOAST · компактные сообщения
--// ═══════════════════════════════════════════════════════════════════════

local Toast = {
    holder = nil,
    queue = {},
    active = 0,
    maxActive = 3,
}

local function EnsureToastHolder()
    if Toast.holder and Toast.holder.Parent then
        return Toast.holder
    end
    local win = NL._window
    if not win then return nil end

    local holder = New("Frame", {
        Name = "Toasts",
        AnchorPoint = Vector2.new(0.5, 0),
        Position = UDim2.new(0.5, 0, 0, 80),
        Size = UDim2.new(0, 300, 0, 0),
        BackgroundTransparency = 1,
        ZIndex = 510,
        Parent = win._screen,
    })
    VLayout(holder, 6)
    local layout = holder:FindFirstChildOfClass("UIListLayout")
    if layout then
        layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    end

    Toast.holder = holder
    return holder
end

local function MakeToast(text, duration)
    local holder = EnsureToastHolder()
    if not holder then return end

    local wrapper = New("Frame", {
        BackgroundColor3 = NL.Theme.Popout,
        BorderSizePixel = 0,
        Size = UDim2.new(0, 40, 0, 30),
        AutomaticSize = Enum.AutomaticSize.X,
        LayoutOrder = -math.floor(tick() * 1000),
        Parent = holder,
    })
    Round(wrapper, 15)
    Stroke(wrapper, NL.Theme.StrokeLight)

    Padding(wrapper, 0, 16, 0, 16)

    local label = New("TextLabel", {
        Text = tostring(text or ""),
        Font = NL.Theme.Font,
        TextSize = 11,
        TextColor3 = NL.Theme.Text,
        BackgroundTransparency = 1,
        AutomaticSize = Enum.AutomaticSize.X,
        Size = UDim2.new(0, 0, 1, 0),
        Parent = wrapper,
    })

    local alive = true

    local function dismiss()
        if not alive then return end
        alive = false
        Tween(wrapper, 0.2, {
            BackgroundTransparency = 1,
        })
        Tween(label, 0.2, { TextTransparency = 1 })
        task.delay(0.22, function()
            pcall(function() wrapper:Destroy() end)
        end)
    end

    wrapper.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dismiss()
        end
    end)

    wrapper.BackgroundTransparency = 1
    label.TextTransparency = 1

    Tween(wrapper, 0.25, { BackgroundTransparency = 0 })
    Tween(label, 0.25, { TextTransparency = 0 })

    task.delay(duration or 2, dismiss)

    return wrapper
end

function NL:Toast(text, duration)
    return MakeToast(text, duration)
end

NL.Toast = Toast

--// ═══════════════════════════════════════════════════════════════════════
--//  §103 · CONTEXT MENU · BASE
--// ═══════════════════════════════════════════════════════════════════════

local ContextMenu = {
    current = nil,
}

-- состояние вложенности
local function CloseContextMenu()
    if ContextMenu.current and ContextMenu.current.close then
        pcall(ContextMenu.current.close)
    end
    ContextMenu.current = nil
end

-- показать меню
function NL:ShowContextMenu(items, screenPos, opts)
    opts = opts or {}
    CloseContextMenu()

    local win = NL._window
    if not win or type(items) ~= "table" or #items == 0 then return end

    -- закрыть другие попапы
    if NL._activeDropdown then
        pcall(NL._activeDropdown.Close)
        NL._activeDropdown = nil
    end

    local itemH = 28
    local longest = 0
    local iconWidth = 30

    for _, item in ipairs(items) do
        if item.Text and item.Text ~= "-" then
            longest = math.max(longest, #tostring(item.Text))
        end
    end

    local width = math.clamp(longest * 7 + iconWidth + 40, 160, 280)
    local height = #items * itemH + 8

    local menu = New("Frame", {
        Size = UDim2.new(0, width, 0, height),
        BackgroundColor3 = NL.Theme.Popout,
        BorderSizePixel = 0,
        ZIndex = 600,
        Parent = win._screen,
    })
    Round(menu, 8)
    Stroke(menu, NL.Theme.StrokeLight)

    -- тень
    New("UIStroke", {
        Color = Color3.new(0, 0, 0),
        Thickness = 5,
        Transparency = 0.7,
        Parent = menu,
    })

    local ctx = {}

    -- закрытие
    local outConn, escConn

    local function close()
        if outConn then outConn:Disconnect(); outConn = nil end
        if escConn then escConn:Disconnect(); escConn = nil end
        if menu.Parent then menu:Destroy() end
        if ContextMenu.current == ctx then ContextMenu.current = nil end
    end
    ctx.close = close

    -- построение строк
    local rowConnections = {}

    for i, item in ipairs(items) do
        local isDivider = (item.Text == nil or item.Text == "" or item.Text == "-")

        if isDivider then
            local div = New("Frame", {
                Position = UDim2.new(0, 10, 0, 4 + (i - 1) * itemH + 13),
                Size = UDim2.new(1, -20, 0, 1),
                BackgroundColor3 = NL.Theme.Divider,
                BorderSizePixel = 0,
                ZIndex = 601,
                Parent = menu,
            })
        else
            local row = New("TextButton", {
                Text = "",
                Position = UDim2.new(0, 4, 0, 4 + (i - 1) * itemH),
                Size = UDim2.new(1, -8, 0, itemH - 2),
                BackgroundColor3 = NL.Theme.Popout,
                AutoButtonColor = false,
                BorderSizePixel = 0,
                ZIndex = 601,
                Parent = menu,
            })
            Round(row, 6)

            -- иконка
            local textX = 12
            local ico
            if item.Icon then
                ico = Icon.new(item.Icon, row, 14, item.Color or NL.Theme.TextSub)
                ico.Position = UDim2.new(0, 10, 0.5, -7)
                ico.ZIndex = 602
                textX = 32
            end

            -- текст
            local textLabel = New("TextLabel", {
                Text = tostring(item.Text),
                Font = NL.Theme.Font,
                TextSize = 11,
                TextColor3 = item.Color or NL.Theme.Text,
                TextXAlignment = Enum.TextXAlignment.Left,
                TextTruncate = Enum.TextTruncate.AtEnd,
                AnchorPoint = Vector2.new(0, 0.5),
                Position = UDim2.new(0, textX, 0.5, 0),
                Size = UDim2.new(1, -textX - 40, 0, 12),
                BackgroundTransparency = 1,
                ZIndex = 602,
                Parent = row,
            })

            -- хоткей
            if item.Shortcut then
                local shortcutLabel = New("TextLabel", {
                    Text = tostring(item.Shortcut),
                    Font = NL.Theme.Font,
                    TextSize = 9,
                    TextColor3 = NL.Theme.TextDim,
                    TextXAlignment = Enum.TextXAlignment.Right,
                    AnchorPoint = Vector2.new(1, 0.5),
                    Position = UDim2.new(1, -12, 0.5, 0),
                    Size = UDim2.new(0, 60, 0, 12),
                    BackgroundTransparency = 1,
                    ZIndex = 602,
                    Parent = row,
                })
            end

            -- стрелка вложенного меню
            if item.Submenu then
                local arrowIc = Icon.new("ChevronRight", row, 10, NL.Theme.TextDim)
                arrowIc.AnchorPoint = Vector2.new(1, 0.5)
                arrowIc.Position = UDim2.new(1, -10, 0.5, -5)
                arrowIc.ZIndex = 602
            end

            -- ховер
            row.MouseEnter:Connect(function()
                Tween(row, 0.08, { BackgroundColor3 = NL.Theme.ElementHover })
                if ico then Icon.TweenTint(ico, item.Color or NL.Theme.Text, 0.08) end
                if textLabel then Tween(textLabel, 0.08, { TextColor3 = item.Color or NL.Theme.Text }) end
            end)
            row.MouseLeave:Connect(function()
                Tween(row, 0.08, { BackgroundColor3 = NL.Theme.Popout })
                if ico then Icon.TweenTint(ico, item.Color or NL.Theme.TextSub, 0.08) end
                if textLabel then Tween(textLabel, 0.08, { TextColor3 = item.Color or NL.Theme.Text }) end
            end)

            -- клик
            row.MouseButton1Click:Connect(function()
                PlaySound()
                if item.Submenu then
                    -- открыть вложенное меню
                    local subPos = Vector2.new(
                        menu.AbsolutePosition.X + menu.AbsoluteSize.X + 4,
                        menu.AbsolutePosition.Y + (4 + (i - 1) * itemH)
                    )
                    -- проверяем, влезает ли в экран
                    local vp = Cache.GetViewport()
                    if subPos.X + 160 > vp.X then
                        subPos = Vector2.new(
                            menu.AbsolutePosition.X - 165,
                            menu.AbsolutePosition.Y + (4 + (i - 1) * itemH)
                        )
                    end
                    close()
                    task.defer(function()
                        NL:ShowContextMenu(item.Submenu, subPos)
                    end)
                else
                    local cb = item.Callback
                    close()
                    if cb then SafeCall(cb) end
                end
            end)
        end
    end

    -- позиционирование
    local vp = Cache.GetViewport()
    local px = math.clamp(screenPos.X, 6, vp.X - width - 6)
    local py = math.clamp(screenPos.Y, 6, vp.Y - height - 6)
    menu.Position = UDim2.new(0, px, 0, py)

    -- закрытие по клику вне
    outConn = Connect(UserInputService.InputBegan, function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
        and input.UserInputType ~= Enum.UserInputType.MouseButton2 then return end
        local p = input.Position
        local lp, ls = menu.AbsolutePosition, menu.AbsoluteSize
        if p.X < lp.X or p.X > lp.X + ls.X or p.Y < lp.Y or p.Y > lp.Y + ls.Y then
            close()
        end
    end)

    -- закрытие по Esc
    escConn = Connect(UserInputService.InputBegan, function(input, processed)
        if processed then return end
        if input.KeyCode == Enum.KeyCode.Escape then
            close()
        end
    end)

    ContextMenu.current = ctx
    NL._activeContext = ctx

    return ctx
end

function NL:BindContextMenu(frame, itemsFn, opts)
    if not frame or type(itemsFn) ~= "function" then return end
    frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton2 then
            local items = itemsFn()
            if items then
                NL:ShowContextMenu(items, Vector2.new(input.Position.X, input.Position.Y), opts)
            end
        end
    end)
end

NL.ContextMenu = ContextMenu

--// ═══════════════════════════════════════════════════════════════════════
--//  §104 · CONTEXT MENU · HOTKEYS
--// ═══════════════════════════════════════════════════════════════════════

-- Пример использования: добавляем хоткей в context item
-- { Text = "Delete", Shortcut = "Del", Callback = ... }

-- хелпер: конвертер KeyCode в display name
local function KeyCodeToDisplay(kc)
    if typeof(kc) ~= "EnumItem" then return "?" end
    local name = kc.Name
    -- короткие имена
    local map = {
        LeftShift = "Shift",
        RightShift = "Shift",
        LeftControl = "Ctrl",
        RightControl = "Ctrl",
        LeftAlt = "Alt",
        RightAlt = "Alt",
        MouseButton1 = "LMB",
        MouseButton2 = "RMB",
    }
    return map[name] or name
end

NL.KeyCodeToDisplay = KeyCodeToDisplay

