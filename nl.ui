--// ═══════════════════════════════════════════════════════════════════════
--//  §106 · TOOLTIP · RICH TEXT
--// ═══════════════════════════════════════════════════════════════════════

local TooltipAdvanced = {
    frame = nil,
    label = nil,
    iconHolder = nil,
    titleLabel = nil,
    bodyLabel = nil,
    visible = false,
    lastShownText = nil,
    _token = 0,
    _mouseConn = nil,
}

-- построить тултип
local function EnsureTooltipAdvanced()
    if TooltipAdvanced.frame and TooltipAdvanced.frame.Parent then
        return TooltipAdvanced
    end
    local win = NL._window
    if not win then return nil end

    local f = New("Frame", {
        Name = "TooltipAdvanced",
        Size = UDim2.new(0, 220, 0, 40),
        BackgroundColor3 = NL.Theme.Popout,
        BorderSizePixel = 0,
        Visible = false,
        ZIndex = 700,
        Parent = win._screen,
    })
    Round(f, 8)
    Stroke(f, NL.Theme.StrokeLight)

    -- тень
    New("UIStroke", {
        Color = Color3.new(0, 0, 0),
        Thickness = 5,
        Transparency = 0.75,
        Parent = f,
    })

    -- контейнер
    local padding = Padding(f, 10, 12, 10, 12)

    -- иконка (опционально)
    local iconHolder = New("Frame", {
        Position = UDim2.new(0, 10, 0, 10),
        Size = UDim2.new(0, 18, 0, 18),
        BackgroundTransparency = 1,
        Visible = false,
        ZIndex = 701,
        Parent = f,
    })

    -- заголовок
    local titleLabel = New("TextLabel", {
        Text = "",
        Font = NL.Theme.FontBold,
        TextSize = 12,
        TextColor3 = NL.Theme.Text,
        TextXAlignment = Enum.TextXAlignment.Left,
        RichText = true,
        Position = UDim2.new(0, 12, 0, 8),
        Size = UDim2.new(1, -24, 0, 14),
        BackgroundTransparency = 1,
        Visible = false,
        ZIndex = 701,
        Parent = f,
    })

    -- тело
    local bodyLabel = New("TextLabel", {
        Text = "",
        Font = NL.Theme.Font,
        TextSize = 11,
        TextColor3 = NL.Theme.TextSub,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextWrapped = true,
        RichText = true,
        Position = UDim2.new(0, 12, 0, 8),
        Size = UDim2.new(1, -24, 1, -16),
        BackgroundTransparency = 1,
        ZIndex = 701,
        Parent = f,
    })

    TooltipAdvanced.frame = f
    TooltipAdvanced.label = bodyLabel
    TooltipAdvanced.titleLabel = titleLabel
    TooltipAdvanced.bodyLabel = bodyLabel
    TooltipAdvanced.iconHolder = iconHolder

    -- следование за мышью
    if TooltipAdvanced._mouseConn then
        TooltipAdvanced._mouseConn:Disconnect()
    end
    TooltipAdvanced._mouseConn = UserInputService.InputChanged:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseMovement then return end
        if not f.Visible then return end
        local vp = Cache.GetViewport()
        local x = math.clamp(input.Position.X + 16, 6, vp.X - f.AbsoluteSize.X - 6)
        local y = math.clamp(input.Position.Y + 18, 6, vp.Y - f.AbsoluteSize.Y - 6)
        f.Position = UDim2.new(0, x, 0, y)
    end)

    return TooltipAdvanced
end

-- показать тултип
local function ShowTooltipAdvanced(cfg)
    if not cfg then return end
    local t = EnsureTooltipAdvanced()
    if not t then return end

    local title = cfg.Title or nil
    local body  = cfg.Body or cfg.Text or ""
    local iconName = cfg.Icon or nil
    local color = cfg.Color or NL.Theme.Text

    -- иконка
    if iconName then
        -- очистить
        for _, c in ipairs(t.iconHolder:GetChildren()) do
            if c:IsA("GuiObject") then c:Destroy() end
        end
        local ic = Icon.new(iconName, t.iconHolder, 16, NL.Theme.Accent)
        ic.Position = UDim2.new(0, 1, 0, 1)
        t.iconHolder.Visible = true
    else
        t.iconHolder.Visible = false
    end

    -- заголовок
    if title then
        t.titleLabel.Text = "<b>" .. tostring(title) .. "</b>"
        t.titleLabel.TextColor3 = color
        t.titleLabel.Visible = true
        t.titleLabel.Position = UDim2.new(0, iconName and 34 or 12, 0, 8)
        t.titleLabel.Size = UDim2.new(1, iconName and -44 or -24, 0, 14)
    else
        t.titleLabel.Visible = false
    end

    -- тело
    t.bodyLabel.Text = tostring(body)
    t.bodyLabel.TextColor3 = NL.Theme.TextSub

    -- позиция тела
    if title then
        t.bodyLabel.Position = UDim2.new(0, iconName and 34 or 12, 0, 26)
        t.bodyLabel.Size = UDim2.new(1, iconName and -44 or -24, 1, -34)
    else
        t.bodyLabel.Position = UDim2.new(0, iconName and 34 or 12, 0, 8)
        t.bodyLabel.Size = UDim2.new(1, iconName and -44 or -24, 1, -16)
    end

    -- авто-размер
    local titleH = title and 20 or 0
    local bodyW = math.clamp(t.bodyLabel.TextBounds.X + 24 + (iconName and 22 or 0), 120, 320)
    local bodyH = math.clamp(t.bodyLabel.TextBounds.Y + 20 + titleH, 30, 200)
    t.frame.Size = UDim2.new(0, bodyW, 0, bodyH)

    -- показ
    if not t.frame.Visible then
        t.frame.Visible = true
        t.frame.BackgroundTransparency = 0.15
        Tween(t.frame, 0.15, { BackgroundTransparency = 0 })
    end
    t.visible = true
end

-- скрыть
local function HideTooltipAdvanced()
    local t = TooltipAdvanced
    if not t.frame or not t.visible then return end
    t.visible = false
    Tween(t.frame, 0.1, { BackgroundTransparency = 1 })
    task.delay(0.12, function()
        if t.frame and not t.visible then
            t.frame.Visible = false
        end
    end)
end

-- привязать
local function BindTooltipAdvanced(frame, cfg)
    if not frame or not cfg then return end
    local delay = cfg.Delay or 0.4

    frame.MouseEnter:Connect(function()
        TooltipAdvanced._token = TooltipAdvanced._token + 1
        local token = TooltipAdvanced._token
        task.delay(delay, function()
            if TooltipAdvanced._token == token then
                ShowTooltipAdvanced(cfg)
            end
        end)
    end)

    frame.MouseLeave:Connect(function()
        TooltipAdvanced._token = TooltipAdvanced._token + 1
        HideTooltipAdvanced()
    end)
end

NL._util.BindTooltipAdvanced = BindTooltipAdvanced
NL._util.ShowTooltipAdvanced = ShowTooltipAdvanced
NL._util.HideTooltipAdvanced = HideTooltipAdvanced
NL.TooltipAdvanced = TooltipAdvanced

--// ═══════════════════════════════════════════════════════════════════════
--//  §107 · TOOLTIP · MULTI-LAYER (реализовано в §106)
--// ═══════════════════════════════════════════════════════════════════════

-- используется cfg.Icon + cfg.Title + cfg.Body

--// ═══════════════════════════════════════════════════════════════════════
--//  §108 · TOOLTIP · DELAYED (используется по умолчанию)
--// ═══════════════════════════════════════════════════════════════════════

-- delay настраивается через cfg.Delay

--// ═══════════════════════════════════════════════════════════════════════
--//  §109 · EFFECTS · RIPPLE ADVANCED
--// ═══════════════════════════════════════════════════════════════════════

local EffectsAdv = {}

-- улучшенный ripple с настраиваемым цветом и позицией
function EffectsAdv.RippleAt(target, screenPos, color, maxSize)
    if not target then return end
    color = color or NL.Theme.Accent

    local size = target.AbsoluteSize
    local relX = screenPos.X - target.AbsolutePosition.X
    local relY = screenPos.Y - target.AbsolutePosition.Y

    local ripple = New("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0, relX, 0, relY),
        Size = UDim2.new(0, 0, 0, 0),
        BackgroundColor3 = color,
        BackgroundTransparency = 0.5,
        BorderSizePixel = 0,
        ZIndex = 100,
        Parent = target,
    })
    Circle(ripple)

    local finalSize = maxSize or (math.max(size.X, size.Y) * 1.6)

    Tween(ripple, 0.5, {
        Size = UDim2.new(0, finalSize, 0, finalSize),
        BackgroundTransparency = 1,
    }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

    task.delay(0.52, function()
        pcall(function() ripple:Destroy() end)
    end)
end

-- множественный ripple (каскад)
function EffectsAdv.RippleCascade(target, count, delayPer)
    count = count or 3
    delayPer = delayPer or 0.05
    for i = 1, count do
        task.delay((i - 1) * delayPer, function()
            EffectsAdv.RippleAt(target, Vector2.new(
                target.AbsolutePosition.X + target.AbsoluteSize.X * 0.5,
                target.AbsolutePosition.Y + target.AbsoluteSize.Y * 0.5
            ), NL.Theme.AccentBright)
        end)
    end
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §110 · EFFECTS · GLOW / BORDER LIGHT
--// ═══════════════════════════════════════════════════════════════════════

-- свечение обводки
function EffectsAdv.Glow(target, color, duration, thickness)
    if not target then return end
    color = color or NL.Theme.AccentGlow
    duration = duration or 0.4
    thickness = thickness or 2

    local stroke = target:FindFirstChildOfClass("UIStroke")
    if not stroke then return end

    local oldColor = stroke.Color
    local oldThickness = stroke.Thickness
    local oldTransparency = stroke.Transparency

    Tween(stroke, duration * 0.3, {
        Color = color,
        Thickness = oldThickness + thickness,
        Transparency = 0,
    })

    task.delay(duration * 0.3, function()
        Tween(stroke, duration * 0.7, {
            Color = oldColor,
            Thickness = oldThickness,
            Transparency = oldTransparency,
        })
    end)
end

-- постоянное свечение (пульсация)
function EffectsAdv.GlowLoop(target, color, interval)
    if not target then return end
    color = color or NL.Theme.AccentGlow
    interval = interval or 1.5

    local stroke = target:FindFirstChildOfClass("UIStroke")
    if not stroke then return end

    local oldColor = stroke.Color

    task.spawn(function()
        while target.Parent do
            Tween(stroke, interval * 0.5, {
                Color = color,
                Transparency = 0,
            }, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)

            task.wait(interval * 0.5)

            Tween(stroke, interval * 0.5, {
                Color = oldColor,
                Transparency = 0.2,
            }, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)

            task.wait(interval * 0.5)
        end
    end)
end

-- внешнее свечение (drop-shadow glow)
function EffectsAdv.OuterGlow(target, color)
    color = color or NL.Theme.Accent

    local glow = New("UIStroke", {
        Color = color,
        Thickness = 6,
        Transparency = 0.7,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        Parent = target,
    })

    return {
        Stop = function()
            if glow and glow.Parent then
                glow:Destroy()
            end
        end,
    }
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §111 · EFFECTS · SHAKE ADVANCED
--// ═══════════════════════════════════════════════════════════════════════

-- тряска с easing
function EffectsAdv.ShakeAdvanced(target, intensity, duration, easing)
    if not target then return end
    intensity = intensity or 5
    duration = duration or 0.3
    easing = easing or "quad"

    local oldPos = target.Position
    local startTime = tick()
    local conn

    conn = RunService.RenderStepped:Connect(function()
        local t = tick() - startTime
        if t >= duration then
            target.Position = oldPos
            if conn then conn:Disconnect() end
            return
        end

        local progress = t / duration
        local decay
        if easing == "quad" then
            decay = math.pow(1 - progress, 2)
        elseif easing == "cubic" then
            decay = math.pow(1 - progress, 3)
        elseif easing == "bounce" then
            decay = math.abs(math.cos(progress * math.pi * 3)) * (1 - progress)
        else
            decay = 1 - progress
        end

        local dx = (math.random() - 0.5) * 2 * intensity * decay
        local dy = (math.random() - 0.5) * 2 * intensity * decay
        target.Position = oldPos + UDim2.new(0, dx, 0, dy)
    end)

    return conn
end

-- поворот + тряска (rotate shake)
function EffectsAdv.RotateShake(target, angle, duration)
    if not target then return end
    angle = angle or 5
    duration = duration or 0.3

    local oldRot = target.Rotation
    local startTime = tick()
    local conn

    conn = RunService.RenderStepped:Connect(function()
        local t = tick() - startTime
        if t >= duration then
            target.Rotation = oldRot
            if conn then conn:Disconnect() end
            return
        end

        local decay = math.pow(1 - t / duration, 2)
        local da = (math.random() - 0.5) * 2 * angle * decay
        target.Rotation = oldRot + da
    end)

    return conn
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §112 · EFFECTS · MORPH
--// ═══════════════════════════════════════════════════════════════════════

-- морфинг размеров (плавное изменение)
function EffectsAdv.MorphSize(target, targetSize, duration, easing)
    if not target then return end
    duration = duration or 0.3
    easing = easing or Enum.EasingStyle.Quint

    local startSize = target.Size

    Tween(target, duration, {
        Size = targetSize,
    }, easing, Enum.EasingDirection.Out)
end

-- морфинг цвета
function EffectsAdv.MorphColor(target, targetColor, duration)
    if not target then return end
    duration = duration or 0.3

    Tween(target, duration, { BackgroundColor3 = targetColor })
end

-- морфинг нескольких свойств
function EffectsAdv.MorphMulti(target, props, duration, easing)
    if not target then return end
    duration = duration or 0.3

    Tween(target, duration, props, easing or Enum.EasingStyle.Quint)
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §113 · EFFECTS · CONFETTI / PARTICLES
--// ═══════════════════════════════════════════════════════════════════════

-- confetti — разлетающиеся частицы
function EffectsAdv.Confetti(target, count, colors)
    if not target then return end
    count = count or 20
    colors = colors or { NL.Theme.Accent, NL.Theme.Success, NL.Theme.Warning, NL.Theme.AccentBright }

    local size = target.AbsoluteSize

    for i = 1, count do
        local color = colors[math.random(1, #colors)]
        local particle = New("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.new(0.5, 0, 0.5, 0),
            Size = UDim2.new(0, 4, 0, 4),
            BackgroundColor3 = color,
            BorderSizePixel = 0,
            ZIndex = 200,
            Parent = target,
        })
        Round(particle, 2)

        local angle = math.random() * math.pi * 2
        local distance = math.random(20, 100)
        local dx = math.cos(angle) * distance
        local dy = math.sin(angle) * distance

        Tween(particle, 0.6 + math.random() * 0.4, {
            Position = UDim2.new(0.5, dx, 0.5, dy),
            Size = UDim2.new(0, 0, 0, 0),
            BackgroundTransparency = 1,
            Rotation = math.random(-180, 180),
        }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

        task.delay(1.1, function()
            pcall(function() particle:Destroy() end)
        end)
    end
end

-- sparkle — точечные вспышки
function EffectsAdv.Sparkle(target, duration)
    if not target then return end
    duration = duration or 0.5

    local size = target.AbsoluteSize
    local startTime = tick()

    task.spawn(function()
        while tick() - startTime < duration do
            local spark = New("Frame", {
                AnchorPoint = Vector2.new(0.5, 0.5),
                Position = UDim2.new(math.random(), 0, math.random(), 0),
                Size = UDim2.new(0, 3, 0, 3),
                BackgroundColor3 = NL.Theme.AccentGlow,
                BorderSizePixel = 0,
                ZIndex = 200,
                Parent = target,
            })
            Circle(spark)

            Tween(spark, 0.4, {
                Size = UDim2.new(0, 0, 0, 0),
                BackgroundTransparency = 1,
            })

            task.delay(0.45, function()
                pcall(function() spark:Destroy() end)
            end)

            task.wait(0.05)
        end
    end)
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §114 · UI POLISH · DROP SHADOW
--// ═══════════════════════════════════════════════════════════════════════

-- добавить тень к элементу
function EffectsAdv.AddShadow(target, blur, opacity)
    if not target then return end
    blur = blur or 4
    opacity = opacity or 0.75

    return New("UIStroke", {
        Color = Color3.new(0, 0, 0),
        Thickness = blur,
        Transparency = opacity,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        Parent = target,
    })
end

-- убрать все тени
function EffectsAdv.RemoveShadows(target)
    if not target then return end
    for _, s in ipairs(target:GetChildren()) do
        if s:IsA("UIStroke") and s.Color == Color3.new(0, 0, 0) then
            s:Destroy()
        end
    end
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §115 · UI POLISH · GRADIENT TEXT
--// ═══════════════════════════════════════════════════════════════════════

-- применить градиент к тексту
function EffectsAdv.GradientText(label, c1, c2, rotation)
    if not label then return end
    c1 = c1 or NL.Theme.Accent
    c2 = c2 or NL.Theme.AccentBright
    rotation = rotation or 90

    local old = label:FindFirstChildOfClass("UIGradient")
    if old then old:Destroy() end

    return New("UIGradient", {
        Color = ColorSequence.new(c1, c2),
        Rotation = rotation,
        Parent = label,
    })
end

-- rainbow-градиент (анимированный)
function EffectsAdv.RainbowText(label, speed)
    if not label then return end
    speed = speed or 0.5

    local old = label:FindFirstChildOfClass("UIGradient")
    if old then old:Destroy() end

    local grad = New("UIGradient", {
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0.0, Color3.fromRGB(255, 0, 0)),
            ColorSequenceKeypoint.new(0.17, Color3.fromRGB(255, 255, 0)),
            ColorSequenceKeypoint.new(0.33, Color3.fromRGB(0, 255, 0)),
            ColorSequenceKeypoint.new(0.5, Color3.fromRGB(0, 255, 255)),
            ColorSequenceKeypoint.new(0.67, Color3.fromRGB(0, 0, 255)),
            ColorSequenceKeypoint.new(0.83, Color3.fromRGB(255, 0, 255)),
            ColorSequenceKeypoint.new(1.0, Color3.fromRGB(255, 0, 0)),
        }),
        Parent = label,
    })

    task.spawn(function()
        local offset = 0
        while label.Parent do
            offset = (offset + 0.005) % 1
            grad.Offset = Vector2.new(offset, 0)
            task.wait()
        end
    end)

    return grad
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §116 · UI POLISH · SCROLL FADE
--// ═══════════════════════════════════════════════════════════════════════

-- добавить градиентные полосы по краям скролла
function EffectsAdv.AddScrollFade(scrollFrame, topColor, bottomColor)
    if not scrollFrame then return end
    topColor = topColor or NL.Theme.Content
    bottomColor = bottomColor or NL.Theme.Content

    -- верхний fade
    local topFade = New("Frame", {
        Size = UDim2.new(1, 0, 0, 12),
        Position = UDim2.new(0, 0, 0, 0),
        BackgroundColor3 = topColor,
        BorderSizePixel = 0,
        ZIndex = 10,
        Parent = scrollFrame,
    })

    local topGrad = New("UIGradient", {
        Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0),
            NumberSequenceKeypoint.new(1, 1),
        }),
        Rotation = 90,
        Parent = topFade,
    })

    -- нижний fade
    local bottomFade = New("Frame", {
        Size = UDim2.new(1, 0, 0, 12),
        Position = UDim2.new(0, 0, 1, -12),
        BackgroundColor3 = bottomColor,
        BorderSizePixel = 0,
        ZIndex = 10,
        Parent = scrollFrame,
    })

    local bottomGrad = New("UIGradient", {
        Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 1),
            NumberSequenceKeypoint.new(1, 0),
        }),
        Rotation = 90,
        Parent = bottomFade,
    })

    return {
        Top = topFade,
        Bottom = bottomFade,
        Destroy = function()
            pcall(function() topFade:Destroy() end)
            pcall(function() bottomFade:Destroy() end)
        end,
    }
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §117 · UI POLISH · FOCUS RINGS
--// ═══════════════════════════════════════════════════════════════════════

-- добавить ring фокуса (например для инпутов при фокусе)
function EffectsAdv.AddFocusRing(target, color)
    if not target then return end
    color = color or NL.Theme.Accent

    local ring = New("UIStroke", {
        Color = color,
        Thickness = 0,
        Transparency = 0.5,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        Parent = target,
    })

    return {
        Activate = function()
            Tween(ring, 0.2, { Thickness = 2, Transparency = 0 })
        end,
        Deactivate = function()
            Tween(ring, 0.2, { Thickness = 0, Transparency = 0.5 })
        end,
        Destroy = function()
            pcall(function() ring:Destroy() end)
        end,
    }
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §118 · UI POLISH · SKELETON LOADING
--// ═══════════════════════════════════════════════════════════════════════

-- skeleton placeholder
function EffectsAdv.Skeleton(parent, size, radius)
    if not parent then return end
    radius = radius or 4

    local skel = New("Frame", {
        BackgroundColor3 = NL.Theme.List,
        BorderSizePixel = 0,
        Size = size or UDim2.new(1, 0, 0, 16),
        Parent = parent,
    })
    Round(skel, radius)

    -- shimmer эффект
    local shimmer = New("Frame", {
        Size = UDim2.new(0.3, 0, 1, 0),
        BackgroundColor3 = NL.Theme.ElementHover,
        BackgroundTransparency = 0.3,
        BorderSizePixel = 0,
        ZIndex = 2,
        Parent = skel,
    })

    task.spawn(function()
        while skel.Parent do
            shimmer.Position = UDim2.new(-0.3, 0, 0, 0)
            Tween(shimmer, 1.2, {
                Position = UDim2.new(1, 0, 0, 0),
            }, Enum.EasingStyle.Linear)
            task.wait(1.2)
        end
    end)

    return skel
end

