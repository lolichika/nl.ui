-- алиасы
Icon.User    = Icon.Person
Icon.Rage    = Icon.Crosshair
Icon.Weapon  = Icon.Crosshair
Icon.Settings = Icon.Cog
Icon.Config  = Icon.List
Icon.Console = Icon.Code
Icon.Back    = Icon.ChevronLeft
Icon.Forward = Icon.ChevronRight

-- конструктор по имени
function Icon.new(name, parent, size, color)
    local fn = Icon[name]
    if not fn then
        if Settings.DebugMode then
            warn("[NL] Неизвестная иконка: " .. tostring(name))
        end
        fn = Icon.List
    end
    return fn(parent, size, color)
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §19 · РАСШИРЕННЫЕ ЭФФЕКТЫ
--// ═══════════════════════════════════════════════════════════════════════

local Effects = {}

-- Ripple-эффект при клике
function Effects.Ripple(target, color)
    if not Settings.EnableRipple or not target then return end
    color = color or Theme.Accent
    local sizeX = target.AbsoluteSize.X
    local sizeY = target.AbsoluteSize.Y
    local maxSize = math.max(sizeX, sizeY) * 1.6

    local ripple = New("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.5, 0, 0.5, 0),
        Size = UDim2.new(0, 0, 0, 0),
        BackgroundColor3 = color,
        BackgroundTransparency = 0.55,
        BorderSizePixel = 0,
        ZIndex = 100,
        Parent = target,
    })
    if not ripple then return end
    Circle(ripple)

    Tween(ripple, 0.45, {
        Size = UDim2.new(0, maxSize, 0, maxSize),
        BackgroundTransparency = 1,
    }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

    task.delay(0.47, function()
        pcall(function() ripple:Destroy() end)
    end)
end

-- Мягкое свечение обводки
function Effects.Glow(target, color, duration)
    if not Settings.EnableGlow or not target then return end
    color = color or Theme.AccentGlow
    duration = duration or 0.35

    local stroke = target:FindFirstChildOfClass("UIStroke")
    if not stroke then return end
    local oldColor = stroke.Color
    local oldThickness = stroke.Thickness

    Tween(stroke, duration * 0.4, { Color = color, Thickness = oldThickness + 0.5 })
    task.delay(duration * 0.4, function()
        Tween(stroke, duration * 0.6, { Color = oldColor, Thickness = oldThickness })
    end)
end

-- Тряска
function Effects.Shake(target, intensity, duration)
    if not target then return end
    intensity = intensity or 3
    duration = duration or 0.25

    local oldPos = target.Position
    local startTime = tick()
    local conn

    conn = RunService.RenderStepped:Connect(function()
        local t = tick() - startTime
        if t >= duration then
            target.Position = oldPos
            if conn then conn:Disconnect() end
            return
        end
        local decay = 1 - (t / duration)
        local dx = (math.random() - 0.5) * 2 * intensity * decay
        local dy = (math.random() - 0.5) * 2 * intensity * decay
        target.Position = oldPos + UDim2.new(0, dx, 0, dy)
    end)
end

-- Вспышка
function Effects.Flash(target, color, duration)
    if not target then return end
    color = color or Theme.Accent
    duration = duration or 0.35

    local oldColor = target.BackgroundColor3
    Tween(target, duration * 0.3, { BackgroundColor3 = color })
    task.delay(duration * 0.3, function()
        Tween(target, duration * 0.7, { BackgroundColor3 = oldColor })
    end)
end

-- Выделение
function Effects.Highlight(target, color, duration)
    if not target then return end
    color = color or Theme.Accent
    duration = duration or 0.6

    local highlight = New("Frame", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundColor3 = color,
        BackgroundTransparency = 0.75,
        BorderSizePixel = 0,
        ZIndex = 15,
        Parent = target,
    })
    if not highlight then return end
    Round(highlight, 6)

    Tween(highlight, duration, { BackgroundTransparency = 1 })
    task.delay(duration + 0.05, function()
        pcall(function() highlight:Destroy() end)
    end)
end

-- Пульсация
function Effects.Pulse(target, color, interval)
    if not target then return end
    color = color or Theme.Accent
    interval = interval or 1.2

    local stroke = target:FindFirstChildOfClass("UIStroke")
    if not stroke then return end
    local oldColor = stroke.Color

    task.spawn(function()
        while target.Parent do
            Tween(stroke, interval / 2, { Color = color }, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
            task.wait(interval / 2)
            Tween(stroke, interval / 2, { Color = oldColor }, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
            task.wait(interval / 2)
        end
    end)
end

-- Плавное появление
function Effects.FadeIn(inst, time)
    if not inst then return end
    time = time or Theme.AnimNormal
    inst.BackgroundTransparency = 1
    Tween(inst, time, { BackgroundTransparency = 0 })
end

-- Скользящее появление
function Effects.SlideIn(inst, time, offset)
    if not inst then return end
    time = time or Theme.AnimSlow
    offset = offset or UDim2.new(0, 30, 0, 0)
    local finalPos = inst.Position
    inst.Position = finalPos + offset
    Tween(inst, time, { Position = finalPos }, Enum.EasingStyle.Quint)
end

-- Отскок (bounce)
function Effects.Bounce(inst, amount)
    if not inst then return end
    amount = amount or 6
    local finalPos = inst.Position
    Anim.Sequence({
        { Duration = 0.1, Ease = Anim.Ease.QuadOut, OnUpdate = function(t)
            inst.Position = finalPos - UDim2.new(0, 0, 0, amount * t)
        end},
        { Duration = 0.15, Ease = Anim.Ease.BounceOut, OnUpdate = function(t)
            inst.Position = finalPos - UDim2.new(0, 0, 0, amount * (1 - t))
        end},
    })
end

-- Оборачивание элемента в hover-эффект
function Effects.BindHover(target, normalColor, hoverColor, strokeObj)
    if not target then return end
    normalColor = normalColor or Theme.Element
    hoverColor = hoverColor or Theme.ElementHover

    target.MouseEnter:Connect(function()
        Tween(target, Theme.AnimFast, { BackgroundColor3 = hoverColor })
        if strokeObj then Tween(strokeObj, Theme.AnimFast, { Color = Theme.StrokeLight }) end
    end)
    target.MouseLeave:Connect(function()
        Tween(target, Theme.AnimFast, { BackgroundColor3 = normalColor })
        if strokeObj then Tween(strokeObj, Theme.AnimFast, { Color = Theme.Stroke }) end
    end)
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §20 · КЭШ И ОПТИМИЗАЦИЯ
--// ═══════════════════════════════════════════════════════════════════════

local Cache = {}

-- viewport size с кэшированием
function Cache.GetViewport()
    local cam = Workspace.CurrentCamera
    if cam and cam.ViewportSize then
        NL._cache.viewport = cam.ViewportSize
        return cam.ViewportSize
    end
    return NL._cache.viewport or Vector2.new(1920, 1080)
end

-- центр экрана
function Cache.GetCenter()
    local vp = Cache.GetViewport()
    return Vector2.new(vp.X / 2, vp.Y / 2)
end

-- проверка внутри границ экрана
function Cache.IsInsideScreen(pos, size, padding)
    padding = padding or 0
    local vp = Cache.GetViewport()
    return pos.X >= -padding
        and pos.Y >= -padding
        and pos.X + size.X <= vp.X + padding
        and pos.Y + size.Y <= vp.Y + padding
end

