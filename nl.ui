--// ═══════════════════════════════════════════════════════════════════════

-- Вспомогательная функция для безопасного получения сервиса
-- (в некоторых средах отдельные сервисы могут быть недоступны)
local function SafeGetService(name)
    local ok, service = pcall(function()
        return game:GetService(name)
    end)
    if ok and service then return service end
    warn("[NL] Не удалось получить сервис: " .. name)
    return nil
end

-- Базовые сервисы
local Players               = SafeGetService("Players")
local RunService            = SafeGetService("RunService")
local UserInputService      = SafeGetService("UserInputService")
local TweenService          = SafeGetService("TweenService")
local HttpService           = SafeGetService("HttpService")
local SoundService          = SafeGetService("SoundService")
local Debris                = SafeGetService("Debris")
local Stats                 = SafeGetService("Stats")
local Lighting              = SafeGetService("Lighting")
local Workspace             = SafeGetService("Workspace")
local CoreGui               = SafeGetService("CoreGui")
local GuiService            = SafeGetService("GuiService")
local ContextActionService  = SafeGetService("ContextActionService")
local ReplicatedStorage     = SafeGetService("ReplicatedStorage")
local StarterGui            = SafeGetService("StarterGui")
local TextChatService       = SafeGetService("TextChatService") -- может быть nil

-- Проверка критичных сервисов
if not Players then
    error("[NL] Критическая ошибка: сервис Players недоступен")
end
if not RunService then
    error("[NL] Критическая ошибка: сервис RunService недоступен")
end
if not TweenService then
    error("[NL] Критическая ошибка: сервис TweenService недоступен")
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §03 · ПОЛУЧЕНИЕ LOCALPLAYER
--// ═══════════════════════════════════════════════════════════════════════

local LocalPlayer = nil
do
    -- пробуем получить сразу
    local ok, player = pcall(function() return Players.LocalPlayer end)
    if ok and player then
        LocalPlayer = player
    else
        -- ждём до 5 секунд
        local startTime = tick()
        repeat
            task.wait(0.1)
            local ok2, p2 = pcall(function() return Players.LocalPlayer end)
            if ok2 and p2 then LocalPlayer = p2; break end
        until tick() - startTime > 5
    end
end

if not LocalPlayer then
    warn("[NL] LocalPlayer не найден. Некоторые функции могут не работать")
end

