    if NL.Settings.ShowTime then
        local clockIc = Icon.new("Clock", RightBox, 12, Theme.TextSub)
        clockIc.AnchorPoint = Vector2.new(0, 0.5)
        clockIc.Position = UDim2.new(0, 0, 0.5, 0)
        clockIc.ZIndex = 4

        local TimeLabel = New("TextLabel", {
            Text = os.date("%H:%M"),
            Font = Theme.Font,
            TextSize = 11,
            TextColor3 = Theme.Text,
            TextXAlignment = Enum.TextXAlignment.Left,
            AnchorPoint = Vector2.new(0, 0.5),
            Position = UDim2.new(0, 18, 0.5, 0),
            Size = UDim2.new(0, 40, 0, 12),
            BackgroundTransparency = 1,
            ZIndex = 4,
            Parent = RightBox,
        })
        refs.TimeLabel = TimeLabel

        -- обновление времени раз в минуту
        task.spawn(function()
            while TimeLabel.Parent do
                task.wait(1)
                TimeLabel.Text = os.date("%H:%M")
            end
        end)
    end

    if NL.Settings.ShowIcons then
        local iconDefs = {
            { name = "Mic",     tooltip = "Голосовой чат" },
            { name = "Shield",  tooltip = "Защита" },
            { name = "Slots",   tooltip = "Слоты" },
            { name = "Cog",     tooltip = "Настройки" },
        }
        local offsetX = 74
        for _, def in ipairs(iconDefs) do
            local btn = New("TextButton", {
                Text = "",
                BackgroundTransparency = 1,
                AutoButtonColor = false,
                AnchorPoint = Vector2.new(0, 0.5),
                Position = UDim2.new(0, offsetX, 0.5, 0),
                Size = UDim2.new(0, 20, 0, 20),
                ZIndex = 4,
                Parent = RightBox,
            })
            local ic = Icon.new(def.name, btn, 13, Theme.TextDim)
            ic.Position = UDim2.new(0.5, -6.5, 0.5, -6.5)

            btn.MouseEnter:Connect(function()
                Icon.TweenTint(ic, Theme.Text, Theme.AnimFast)
            end)
            btn.MouseLeave:Connect(function()
                Icon.TweenTint(ic, Theme.TextDim, Theme.AnimFast)
            end)
            offsetX = offsetX + 22
        end
    end

    return refs
end

