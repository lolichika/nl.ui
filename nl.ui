-- функция показа readme в консоли
function NL:PrintReadme()
    for line in NL.Readme:gmatch("[^\n]+") do
        if NL.DevTools and NL.DevTools.Console then
            NL.DevTools.Console:Info(line)
        else
            print(line)
        end
    end
end

