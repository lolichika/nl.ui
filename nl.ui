        Callback = function(v)
            AimHold._smooth = v
        end,
    })

    group:AddSlider("Min HP", {
        Flag = "aimhold_minhp",
        Min = 0,
        Max = 100,
        Default = 20,
        Suffix = " hp",
        Tooltip = "Не холдить таргетов с HP ниже",
        Callback = function(v)
            AimHold._minHP = v
        end,
    })

    group:AddToggle("WallCheck", {
        Flag = "aimhold_wallcheck",
        Default = true,
        Tooltip = "Не холдить за стеной",
        Callback = function(on)
            AimHold._wallCheck = on
        end,
    })

    group:AddToggle("Draw FOV", {
        Flag = "aimhold_drawfov",
        Default = false,
        Tooltip = "Круг FOV на экране",
        Callback = function(on)
            AimHold._drawFov = on
            if on and AimHold._enabled then
                EnableFOVCircle(FovRadiusFromDegrees(AimHold._fov))
            else
                DisableFOVCircle()
            end
        end,
    })

    group:AddToggle("Debug", {
        Flag = "aimhold_debug",
        Default = false,
        Tooltip = "Логи в консоль",
        Callback = function(on)
            AimHold._debug = on
        end,
    })
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §83 · TRIGGER BOT · ЯДРО
--// ═══════════════════════════════════════════════════════════════════════

local TriggerBot = {
    _enabled = false,
    _delay   = 50,
    _minHP   = 20,
    _wallCheck = true,
    _debug   = false,

    _loop    = nil,
    _lastShot = 0,
}

-- виртуальный клик ЛКМ
local function FireVirtualClick()
    pcall(function()
        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 1)
    end)
    pcall(function()
        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 1)
    end)
end

-- проверка цели
local function IsValidHumanoid(inst)
    if not inst then return false end
    local hum = inst:FindFirstChildOfClass("Humanoid")
    if not hum then
        local model = inst:FindFirstAncestorOfClass("Model")
        if model then
            hum = model:FindFirstChildOfClass("Humanoid")
        end
    end
    if not hum then return false end
    if hum.Health <= 0 then return false end
    if hum.Health < TriggerBot._minHP then return false end
    if LocalPlayer.Character and hum:IsDescendantOf(LocalPlayer.Character) then
        return false
    end
    return true
end

local function TriggerBotLoop()
    if not TriggerBot._enabled then return end

    local cam = Workspace.CurrentCamera
    if not cam then return end

    local origin = cam.CFrame.Position
    local dir = cam.CFrame.LookVector * 3000

    local filter = { }
    if LocalPlayer.Character then
        table.insert(filter, LocalPlayer.Character)
    end
    table.insert(filter, cam)

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Blacklist
    params.FilterDescendantsInstances = filter
    params.IgnoreWater = true

    local result = Workspace:Raycast(origin, dir, params)
    if not result then return end
    if not IsValidHumanoid(result.Instance) then return end

    local now = tick() * 1000
    if now - TriggerBot._lastShot < TriggerBot._delay then return end

    TriggerBot._lastShot = now
    if TriggerBot._debug then
        print("[TriggerBot] Fire on " .. result.Instance.Name)
    end
    FireVirtualClick()
end

local function StopTriggerBot()
    TriggerBot._enabled = false
    if TriggerBot._loop then
        TriggerBot._loop:Disconnect()
        TriggerBot._loop = nil
    end
end

local function StartTriggerBot()
    StopTriggerBot()
    TriggerBot._enabled = true
    TriggerBot._loop = RunService.RenderStepped:Connect(TriggerBotLoop)
end

FeatureRegistry:Register("TriggerBot", StopTriggerBot)
NL.TriggerBot = {
    Start = StartTriggerBot,
    Stop  = StopTriggerBot,
    State = TriggerBot,
}

