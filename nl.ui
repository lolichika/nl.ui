-- построение расширенной структуры темы (с оттенками)
local function MakeThemeFull(key, name, accent)
    return {
        Key          = key,
        Name         = name,
        Accent       = accent,
        AccentBright = Color.Lerp(accent, Color3.new(1, 1, 1), 0.28),
        AccentDim    = Color.Lerp(accent, Color3.new(0, 0, 0), 0.30),
        AccentDeep   = Color.Lerp(accent, Color3.new(0, 0, 0), 0.55),
        AccentGlow   = Color.Lerp(accent, Color3.new(1, 1, 1), 0.45),
        AccentPressed= Color.Lerp(accent, Color3.new(0, 0, 0), 0.15),
    }
end

local FullThemes = {}
for _, t in ipairs(Themes) do
    table.insert(FullThemes, MakeThemeFull(t.Key, t.Name, t.Accent))
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §69 · THEMES · ПРИМЕНЕНИЕ С ЖИВОЙ ПЕРЕКРАСКОЙ
--// ═══════════════════════════════════════════════════════════════════════

-- применить оттенки акцента в NL.Theme
local function ApplyThemeShades(theme)
    local T = NL.Theme
    T.Accent        = theme.Accent
    T.AccentBright  = theme.AccentBright
    T.AccentDim     = theme.AccentDim
    T.AccentDeep    = theme.AccentDeep
    T.AccentGlow    = theme.AccentGlow
    T.AccentPressed = theme.AccentPressed
end

-- пройтись по всем объектам ScreenGui и перекрасить совпадения
local function RecolorScreenGui(oldAccentSet, newAccent)
    local win = NL._window
    if not win or not win._screen then return end

    -- простая функция — сравнить с любым из старых оттенков
    local function matchesOld(c)
        for _, oldColor in ipairs(oldAccentSet) do
            if c.R == oldColor.R and c.G == oldColor.G and c.B == oldColor.B then
                return true
            end
        end
        return false
    end

    for _, d in ipairs(win._screen:GetDescendants()) do
        if d:IsA("GuiObject") then
            local bc = d.BackgroundColor3
            if bc and matchesOld(bc) then
                d.BackgroundColor3 = newAccent
            end

            if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then
                local tc = d.TextColor3
                if tc and matchesOld(tc) then
                    d.TextColor3 = newAccent
                end
            end

            if d:IsA("ScrollingFrame") then
                local sc = d.ScrollBarImageColor3
                if sc and matchesOld(sc) then
                    d.ScrollBarImageColor3 = newAccent
                end
            end

            local stroke = d:FindFirstChildOfClass("UIStroke")
            if stroke then
                local sc = stroke.Color
                if sc and matchesOld(sc) then
                    stroke.Color = newAccent
                end
            end

            -- UIGradient
            local grad = d:FindFirstChildOfClass("UIGradient")
            if grad then
                local kps = grad.Color.Keypoints
                local changed = false
                local newKps = {}

                for _, kp in ipairs(kps) do
                    local c = kp.Value
                    if matchesOld(c) then
                        table.insert(newKps, ColorSequenceKeypoint.new(kp.Time, newAccent))
                        changed = true
                    else
                        table.insert(newKps, kp)
                    end
                end

                if changed then
                    grad.Color = ColorSequence.new(newKps)
                end
            end
        end
    end
end

-- публичное API применения темы
local function ApplyThemeByKey(key, doSave)
    local theme = nil
    for _, t in ipairs(FullThemes) do
        if t.Key == key then
            theme = t
            break
        end
    end
    if not theme then return end

    local T = NL.Theme
    -- запоминаем старые оттенки
    local oldAccents = { T.Accent, T.AccentBright, T.AccentDim, T.AccentDeep }

    -- применяем новые
    ApplyThemeShades(theme)

    -- перекраска
    RecolorScreenGui(oldAccents, theme.Accent)

    -- сохранение
    if doSave then
        local intf = NL.Settings
        intf.Theme = key
        local settings = LoadSettingsFile()
        settings.Theme = key
        SaveSettingsFile(settings)
    end

    NL._currentTheme = theme
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §70 · THEMES · КАСТОМНЫЙ АКЦЕНТ
--// ═══════════════════════════════════════════════════════════════════════

local function ApplyCustomTheme(color, doSave)
    if typeof(color) ~= "Color3" then return end

    local fake = MakeThemeFull("custom", "Кастом", color)
    local T = NL.Theme
    local oldAccents = { T.Accent, T.AccentBright, T.AccentDim, T.AccentDeep }

    ApplyThemeShades(fake)
    RecolorScreenGui(oldAccents, color)

    if doSave then
        local settings = LoadSettingsFile()
        settings.Theme = "custom"
        settings.CustomAccent = {
            R = math.floor(color.R * 255 + 0.5),
            G = math.floor(color.G * 255 + 0.5),
            B = math.floor(color.B * 255 + 0.5),
        }
        SaveSettingsFile(settings)
    end

    NL._currentTheme = fake
end

-- применить сохранённый кастомный
local function ApplySavedCustom(settings)
    if not settings or not settings.CustomAccent then return end
    local c = settings.CustomAccent
    local col = Color3.fromRGB(c.R or 130, c.G or 100, c.B or 255)
    ApplyCustomTheme(col, false)
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §71 · THEMES · ГОТОВАЯ ВКЛАДКА ИНТЕРФЕЙСА
--// ═══════════════════════════════════════════════════════════════════════

function NL:BuildFullInterfaceTab(tab)
    if not tab then return end

    -- ОБЩИЕ
    local general = tab:CreateGroup("Общие")

    general:AddToggle("Звуки интерфейса", {
        Flag = "ui_sounds",
        Default = NL.Settings.Sounds,
        Tooltip = "Звуки кликов и уведомлений",
        Callback = function(on)
            NL.Settings.Sounds = on
        end,
    })

    general:AddToggle("Анимации", {
        Flag = "ui_animations",
        Default = NL.Settings.Animations,
        Tooltip = "Плавные переходы и появления элементов",
        Callback = function(on)
            NL.Settings.Animations = on
        end,
    })

    general:AddSlider("Громкость звуков", {
        Flag = "ui_volume",
        Min = 0,
        Max = 1,
        Default = 0.2,
        Decimals = 2,
        Callback = function(v)
            NL.Settings.SoundVolume = v
        end,
    })

    -- ТЕМА
    local theme = tab:CreateGroup("Тема")

    local themeNames = {}
    for _, t in ipairs(FullThemes) do
        table.insert(themeNames, t.Name)
    end

    theme:AddDropdown("Пресет", themeNames, {
        Flag = "ui_theme_preset",
        Default = "Neverlose",
        Tooltip = "Готовая цветовая схема",
        Callback = function(name)
            for _, t in ipairs(FullThemes) do
                if t.Name == name then
                    ApplyThemeByKey(t.Key, true)
                    NL:Notify("Тема", "Установлена: " .. name, 2, "success")
                    return
                end
            end
        end,
    })

    theme:AddColorPicker("Кастомный акцент", {
        Flag = "ui_theme_custom",
        Default = NL.Theme.Accent,
        Tooltip = "Свой цвет для всего UI",
        Callback = function(color)
            ApplyCustomTheme(color, true)
        end,
    })

    theme:AddButtonRow({
        {
            Text = "Сбросить",
            Callback = function()
                ApplyThemeByKey("default", true)
                NL:Notify("Тема", "Сброшено", 2, "info")
            end,
        },
        {
            Text = "Случайная",
            Callback = function()
                local t = FullThemes[math.random(1, #FullThemes)]
                ApplyThemeByKey(t.Key, true)
                NL:Notify("Тема", "Установлена: " .. t.Name, 2, "success")
            end,
        },
    })

    -- ВОТЕРМАРКА
    local wm = tab:CreateGroup("Вотермарка")

    wm:AddToggle("Показывать", {
        Flag = "ui_wm_show",
        Default = NL.Settings.Watermark,
        Callback = function(on)
            NL.Settings.Watermark = on
            if NL._watermark and NL._watermark.frame then
                NL._watermark.frame.Visible = on
            end
        end,
    })

    wm:AddTextInput("Название чита", {
        Flag = "ui_wm_name",
        Default = NL.Settings.WMCheatName,
        Live = true,
        Callback = function(v)
            NL.Settings.WMCheatName = v
            local wmRef = NL._watermark
            if wmRef and wmRef._nameLabel then
                wmRef._nameLabel.Text = v
            end
        end,
    })

    wm:AddTextInput("Тег (BETA)", {
        Flag = "ui_wm_tag",
        Default = NL.Settings.WMCheatTag,
        Live = true,
        Callback = function(v)
            NL.Settings.WMCheatTag = v
            local wmRef = NL._watermark
            if wmRef and wmRef._tagLabel then
                wmRef._tagLabel.Text = v
            end
        end,
    })

    wm:AddTextInput("Логотип (1 символ)", {
        Flag = "ui_wm_logo",
        Default = NL.Settings.WMCheatLogo,
        Live = true,
        Callback = function(v)
            if #v > 0 then
                NL.Settings.WMCheatLogo = string.sub(v, 1, 1)
            end
        end,
    })

    wm:AddDropdown("Позиция", {
        "Слева сверху",
        "Справа сверху",
        "По центру сверху",
        "Снизу по центру",
    }, {
        Flag = "ui_wm_pos",
        Default = "Слева сверху",
        Callback = function(v)
            local map = {
                ["Слева сверху"] = "top-left",
                ["Справа сверху"] = "top-right",
                ["По центру сверху"] = "top-center",
                ["Снизу по центру"] = "bottom-center",
            }
            NL.Settings.WMPosition = map[v] or "top-left"
            if NL._wmApplyPosition then NL._wmApplyPosition() end
        end,
    })

    wm:AddToggle("FPS", {
        Flag = "ui_wm_fps",
        Default = true,
        Callback = function(on) NL.Settings.WMShowFPS = on end,
    })

    wm:AddToggle("Ping", {
        Flag = "ui_wm_ping",
        Default = true,
        Callback = function(on) NL.Settings.WMShowPing = on end,
    })

    wm:AddSlider("Прозрачность", {
        Flag = "ui_wm_bg",
        Min = 0,
        Max = 0.9,
        Default = 0.15,
        Decimals = 2,
        Callback = function(v)
            NL.Settings.WMBackground = v
            if NL._watermark and NL._watermark.frame then
                NL._watermark.frame.BackgroundTransparency = v
            end
        end,
    })

    -- ИНФОРМАЦИЯ
    local info = tab:CreateGroup("Информация")

    info:AddInfo(
        "Neverlose UI v" .. NL.Version .. " · build " .. NL.Build,
        NL.Theme.Accent,
        "Dot"
    )
    info:AddLabel("Элементов: " .. tostring(#NL.Elements))
    info:AddLabel("Файловая система: " .. (Config.HAS_FILES and "да" or "нет"))

    info:AddDivider()

    info:AddButton("Выгрузить интерфейс", {
        Tooltip = "Закрыть меню",
        Callback = function() NL:Destroy() end,
    })
end

