function NL:BuildDemo()
    -- окно
    local Window = self:CreateWindow({
        Title  = self.Settings.WMCheatName or "neverlose",
        Width  = 800,
        Height = 540,
    })

    -- вотермарка
    self:CreateWatermark()

    -- демо-вкладки
    BuildDemoRageTab(Window)
    BuildDemoLegitTab(Window)
    BuildDemoVisualsTab(Window)

    -- стандартные builder-вкладки
    local combatTab = Window:CreateTab("Combat", { Columns = 2, Icon = "Bolt" })
    self:BuildFullCombatTab(combatTab)

    local remTab = Window:CreateTab("Removals", { Columns = 2, Icon = "Trash" })
    self:BuildFullRemovalsTab(remTab)

    BuildDemoMiscTab(Window)

    local cfgTab = Window:CreateTab("Config", { Icon = "List" })
    self:BuildFullConfigTab(cfgTab)

    local ifaceTab = Window:CreateTab("Interface", { Columns = 1, Icon = "Cog" })
    self:BuildFullInterfaceTabAdvanced(ifaceTab)

    local infoTab = Window:CreateTab("Info", { Icon = "Person" })
    self:BuildInfoTab(infoTab)

    -- финальное уведомление
    NL:Notify(
        self.Settings.WMCheatName or "neverlose",
        string.format("Demo · %d элементов · RightShift — меню", #self.Elements),
        6, "success"
    )

    -- авто-загрузка раскладки
    AutoLoadLoop:Run()

    -- авто-сохранение
    if self.Settings.AutoSave then
        AutoSaveLoop:Start()
    end

    return Window
end

