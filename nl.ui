--// ═══════════════════════════════════════════════════════════════════════
--//  §161 · COMMAND PALETTE · ЯДРО
--// ═══════════════════════════════════════════════════════════════════════

local Palette = {
    commands = {},
    filtered = {},
    query = "",
    selected = 1,
    visible = false,
    frame = nil,
    lastQuery = "",
}

-- регистрация
function Palette:Register(cmd)
    if not cmd or not cmd.Name then return end
    table.insert(self.commands, {
        Name = cmd.Name,
        Description = cmd.Description or "",
        Category = cmd.Category or "General",
        Icon = cmd.Icon or "Dot",
        Keywords = cmd.Keywords or {},
        Callback = cmd.Callback,
        Color = cmd.Color,
    })
end

-- простой fuzzy-матч
local function fuzzyMatch(text, query)
    text = string.lower(text or "")
    query = string.lower(query or "")
    if query == "" then return true end

    -- прямой поиск
    if string.find(text, query, 1, true) then return true end

    -- fuzzy: все символы query по порядку
    local ti = 1
    for qi = 1, #query do
        local qc = query:sub(qi, qi)
        local found = false
        while ti <= #text do
            if text:sub(ti, ti) == qc then
                found = true
                ti = ti + 1
                break
            end
            ti = ti + 1
        end
        if not found then return false end
    end
    return true
end

-- фильтрация с сортировкой по релевантности
function Palette:Filter(query)
    query = tostring(query or "")
    self.query = query
    self.filtered = {}

    for _, c in ipairs(self.commands) do
        local nameMatch = fuzzyMatch(c.Name, query)
        local descMatch = fuzzyMatch(c.Description, query)
        local kwMatch = false

        for _, kw in ipairs(c.Keywords) do
            if fuzzyMatch(tostring(kw), query) then
                kwMatch = true
                break
            end
        end

        if nameMatch or descMatch or kwMatch then
            local score = 0
            if nameMatch then score = score + 100 end
            if descMatch then score = score + 30 end
            if kwMatch then score = score + 50 end
            if string.lower(c.Name):sub(1, #query) == string.lower(query) then
                score = score + 200
            end

            table.insert(self.filtered, {
                cmd = c,
                score = score,
            })
        end
    end

    table.sort(self.filtered, function(a, b) return a.score > b.score end)

    -- сохраняем только команды
    local sorted = {}
    for _, e in ipairs(self.filtered) do
        table.insert(sorted, e.cmd)
    end
    self.filtered = sorted

    self.selected = 1
end

function Palette:Execute(index)
    local cmd = self.filtered[index or self.selected]
    if not cmd or not cmd.Callback then return end
    SafeCall(cmd.Callback)
    self:Close()
end

NL.Palette = Palette

--// ═══════════════════════════════════════════════════════════════════════
--//  §162 · COMMAND PALETTE · UI
--// ═══════════════════════════════════════════════════════════════════════

local function BuildPaletteUI()
    local win = NL._window
    if not win or Palette.frame then return end

    -- back overlay
    local backdrop = New("Frame", {
        Name = "PaletteBackdrop",
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundColor3 = Color3.new(0, 0, 0),
        BackgroundTransparency = 0.5,
        BorderSizePixel = 0,
        Visible = false,
        ZIndex = 799,
        Parent = win._screen,
    })

    -- сама палитра
    local frame = New("Frame", {
        Name = "CommandPalette",
        AnchorPoint = Vector2.new(0.5, 0),
        Position = UDim2.new(0.5, 0, 0, -400),
        Size = UDim2.new(0, 540, 0, 420),
        BackgroundColor3 = NL.Theme.Popout,
        BorderSizePixel = 0,
        Visible = false,
        ZIndex = 800,
        Parent = win._screen,
    })
    Round(frame, 12)
    Stroke(frame, NL.Theme.StrokeLight)
    New("UIStroke", {
        Color = Color3.new(0, 0, 0),
        Thickness = 8,
        Transparency = 0.65,
        Parent = frame,
    })

    -- верхняя полоса с акцентом
    local accentBar = New("Frame", {
        Size = UDim2.new(1, 0, 0, 3),
        BackgroundColor3 = NL.Theme.Accent,
        BorderSizePixel = 0,
        ZIndex = 801,
        Parent = frame,
    })
    Round(accentBar, 2)
    Gradient(accentBar, NL.Theme.Accent, NL.Theme.AccentBright, 0)

    -- строка ввода
    local input = New("TextBox", {
        Text = "",
        PlaceholderText = "Поиск команд...",
        Font = NL.Theme.Font,
        TextSize = 14,
        TextColor3 = NL.Theme.Text,
        PlaceholderColor3 = NL.Theme.TextPlaceholder,
        TextXAlignment = Enum.TextXAlignment.Left,
        ClearTextOnFocus = false,
        BackgroundColor3 = NL.Theme.List,
        Position = UDim2.new(0, 14, 0, 14),
        Size = UDim2.new(1, -28, 0, 44),
        ZIndex = 802,
        Parent = frame,
    })
    Round(input, 8)
    local inputStroke = Stroke(input, NL.Theme.Stroke)
    Padding(input, 0, 40, 0, 14)

    local searchIcon = Icon.new("Search", input, 16, NL.Theme.TextDim)
    searchIcon.Position = UDim2.new(1, -30, 0.5, -8)
    searchIcon.ZIndex = 803

    -- счётчик
    local counter = New("TextLabel", {
        Text = "0",
        Font = NL.Theme.FontBold,
        TextSize = 10,
        TextColor3 = NL.Theme.Accent,
        TextXAlignment = Enum.TextXAlignment.Right,
        Position = UDim2.new(0, 14, 0, 64),
        Size = UDim2.new(1, -28, 0, 12),
        BackgroundTransparency = 1,
        ZIndex = 802,
        Parent = frame,
    })

    -- список
    local listScroll = New("ScrollingFrame", {
        Position = UDim2.new(0, 10, 0, 82),
        Size = UDim2.new(1, -20, 1, -90),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = NL.Theme.Accent,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        ZIndex = 802,
        Parent = frame,
    })
    VLayout(listScroll, 3)

    -- нижняя полоса с подсказками
    local footer = New("Frame", {
        AnchorPoint = Vector2.new(0, 1),
        Position = UDim2.new(0, 0, 1, 0),
        Size = UDim2.new(1, 0, 0, 26),
        BackgroundColor3 = NL.Theme.Header,
        BorderSizePixel = 0,
        ZIndex = 802,
        Parent = frame,
    })
    Round(footer, 12)
    -- маска сверху
    New("Frame", {
        Size = UDim2.new(1, 0, 0, 8),
        BackgroundColor3 = NL.Theme.Header,
        BorderSizePixel = 0,
        ZIndex = 803,
        Parent = footer,
    })

    local hints = {
        { key = "↑↓", text = "Навигация" },
        { key = "Enter", text = "Выполнить" },
        { key = "Esc", text = "Закрыть" },
    }
    local hintX = 14
    for _, hint in ipairs(hints) do
        local chip = New("Frame", {
            Position = UDim2.new(0, hintX, 0.5, -8),
            Size = UDim2.new(0, #hint.key * 7 + 12, 0, 16),
            BackgroundColor3 = NL.Theme.Element,
            BorderSizePixel = 0,
            ZIndex = 803,
            Parent = footer,
        })
        Round(chip, 4)
        Stroke(chip, NL.Theme.Stroke)

        New("TextLabel", {
            Text = hint.key,
            Font = NL.Theme.FontBold,
            TextSize = 9,
            TextColor3 = NL.Theme.Accent,
            Size = UDim2.new(1, 0, 1, 0),
            BackgroundTransparency = 1,
            ZIndex = 804,
            Parent = chip,
        })

        New("TextLabel", {
            Text = hint.text,
            Font = NL.Theme.Font,
            TextSize = 9,
            TextColor3 = NL.Theme.TextDim,
            TextXAlignment = Enum.TextXAlignment.Left,
            Position = UDim2.new(0, #hint.key * 7 + 18, 0.5, -6),
            Size = UDim2.new(0, 80, 0, 12),
            BackgroundTransparency = 1,
            ZIndex = 804,
            Parent = footer,
        })

        hintX = hintX + #hint.key * 7 + 12 + 6 + 70
    end

    Palette.frame = frame
    Palette.backdrop = backdrop
    Palette.input = input
    Palette.listScroll = listScroll
    Palette.counter = counter

    -- обновление списка
    local function refresh()
        for _, c in ipairs(listScroll:GetChildren()) do
            if c:IsA("GuiObject") then c:Destroy() end
        end

        Palette:Filter(input.Text)
        local results = Palette.filtered

        counter.Text = #results .. " найдено"

        if #results == 0 then
            New("TextLabel", {
                Text = "Ничего не найдено",
                Font = NL.Theme.Font,
                TextSize = 12,
                TextColor3 = NL.Theme.TextDim,
                Size = UDim2.new(1, 0, 0, 60),
                TextYAlignment = Enum.TextYAlignment.Center,
                BackgroundTransparency = 1,
                ZIndex = 803,
                Parent = listScroll,
            })
            return
        end

        local visibleCount = math.min(#results, 15)
        local itemH = 44

        for i = 1, visibleCount do
            local cmd = results[i]
            local isSel = (i == Palette.selected)

            local row = New("TextButton", {
                Text = "",
                BackgroundColor3 = isSel and NL.Theme.ElementHover or NL.Theme.List,
                AutoButtonColor = false,
                BorderSizePixel = 0,
                Size = UDim2.new(1, -4, 0, itemH),
                LayoutOrder = i,
                ZIndex = 803,
                Parent = listScroll,
            })
            Round(row, 7)

            -- акцентная полоска для выбранного
            if isSel then
                local bar = New("Frame", {
                    AnchorPoint = Vector2.new(0, 0.5),
                    Position = UDim2.new(0, 0, 0.5, 0),
                    Size = UDim2.new(0, 3, 0, itemH - 12),
                    BackgroundColor3 = NL.Theme.Accent,
                    BorderSizePixel = 0,
                    ZIndex = 805,
                    Parent = row,
                })
                Round(bar, 2)
            end

            -- иконка в квадратном контейнере
            local iconBox = New("Frame", {
                AnchorPoint = Vector2.new(0, 0.5),
                Position = UDim2.new(0, 12, 0.5, 0),
                Size = UDim2.new(0, 28, 0, 28),
                BackgroundColor3 = isSel and NL.Theme.Accent or NL.Theme.Element,
                BackgroundTransparency = isSel and 0.85 or 1,
                BorderSizePixel = 0,
                ZIndex = 804,
                Parent = row,
            })
            Round(iconBox, 6)
            if isSel then Stroke(iconBox, NL.Theme.Accent, 1, 0.6) end

            local ico = Icon.new(cmd.Icon, iconBox, 15, isSel and NL.Theme.Accent or NL.Theme.TextSub)
            ico.Position = UDim2.new(0.5, -7.5, 0.5, -7.5)
            ico.ZIndex = 805

            -- название
            New("TextLabel", {
                Text = cmd.Name,
                Font = NL.Theme.FontBold,
                TextSize = 12,
                TextColor3 = NL.Theme.Text,
                TextXAlignment = Enum.TextXAlignment.Left,
                Position = UDim2.new(0, 52, 0, 7),
                Size = UDim2.new(0.55, 0, 0, 14),
                BackgroundTransparency = 1,
                ZIndex = 804,
                Parent = row,
            })

            -- описание
            New("TextLabel", {
                Text = cmd.Description,
                Font = NL.Theme.Font,
                TextSize = 10,
                TextColor3 = NL.Theme.TextDim,
                TextXAlignment = Enum.TextXAlignment.Left,
                TextTruncate = Enum.TextTruncate.AtEnd,
                Position = UDim2.new(0, 52, 0, 23),
                Size = UDim2.new(0.6, 0, 0, 12),
                BackgroundTransparency = 1,
                ZIndex = 804,
                Parent = row,
            })

            -- категория
            local catBg = New("Frame", {
                AnchorPoint = Vector2.new(1, 0.5),
                Position = UDim2.new(1, -10, 0.5, 0),
                Size = UDim2.new(0, 70, 0, 18),
                BackgroundColor3 = NL.Theme.Element,
                BorderSizePixel = 0,
                ZIndex = 804,
                Parent = row,
            })
            Round(catBg, 4)

            New("TextLabel", {
                Text = cmd.Category,
                Font = NL.Theme.FontBold,
                TextSize = 9,
                TextColor3 = NL.Theme.Accent,
                Size = UDim2.new(1, 0, 1, 0),
                BackgroundTransparency = 1,
                ZIndex = 805,
                Parent = catBg,
            })

            -- клик
            row.MouseButton1Click:Connect(function()
                PlaySound()
                Palette:Execute(i)
            end)

            row.MouseEnter:Connect(function()
                Palette.selected = i
                refresh()
            end)

            -- hover-эффект
            if not isSel then
                row.MouseEnter:Connect(function()
                    Tween(row, 0.08, { BackgroundColor3 = NL.Theme.ElementHover })
                end)
                row.MouseLeave:Connect(function()
                    Tween(row, 0.08, { BackgroundColor3 = NL.Theme.List })
                end)
            end
        end

        listScroll.CanvasSize = UDim2.new(0, 0, 0, visibleCount * (itemH + 3) + 4)
    end

    input:GetPropertyChangedSignal("Text"):Connect(function()
        Palette.selected = 1
        refresh()
    end)

    input.Focused:Connect(function()
        Tween(input, 0.12, { BackgroundColor3 = NL.Theme.ElementHover })
        Tween(inputStroke, 0.12, { Color = NL.Theme.Accent })
    end)

    input.FocusLost:Connect(function()
        Tween(input, 0.12, { BackgroundColor3 = NL.Theme.List })
        Tween(inputStroke, 0.12, { Color = NL.Theme.Stroke })
    end)

    Palette._refresh = refresh

    -- клавиатура
    Connect(UserInputService.InputBegan, function(input, processed)
        if processed then return end
        if not Palette.visible then return end

        if input.KeyCode == Enum.KeyCode.Down then
            Palette.selected = math.min(Palette.selected + 1, #Palette.filtered)
            refresh()
        elseif input.KeyCode == Enum.KeyCode.Up then
            Palette.selected = math.max(Palette.selected - 1, 1)
            refresh()
        elseif input.KeyCode == Enum.KeyCode.Return then
            Palette:Execute(Palette.selected)
        elseif input.KeyCode == Enum.KeyCode.Escape then
            Palette:Close()
        end
    end)

    refresh()
end

function Palette:Open()
    BuildPaletteUI()
    if not self.frame then return end
    self.visible = true
    self.frame.Visible = true
    self.backdrop.Visible = true
    self.input.Text = ""

    -- анимация появления
    self.frame.Position = UDim2.new(0.5, 0, 0, -400)
    self.backdrop.BackgroundTransparency = 1
    Tween(self.frame, 0.25, {
        Position = UDim2.new(0.5, 0, 0, 80),
    }, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
    Tween(self.backdrop, 0.2, { BackgroundTransparency = 0.5 })

    self:Filter("")
    if self._refresh then self._refresh() end
    pcall(function() self.input:CaptureFocus() end)
end

function Palette:Close()
    if not self.frame then return end
    self.visible = false
    pcall(function() self.input:ReleaseFocus() end)

    Tween(self.frame, 0.2, {
        Position = UDim2.new(0.5, 0, 0, -400),
    }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
    Tween(self.backdrop, 0.2, { BackgroundTransparency = 1 })

    task.delay(0.22, function()
        if not self.visible then
            self.frame.Visible = false
            self.backdrop.Visible = false
        end
    end)
end

function Palette:Toggle()
    if self.visible then self:Close() else self:Open() end
end

-- хоткей Ctrl+P
Connect(UserInputService.InputBegan, function(input, processed)
    if processed then return end
    if input.KeyCode == Enum.KeyCode.P then
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl)
        or UserInputService:IsKeyDown(Enum.KeyCode.RightControl) then
            Palette:Toggle()
        end
    end
end)

