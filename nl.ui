-- проверка загрузки предыдущих частей
if not NL or not NL._widgets or not NL.GroupMethods then
    error("[NL] Часть 3 не загружена")
end

-- Roblox сервисы (для использования внутри этой части)
local Players          = game:GetService("Players")
local RunService       = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local TweenService     = game:GetService("TweenService")
local HttpService      = game:GetService("HttpService")
local SoundService     = game:GetService("SoundService")
local Debris           = game:GetService("Debris")
local Stats            = game:GetService("Stats")
local Lighting         = game:GetService("Lighting")
local Workspace        = game:GetService("Workspace")
local CoreGui          = game:GetService("CoreGui")
local LocalPlayer      = Players.LocalPlayer
-- ссылки
local New = NL._util.New
local Round = NL._util.Round
local Circle = NL._util.Circle
local Stroke = NL._util.Stroke
local Gradient = NL._util.Gradient
local Padding = NL._util.Padding
local HLayout = NL._util.HLayout
local VLayout = NL._util.VLayout
local Tween = NL._util.Tween
local Connect = NL._util.Connect
local SafeCall = NL._util.SafeCall
local PlaySound = NL._util.PlaySound

local Num = NL.Num
local Color = NL.Color
local Str = NL.Str
local Icon = NL.Icon
local Effects = NL.Effects
local Cache = NL._util.Cache
local Theme = NL.Theme
local Settings = NL.Settings

--// ═══════════════════════════════════════════════════════════════════════
--//  §57 · CONFIG · ИНИЦИАЛИЗАЦИЯ + ДЕТЕКТ FS
--// ═══════════════════════════════════════════════════════════════════════

local Config = {
    -- состояние
    HAS_FILES      = false,
    memoryStore    = {},        -- fallback без файловой системы
    folder         = NL.Settings.ConfigFolder,
    selected       = nil,        -- выбранное имя конфига
    entries        = {},          -- кэш списка конфигов
    autoToggle     = nil,        -- ссылка на тумблер автозагрузки
    rebuildFn      = nil,        -- функция перестройки UI
    _pendingRename = nil,        -- конфиг в процессе переименования
}

-- детект возможностей executor'а
do
    local hasWrite = (type(writefile) == "function")
    local hasRead  = (type(readfile) == "function")
    local hasList  = (type(listfiles) == "function")
    local hasIsFile = (type(isfile) == "function")

    Config.HAS_FILES = hasWrite and hasRead and hasList and hasIsFile
end

-- вспомогательная функция создания папки
local function EnsureFolder()
    if not Config.HAS_FILES then return end
    pcall(function()
        if type(isfolder) == "function" then
            if not isfolder(Config.folder) then
                if type(makefolder) == "function" then
                    makefolder(Config.folder)
                end
            end
        end
    end)
end

-- построение пути к файлу конфига
local function GetConfigPath(name)
    return Config.folder .. "/" .. name .. ".json"
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §58 · CONFIG · ОПЕРАЦИИ С ФАЙЛАМИ
--// ═══════════════════════════════════════════════════════════════════════

-- список имён конфигов
local function ListConfigs()
    local names = {}

    if Config.HAS_FILES then
        EnsureFolder()
        local ok, files = pcall(function() return listfiles(Config.folder) end)
        if ok and type(files) == "table" then
            for _, f in ipairs(files) do
                local base = tostring(f):match("([^/\\]+)%.json$")
                -- исключаем служебные файлы (_settings)
                if base and base:sub(1, 1) ~= "_" then
                    table.insert(names, base)
                end
            end
        end
    else
        for name in pairs(Config.memoryStore) do
            if name:sub(1, 1) ~= "_" then
                table.insert(names, name)
            end
        end
    end

    table.sort(names)
    return names
end

-- чтение содержимого конфига
local function ReadConfig(name)
    if not name or name == "" then return nil end

    if Config.HAS_FILES then
        local content = nil
        pcall(function()
            local path = GetConfigPath(name)
            if isfile(path) then
                content = readfile(path)
            end
        end)
        return content
    end

    return Config.memoryStore[name]
end

-- запись конфига
local function WriteConfig(name, content)
    if not name or name == "" then return false end

    if Config.HAS_FILES then
        EnsureFolder()
        local ok = pcall(function()
            writefile(GetConfigPath(name), content)
        end)
        return ok
    end

    Config.memoryStore[name] = content
    return true
end

-- удаление конфига
local function DeleteConfigFile(name)
    if not name or name == "" then return end

    if Config.HAS_FILES then
        pcall(function()
            local path = GetConfigPath(name)
            if isfile(path) then
                delfile(path)
            end
        end)
    else
        Config.memoryStore[name] = nil
    end
end

-- переименование
local function RenameConfigFile(oldName, newName)
    if not oldName or not newName then return false end
    if oldName == newName then return false end

    local content = ReadConfig(oldName)
    if not content then return false end

    WriteConfig(newName, content)
    DeleteConfigFile(oldName)
    return true
end

-- проверка существования
local function ConfigExists(name)
    if not name or name == "" then return false end
    if Config.HAS_FILES then
        local ok, exists = pcall(function()
            return isfile(GetConfigPath(name))
        end)
        return ok and exists
    end
    return Config.memoryStore[name] ~= nil
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §59 · CONFIG · СЕРИАЛИЗАЦИЯ
--// ═══════════════════════════════════════════════════════════════════════

-- encode в JSON
local function EncodeConfig(data)
    if not data then return nil end
    local ok, json = pcall(function()
        return HttpService:JSONEncode(data)
    end)
    if ok then return json end
    return nil
end

-- decode из JSON
local function DecodeConfig(json)
    if not json or json == "" then return nil end
    local ok, data = pcall(function()
        return HttpService:JSONDecode(json)
    end)
    if ok and type(data) == "table" then return data end
    return nil
end

-- конвертация KeyCode из имени
local function KeyFromName(name)
    if not name or name == "none" then return nil end
    for _, item in ipairs(Enum.KeyCode:GetEnumItems()) do
        if item.Name == name then
            return item
        end
    end
    return nil
end

-- поиск элемента по флагу
local function FindByFlag(flag)
    for _, el in ipairs(NL.Elements) do
        if el.Flag == flag then
            return el
        end
    end
    return nil
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §60 · CONFIG · BUILD/APPLY ДАННЫХ
--// ═══════════════════════════════════════════════════════════════════════

-- собрать все значения в таблицу
local function BuildConfigData()
    local data = {
        _meta = {
            version  = NL.Version,
            build    = NL.Build,
            saved    = os.date("%Y-%m-%d %H:%M:%S"),
            elements = #NL.Elements,
        },
    }

    for _, el in ipairs(NL.Elements) do
        if el.Flag and el._type and el.Flag:sub(1, 4) ~= "cfg_" then
            local t = el._type

            if t == "Toggle" or t == "Checkbox" then
                data[el.Flag] = (el.Get() == true)

            elseif t == "Slider" or t == "TextInput" or t == "NumberInput" then
                data[el.Flag] = el.Get()

            elseif t == "Dropdown" then
                data[el.Flag] = el.Get()

            elseif t == "Keybind" then
                local key = el.Get()
                data[el.Flag] = {
                    Key  = key and key.Name or "none",
                    Mode = el.GetMode and el.GetMode() or "toggle",
                }

            elseif t == "ColorPicker" then
                local c = el.Get()
                data[el.Flag] = {
                    Hex   = Color.ToHex(c),
                    Alpha = el.GetAlpha and el.GetAlpha() or 1,
                }
            end
        end
    end

    return data
end

-- применить данные из таблицы
local function ApplyConfigData(data)
    if type(data) ~= "table" then return 0 end
    local applied = 0

    for flag, value in pairs(data) do
        if flag ~= "_meta" then
            local el = FindByFlag(flag)
            if el and el.Set then
                local ok = pcall(function()
                    if el._type == "Keybind" and type(value) == "table" then
                        el.Set({
                            Key = KeyFromName(value.Key),
                            Mode = value.Mode,
                        })
                    elseif el._type == "ColorPicker" and type(value) == "table" then
                        el.Set(Color.FromHex(value.Hex or "FFFFFF"))
                        if value.Alpha ~= nil and el.SetAlpha then
                            el.SetAlpha(value.Alpha)
                        end
                    else
                        el.Set(value)
                    end
                end)
                if ok then
                    applied = applied + 1
                end
            end
        end
    end

    return applied
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §61 · CONFIG · SETTINGS FILE (автозагрузка и общие настройки)
--// ═══════════════════════════════════════════════════════════════════════

local function LoadSettingsFile()
    local content = nil

    if Config.HAS_FILES then
        pcall(function()
            local path = Config.folder .. "/_settings.json"
            if isfile(path) then
                content = readfile(path)
            end
        end)
    else
        content = Config.memoryStore["_settings"]
    end

    if content then
        local data = DecodeConfig(content)
        if data then return data end
    end

    return {}
end

local function SaveSettingsFile(data)
    local json = EncodeConfig(data)
    if not json then return end

    if Config.HAS_FILES then
        EnsureFolder()
        pcall(function()
            writefile(Config.folder .. "/_settings.json", json)
        end)
    else
        Config.memoryStore["_settings"] = json
    end
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §62 · CONFIG · UI СПИСОК
--// ═══════════════════════════════════════════════════════════════════════

local function MakeConfigList(group, opts)
    opts = opts or {}
    local listH = opts.Height or 240

    -- контейнер
    local frame = New("Frame", {
        BackgroundColor3 = Theme.Element,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, listH),
    })
    Round(frame, Theme.RadiusElement)

    local el = {
        _frame = frame,
        _height = listH,
        _type = "ConfigList",
        Name = "Configurations",
    }

    -- скролл
    local scroll = New("ScrollingFrame", {
        Position = UDim2.new(0, 4, 0, 4),
        Size = UDim2.new(1, -8, 1, -8),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = Theme.Accent,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        ZIndex = 2,
        Parent = frame,
    })
    VLayout(scroll, 3)

    -- таблица строк [name] = rowData
    local rows = {}

    -- обновить выделение
    local function updateSelection()
        for name, r in pairs(rows) do
            r.setSel(name == Config.selected)
        end
    end

    -- режим переименования
    local function startRename(row, name)
        if Config._pendingRename then return end
        Config._pendingRename = name

        local input = New("TextBox", {
            Text = name,
            Font = Theme.Font,
            TextSize = 11,
            TextColor3 = Theme.Text,
            TextXAlignment = Enum.TextXAlignment.Left,
            ClearTextOnFocus = false,
            BackgroundColor3 = Theme.List,
            Size = UDim2.new(1, 0, 1, 0),
            ZIndex = 6,
            Parent = row,
        })
        Round(input, Theme.RadiusElement - 2)
        Padding(input, 0, 8, 0, 14)

        pcall(function() input:CaptureFocus() end)

        input.FocusLost:Connect(function(enter)
            local newName = Str.Trim(input.Text)
            input:Destroy()
            Config._pendingRename = nil

            if enter and newName ~= "" and newName ~= name then
                if not ConfigExists(newName) then
                    if RenameConfigFile(name, newName) then
                        if Config.selected == name then
                            Config.selected = newName
                        end
                        NL:Notify("Конфиги", "Переименован: «" .. newName .. "»", 3, "success")
                        if Config.rebuildFn then Config.rebuildFn() end
                    end
                else
                    NL:Notify("Конфиги", "Имя «" .. newName .. "» уже занято", 3, "warning")
                end
            end
        end)
    end

    -- перестройка списка
    local function rebuild()
        -- очищаем
        for _, c in ipairs(scroll:GetChildren()) do
            if c:IsA("GuiObject") then
                c:Destroy()
            end
        end
        rows = {}

        local configs = ListConfigs()
        Config.entries = configs

        -- пусто
        if #configs == 0 then
            New("TextLabel", {
                Text = Config.HAS_FILES and "Нет сохранённых конфигов" or "Нет конфигов (память)",
                Font = Theme.Font,
                TextSize = 11,
                TextColor3 = Theme.TextDim,
                TextWrapped = true,
                AnchorPoint = Vector2.new(0.5, 0.5),
                Position = UDim2.new(0.5, 0, 0, 20),
                Size = UDim2.new(1, -16, 0, 14),
                TextXAlignment = Enum.TextXAlignment.Center,
                BackgroundTransparency = 1,
                ZIndex = 3,
                Parent = scroll,
            })
        end

        -- строки
        for i, name in ipairs(configs) do
            local isSel = (name == Config.selected)

            local row = New("TextButton", {
                Text = "",
                BackgroundColor3 = isSel and Theme.ElementHover or Theme.List,
                AutoButtonColor = false,
                BorderSizePixel = 0,
                Size = UDim2.new(1, 0, 0, 28),
                LayoutOrder = i,
                ZIndex = 3,
                Parent = scroll,
            })
            Round(row, Theme.RadiusElement - 2)

            -- акцентная полоска слева
            local bar = New("Frame", {
                AnchorPoint = Vector2.new(0, 0.5),
                Position = UDim2.new(0, 3, 0.5, 0),
                Size = UDim2.new(0, 3, 0, 16),
                BackgroundColor3 = Theme.Accent,
                BackgroundTransparency = isSel and 0 or 1,
                BorderSizePixel = 0,
                ZIndex = 4,
                Parent = row,
            })
            Round(bar, 2)

            -- название
            local label = New("TextLabel", {
                Text = name,
                Font = Theme.Font,
                TextSize = 11,
                TextColor3 = isSel and Theme.Text or Theme.TextSub,
                TextXAlignment = Enum.TextXAlignment.Left,
                TextTruncate = Enum.TextTruncate.AtEnd,
                AnchorPoint = Vector2.new(0, 0.5),
                Position = UDim2.new(0, 14, 0.5, 0),
                Size = UDim2.new(1, -22, 0, 12),
                BackgroundTransparency = 1,
                ZIndex = 4,
                Parent = row,
            })

            -- функция выделения
            local function setSel(selected)
                Tween(row, Theme.AnimFast, {
                    BackgroundColor3 = selected and Theme.ElementHover or Theme.List,
                })
                Tween(bar, Theme.AnimFast, {
                    BackgroundTransparency = selected and 0 or 1,
                })
                Tween(label, Theme.AnimFast, {
                    TextColor3 = selected and Theme.Text or Theme.TextSub,
                })
            end
            rows[name] = { setSel = setSel }

            -- клик: двойной = загрузка
            local lastClick = 0
            row.MouseButton1Click:Connect(function()
                local now = os.clock()
                if now - lastClick < 0.4 then
                    lastClick = 0
                    NL.Config.Load(name)
                else
                    lastClick = now
                end
                Config.selected = name
                updateSelection()
            end)

            -- ПКМ-меню
            NL:BindContextMenu(row, function()
                return {
                    { Text = "Загрузить", Icon = "Download",
                      Callback = function() NL.Config.Load(name) end },
                    { Text = "Перезаписать", Icon = "Save",
                      Callback = function() NL.Config.Save(name) end },
                    { Text = "Переименовать", Icon = "List",
                      Callback = function() startRename(row, name) end },
                    { Text = "Экспорт в буфер", Icon = "Upload",
                      Callback = function() NL.Config.Export(name) end },
                    { Text = "-" },
                    { Text = "Удалить", Icon = "Trash", Color = Theme.Error,
                      Callback = function() NL.Config.Delete(name) end },
                }
            end)

            -- hover
            row.MouseEnter:Connect(function()
                if Config.selected ~= name then
                    Tween(row, Theme.AnimFast, { BackgroundColor3 = Theme.ElementHover })
                end
            end)
            row.MouseLeave:Connect(function()
                if Config.selected ~= name then
                    Tween(row, Theme.AnimFast, { BackgroundColor3 = Theme.List })
                end
            end)
        end

        scroll.CanvasSize = UDim2.new(0, 0, 0, math.max(#configs, 1) * 31)
        updateSelection()
    end

    -- сохраняем функцию перестройки в общий стейт
    Config.rebuildFn = rebuild

    -- регистрация в группе
    group:_register(el)

    -- строим сразу
    rebuild()

    el.Rebuild = rebuild
    el.Get = function() return Config.selected end

    return el
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §63 · CONFIG · ДЕЙСТВИЯ (save/load/create/delete/export/import)
--// ═══════════════════════════════════════════════════════════════════════

-- создать
local function CreateConfig(name)
    name = Str.Trim(tostring(name or "")):gsub("[/\\%c]", "-")
    if name == "" then
        NL:Notify("Конфиги", "Введите имя", 3, "warning")
        return
    end
    if #name > 40 then
        NL:Notify("Конфиги", "Имя слишком длинное (>40)", 3, "warning")
        return
    end
    if ConfigExists(name) then
        NL:Notify("Конфиги", "Конфиг уже существует", 3, "warning")
        return
    end

    local json = EncodeConfig(BuildConfigData())
    if json and WriteConfig(name, json) then
        Config.selected = name
        if Config.rebuildFn then Config.rebuildFn() end
        NL:Notify("neverlose.cc", "Конфиг «" .. name .. "» создан", 3, "success")
    else
        NL:Notify("Конфиги", "Не удалось создать", 3, "error")
    end
end

-- сохранить
local function SaveConfig(name)
    name = name or Config.selected
    if not name or name == "" then
        NL:Notify("Конфиги", "Сначала выберите конфиг", 3, "warning")
        return
    end

    local json = EncodeConfig(BuildConfigData())
    if json and WriteConfig(name, json) then
        NL:Notify("neverlose.cc", "«" .. name .. "» сохранён", 3, "success")
        if Config.rebuildFn then Config.rebuildFn() end
    else
        NL:Notify("Конфиги", "Не удалось сохранить", 3, "error")
    end
end

-- загрузить
local function LoadConfig(name)
    name = name or Config.selected
    if not name or name == "" then
        NL:Notify("Конфиги", "Сначала выберите конфиг", 3, "warning")
        return
    end

    local content = ReadConfig(name)
    if not content then
        NL:Notify("Конфиги", "Не найден: " .. name, 3, "error")
        return
    end

    local data = DecodeConfig(content)
    if not data then
        NL:Notify("Конфиги", "Файл повреждён", 3, "error")
        return
    end

    local applied = ApplyConfigData(data)
    Config.selected = name
    if Config.rebuildFn then Config.rebuildFn() end

    NL:Notify("neverlose.cc",
        string.format("«%s» загружен · %d", name, applied), 3, "success")
end

-- удалить
local function DeleteConfig(name)
    name = name or Config.selected
    if not name or name == "" then return end

    DeleteConfigFile(name)
    if Config.selected == name then
        Config.selected = nil
    end
    if Config.rebuildFn then Config.rebuildFn() end

    NL:Notify("Конфиги", "«" .. name .. "» удалён", 3, "info")
end

-- экспорт в буфер
local function ExportConfig(name)
    name = name or Config.selected
    if not name or name == "" then
        NL:Notify("Конфиги", "Сначала выберите конфиг", 3, "warning")
        return
    end

    local content = ReadConfig(name)
    if not content then
        NL:Notify("Конфиги", "Не найден", 3, "error")
        return
    end

    if type(setclipboard) ~= "function" then
        NL:Notify("Конфиги", "Буфер обмена недоступен", 3, "error")
        return
    end

    local ok = pcall(function() setclipboard(content) end)
    if ok then
        NL:Notify("Конфиги", "«" .. name .. "» в буфере", 3, "success")
    else
        NL:Notify("Конфиги", "Ошибка буфера", 3, "error")
    end
end

-- импорт из буфера
local function ImportConfig()
    if type(getclipboard) ~= "function" then
        NL:Notify("Конфиги", "Буфер обмена недоступен", 3, "error")
        return
    end

    local clip = nil
    local ok = pcall(function() clip = getclipboard() end)
    if not ok or not clip or clip == "" then
        NL:Notify("Конфиги", "Буфер пуст", 3, "error")
        return
    end

    local data = DecodeConfig(clip)
    if not data then
        NL:Notify("Конфиги", "В буфере нет валидного конфига", 3, "error")
        return
    end

    local applied = ApplyConfigData(data)
    NL:Notify("neverlose.cc",
        "Импорт · " .. tostring(applied) .. " параметров", 3, "success")
end

-- авто-сохранение
local function AutoSaveOnExit()
    if not NL.Settings.AutoSave then return end
    if Config.selected and ConfigExists(Config.selected) then
        SaveConfig(Config.selected)
    end
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §64 · CONFIG · ГОТОВАЯ ВКЛАДКА
--// ═══════════════════════════════════════════════════════════════════════

function NL:BuildConfigTab(tab)
    if not tab then return end

    -- группа со списком
    local listGroup = tab:CreateGroup("Configurations")
    MakeConfigList(listGroup)

    -- группа с действиями
    local actions = tab:CreateGroup("Actions")

    local nameInput = actions:AddTextInput("Имя конфига", {
        Flag = "cfg_name",
        Placeholder = "my_config",
    })

    actions:AddButtonRow({
        {
            Text = "Создать",
            Callback = function()
                CreateConfig(nameInput.Get())
            end,
        },
        {
            Text = "Загрузить",
            Callback = function()
                LoadConfig(Config.selected)
            end,
        },
    })

    actions:AddButtonRow({
        {
            Text = "Сохранить",
            Callback = function()
                SaveConfig(Config.selected)
            end,
        },
        {
            Text = "Удалить",
            Color = Theme.Error,
            Callback = function()
                if Config.selected then
                    DeleteConfig(Config.selected)
                else
                    NL:Notify("Конфиги", "Выберите конфиг", 3, "warning")
                end
            end,
        },
    })

    actions:AddButtonRow({
        {
            Text = "Импорт",
            Icon = "Download",
            Callback = ImportConfig,
        },
        {
            Text = "Экспорт",
            Callback = function()
                ExportConfig(Config.selected)
            end,
        },
    })

    -- автозагрузка
    Config.autoToggle = actions:AddToggle("Автозагрузка", {
        Flag = "cfg_autoload",
        Tooltip = "Загружать последний конфиг при следующем запуске",
        Callback = function(on)
            local settings = LoadSettingsFile()
            if on then
                if Config.selected then
                    settings.AutoLoad = Config.selected
                else
                    NL:Notify("Конфиги", "Сначала выберите конфиг", 3, "warning")
                end
            else
                settings.AutoLoad = nil
            end
            SaveSettingsFile(settings)
        end,
    })

    -- информация
    local info = tab:CreateGroup("Info")
    info:AddInfo(
        Config.HAS_FILES
            and "Файловый режим: " .. Config.folder
            or "Режим памяти (без сохранения на диск)",
        Config.HAS_FILES and Theme.Success or Theme.Warning,
        "Folder"
    )
    info:AddLabel("Файлов: " .. tostring(#Config.entries))

    -- отложенная синхронизация
    task.delay(0.1, function()
        if Config.rebuildFn then
            Config.rebuildFn()
        end
        -- если в настройках уже есть автозагрузка — включим тумблер
        local settings = LoadSettingsFile()
        if settings.AutoLoad and Config.autoToggle then
            Config.autoToggle.Set(true, true)
        end
    end)

    return Config
end

-- экспорт в NL
NL.Config = {
    HAS_FILES = Config.HAS_FILES,
    State     = Config,

    List      = ListConfigs,
    Exists    = ConfigExists,
    Get       = ReadConfig,
    Write     = WriteConfig,

    Create    = CreateConfig,
    Save      = SaveConfig,
    Load      = LoadConfig,
    Delete    = DeleteConfig,
    Rename    = RenameConfigFile,
    Export    = ExportConfig,
    Import    = ImportConfig,

    LoadSettings = LoadSettingsFile,
    SaveSettings = SaveSettingsFile,

    BuildData = BuildConfigData,
    ApplyData = ApplyConfigData,
}

--// ═══════════════════════════════════════════════════════════════════════
--//  §65 · SEARCH · ЯДРО
--// ═══════════════════════════════════════════════════════════════════════

local SearchCore = {
    index = {},          -- кэш: {el, nameLower, tabName, groupName}
    lastQuery = "",
    lastResults = {},
}

-- индексация всех элементов
local function RebuildSearchIndex()
    SearchCore.index = {}

    for _, el in ipairs(NL.Elements) do
        if el.Name then
            local tabName = el._tab and el._tab.Name or "?"
            local groupName = el._group and el._group.Name or "?"

            table.insert(SearchCore.index, {
                el = el,
                nameLower = string.lower(tostring(el.Name)),
                tabName = tabName,
                groupName = groupName,
            })
        end
    end
end

-- фильтрация по запросу
local function SearchElements(query, maxResults)
    if not query or query == "" then return {} end

    local q = string.lower(query)
    local results = {}
    local total = 0

    for _, entry in ipairs(SearchCore.index) do
        if string.find(entry.nameLower, q, 1, true) then
            total = total + 1
            if #results < (maxResults or 60) then
                table.insert(results, entry.el)
            end
        end
    end

    SearchCore.lastQuery = query
    SearchCore.lastResults = results

    return results, total
end

-- открыть элемент
local function NavigateToElement(el)
    if not el then return end

    local tab = el._tab
    if not tab or not tab._window then return end

    -- переход на вкладку
    tab._window:SelectTab(tab)

    -- раскрыть группу
    local group = el._group
    if group and not group._open then
        group._open = true
        local h = group._height
        Tween(group._body, Theme.AnimNormal, { Size = UDim2.new(1, 0, 0, h) })
        Tween(group._frame, Theme.AnimNormal, {
            Size = UDim2.new(1, 0, 0, Theme.GroupHeaderHeight + h),
        })
        Tween(group._arrow, Theme.AnimNormal, { Rotation = 0 })
        task.delay(0.18, function()
            NL._recalcTab(group._tab)
        end)
    end

    -- подсветка
    task.delay(0.1, function()
        Effects.Highlight(el._frame, Theme.Accent, 0.7)
    end)

    -- прокрутка к элементу
    task.delay(0.24, function()
        if not el._frame or not el._frame.Parent then return end
        local scroll = tab._scroll
        if not scroll or not scroll.Parent then return end

        local target = el._frame.AbsolutePosition.Y - scroll.AbsolutePosition.Y
            + scroll.CanvasPosition.Y - 50
        local maxScroll = math.max(0, scroll.CanvasSize.Y.Offset - scroll.AbsoluteSize.Y)
        target = math.clamp(target, 0, maxScroll)

        Tween(scroll, 0.3, {
            CanvasPosition = Vector2.new(0, target),
        }, Enum.EasingStyle.Quint)
    end)
end

NL.Search = {
    Rebuild = RebuildSearchIndex,
    Query   = SearchElements,
    GoTo    = NavigateToElement,
    Index   = SearchCore,
}

--// ═══════════════════════════════════════════════════════════════════════
--//  §66 · SEARCH · UI OVERLAY
--// ═══════════════════════════════════════════════════════════════════════

local SearchUI = {
    overlay = nil,
    input = nil,
    header = nil,
    listScroll = nil,
    visible = false,
    _conns = {},
}

-- построить overlay
local function BuildSearchOverlay(Window)
    local overlay = New("Frame", {
        Name = "SearchOverlay",
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundColor3 = Theme.Content,
        BorderSizePixel = 0,
        Visible = false,
        ZIndex = 60,
        Parent = Window._contentArea,
    })
    Round(overlay, Theme.RadiusWindow)

    -- маска слева
    New("Frame", {
        Size = UDim2.new(0, 8, 1, 0),
        BackgroundColor3 = Theme.Content,
        BorderSizePixel = 0,
        ZIndex = 61,
        Parent = overlay,
    })

    -- поле ввода
    local inputBox = New("TextBox", {
        Text = "",
        PlaceholderText = "Поиск по функциям...",
        Font = Theme.Font,
        TextSize = 12,
        TextColor3 = Theme.Text,
        PlaceholderColor3 = Theme.TextPlaceholder,
        TextXAlignment = Enum.TextXAlignment.Left,
        ClearTextOnFocus = false,
        BackgroundColor3 = Theme.List,
        Position = UDim2.new(0, 12, 0, 12),
        Size = UDim2.new(1, -24, 0, 34),
        ZIndex = 62,
        Parent = overlay,
    })
    Round(inputBox, 6)
    local inputStroke = Stroke(inputBox, Theme.Stroke)
    Padding(inputBox, 0, 36, 0, 12)

    local sIcon = Icon.new("Search", inputBox, 14, Theme.TextDim)
    sIcon.Position = UDim2.new(1, -28, 0.5, -7)
    sIcon.ZIndex = 63

    -- заголовок
    local header = New("TextLabel", {
        Text = "Введите запрос для поиска",
        Font = Theme.Font,
        TextSize = 10,
        TextColor3 = Theme.TextDim,
        TextXAlignment = Enum.TextXAlignment.Left,
        Position = UDim2.new(0, 16, 0, 54),
        Size = UDim2.new(1, -32, 0, 12),
        BackgroundTransparency = 1,
        ZIndex = 62,
        Parent = overlay,
    })

    -- список результатов
    local listScroll = New("ScrollingFrame", {
        Position = UDim2.new(0, 10, 0, 72),
        Size = UDim2.new(1, -20, 1, -84),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = Theme.Accent,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        ZIndex = 62,
        Parent = overlay,
    })
    VLayout(listScroll, 4)

    SearchUI.overlay = overlay
    SearchUI.input = inputBox
    SearchUI.header = header
    SearchUI.listScroll = listScroll

    -- обновление результатов
    local function refresh()
        for _, c in ipairs(listScroll:GetChildren()) do
            if c:IsA("GuiObject") then c:Destroy() end
        end

        local q = inputBox.Text
        if q == "" then
            header.Text = "Введите запрос для поиска"
            overlay.Visible = false
            SearchUI.visible = false
            return
        end

        -- пересобираем индекс
        RebuildSearchIndex()

        local results, total = SearchElements(q, 60)

        if #results == 0 then
            header.Text = "Поиск: «" .. q .. "» — ничего не найдено"
        elseif total > 60 then
            header.Text = string.format("Поиск: «%s» — %d (показаны 60)", q, total)
        else
            header.Text = string.format("Поиск: «%s» — %d", q, total)
        end

        for i, el in ipairs(results) do
            local entry = nil
            for _, e in ipairs(SearchCore.index) do
                if e.el == el then entry = e; break end
            end

            local row = New("TextButton", {
                Text = "",
                BackgroundColor3 = Theme.Element,
                AutoButtonColor = false,
                BorderSizePixel = 0,
                Size = UDim2.new(1, -4, 0, 32),
                LayoutOrder = i,
                ZIndex = 63,
                Parent = listScroll,
            })
            Round(row, 5)

            -- название
            New("TextLabel", {
                Text = tostring(el.Name),
                Font = Theme.Font,
                TextSize = 11,
                TextColor3 = Theme.Text,
                TextXAlignment = Enum.TextXAlignment.Left,
                TextTruncate = Enum.TextTruncate.AtEnd,
                AnchorPoint = Vector2.new(0, 0.5),
                Position = UDim2.new(0, 12, 0.5, -5),
                Size = UDim2.new(1, -100, 0, 12),
                BackgroundTransparency = 1,
                ZIndex = 64,
                Parent = row,
            })

            -- путь (tab · group)
            local where = "?"
            if entry then
                where = entry.tabName .. " · " .. entry.groupName
            end

            New("TextLabel", {
                Text = where,
                Font = Theme.Font,
                TextSize = 9,
                TextColor3 = Theme.TextDim,
                TextXAlignment = Enum.TextXAlignment.Left,
                TextTruncate = Enum.TextTruncate.AtEnd,
                AnchorPoint = Vector2.new(0, 0.5),
                Position = UDim2.new(0, 12, 0.5, 7),
                Size = UDim2.new(1, -100, 0, 10),
                BackgroundTransparency = 1,
                ZIndex = 64,
                Parent = row,
            })

            -- тип элемента
            New("TextLabel", {
                Text = el._type or "?",
                Font = Theme.FontBold,
                TextSize = 9,
                TextColor3 = Theme.Accent,
                TextXAlignment = Enum.TextXAlignment.Right,
                AnchorPoint = Vector2.new(1, 0.5),
                Position = UDim2.new(1, -12, 0.5, 0),
                Size = UDim2.new(0, 80, 0, 12),
                BackgroundTransparency = 1,
                ZIndex = 64,
                Parent = row,
            })

            row.MouseEnter:Connect(function()
                Tween(row, Theme.AnimFast, { BackgroundColor3 = Theme.ElementHover })
            end)
            row.MouseLeave:Connect(function()
                Tween(row, Theme.AnimFast, { BackgroundColor3 = Theme.Element })
            end)
            row.MouseButton1Click:Connect(function()
                PlaySound()
                inputBox.Text = ""
                overlay.Visible = false
                SearchUI.visible = false
                HideTooltip()
                NavigateToElement(el)
            end)
        end

        listScroll.CanvasSize = UDim2.new(0, 0, 0, #results * 36 + 4)
        overlay.Visible = true
        SearchUI.visible = true
    end

    -- слушаем ввод
    inputBox:GetPropertyChangedSignal("Text"):Connect(refresh)

    -- фокус
    inputBox.Focused:Connect(function()
        Tween(inputBox, Theme.AnimFast, { BackgroundColor3 = Theme.ElementHover })
        Tween(inputStroke, Theme.AnimFast, { Color = Theme.Accent })
    end)
    inputBox.FocusLost:Connect(function()
        Tween(inputBox, Theme.AnimFast, { BackgroundColor3 = Theme.List })
        Tween(inputStroke, Theme.AnimFast, { Color = Theme.Stroke })
    end)

    -- Esc закрывает
    Connect(UserInputService.InputBegan, function(input, processed)
        if processed then return end
        if input.KeyCode == Enum.KeyCode.Escape and SearchUI.visible then
            inputBox.Text = ""
            overlay.Visible = false
            SearchUI.visible = false
        end
    end)

    return overlay
end

-- хук в топбар
local function HookSearchIntoWindow(Window)
    local topBar = Window._topBar
    if not topBar or not topBar.SearchChip then return end

    local overlay = BuildSearchOverlay(Window)
    Window._searchOverlay = overlay

    topBar.SearchChip.MouseButton1Click:Connect(function()
        overlay.Visible = true
        SearchUI.visible = true
        PlaySound()
        pcall(function() SearchUI.input:CaptureFocus() end)
    end)
end

NL._util.HookSearchIntoWindow = HookSearchIntoWindow

--// ═══════════════════════════════════════════════════════════════════════
--//  §67 · SEARCH · ПРОГРАММНОЕ ОТКРЫТИЕ/ЗАКРЫТИЕ
--// ═══════════════════════════════════════════════════════════════════════

function NL:OpenSearch()
    if SearchUI.overlay then
        SearchUI.overlay.Visible = true
        SearchUI.visible = true
        pcall(function() SearchUI.input:CaptureFocus() end)
    end
end

function NL:CloseSearch()
    if SearchUI.overlay then
        SearchUI.input.Text = ""
        SearchUI.overlay.Visible = false
        SearchUI.visible = false
    end
end

function NL:IsSearchOpen()
    return SearchUI.visible == true
end

