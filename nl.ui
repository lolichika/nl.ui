--// ═══════════════════════════════════════════════════════════════════════
--//  §85 · NIGHT MODE · ЯДРО
--// ═══════════════════════════════════════════════════════════════════════

local NightMode = {
    _enabled = false,
    _percent = 50,
    _saved   = nil,        -- снимок исходных значений
}

-- снимок текущего состояния Lighting
local function SaveLighting()
    if NightMode._saved then return end
    NightMode._saved = {
        ClockTime       = Lighting.ClockTime,
        Brightness      = Lighting.Brightness,
        FogEnd          = Lighting.FogEnd,
        FogStart        = Lighting.FogStart,
        FogColor        = Lighting.FogColor,
        Ambient         = Lighting.Ambient,
        OutdoorAmbient  = Lighting.OutdoorAmbient,
        ExposureComp    = Lighting.ExposureCompensation,
    }
end

-- восстановить
local function RestoreLighting()
    local s = NightMode._saved
    if not s then return end

    local ti = TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

    pcall(function()
        TweenService:Create(Lighting, ti, { ClockTime = s.ClockTime }):Play()
        TweenService:Create(Lighting, ti, { Brightness = s.Brightness }):Play()
        TweenService:Create(Lighting, ti, { FogEnd = s.FogEnd }):Play()
        TweenService:Create(Lighting, ti, { FogStart = s.FogStart }):Play()
        TweenService:Create(Lighting, ti, { FogColor = s.FogColor }):Play()
        TweenService:Create(Lighting, ti, { Ambient = s.Ambient }):Play()
        TweenService:Create(Lighting, ti, { OutdoorAmbient = s.OutdoorAmbient }):Play()
        TweenService:Create(Lighting, ti, { ExposureCompensation = s.ExposureComp }):Play()
    end)

    NightMode._saved = nil
end

-- интерполяция цвета
local function LerpC(a, b, t)
    return Color3.new(
        a.R + (b.R - a.R) * t,
        a.G + (b.G - a.G) * t,
        a.B + (b.B - a.B) * t
    )
end

-- применить с текущим процентом
local function ApplyNight(tween)
    if not NightMode._enabled then return end
    SaveLighting()

    local t = NightMode._percent / 100
    local s = NightMode._saved
    if not s then return end

    -- целевые значения на 100%
    local targetClock      = 0
    local targetBright     = 0.5
    local targetFogEnd     = 500
    local targetFogStart   = 0
    local targetFogColor   = Color3.fromRGB(20, 20, 30)
    local targetAmbient    = Color3.fromRGB(40, 40, 50)
    local targetOutdoorAmb = Color3.fromRGB(40, 40, 55)
    local targetExposure   = -1

    local fClock      = s.ClockTime + (targetClock - s.ClockTime) * t
    local fBright     = s.Brightness + (targetBright - s.Brightness) * t
    local fFogEnd     = s.FogEnd + (targetFogEnd - s.FogEnd) * t
    local fFogStart   = s.FogStart + (targetFogStart - s.FogStart) * t
    local fFogColor   = LerpC(s.FogColor, targetFogColor, t)
    local fAmbient    = LerpC(s.Ambient, targetAmbient, t)
    local fOutdoorAmb = LerpC(s.OutdoorAmbient, targetOutdoorAmb, t)
    local fExposure   = s.ExposureComp + (targetExposure - s.ExposureComp) * t

    if tween then
        local ti = TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        pcall(function()
            TweenService:Create(Lighting, ti, { ClockTime = fClock }):Play()
            TweenService:Create(Lighting, ti, { Brightness = fBright }):Play()
            TweenService:Create(Lighting, ti, { FogEnd = fFogEnd }):Play()
            TweenService:Create(Lighting, ti, { FogStart = fFogStart }):Play()
            TweenService:Create(Lighting, ti, { FogColor = fFogColor }):Play()
            TweenService:Create(Lighting, ti, { Ambient = fAmbient }):Play()
            TweenService:Create(Lighting, ti, { OutdoorAmbient = fOutdoorAmb }):Play()
            TweenService:Create(Lighting, ti, { ExposureCompensation = fExposure }):Play()
        end)
    else
        pcall(function()
            Lighting.ClockTime = fClock
            Lighting.Brightness = fBright
            Lighting.FogEnd = fFogEnd
            Lighting.FogStart = fFogStart
            Lighting.FogColor = fFogColor
            Lighting.Ambient = fAmbient
            Lighting.OutdoorAmbient = fOutdoorAmb
            Lighting.ExposureCompensation = fExposure
        end)
    end
end

local function StopNight()
    NightMode._enabled = false
    RestoreLighting()
end

local function StartNight()
    NightMode._enabled = true
    ApplyNight(false)
end

FeatureRegistry:Register("NightMode", StopNight)
NL.NightMode = {
    Start = StartNight,
    Stop  = StopNight,
    Apply = ApplyNight,
    State = NightMode,
}

--// ═══════════════════════════════════════════════════════════════════════
--//  §86 · NIGHT MODE · UI
--// ═══════════════════════════════════════════════════════════════════════

local function BuildNightModeUI(group)
    if not group then return end

    group:AddToggle("Enabled", {
        Flag = "night_enabled",
        Default = false,
        Tooltip = "Ночной режим с туманом",
        Callback = function(on)
            if on then
                StartNight()
                NL:Notify("Night Mode", "Активен · " .. NightMode._percent .. "%", 2, "success")
            else
                StopNight()
            end
        end,
    })

    group:AddSlider("Яркость", {
        Flag = "night_percent",
        Min = 0,
        Max = 100,
        Default = 50,
        Suffix = "%",
        Decimals = 0,
        Tooltip = "0% = день · 100% = глубокая ночь",
        Callback = function(v)
            NightMode._percent = v
