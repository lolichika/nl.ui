    game:GetService("TeleportService").TeleportInitFailed:Connect(function(_, result)
        if NL.DevTools and NL.DevTools.Console then
            NL.DevTools.Console:Warn("Teleport failed: " .. tostring(result))
        end
    end)
end)

-- финальный auto-save перед закрытием
Connect(game:GetService("GuiService").MenuOpened, function()
    pcall(function()
        if NL.Settings.AutoSave and NL.Config.State.selected then
            NL.Config.Save(NL.Config.State.selected)
        end
    end)
end)

--// ═══════════════════════════════════════════════════════════════════════
--//  §198 · READY SIGNAL
--// ═══════════════════════════════════════════════════════════════════════

local function FireReady()
    SafeBoot.booted = true
    SafeBoot.endTime = tick()
    SafeBoot.bootDuration = SafeBoot.endTime - SafeBoot.startTime

    -- уведомляем глобально
    if getgenv then
        pcall(function()
            getgenv().NeverloseUI_Ready = true
            getgenv().NeverloseUI_BootTime = SafeBoot.bootDuration
        end)
    end

    -- кастомный сигнал
    if NL._onReady and type(NL._onReady) == "function" then
        pcall(NL._onReady, NL)
    end
end

-- метод регистрации callback'а готовности
function NL:OnReady(fn)
    if SafeBoot.booted then
        pcall(fn, self)
    else
        self._onReady = fn
    end
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §199 · DEBUG INFO
--// ═══════════════════════════════════════════════════════════════════════

function NL:GetDebugInfo()
    return {
        Version   = self.Version,
        Build     = self.Build,
        BootTime  = SafeBoot.bootDuration,

        -- системы
        HasFiles     = self.Config and self.Config.HAS_FILES or false,
        HasDrawing   = self.Environment and self.Environment.HasDrawing or false,
        HasProtect   = self.Environment and self.Environment.HasProtectGUI or false,

        -- контент
        Elements     = #self.Elements,
        Tabs         = self._window and #self._window._tabs or 0,
        Flags        = (function()
            local c = 0
            for _ in pairs(self.Flags) do c = c + 1 end
            return c
        end)(),

        -- активные фичи
        Features = (function()
            local list = {}
            if self.Features and self.Features._features then
                for name, f in pairs(self.Features._features) do
                    if f.enabled then table.insert(list, name) end
                end
            end
            return list
        end)(),

        -- сессия
        Uptime       = self.Session and self.Session:Uptime() or "0:00",
        Notifications= self.Session and self.Session.notifications or 0,

        -- производительность
        FPS          = self.Performance and self.Performance.fps or 0,
        LowMode      = self.Performance and self.Performance.lowMode or false,

        -- ошибки
        Errors       = SafeBoot.errors,
    }
end

function NL:PrintDebugInfo()
    local info = self:GetDebugInfo()
    print("══════ NL DEBUG INFO ══════")
    print("Version:    " .. info.Version)
    print("Build:      " .. info.Build)
    print("Boot time:  " .. string.format("%.3f sec", info.BootTime))
    print("Elements:   " .. tostring(info.Elements))
    print("Tabs:       " .. tostring(info.Tabs))
    print("Flags:      " .. tostring(info.Flags))
    print("Uptime:     " .. info.Uptime)
    print("FPS:        " .. tostring(info.FPS))
    print("Filesystem: " .. tostring(info.HasFiles))
    print("Drawing:    " .. tostring(info.HasDrawing))
    if #info.Features > 0 then
        print("Active features: " .. table.concat(info.Features, ", "))
    end
    if #info.Errors > 0 then
        print("Errors: " .. tostring(#info.Errors))
        for _, e in ipairs(info.Errors) do
            print("  · [" .. e.name .. "] " .. e.err)
        end
    end
    print("═══════════════════════════")
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §200 · ЗАКЛЮЧИТЕЛЬНЫЙ ЛОГ
--// ═══════════════════════════════════════════════════════════════════════

-- прогрев
TryBoot("PreInitUI", PreInitUI)
TryBoot("Warmup", Warmup)

-- готовность
task.defer(function()
    TryBoot("FireReady", FireReady)

    -- финальный лог
    local log = string.format(
        "[NL v%s · build %s] Готово за %.3f сек · %d элементов · %d модулей · %s",
        NL.Version,
        NL.Build,
        SafeBoot.bootDuration or 0,
        #NL.Elements,
        #REQUIRED_MODULES - #failedModules,
        NL.Config and NL.Config.HAS_FILES and "filesystem" or "memory"
    )

    print(log)

    if #SafeBoot.errors > 0 then
        warn("[NL] Загрузка завершена с " .. tostring(#SafeBoot.errors) .. " ошибкой(ами)")
    end
end)

