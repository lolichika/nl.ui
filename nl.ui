    New("TextLabel", {
        Text = NL.Settings.WMCheatLogo or "N",
        Font = Theme.FontBold,
        TextSize = 15,
        TextColor3 = Color3.fromRGB(255, 255, 255),
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        ZIndex = 4,
        Parent = LogoBox,
    })
    refs.LogoBox = LogoBox

    -- ─── НАЗВАНИЕ ЧИТА + ТЕГ ─────────────────────────────────────
    local TitleBox = New("Frame", {
        BackgroundTransparency = 1,
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, 46, 0.5, 0),
        Size = UDim2.new(0, 200, 0, 20),
        ZIndex = 3,
        Parent = Header,
    })
    HLayout(TitleBox, 6)

    New("TextLabel", {
        Text = title or "neverlose",
        Font = Theme.FontBold,
        TextSize = 13,
        TextColor3 = Theme.Text,
        BackgroundTransparency = 1,
        AutomaticSize = Enum.AutomaticSize.X,
        Size = UDim2.new(0, 0, 0, 16),
        LayoutOrder = 1,
        ZIndex = 4,
        Parent = TitleBox,
    })

    local tagLabel = New("TextLabel", {
        Text = NL.Settings.WMCheatTag or "BETA",
        Font = Theme.Font,
        TextSize = 9,
        TextColor3 = Theme.TextDim,
        BackgroundTransparency = 1,
        AutomaticSize = Enum.AutomaticSize.X,
        Size = UDim2.new(0, 0, 0, 12),
        LayoutOrder = 2,
        ZIndex = 4,
        Parent = TitleBox,
    })
    refs.TagLabel = tagLabel

    -- ─── ЮЗЕР-ЧИП ────────────────────────────────────────────────
    if NL.Settings.ShowUserChip and LocalPlayer then
        local chipW = 170
        local UserChip = New("Frame", {
            AnchorPoint = Vector2.new(0, 0.5),
            Position = UDim2.new(0, 240, 0.5, 0),
            Size = UDim2.new(0, chipW, 0, 32),
            BackgroundColor3 = Theme.Chip,
            BorderSizePixel = 0,
            ZIndex = 3,
            Parent = Header,
        })
        Round(UserChip, Theme.RadiusChip)
        local chipStroke = Stroke(UserChip, Theme.Stroke)
        refs.UserChip = UserChip

        -- аватарка (буква)
        local Avatar = New("TextLabel", {
            Text = string.sub(LocalPlayer.Name, 1, 1):upper(),
            Font = Theme.FontBold,
            TextSize = 11,
            TextColor3 = Color3.fromRGB(255, 255, 255),
            BackgroundColor3 = Theme.Accent,
            AnchorPoint = Vector2.new(0, 0.5),
            Position = UDim2.new(0, 4, 0.5, 0),
            Size = UDim2.new(0, 24, 0, 24),
            ZIndex = 4,
            Parent = UserChip,
        })
        Circle(Avatar)
        Gradient(Avatar, Theme.Accent, Theme.AccentBright, 135)

        -- имя
        New("TextLabel", {
            Text = LocalPlayer.Name,
            Font = Theme.Font,
            TextSize = 11,
            TextColor3 = Theme.Text,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd,
            AnchorPoint = Vector2.new(0, 0.5),
            Position = UDim2.new(0, 34, 0.5, -6),
            Size = UDim2.new(1, -42, 0, 12),
            BackgroundTransparency = 1,
            ZIndex = 4,
            Parent = UserChip,
        })

        -- дата
        New("TextLabel", {
            Text = os.date("%d.%m.%Y"),
            Font = Theme.Font,
            TextSize = 9,
            TextColor3 = Theme.TextGreen,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd,
            AnchorPoint = Vector2.new(0, 0.5),
            Position = UDim2.new(0, 34, 0.5, 6),
            Size = UDim2.new(1, -42, 0, 10),
            BackgroundTransparency = 1,
            ZIndex = 4,
            Parent = UserChip,
        })

        -- пин-иконка
        local pinIc = Icon.new("Pin", UserChip, 10, Theme.TextDim)
        pinIc.AnchorPoint = Vector2.new(1, 0.5)
        pinIc.Position = UDim2.new(1, -8, 0.5, -5)
        pinIc.ZIndex = 4

        -- hover
        UserChip.MouseEnter:Connect(function()
            Tween(UserChip, Theme.AnimFast, { BackgroundColor3 = Theme.ChipHover })
            Tween(chipStroke, Theme.AnimFast, { Color = Theme.StrokeLight })
        end)
        UserChip.MouseLeave:Connect(function()
            Tween(UserChip, Theme.AnimFast, { BackgroundColor3 = Theme.Chip })
            Tween(chipStroke, Theme.AnimFast, { Color = Theme.Stroke })
        end)
