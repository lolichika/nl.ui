--//  §154 · INTEGRATION · WRAPPER
--// ═══════════════════════════════════════════════════════════════════════

-- обёртка для безопасного вызова внешних модулей
local function WrapExternalCall(fn, name)
    return function(...)
        local ok, err = pcall(fn, ...)
        if not ok then
            NL:NotifyWarning("External", "Ошибка в " .. (name or "модуле") .. ": " .. tostring(err))
        end
        return ok
    end
end

NL.WrapExternalCall = WrapExternalCall

--// ═══════════════════════════════════════════════════════════════════════
--//  §155 · AUTO-SAVE LOOP
---- ═══════════════════════════════════════════════════════════════════════

local AutoSaveLoop = {
    enabled = false,
    interval = 60,       -- сек
    lastSave = 0,
    _conn = nil,
}

function AutoSaveLoop:Start()
    if self._conn then return end
    self.enabled = true
    self.lastSave = tick()

    self._conn = task.spawn(function()
        while self.enabled do
            task.wait(self.interval)
            if not self.enabled then break end

            -- авто-сохранение конфига
            if NL.Settings.AutoSave and NL.Config.State.selected then
                local ok = pcall(function()
                    NL.Config.Save(NL.Config.State.selected)
                end)
            end

            -- авто-сохранение UI-пресета
            pcall(function()
                NL.UIPreset.Save(NL.UIPreset.autoSaveSlot)
            end)

            self.lastSave = tick()
        end
    end)
end

function AutoSaveLoop:Stop()
    self.enabled = false
    if self._conn then
        task.cancel(self._conn)
        self._conn = nil
    end
end

NL.AutoSaveLoop = AutoSaveLoop

--// ═══════════════════════════════════════════════════════════════════════
--//  §156 · AUTO-LOAD LOOP
--// ═══════════════════════════════════════════════════════════════════════

local AutoLoadLoop = {
    loaded = false,
}

function AutoLoadLoop:Run()
    if self.loaded then return end
    self.loaded = true

    task.defer(function()
        task.wait(1)

        -- авто-загрузка UI-пресета
        local loadedUI = pcall(function()
            NL.UIPreset.Load(NL.UIPreset.autoSaveSlot)
        end)

        if loadedUI then
            NL:Notify("UI Preset", "Авто-загрузка раскладки", 2, "info")
        end
    end)
end

NL.AutoLoadLoop = AutoLoadLoop

