            BackgroundTransparency = 1,
            ZIndex = 4,
            Parent = SearchChip,
        })

        SearchChip.MouseEnter:Connect(function()
            Tween(SearchChip, Theme.AnimFast, { BackgroundColor3 = Theme.ChipHover })
            Tween(searchStroke, Theme.AnimFast, { Color = Theme.StrokeLight })
            Icon.TweenTint(sIcon, Theme.TextSub, Theme.AnimFast)
        end)
        SearchChip.MouseLeave:Connect(function()
            Tween(SearchChip, Theme.AnimFast, { BackgroundColor3 = Theme.Chip })
            Tween(searchStroke, Theme.AnimFast, { Color = Theme.Stroke })
            Icon.TweenTint(sIcon, Theme.TextDim, Theme.AnimFast)
        end)
    end

    -- ─── ВРЕМЯ + ИКОНКИ (справа) ─────────────────────────────────
    local RightBox = New("Frame", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -82, 0.5, 0),
        Size = UDim2.new(0, 180, 0, 32),
        BackgroundTransparency = 1,
        ZIndex = 3,
        Parent = Header,
    })
