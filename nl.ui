--// ═══════════════════════════════════════════════════════════════════════
--//  §09 · УТИЛИТЫ СОЗДАНИЯ ОБЪЕКТОВ
--// ═══════════════════════════════════════════════════════════════════════

-- Создание Instance с применением свойств
-- Parent применяется последним (важно!)
local function New(class, props)
    if not class or type(class) ~= "string" then
        warn("[NL] New(): неверный класс " .. tostring(class))
        return nil
    end

    local inst = Instance.new(class)
    if not inst then return nil end

    props = props or {}
    local parent = props.Parent
    props.Parent = nil

    for k, v in pairs(props) do
        local ok, err = pcall(function() inst[k] = v end)
        if not ok then
            warn("[NL] New(" .. class .. ")." .. tostring(k) .. " = " .. tostring(v) .. " — " .. tostring(err))
        end
    end

    if parent then
        inst.Parent = parent
    end

    return inst
end

-- Скругление углов
local function Round(inst, radius)
    if not inst then return nil end
    return New("UICorner", {
        CornerRadius = UDim.new(0, radius or 4),
        Parent = inst,
    })
end

-- Полное скругление (круг/пилюля)
local function Circle(inst)
    if not inst then return nil end
    return New("UICorner", {
        CornerRadius = UDim.new(1, 0),
        Parent = inst,
    })
end

-- Обводка
local function Stroke(inst, color, thickness, transparency)
    if not inst then return nil end
    return New("UIStroke", {
        Color = color or Theme.Stroke,
        Thickness = thickness or 1,
        Transparency = transparency or 0,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        Parent = inst,
    })
end

-- Градиент
local function Gradient(inst, c1, c2, rotation)
    if not inst then return nil end
    return New("UIGradient", {
        Color = ColorSequence.new(c1 or Theme.Accent, c2 or Theme.AccentBright),
        Rotation = rotation or 90,
        Parent = inst,
    })
end

-- Отступы
local function Padding(inst, top, right, bottom, left)
    if not inst then return nil end
    return New("UIPadding", {
        PaddingTop    = UDim.new(0, top or 0),
        PaddingRight  = UDim.new(0, right or 0),
        PaddingBottom = UDim.new(0, bottom or 0),
        PaddingLeft   = UDim.new(0, left or 0),
        Parent = inst,
    })
end

-- Горизонтальный layout
local function HLayout(parent, gap, align)
    return New("UIListLayout", {
        FillDirection = Enum.FillDirection.Horizontal,
        Padding = UDim.new(0, gap or 6),
        VerticalAlignment = align or Enum.VerticalAlignment.Center,
        SortOrder = Enum.SortOrder.LayoutOrder,
        Parent = parent,
    })
end

-- Вертикальный layout
local function VLayout(parent, gap)
    return New("UIListLayout", {
        FillDirection = Enum.FillDirection.Vertical,
        Padding = UDim.new(0, gap or 4),
        SortOrder = Enum.SortOrder.LayoutOrder,
        Parent = parent,
    })
end

-- Tween-обёртка
local function Tween(inst, time, props, style, dir)
    if not inst or not inst.Parent then return nil end
    local t = TweenService:Create(inst,
        TweenInfo.new(
            time or Theme.AnimNormal,
            style or Enum.EasingStyle.Quad,
            dir or Enum.EasingDirection.Out
        ),
        props
    )
    t:Play()
    return t
end

-- Создание текстового лейбла
local function Label(parent, text, size, color, font)
    return New("TextLabel", {
        Text = text or "",
        Font = font or Theme.Font,
        TextSize = size or 11,
        TextColor3 = color or Theme.Text,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 14),
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = parent,
    })
end

-- Создание фрейма с фоном
local function Frame(parent, color, radius, size)
    local f = New("Frame", {
        BackgroundColor3 = color or Theme.Element,
        BorderSizePixel = 0,
        Size = size or UDim2.new(1, 0, 0, 30),
        Parent = parent,
    })
    if radius then Round(f, radius) end
    return f
end

-- Быстрый spacer
local function Spacer(parent, size)
    return New("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, size or 8),
        Parent = parent,
    })
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §10 · УТИЛИТЫ ЦВЕТА
--// ═══════════════════════════════════════════════════════════════════════

local Color = {}

function Color.Lerp(a, b, t)
    if not a or not b then return a or b end
    t = math.clamp(t or 0, 0, 1)
    return Color3.new(
        a.R + (b.R - a.R) * t,
        a.G + (b.G - a.G) * t,
        a.B + (b.B - a.B) * t
    )
end

function Color.ToHex(c, includeHash)
    if typeof(c) ~= "Color3" then return "" end
    local hex = string.format("%02X%02X%02X",
        math.floor(c.R * 255 + 0.5),
        math.floor(c.G * 255 + 0.5),
        math.floor(c.B * 255 + 0.5))
    if includeHash then return "#" .. hex end
    return hex
end

function Color.FromHex(hex, fallback)
    hex = tostring(hex or ""):gsub("#", "")
    if #hex >= 6 then
        local r = tonumber(hex:sub(1, 2), 16)
        local g = tonumber(hex:sub(3, 4), 16)
        local b = tonumber(hex:sub(5, 6), 16)
        if r and g and b then
            return Color3.fromRGB(r, g, b)
        end
    end
    return fallback or Theme.Accent
end

function Color.Brighten(c, factor)
    factor = factor or 0.2
    return Color3.new(
        math.clamp(c.R + factor, 0, 1),
        math.clamp(c.G + factor, 0, 1),
        math.clamp(c.B + factor, 0, 1)
    )
end

function Color.Darken(c, factor)
    factor = factor or 0.2
    return Color3.new(
        math.clamp(c.R - factor, 0, 1),
        math.clamp(c.G - factor, 0, 1),
        math.clamp(c.B - factor, 0, 1)
    )
end

function Color.Invert(c)
    return Color3.new(1 - c.R, 1 - c.G, 1 - c.B)
end

-- Контраст (яркость по стандарту WCAG)
function Color.Luminance(c)
    local function chan(v)
        if v <= 0.03928 then return v / 12.92 end
        return math.pow((v + 0.055) / 1.055, 2.4)
    end
    return 0.2126 * chan(c.R) + 0.7152 * chan(c.G) + 0.0722 * chan(c.B)
end

-- выбрать контрастный цвет (белый или чёрный)
function Color.ContrastText(bg)
    return Color.Luminance(bg) > 0.5 and Color3.fromRGB(20, 20, 20) or Color3.fromRGB(255, 255, 255)
end

-- насыщенность / яркость через HSV
function Color.SetSaturation(c, sat)
    local h, _, v = Color3.toHSV(c)
    return Color3.fromHSV(h, sat, v)
end

function Color.SetValue(c, val)
    local h, s, _ = Color3.toHSV(c)
    return Color3.fromHSV(h, s, val)
end

function Color.SetHue(c, hue)
    local _, s, v = Color3.toHSV(c)
    return Color3.fromHSV(hue, s, v)
end

function Color.Saturate(c, amount)
    local h, s, v = Color3.toHSV(c)
    s = math.clamp(s + amount, 0, 1)
    return Color3.fromHSV(h, s, v)
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §11 · УТИЛИТЫ ЧИСЕЛ
--// ═══════════════════════════════════════════════════════════════════════

local Num = {}

function Num.Round(x)
    return math.floor(x + 0.5)
end

function Num.Floor(x)
    return math.floor(x)
end

function Num.Ceil(x)
    return math.ceil(x)
end

function Num.Clamp(v, min, max)
    if min > max then min, max = max, min end
    return math.max(min, math.min(max, v))
end

function Num.Lerp(a, b, t)
    return a + (b - a) * math.clamp(t, 0, 1)
end

-- линейная интерполяция с собственным easing
function Num.SmoothLerp(a, b, t)
    t = math.clamp(t, 0, 1)
    t = t * t * (3 - 2 * t)  -- smoothstep
    return a + (b - a) * t
end

-- перевести значение из одного диапазона в другой
function Num.Map(v, inMin, inMax, outMin, outMax)
    if inMax == inMin then return outMin end
    return outMin + (v - inMin) * (outMax - outMin) / (inMax - inMin)
end

function Num.RoundTo(v, step)
    if not step or step <= 0 then return v end
    return math.floor(v / step + 0.5) * step
end

-- безопасный корень
function Num.SqrtSafe(x)
    if x < 0 then return 0 end
    return math.sqrt(x)
end

-- проценты
function Num.Percent(v, total)
    if total == 0 then return 0 end
    return (v / total) * 100
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §12 · УТИЛИТЫ СТРОК
--// ═══════════════════════════════════════════════════════════════════════

local Str = {}

function Str.Trim(s)
    return (tostring(s or ""):gsub("^%s+", ""):gsub("%s+$", ""))
end

function Str.Split(s, sep)
    s = tostring(s or "")
    sep = sep or "%s"
    local result = {}
    for token in s:gmatch("([^" .. sep .. "]+)") do
        table.insert(result, token)
    end
    return result
end

function Str.Replace(s, pat, rep)
    return (tostring(s or ""):gsub(pat, rep))
end

function Str.Format(fmt, ...)
    local ok, result = pcall(string.format, fmt, ...)
    if ok then return result end
    return tostring(fmt)
end

function Str.StartsWith(s, prefix)
    return tostring(s or ""):sub(1, #prefix) == prefix
end

function Str.EndsWith(s, suffix)
    return tostring(s or ""):sub(-#suffix) == suffix
end

function Str.Contains(s, needle)
    return string.find(tostring(s or ""), needle, 1, true) ~= nil
end

function Str.Uppercase(s)
    return string.upper(tostring(s or ""))
end

function Str.Lowercase(s)
    return string.lower(tostring(s or ""))
end

function Str.Capitalize(s)
    s = tostring(s or "")
    if #s == 0 then return s end
    return s:sub(1, 1):upper() .. s:sub(2):lower()
end

-- обрезать с многоточием
function Str.Truncate(s, maxLen)
    s = tostring(s or "")
    if #s <= maxLen then return s end
    return s:sub(1, maxLen - 3) .. "..."
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §13 · УТИЛИТЫ СИГНАЛОВ
--// ═══════════════════════════════════════════════════════════════════════

-- Подключить сигнал с авто-регистрацией для отключения
local function Connect(signal, fn)
    if not signal or not fn then return nil end
    local ok, c = pcall(function()
        return signal:Connect(fn)
    end)
    if ok and c then
        table.insert(NL._connections, c)
        return c
    end
    return nil
end

-- Отключить ВСЕ соединения
local function DisconnectAll()
    for _, c in ipairs(NL._connections) do
        pcall(function()
            if c and c.Disconnect then c:Disconnect() end
        end)
    end
    table.clear(NL._connections)
end

-- Безопасный вызов функции
local function SafeCall(fn, ...)
    if type(fn) ~= "function" then return false, nil end
    local ok, result = pcall(fn, ...)
    if not ok then
        if Settings.DebugMode then
            warn("[NL] SafeCall error: " .. tostring(result))
        end
    end
    return ok, result
end

-- создание собственного сигнала
local function CreateSignal()
    local handlers = {}
    local signal = {}

    function signal:Connect(fn)
        local c = { connected = true, callback = fn }
        table.insert(handlers, c)
        return {
            Disconnect = function()
                c.connected = false
                for i, h in ipairs(handlers) do
                    if h == c then table.remove(handlers, i); break end
                end
            end,
            disconnect = function()
                c.connected = false
            end,
        }
    end

    function signal:Fire(...)
        for _, c in ipairs(handlers) do
            if c.connected then
                SafeCall(c.callback, ...)
            end
        end
    end

    function signal:Wait()
        local thread = coroutine.running()
        local c
        c = signal:Connect(function(...)
            if c then c:Disconnect() end
            task.spawn(thread, ...)
        end)
        coroutine.yield()
    end

    return signal
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §14 · УТИЛИТЫ ЗВУКА
--// ═══════════════════════════════════════════════════════════════════════

local SoundPool = {
    _cache = {},
    _active = {},
}

function SoundPool:Preload(asset)
    if self._cache[asset] then return self._cache[asset] end
    local s = Instance.new("Sound")
    s.SoundId = asset
    s.Volume = 0
    pcall(function()
        SoundService:PlayLocalSound(s)
        s:Stop()
    end)
    self._cache[asset] = s
    return s
end

function SoundPool:Play(asset, volume)
    if not Settings.Sounds then return end
    if not asset then return end
    local ok = pcall(function()
        local s = Instance.new("Sound")
        s.SoundId = asset
        s.Volume = math.clamp(volume or Settings.SoundVolume, 0, 10)
        SoundService:PlayLocalSound(s)
        Debris:AddItem(s, 4)
    end)
    return ok
end

local function PlaySound(asset, volume)
    if not Settings.Sounds then return end
    SoundPool:Play(asset or Settings.SoundClick, volume or Settings.SoundVolume)
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §15 · DRAG (расширенный, с границами и вязкостью)
--// ═══════════════════════════════════════════════════════════════════════

local function MakeDraggable(area, target, options)
    if not area or not target then return nil end
    options = options or {}

    local dragging = false
    local dragStart = nil
    local startPosX = 0
    local startPosY = 0
    local velocityX = 0
    local velocityY = 0
    local lastPos = nil
    local lastTime = nil
    local inertia = options.Inertia ~= false
    local inertiaDrag = 0.9
    local inertiaConn = nil

    local function stopInertia()
        if inertiaConn then
            inertiaConn:Disconnect()
            inertiaConn = nil
        end
    end

    local function startInertia()
        if not inertia then return end
        if math.abs(velocityX) < 0.5 and math.abs(velocityY) < 0.5 then return end
        stopInertia()
        inertiaConn = RunService.RenderStepped:Connect(function(dt)
            velocityX = velocityX * inertiaDrag
            velocityY = velocityY * inertiaDrag

            if math.abs(velocityX) < 0.5 and math.abs(velocityY) < 0.5 then
                stopInertia()
                return
            end

            local newX = target.Position.X.Offset + velocityX * dt * 60
            local newY = target.Position.Y.Offset + velocityY * dt * 60

            if options.Clamp then
                local cam = Workspace.CurrentCamera
                local vs = cam and cam.ViewportSize or Vector2.new(1920, 1080)
                local w = target.AbsoluteSize.X
                local h = target.AbsoluteSize.Y
                newX = Num.Clamp(newX, -w + (options.KeepX or 120), vs.X - (options.KeepX or 120))
                newY = Num.Clamp(newY, 0, vs.Y - (options.KeepY or 60))
            end

            target.Position = UDim2.new(0, newX, 0, newY)
        end)
    end

    area.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            velocityX = 0
            velocityY = 0
            lastPos = input.Position
            lastTime = tick()
            stopInertia()

            local cam = Workspace.CurrentCamera
            local vs = cam and cam.ViewportSize or Vector2.new(1920, 1080)
            local pos = target.Position
            local ap = target.AnchorPoint
            startPosX = pos.X.Scale * vs.X + pos.X.Offset - ap.X * target.AbsoluteSize.X
            startPosY = pos.Y.Scale * vs.Y + pos.Y.Offset - ap.Y * target.AbsoluteSize.Y

            target.AnchorPoint = Vector2.new(0, 0)
            target.Position = UDim2.new(0, startPosX, 0, startPosY)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
            local now = tick()
            if lastTime and lastPos then
                local dt = now - lastTime
                if dt > 0 then
                    local dx = input.Position.X - lastPos.X
                    local dy = input.Position.Y - lastPos.Y
                    velocityX = velocityX * 0.7 + (dx / (dt * 60)) * 0.3
                    velocityY = velocityY * 0.7 + (dy / (dt * 60)) * 0.3
                end
            end
            lastPos = input.Position
            lastTime = now

            local delta = input.Position - dragStart
            local x = startPosX + delta.X
            local y = startPosY + delta.Y

            if options.Clamp then
                local cam = Workspace.CurrentCamera
                local vs = cam and cam.ViewportSize or Vector2.new(1920, 1080)
                local w = target.AbsoluteSize.X
                local h = target.AbsoluteSize.Y
                x = Num.Clamp(x, -w + (options.KeepX or 120), vs.X - (options.KeepX or 120))
                y = Num.Clamp(y, 0, vs.Y - (options.KeepY or 60))
            end

            target.Position = UDim2.new(0, x, 0, y)
        end
    end)

    local function endDrag()
        if dragging then
            dragging = false
            startInertia()
        end
    end

    area.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            endDrag()
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            endDrag()
        end
    end)

    return {
        Stop = function()
            dragging = false
            stopInertia()
        end,
        IsDragging = function() return dragging end,
    }
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §16 · RESIZE (для окна)
--// ═══════════════════════════════════════════════════════════════════════

local function MakeResizable(handle, target, options)
    if not handle or not target then return nil end
    options = options or {}

    local resizing = false
    local resizeStart = nil
    local startW, startH = 0, 0

    local minW = options.MinWidth or 400
    local minH = options.MinHeight or 300
    local maxW = options.MaxWidth or 2000
    local maxH = options.MaxHeight or 1400
    local aspect = options.AspectRatio

    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            resizing = true
            resizeStart = input.Position
            startW = target.AbsoluteSize.X
            startH = target.AbsoluteSize.Y
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if not resizing then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
            local delta = input.Position - resizeStart
            local w = Num.Clamp(startW + delta.X, minW, maxW)
            local h = Num.Clamp(startH + delta.Y, minH, maxH)

            if aspect then
                h = w / aspect
                if h > maxH then h = maxH; w = h * aspect end
                if h < minH then h = minH; w = h * aspect end
            end

            target.Size = UDim2.new(0, w, 0, h)
            if options.OnResize then options.OnResize(w, h) end
        end
    end)

    local function endResize()
        if resizing then
            resizing = false
            if options.OnResizeEnd then
                options.OnResizeEnd(target.AbsoluteSize.X, target.AbsoluteSize.Y)
            end
        end
    end

    handle.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            endResize()
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            endResize()
        end
    end)

    return {
        IsResizing = function() return resizing end,
    }
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §17 · АНИМАЦИОННЫЙ ДВИЖОК
--// ═══════════════════════════════════════════════════════════════════════

local Anim = {}

-- easing-функции
Anim.Ease = {
    Linear = function(t) return t end,
    QuadIn = function(t) return t * t end,
    QuadOut = function(t) return 1 - (1 - t) * (1 - t) end,
    QuadInOut = function(t)
        if t < 0.5 then return 2 * t * t end
        return 1 - math.pow(-2 * t + 2, 2) / 2
    end,
    CubicIn = function(t) return t * t * t end,
    CubicOut = function(t) return 1 - math.pow(1 - t, 3) end,
    CubicInOut = function(t)
        if t < 0.5 then return 4 * t * t * t end
        return 1 - math.pow(-2 * t + 2, 3) / 2
    end,
    BackOut = function(t)
        local c1 = 1.70158
        local c3 = c1 + 1
        return 1 + c3 * math.pow(t - 1, 3) + c1 * math.pow(t - 1, 2)
    end,
    ElasticOut = function(t)
        local c4 = (2 * math.pi) / 3
        if t == 0 then return 0 end
        if t == 1 then return 1 end
        return math.pow(2, -10 * t) * math.sin((t * 10 - 0.75) * c4) + 1
    end,
    BounceOut = function(t)
        local n1 = 7.5625
        local d1 = 2.75
        if t < 1 / d1 then
            return n1 * t * t
        elseif t < 2 / d1 then
            t = t - 1.5 / d1
            return n1 * t * t + 0.75
        elseif t < 2.5 / d1 then
            t = t - 2.25 / d1
            return n1 * t * t + 0.9375
        else
            t = t - 2.625 / d1
            return n1 * t * t + 0.984375
        end
    end,
}

-- универсальная анимация
function Anim.Animate(duration, easeFn, onUpdate, onComplete)
    if Settings.ReducedMotion then
        if onUpdate then onUpdate(1) end
        if onComplete then onComplete() end
        return nil
    end

    local startTime = tick()
    local conn

    conn = RunService.RenderStepped:Connect(function()
        local elapsed = tick() - startTime
        local t = math.clamp(elapsed / duration, 0, 1)
        local eased = easeFn and easeFn(t) or t

        if onUpdate then onUpdate(eased, t) end

        if t >= 1 then
            if conn then conn:Disconnect() end
            if onComplete then onComplete() end
        end
    end)

    table.insert(NL._animations, conn)
    return conn
end

-- последовательная анимация
function Anim.Sequence(steps)
    local index = 1
    local function nextStep()
        if index > #steps then return end
        local step = steps[index]
        index = index + 1
        Anim.Animate(
            step.Duration or 0.2,
            step.Ease or Anim.Ease.QuadOut,
            step.OnUpdate,
            function()
                if step.OnComplete then step.OnComplete() end
                nextStep()
            end
        )
    end
    nextStep()
end

-- пружина (spring-подобная)
function Anim.Spring(target, property, targetValue, config)
    config = config or {}
    local stiffness = config.Stiffness or 200
    local damping = config.Damping or 20
    local velocity = 0
    local currentValue = target[property]
    if type(currentValue) ~= "number" then return nil end

    local conn
    conn = RunService.RenderStepped:Connect(function(dt)
        local force = (targetValue - currentValue) * stiffness
        velocity = velocity + force * dt
        velocity = velocity * (1 - damping * dt)
        currentValue = currentValue + velocity * dt

        target[property] = currentValue

        if math.abs(targetValue - currentValue) < 0.01 and math.abs(velocity) < 0.01 then
            target[property] = targetValue
            if conn then conn:Disconnect() end
        end
    end)

    return conn
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §18 · БИБЛИОТЕКА ВЕКТОРНЫХ ИКОНОК
--// ═══════════════════════════════════════════════════════════════════════

local Icon = {}

-- залитый примитив
local function shape(parent, props)
    local corner = props.CornerRadius
    props.CornerRadius = nil
    props.BorderSizePixel = 0
    props.BackgroundColor3 = props.BackgroundColor3 or Theme.Text
    props.Parent = parent
    local f = New("Frame", props)
    if not f then return nil end
    if corner then New("UICorner", { CornerRadius = corner, Parent = f }) end
    return f
end

-- контурный примитив
local function outline(parent, props, thickness)
    local corner = props.CornerRadius
    props.CornerRadius = nil
    props.BackgroundTransparency = 1
    props.BorderSizePixel = 0
    props.BackgroundColor3 = nil
    props.Parent = parent
    local f = New("Frame", props)
    if not f then return nil end
    if corner then New("UICorner", { CornerRadius = corner, Parent = f }) end
    New("UIStroke", { Color = Theme.Text, Thickness = thickness or 1.4, Parent = f })
    return f
end

-- наклонная палочка
local function arm(parent, x, y, rotation, length, thickness)
    return shape(parent, {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Size = UDim2.new(0, thickness or 2, 0, length),
        Position = UDim2.new(0, x, 0, y),
        Rotation = rotation,
    })
end

-- покрасить иконку мгновенно
function Icon.Tint(holder, color)
    if not holder or not color then return end
    for _, d in ipairs(holder:GetDescendants()) do
        if d:IsA("Frame") and d.BackgroundTransparency < 1 then
            d.BackgroundColor3 = color
        elseif d:IsA("UIStroke") then
            d.Color = color
        end
    end
end

-- плавно покрасить
function Icon.TweenTint(holder, color, time)
    if not holder or not color then return end
    time = time or Theme.AnimFast
    for _, d in ipairs(holder:GetDescendants()) do
        if d:IsA("Frame") and d.BackgroundTransparency < 1 then
            Tween(d, time, { BackgroundColor3 = color })
        elseif d:IsA("UIStroke") then
            Tween(d, time, { Color = color })
        end
    end
end

-- конструктор иконки
local function buildIcon(draw)
    return function(parent, size, color)
        size = size or 16
        color = color or Theme.TextSub
        local holder = New("Frame", {
            BackgroundTransparency = 1,
            Size = UDim2.new(0, size, 0, size),
            Parent = parent,
        })
        if not holder then return nil end
        local ok, err = pcall(draw, holder, size, color)
        if not ok then
            warn("[NL] Иконка: " .. tostring(err))
        end
        Icon.Tint(holder, color)
        return holder
    end
end

-- ═══════════════════════════════════════════════════════════════════
-- БАЗОВЫЕ ИКОНКИ
-- ═══════════════════════════════════════════════════════════════════

Icon.Crosshair = buildIcon(function(h, S)
    outline(h, {
        Size = UDim2.new(0, S - 3, 0, S - 3),
        Position = UDim2.new(0, 1.5, 0, 1.5),
        CornerRadius = UDim.new(1, 0),
    }, 1.4)
    local c = S / 2
    shape(h, { Size = UDim2.new(0, 2, 0, 4), Position = UDim2.new(0, c - 1, 0, 0) })
    shape(h, { Size = UDim2.new(0, 2, 0, 4), Position = UDim2.new(0, c - 1, 0, S - 4) })
    shape(h, { Size = UDim2.new(0, 4, 0, 2), Position = UDim2.new(0, 0, 0, c - 1) })
    shape(h, { Size = UDim2.new(0, 4, 0, 2), Position = UDim2.new(0, S - 4, 0, c - 1) })
end)

Icon.Legit = buildIcon(function(h, S)
    local c = S / 2
    shape(h, { Size = UDim2.new(0, 3, 0, 3), Position = UDim2.new(0, c - 1.5, 0, c - 1.5), CornerRadius = UDim.new(1, 0) })
    shape(h, { Size = UDim2.new(0, 1.6, 0, 5), Position = UDim2.new(0, c - 0.8, 0, 0) })
    shape(h, { Size = UDim2.new(0, 1.6, 0, 5), Position = UDim2.new(0, c - 0.8, 0, S - 5) })
    shape(h, { Size = UDim2.new(0, 5, 0, 1.6), Position = UDim2.new(0, 0, 0, c - 0.8) })
    shape(h, { Size = UDim2.new(0, 5, 0, 1.6), Position = UDim2.new(0, S - 5, 0, c - 0.8) })
end)

Icon.Eye = buildIcon(function(h, S)
    local hgt = math.max(7, Num.Round(S * 0.6))
    local ey = Num.Round((S - hgt) / 2)
    outline(h, {
        Size = UDim2.new(0, S - 2, 0, hgt),
        Position = UDim2.new(0, 1, 0, ey),
        CornerRadius = UDim.new(0, Num.Round(hgt / 2)),
    }, 1.4)
    local p = math.max(3, Num.Round(hgt * 0.5))
    shape(h, {
        Size = UDim2.new(0, p, 0, p),
        Position = UDim2.new(0, Num.Round(S / 2 - p / 2), 0, Num.Round(S / 2 - p / 2)),
        CornerRadius = UDim2.new(1, 0),
    })
end)

Icon.Box = buildIcon(function(h, S)
    outline(h, {
        Size = UDim2.new(0, S - 2, 0, S - 2),
        Position = UDim2.new(0, 1, 0, 1),
        CornerRadius = UDim.new(0, 3),
    }, 1.4)
    shape(h, { Size = UDim2.new(0, 1.5, 0, S - 4), Position = UDim2.new(0, Num.Round(S * 0.55), 0, 2) })
    shape(h, { Size = UDim2.new(0, S - 4, 0, 1.5), Position = UDim2.new(0, 2, 0, Num.Round(S * 0.55)) })
end)

Icon.Move = buildIcon(function(h, S)
    local c = S / 2
    shape(h, { Size = UDim2.new(0, 3, 0, 3), Position = UDim2.new(0, c - 1.5, 0, 1), CornerRadius = UDim2.new(1, 0) })
    shape(h, { Size = UDim2.new(0, 3, 0, S - 6), Position = UDim2.new(0, c - 1.5, 0, 4), Rotation = 30 })
    shape(h, { Size = UDim2.new(0, S - 4, 0, 3), Position = UDim2.new(0, 2, 0, S - 4) })
end)

Icon.Mic = buildIcon(function(h, S)
    local c = S / 2
    outline(h, {
        Size = UDim2.new(0, 4, 0, 7),
        Position = UDim2.new(0, c - 2, 0, 2),
        CornerRadius = UDim.new(0, 2),
    }, 1.3)
