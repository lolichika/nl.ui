--// ═══════════════════════════════════════════════════════════════════════
--//  §193 · SAFE BOOT
--// ═══════════════════════════════════════════════════════════════════════

local SafeBoot = {
    startTime = tick(),
    booted = false,
    errors = {},
}

local function TryBoot(name, fn)
    local ok, err = pcall(fn)
    if not ok then
        table.insert(SafeBoot.errors, { name = name, err = tostring(err) })
        warn("[NL Boot] " .. name .. ": " .. tostring(err))
    end
    return ok
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §194 · ОБРАБОТКА КРИТИЧЕСКИХ ОШИБОК
--// ═══════════════════════════════════════════════════════════════════════

-- кастомный error handler
local OriginalError = error

local function SafeErrorHandler(err)
    table.insert(SafeBoot.errors, {
        name = "runtime",
        err = tostring(err),
        stack = debug and debug.traceback and debug.traceback() or nil,
    })

    if NL.DevTools and NL.DevTools.Console then
        pcall(function()
            NL.DevTools.Console:Error("Runtime: " .. tostring(err))
        end)
    end

    if NL.Settings.DebugMode then
        warn("[NL Runtime Error] " .. tostring(err))
    end
end

