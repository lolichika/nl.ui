--// ═══════════════════════════════════════════════════════════════════════
--//  §120 · LAYOUT MANAGER · ЯДРО
--// ═══════════════════════════════════════════════════════════════════════

local LayoutManager = {
    -- breakpoints по ширине
    breakpoints = {
        { name = "nano",   minWidth = 0,    maxWidth = 600,  columns = 1, sidebar = "collapsed" },
        { name = "small",  minWidth = 600,  maxWidth = 720,  columns = 1, sidebar = "compact" },
        { name = "medium", minWidth = 720,  maxWidth = 900,  columns = 2, sidebar = "full" },
        { name = "large",  minWidth = 900,  maxWidth = 1200, columns = 2, sidebar = "full" },
        { name = "huge",   minWidth = 1200, maxWidth = 9999, columns = 3, sidebar = "full" },
    },

    -- текущее состояние
    currentMode = "medium",
    lastWidth   = 0,
    lastHeight  = 0,
    listeners   = {},
}

-- определить режим по ширине
function LayoutManager:GetModeFor(width)
    for _, bp in ipairs(self.breakpoints) do
        if width >= bp.minWidth and width < bp.maxWidth then
            return bp
        end
    end
    return self.breakpoints[#self.breakpoints]
end

-- зарегистрировать listener
function LayoutManager:OnResize(fn)
    table.insert(self.listeners, fn)
    return function()
        for i, f in ipairs(self.listeners) do
            if f == fn then
                table.remove(self.listeners, i)
                return
            end
        end
    end
end

-- вызвать все listener'ы
function LayoutManager:_fire(width, height, mode)
    for _, fn in ipairs(self.listeners) do
        SafeCall(fn, width, height, mode)
    end
end

-- обновить при ресайзе
function LayoutManager:Update(width, height)
    if math.abs(width - self.lastWidth) < 5 and math.abs(height - self.lastHeight) < 5 then
        return
    end

    self.lastWidth = width
    self.lastHeight = height

    local mode = self:GetModeFor(width)
    local modeChanged = (self.currentMode ~= mode.name)
    self.currentMode = mode.name
    self.currentBp = mode

    self:_fire(width, height, mode)
end

NL.Layout = LayoutManager

--// ═══════════════════════════════════════════════════════════════════════
--//  §121 · ADAPTIVE COLUMNS · ПЕРЕСЧЁТ КОЛОНОК
--// ═══════════════════════════════════════════════════════════════════════

-- пересобрать колонки вкладки под новое число
local function ReflowTab(tab, targetColumns)
    if not tab or not tab._columns then return end
    if #tab._columns == targetColumns then return end

    -- если текущих больше — надо объединить
    if #tab._columns > targetColumns then
        -- оставляем первые targetColumns, остальные группы переносим
        for i = targetColumns + 1, #tab._columns do
            local col = tab._columns[i]
            -- переносим группы в первую колонку
            for _, group in ipairs(col.groups) do
                table.insert(tab._columns[1].groups, group)
                group._frame.Parent = tab._columns[1].frame
                group._frame.LayoutOrder = #tab._columns[1].groups
            end
            col.frame:Destroy()
        end

        -- обрезаем
        for i = #tab._columns, targetColumns + 1, -1 do
            table.remove(tab._columns, i)
        end

    else
        -- нужно добавить колонки
        for i = #tab._columns + 1, targetColumns do
            local colWidth = 1 / targetColumns
            local col = New("Frame", {
                Size = UDim2.new(colWidth, -(8 * (targetColumns - 1)) / targetColumns, 0, 0),
                BackgroundTransparency = 1,
                LayoutOrder = i,
                Parent = tab._content,
            })
            VLayout(col, 8)
            table.insert(tab._columns, { frame = col, groups = {} })
        end

        -- пересобрать ширину всех колонок
        for i, col in ipairs(tab._columns) do
            local colWidth = 1 / targetColumns
            col.frame.Size = UDim2.new(
                colWidth,
                -(8 * (targetColumns - 1)) / targetColumns,
                0,
                col.frame.Size.Y.Offset
            )
        end
    end

    -- перераспределить группы между колонками
    -- (простой алгоритм: round-robin по высоте)
    local allGroups = {}
    for _, col in ipairs(tab._columns) do
        for _, g in ipairs(col.groups) do
            table.insert(allGroups, g)
        end
        col.groups = {}
    end

    for _, group in ipairs(allGroups) do
        -- в самую короткую колонку
        local best, bestH = 1, math.huge
        for i, col in ipairs(tab._columns) do
            local h = 0
            for _, g in ipairs(col.groups) do
                h = h + (g._frame.Size.Y.Offset or 0) + 8
            end
            if h < bestH then best, bestH = i, h end
        end

        table.insert(tab._columns[best].groups, group)
        group._frame.Parent = tab._columns[best].frame
        group._frame.LayoutOrder = #tab._columns[best].groups
    end

    -- пересчитать высоту
    NL._recalcTab(tab)
end

NL._util.ReflowTab = ReflowTab

-- применить раскладку ко всем вкладкам
local function ApplyAdaptiveLayout(width)
    local mode = LayoutManager:GetModeFor(width)
    local win = NL._window
    if not win then return end

    for _, tab in ipairs(win._tabs) do
        ReflowTab(tab, mode.columns)
    end
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §122 · SIDEBAR COLLAPSE · СВОРАЧИВАНИЕ
--// ═══════════════════════════════════════════════════════════════════════

local SidebarControl = {
    collapsed = false,
    fullWidth = 210,
    compactWidth = 60,
    collapsedWidth = 0,
    mode = "full",         -- full | compact | collapsed | hidden
    _toggleBtn = nil,
    _contentConn = nil,
}

-- установить режим сайдбара
function SidebarControl:SetMode(mode)
    local win = NL._window
    if not win or not win._sidebar then return end

    local targetWidth = self.fullWidth
    if mode == "compact" then
        targetWidth = self.compactWidth
    elseif mode == "collapsed" or mode == "hidden" then
        targetWidth = self.collapsedWidth
    end

    self.mode = mode
    self.collapsed = (mode == "collapsed" or mode == "hidden")

    -- анимировать ширину
    Tween(win._sidebar, 0.3, {
        Size = UDim2.new(0, targetWidth, 1, 0),
    }, Enum.EasingStyle.Quint)

    -- анимировать контент
    Tween(win._contentArea, 0.3, {
        Position = UDim2.new(0, targetWidth, 0, 0),
        Size = UDim2.new(1, -targetWidth, 1, 0),
    }, Enum.EasingStyle.Quint)

    -- скрыть/показать элементы сайдбара
    task.delay(0.15, function()
        local hideDetails = (mode == "compact" or mode == "collapsed")

        -- название чита и версия
        if win._sidebar then
            for _, c in ipairs(win._sidebar:GetDescendants()) do
                if c:IsA("TextLabel") then
                    if c.Name == "CheatLabel" or c.Name == "VersionLabel" then
                        c.Visible = not hideDetails
                    end
                end
            end
        end

        -- текст вкладок
        for _, tab in ipairs(win._tabs) do
            if tab._label then
                tab._label.Visible = not hideDetails
            end
            if tab._icon then
                if mode == "compact" or mode == "full" then
                    tab._icon.Position = UDim2.new(0, mode == "compact" and 22 or 14, 0.5, -8)
                end
            end
        end

        -- секции
        for _, sec in ipairs(win._tabSections or {}) do
            if sec.frame then
                sec.frame.Visible = not hideDetails
            end
        end
    end)

    -- сохраняем режим
    NL.Settings.SidebarMode = mode
end

-- переключить
function SidebarControl:Toggle()
    if self.mode == "full" then
        self:SetMode("compact")
    elseif self.mode == "compact" then
        self:SetMode("collapsed")
    else
        self:SetMode("full")
    end
end

NL.Sidebar = SidebarControl

--// ═══════════════════════════════════════════════════════════════════════
--//  §123 · SIDEBAR HOVER REVEAL · ПОКАЗ ПРИ НАВЕДЕНИИ
--// ═══════════════════════════════════════════════════════════════════════

local HoverReveal = {
    enabled = false,
    revealWidth = 210,
    collapsedWidth = 12,
    _hoverZone = nil,
    _isRevealing = false,
    _hideTimer = nil,
}

-- включить авто-показ
function HoverReveal:Enable()
    local win = NL._window
    if not win or not win._sidebar then return end

    self.enabled = true
    self._isRevealing = false

    -- сначала сворачиваем
    Tween(win._sidebar, 0.3, {
        Size = UDim2.new(0, self.collapsedWidth, 1, 0),
    }, Enum.EasingStyle.Quint)

    Tween(win._contentArea, 0.3, {
        Position = UDim2.new(0, self.collapsedWidth, 0, 0),
        Size = UDim2.new(1, -self.collapsedWidth, 1, 0),
    }, Enum.EasingStyle.Quint)

    -- зона наведения слева
    local zone = New("Frame", {
        Position = UDim2.new(0, 0, 0, 0),
        Size = UDim2.new(0, 6, 1, 0),
        BackgroundTransparency = 1,
        ZIndex = 20,
        Parent = win._body,
    })
    self._hoverZone = zone

    -- наведение на зону → показать
    zone.MouseEnter:Connect(function()
        if self.enabled then self:Reveal() end
    end)

    -- наведение на сайдбар → сбросить таймер скрытия
    win._sidebar.MouseEnter:Connect(function()
        if self._hideTimer then
            task.cancel(self._hideTimer)
            self._hideTimer = nil
        end
    end)

    -- уход с сайдбара → скрыть через задержку
    win._sidebar.MouseLeave:Connect(function()
        if self.enabled and self._isRevealing then
            self._hideTimer = task.delay(0.5, function()
                self:Hide()
            end)
        end
    end)
end

function HoverReveal:Reveal()
    local win = NL._window
    if not win or self._isRevealing then return end
    self._isRevealing = true

    Tween(win._sidebar, 0.25, {
        Size = UDim2.new(0, self.revealWidth, 1, 0),
    }, Enum.EasingStyle.Quint)

    Tween(win._contentArea, 0.25, {
        Position = UDim2.new(0, self.revealWidth, 0, 0),
        Size = UDim2.new(1, -self.revealWidth, 1, 0),
    }, Enum.EasingStyle.Quint)

    -- показать элементы
    for _, tab in ipairs(win._tabs) do
        if tab._label then tab._label.Visible = true end
        if tab._icon then tab._icon.Position = UDim2.new(0, 14, 0.5, -8) end
    end
end

function HoverReveal:Hide()
    local win = NL._window
    if not win then return end
    self._isRevealing = false

    Tween(win._sidebar, 0.25, {
        Size = UDim2.new(0, self.collapsedWidth, 1, 0),
    }, Enum.EasingStyle.Quint)

    Tween(win._contentArea, 0.25, {
        Position = UDim2.new(0, self.collapsedWidth, 0, 0),
        Size = UDim2.new(1, -self.collapsedWidth, 1, 0),
    }, Enum.EasingStyle.Quint)

    for _, tab in ipairs(win._tabs) do
        if tab._label then tab._label.Visible = false end
        if tab._icon then tab._icon.Position = UDim2.new(0, 22, 0.5, -8) end
    end
end

function HoverReveal:Disable()
    self.enabled = false
    if self._hoverZone then
        self._hoverZone:Destroy()
        self._hoverZone = nil
    end
    SidebarControl:SetMode("full")
end

NL.HoverReveal = HoverReveal

--// ═══════════════════════════════════════════════════════════════════════
--//  §124 · WINDOW SNAP · ПРИЛИПАНИЕ К КРАЯМ
--// ═══════════════════════════════════════════════════════════════════════

local WindowSnap = {
    enabled = true,
    threshold = 20,        -- пикселей
    _active = false,
    _snapZones = {},
}

-- зоны снапа
function WindowSnap:Init()
    local win = NL._window
    if not win then return end

    self._snapZones = {
        { x = 0, y = 0, w = 0.5, h = 0.5, name = "top-left" },       -- ЛК
        { x = 0.5, y = 0, w = 0.5, h = 0.5, name = "top-right" },    -- ПК
        { x = 0, y = 0.5, w = 0.5, h = 0.5, name = "bottom-left" },  -- ЛН
        { x = 0.5, y = 0.5, w = 0.5, h = 0.5, name = "bottom-right" }, -- ПН
        { x = 0.25, y = 0.15, w = 0.5, h = 0.7, name = "center" },   -- Центр
    }
end

-- проверка на снап
function WindowSnap:Check(x, y, w, h)
    if not self.enabled then return nil end
    local vp = Cache.GetViewport()

    -- края экрана
    local leftDist = math.abs(x)
    local rightDist = math.abs(vp.X - (x + w))
    local topDist = math.abs(y)
    local bottomDist = math.abs(vp.Y - (y + h))

    local snappedX = x
    local snappedY = y
    local snapped = false

    if leftDist < self.threshold then snappedX = 0; snapped = true end
    if rightDist < self.threshold then snappedX = vp.X - w; snapped = true end
    if topDist < self.threshold then snappedY = 0; snapped = true end
    if bottomDist < self.threshold then snappedY = vp.Y - h; snapped = true end

    if snapped then
        return snappedX, snappedY
    end
    return nil
end

-- снап к центральной зоне (Windows-like)
function WindowSnap:ApplyCenterZone()
    local win = NL._window
    if not win then return end

    local vp = Cache.GetViewport()

    Tween(win._root, 0.3, {
        Position = UDim2.new(0.5, 0, 0.5, 0),
        AnchorPoint = Vector2.new(0.5, 0.5),
    }, Enum.EasingStyle.Quint)
end

function WindowSnap:Disable()
    self.enabled = false
end

function WindowSnap:Enable()
    self.enabled = true
end

NL.WindowSnap = WindowSnap

--// ═══════════════════════════════════════════════════════════════════════
--//  §125 · WINDOW DOCKING · ДОКИНГ К 8 ПОЗИЦИЯМ
--// ═══════════════════════════════════════════════════════════════════════

local Docking = {
    positions = {
        "top-left", "top-center", "top-right",
        "mid-left", "center", "mid-right",
        "bottom-left", "bottom-center", "bottom-right",
    },
    currentDock = nil,
}

-- докинг к позиции
function Docking:Apply(position)
    local win = NL._window
    if not win or not win._root then return end

    self.currentDock = position

    local vp = Cache.GetViewport()
    local w = win._root.AbsoluteSize.X
    local h = win._root.AbsoluteSize.Y
    local margin = 12

    local anchor = Vector2.new(0, 0)
    local pos = UDim2.new(0, 0, 0, 0)

    -- парсим позицию
    local vertical, horizontal = string.match(position, "^(%a+)-(%a+)$")

    -- горизонталь
    if horizontal == "left" then
        anchor = Vector2.new(0, anchor.Y)
        pos = UDim2.new(0, margin, pos.Y.Scale, pos.Y.Offset)
    elseif horizontal == "center" then
        anchor = Vector2.new(0.5, anchor.Y)
        pos = UDim2.new(0.5, 0, pos.Y.Scale, pos.Y.Offset)
    elseif horizontal == "right" then
        anchor = Vector2.new(1, anchor.Y)
        pos = UDim2.new(1, -margin, pos.Y.Scale, pos.Y.Offset)
    end

    -- вертикаль
    if vertical == "top" then
        anchor = Vector2.new(anchor.X, 0)
        pos = UDim2.new(pos.X.Scale, pos.X.Offset, 0, margin)
    elseif vertical == "mid" or vertical == "center" then
        anchor = Vector2.new(anchor.X, 0.5)
        pos = UDim2.new(pos.X.Scale, pos.X.Offset, 0.5, 0)
    elseif vertical == "bottom" then
        anchor = Vector2.new(anchor.X, 1)
        pos = UDim2.new(pos.X.Scale, pos.X.Offset, 1, -margin)
    end

    win._root.AnchorPoint = anchor

    Tween(win._root, 0.35, {
        Position = pos,
    }, Enum.EasingStyle.Quint)

    -- сохраняем
    NL.Settings.Docked = position
end

-- снять докинг
function Docking:Clear()
    local win = NL._window
    if not win or not win._root then return end
    self.currentDock = nil
    NL.Settings.Docked = nil
end

NL.Docking = Docking

--// ═══════════════════════════════════════════════════════════════════════
--//  §126 · WINDOW PRESETS · РАЗМЕРЫ S/M/L/XL
--// ═══════════════════════════════════════════════════════════════════════

local WindowPresets = {
    sizes = {
        S  = { w = 600, h = 400 },
        M  = { w = 780, h = 520 },
        L  = { w = 960, h = 640 },
        XL = { w = 1200, h = 800 },
    },
}

-- применить пресет размера
function WindowPresets:Apply(name)
    local win = NL._window
    if not win or not win._root then return end

    local preset = self.sizes[name]
    if not preset then return end

    -- не больше экрана
    local vp = Cache.GetViewport()
    local w = math.min(preset.w, vp.X - 40)
    local h = math.min(preset.h, vp.Y - 40)

    Tween(win._root, 0.35, {
        Size = UDim2.new(0, w, 0, h),
    }, Enum.EasingStyle.Quint)

    win._width = w
    win._height = h
    NL.Settings.WindowSize = name
end

NL.WindowPresets = WindowPresets

--// ═══════════════════════════════════════════════════════════════════════
--//  §127 · WINDOW ZOOM · МАСШТАБ
--// ═══════════════════════════════════════════════════════════════════════

local Zoom = {
    current = 1.0,
    min = 0.7,
    max = 1.5,
    step = 0.05,
}

-- установить масштаб
function Zoom:Set(scale)
    scale = math.clamp(scale, self.min, self.max)
    self.current = scale

    local win = NL._window
    if win and win._scale then
        Tween(win._scale, 0.15, { Scale = scale }, Enum.EasingStyle.Quint)
    end

    NL.Settings.UIScale = scale
end

-- увеличить
function Zoom:In()
    self:Set(self.current + self.step)
end

-- уменьшить
function Zoom:Out()
    self:Set(self.current - self.step)
end

-- сброс
function Zoom:Reset()
    self:Set(1.0)
end

-- привязать колесо мыши + Ctrl
function Zoom:BindWheel()
    Connect(UserInputService.InputChanged, function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseWheel then return end
        if not UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then return end
        -- только когда окно активно
        local win = NL._window
        if not win or win._hidden then return end

        if input.Position.Z > 0 then
            self:In()
        else
            self:Out()
        end
    end)
end

NL.Zoom = Zoom

--// ═══════════════════════════════════════════════════════════════════════
--//  §128 · WINDOW OPACITY · ПРОЗРАЧНОСТЬ
--// ═══════════════════════════════════════════════════════════════════════

local WindowOpacity = {
    current = 0,
    min = 0,
    max = 0.6,
}

function WindowOpacity:Set(value)
    value = math.clamp(value, self.min, self.max)
    self.current = value

    local win = NL._window
    if win and win._inner then
        Tween(win._inner, 0.2, { BackgroundTransparency = value })
    end

    NL.Settings.WindowOpacity = value
end

NL.WindowOpacity = WindowOpacity

--// ═══════════════════════════════════════════════════════════════════════
--//  §129 · FULLSCREEN MODE
--// ═══════════════════════════════════════════════════════════════════════

local FullscreenMode = {
    active = false,
    _savedSize = nil,
    _savedPos = nil,
}

function FullscreenMode:Toggle()
    local win = NL._window
    if not win or not win._root then return end

    if self.active then
        -- восстановить
        if self._savedSize then
            Tween(win._root, 0.3, {
                Size = self._savedSize,
                Position = self._savedPos,
                AnchorPoint = Vector2.new(0.5, 0.5),
            }, Enum.EasingStyle.Quint)
        end
        self.active = false
    else
        -- сохранить
        self._savedSize = win._root.Size
        self._savedPos = win._root.Position

        -- fullscreen
        local vp = Cache.GetViewport()
        Tween(win._root, 0.3, {
            Size = UDim2.new(0, vp.X - 20, 0, vp.Y - 20),
            Position = UDim2.new(0.5, 0, 0.5, 0),
            AnchorPoint = Vector2.new(0.5, 0.5),
        }, Enum.EasingStyle.Quint)
        self.active = true
    end
end

NL.Fullscreen = FullscreenMode

--// ═══════════════════════════════════════════════════════════════════════
--//  §130 · COMPACT MODE
--// ═══════════════════════════════════════════════════════════════════════

local CompactMode = {
    active = false,
    _savedSpacing = 8,
}

function CompactMode:Toggle()
    local win = NL._window
    if not win then return end

    self.active = not self.active

    -- пересчитать SPACING и padding
    if self.active then
        NL.Settings.CompactMode = true

        -- уменьшить отступы во всех группах
        for _, tab in ipairs(win._tabs) do
            for _, col in ipairs(tab._columns) do
                for _, group in ipairs(col.groups) do
                    if group._body then
                        local pad = group._body:FindFirstChildOfClass("UIPadding")
                        if pad then
                            pad.PaddingTop = UDim.new(0, 4)
                            pad.PaddingBottom = UDim.new(0, 4)
                            pad.PaddingLeft = UDim.new(0, 4)
                            pad.PaddingRight = UDim.new(0, 4)
                        end
                    end
                end
            end
        end
    else
        NL.Settings.CompactMode = false

        -- вернуть стандартные
        for _, tab in ipairs(win._tabs) do
            for _, col in ipairs(tab._columns) do
                for _, group in ipairs(col.groups) do
                    if group._body then
                        local pad = group._body:FindFirstChildOfClass("UIPadding")
                        if pad then
                            pad.PaddingTop = UDim.new(0, 8)
                            pad.PaddingBottom = UDim.new(0, 8)
                            pad.PaddingLeft = UDim.new(0, 8)
                            pad.PaddingRight = UDim.new(0, 8)
                        end
                    end
                end
            end
        end
    end

    -- пересчитать высоты
    for _, tab in ipairs(win._tabs) do
        NL._recalcTab(tab)
    end
end

NL.CompactMode = CompactMode

--// ═══════════════════════════════════════════════════════════════════════
--//  §131 · LAYOUT PRESETS · СОХРАНЕНИЕ РАСКЛАДОК
--// ═══════════════════════════════════════════════════════════════════════

local LayoutPresets = {
    presets = {},
}

-- сохранить текущую раскладку
function LayoutPresets:Capture(name)
    local win = NL._window
    if not win then return end

    self.presets[name] = {
        windowSize = win._root.AbsoluteSize,
        sidebarMode = SidebarControl.mode,
        zoom = Zoom.current,
        opacity = WindowOpacity.current,
        docked = Docking.currentDock,
        compact = CompactMode.active,
    }

    NL:Notify("Layout", "Пресет «" .. name .. "» сохранён", 2, "success")
end

-- применить раскладку
function LayoutPresets:Apply(name)
    local preset = self.presets[name]
    if not preset then
        NL:Notify("Layout", "Пресет не найден", 2, "error")
        return
    end

    local win = NL._window
    if not win then return end

    -- размер
    if preset.windowSize then
        Tween(win._root, 0.3, {
            Size = UDim2.new(0, preset.windowSize.X, 0, preset.windowSize.Y),
        }, Enum.EasingStyle.Quint)
    end

    -- сайдбар
    if preset.sidebarMode then
        SidebarControl:SetMode(preset.sidebarMode)
    end

    -- zoom
    if preset.zoom then
        Zoom:Set(preset.zoom)
    end

    -- opacity
    if preset.opacity then
        WindowOpacity:Set(preset.opacity)
    end

    -- докинг
    if preset.docked then
        Docking:Apply(preset.docked)
    end

    NL:Notify("Layout", "Пресет «" .. name .. "» применён", 2, "success")
end

-- удалить
function LayoutPresets:Delete(name)
    self.presets[name] = nil
end

-- список
function LayoutPresets:List()
    local list = {}
    for name in pairs(self.presets) do
        table.insert(list, name)
    end
    table.sort(list)
    return list
end

NL.LayoutPresets = LayoutPresets

--// ═══════════════════════════════════════════════════════════════════════
--//  §132 · ELEMENT VISIBILITY · СКРЫТИЕ ПО УСЛОВИЮ
--// ═══════════════════════════════════════════════════════════════════════

-- скрыть элемент
function NL:HideElement(el)
    if not el or not el._frame then return end
    el._frame.Visible = false
    el._hidden = true
end

-- показать
function NL:ShowElement(el)
    if not el or not el._frame then return end
    el._frame.Visible = true
    el._hidden = false
end

-- условное скрытие
function NL:BindVisibility(el, conditionFn)
    if not el or not el._frame or type(conditionFn) ~= "function" then return end

    task.spawn(function()
        while el._frame.Parent do
            local visible = conditionFn()
            if el._frame.Visible ~= visible then
                el._frame.Visible = visible
            end
            task.wait(0.1)
        end
    end)
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §133 · GROUP COLLAPSE ALL
--// ═══════════════════════════════════════════════════════════════════════

-- свернуть/развернуть все группы вкладки
function NL:SetAllGroups(tab, open)
    if not tab or not tab._columns then return end

    for _, col in ipairs(tab._columns) do
        for _, group in ipairs(col.groups) do
            group._open = open
            local h = open and group._height or 0

            Tween(group._body, 0.16, { Size = UDim2.new(1, 0, 0, h) })
            Tween(group._frame, 0.16, {
                Size = UDim2.new(1, 0, 0, Theme.GroupHeaderHeight + h),
            })
            Tween(group._arrow, 0.16, { Rotation = open and 0 or -90 })
        end
    end

    task.delay(0.18, function()
        NL._recalcTab(tab)
    end)
end

function NL:CollapseAllGroups(tab)
    self:SetAllGroups(tab, false)
end

function NL:ExpandAllGroups(tab)
    self:SetAllGroups(tab, true)
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §134 · TAB REORDER · ПЕРЕТАСКИВАНИЕ ВКЛАДОК
--// ═══════════════════════════════════════════════════════════════════════

-- (упрощённая версия — перетаскивание через drag с обменом порядком)
-- Реализуется через длинное нажатие + drag

local TabReorder = {
    enabled = false,
    _dragging = nil,
    _startY = 0,
}

-- включает режим перетаскивания (для больших списков)
function TabReorder:Enable()
    if self.enabled then return end
    self.enabled = true

    local win = NL._window
    if not win then return end

    for i, tab in ipairs(win._tabs) do
        tab._button.InputBegan:Connect(function(input)
            if input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end

            local startTime = tick()
            local startPos = input.Position

            local moveConn, endConn
            moveConn = UserInputService.InputChanged:Connect(function(moveInput)
                if moveInput.UserInputType ~= Enum.UserInputType.MouseMovement then return end
                local now = tick()
                local dist = (moveInput.Position - startPos).Magnitude

                -- длинное нажатие + движение
                if now - startTime > 0.5 and dist > 10 and not TabReorder._dragging then
                    TabReorder._dragging = tab
                    tab._button.BackgroundTransparency = 0.4
                end

                if TabReorder._dragging == tab then
                    -- визуальный сдвиг
                    tab._button.Position = UDim2.new(0, 0, 0, moveInput.Position.Y - startPos.Y)
                end
            end)

            endConn = UserInputService.InputEnded:Connect(function(endInput)
                if endInput.UserInputType ~= Enum.UserInputType.MouseButton1 then return end

                if moveConn then moveConn:Disconnect() end
                if endConn then endConn:Disconnect() end

                if TabReorder._dragging == tab then
                    TabReorder._dragging = nil
                    tab._button.BackgroundTransparency = 0
                    tab._button.Position = UDim2.new(0, 0, 0, 0)
                end
            end)
        end)
    end
end

NL.TabReorder = TabReorder

--// ═══════════════════════════════════════════════════════════════════════
--//  §135 · SCROLL SMOOTH · ИНЕРЦИОННЫЙ СКРОЛЛ
--// ═══════════════════════════════════════════════════════════════════════

-- добавить плавный скролл (сглаживание)
local function SmoothScroll(scrollFrame, factor)
    if not scrollFrame then return end
    factor = factor or 0.15

    local targetY = 0
    local currentY = 0
    local animating = false

    local function animate()
        if animating then return end
        animating = true

        local conn
        conn = RunService.RenderStepped:Connect(function()
            currentY = currentY + (targetY - currentY) * factor
            scrollFrame.CanvasPosition = Vector2.new(scrollFrame.CanvasPosition.X, currentY)

            if math.abs(targetY - currentY) < 0.5 then
                currentY = targetY
                scrollFrame.CanvasPosition = Vector2.new(scrollFrame.CanvasPosition.X, currentY)
                if conn then conn:Disconnect() end
                animating = false
            end
        end)
    end

    scrollFrame:GetPropertyChangedSignal("CanvasPosition"):Connect(function()
        if not animating then
            targetY = scrollFrame.CanvasPosition.Y
            currentY = targetY
        end
    end)
end

NL._util.SmoothScroll = SmoothScroll

--// ═══════════════════════════════════════════════════════════════════════
--//  §136 · DRAG GHOST · ПРИЗРАК ПРИ ПЕРЕТАСКИВАНИИ
--// ═══════════════════════════════════════════════════════════════════════

local DragGhost = {
    _ghost = nil,
}

-- показать ghost
function DragGhost:Show(text)
    local win = NL._window
    if not win then return end

    self:Hide()

    local ghost = New("Frame", {
        Size = UDim2.new(0, 200, 0, 40),
        BackgroundColor3 = NL.Theme.Popout,
        BackgroundTransparency = 0.2,
        BorderSizePixel = 0,
        ZIndex = 900,
        Parent = win._screen,
    })
    Round(ghost, 8)
    Stroke(ghost, NL.Theme.Accent, 1.5)

    New("TextLabel", {
        Text = text or "",
        Font = NL.Theme.Font,
        TextSize = 12,
        TextColor3 = NL.Theme.Text,
        Size = UDim2.new(1, -20, 1, 0),
        Position = UDim2.new(0, 10, 0, 0),
        TextXAlignment = Enum.TextXAlignment.Left,
        BackgroundTransparency = 1,
        Parent = ghost,
    })

    -- следование за мышью
    ghost.Name = "DragGhost"

    local conn = UserInputService.InputChanged:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseMovement then return end
        ghost.Position = UDim2.new(0, input.Position.X + 10, 0, input.Position.Y + 10)
    end)

    ghost.Destroying:Connect(function()
        if conn then conn:Disconnect() end
    end)

    self._ghost = ghost
end

function DragGhost:Hide()
    if self._ghost and self._ghost.Parent then
        self._ghost:Destroy()
    end
    self._ghost = nil
end

NL.DragGhost = DragGhost

--// ═══════════════════════════════════════════════════════════════════════
--//  §137 · RESIZE HANDLES · 8 МАРКЕРОВ
--// ═══════════════════════════════════════════════════════════════════════

local ResizeHandles = {}

-- создать 8 маркеров ресайза
function ResizeHandles.Create(root, opts)
    opts = opts or {}
    local minW = opts.MinWidth or 400
    local minH = opts.MinHeight or 300
    local maxW = opts.MaxWidth or 2000
    local maxH = opts.MaxHeight or 1400

    -- удалить старые
    for _, c in ipairs(root:GetChildren()) do
        if c.Name:sub(1, 13) == "NL_ResizeHand" then
            c:Destroy()
        end
    end

    local handles = {}

    -- определить 8 позиций: t=top, b=bottom, l=left, r=right
    local positions = {
        { name = "tl", x = 0, y = 0, ax = 0, ay = 0 },
        { name = "t",  x = 0.5, y = 0, ax = 0.5, ay = 0 },
        { name = "tr", x = 1, y = 0, ax = 1, ay = 0 },
        { name = "l",  x = 0, y = 0.5, ax = 0, ay = 0.5 },
        { name = "r",  x = 1, y = 0.5, ax = 1, ay = 0.5 },
        { name = "bl", x = 0, y = 1, ax = 0, ay = 1 },
        { name = "b",  x = 0.5, y = 1, ax = 0.5, ay = 1 },
        { name = "br", x = 1, y = 1, ax = 1, ay = 1 },
    }

    for _, pos in ipairs(positions) do
        local h = New("Frame", {
            Name = "NL_ResizeHand_" .. pos.name,
            AnchorPoint = Vector2.new(pos.ax, pos.ay),
            Position = UDim2.new(pos.x, 0, pos.y, 0),
            Size = UDim2.new(0, 8, 0, 8),
            BackgroundTransparency = 1,
            ZIndex = 20,
            Parent = root,
        })

        -- растянуть по краям
        if pos.name == "t" then h.Size = UDim2.new(1, -16, 0, 6) end
        if pos.name == "b" then h.Size = UDim2.new(1, -16, 0, 6) end
        if pos.name == "l" then h.Size = UDim2.new(0, 6, 1, -16) end
        if pos.name == "r" then h.Size = UDim2.new(0, 6, 1, -16) end

        -- курсор
        local cursor = "rbxasset://textures/WhiteDot.png"
        if pos.name == "t" or pos.name == "b" then
            cursor = "rbxasset://textures/Cursors/CrossCursor.png"
        elseif pos.name == "l" or pos.name == "r" then
            cursor = "rbxasset://textures/Cursors/CrossCursor.png"
        end

        -- drag-логика
        local dragging = false
        local startPos, startSize, startRootPos

        h.InputBegan:Connect(function(input)
            if input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
            dragging = true
            startPos = input.Position
            startSize = root.AbsoluteSize
            startRootPos = Vector2.new(root.AbsolutePosition.X, root.AbsolutePosition.Y)
        end)

        Connect(UserInputService.InputChanged, function(input)
            if not dragging then return end
            if input.UserInputType ~= Enum.UserInputType.MouseMovement then return end

            local delta = input.Position - startPos
            local newW = startSize.X
            local newH = startSize.Y
            local newX = startRootPos.X
            local newY = startRootPos.Y

            if pos.name:find("r") then
                newW = startSize.X + delta.X
            end
            if pos.name:find("l") then
                newW = startSize.X - delta.X
                newX = startRootPos.X + delta.X
            end
            if pos.name:find("b") then
                newH = startSize.Y + delta.Y
            end
            if pos.name:find("t") then
                newH = startSize.Y - delta.Y
                newY = startRootPos.Y + delta.Y
            end

            newW = math.clamp(newW, minW, maxW)
            newH = math.clamp(newH, minH, maxH)

            -- применить
            root.AnchorPoint = Vector2.new(0, 0)
            root.Position = UDim2.new(0, newX, 0, newY)
            root.Size = UDim2.new(0, newW, 0, newH)
        end)

        h.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = false
            end
        end)

        table.insert(handles, h)
    end

    return handles
end

NL.ResizeHandles = ResizeHandles

--// ═══════════════════════════════════════════════════════════════════════
--//  §138 · AUTO-HIDE UI
--// ═══════════════════════════════════════════════════════════════════════

local AutoHide = {
    enabled = false,
    delay = 8,
    _lastActivity = tick(),
    _hidden = false,
}

-- следить за активностью
function AutoHide:Enable()
    self.enabled = true
    self._lastActivity = tick()

    Connect(UserInputService.InputBegan, function()
        self._lastActivity = tick()
        if self._hidden then
            self:Reveal()
        end
    end)

    Connect(UserInputService.InputChanged, function()
        self._lastActivity = tick()
        if self._hidden then
            self:Reveal()
        end
    end)

    task.spawn(function()
        while self.enabled do
            task.wait(0.5)
            if tick() - self._lastActivity > self.delay and not self._hidden then
                -- скрыть
                if NL._window and not NL._window._hidden then
                    self:Hide()
                end
            end
        end
    end)
end

function AutoHide:Hide()
    local win = NL._window
    if not win then return end
    self._hidden = true
    Tween(win._inner, 0.5, { BackgroundTransparency = 0.85 })
    Tween(win._root, 0.5, { BackgroundTransparency = 0.5 })
end

function AutoHide:Reveal()
    local win = NL._window
    if not win then return end
    self._hidden = false
    Tween(win._inner, 0.3, {
        BackgroundTransparency = NL.Settings.WindowOpacity or 0,
    })
    Tween(win._root, 0.3, { BackgroundTransparency = 0 })
end

function AutoHide:Disable()
    self.enabled = false
    self:Reveal()
end

NL.AutoHide = AutoHide

--// ═══════════════════════════════════════════════════════════════════════
--//  §139 · PERFORMANCE · LOD И ТРОТТЛИНГ
--// ═══════════════════════════════════════════════════════════════════════

local Performance = {
    fps = 60,
    fpsHistory = {},
    _lastFrame = 0,
    lowMode = false,
    lowModeThreshold = 30,
}

-- отслеживание FPS
task.spawn(function()
    local frames = 0
    local lastTime = os.clock()

    while true do
        RunService.RenderStepped:Wait()
        frames = frames + 1

        local now = os.clock()
        if now - lastTime >= 1 then
            Performance.fps = frames
            frames = 0
            lastTime = now

            -- трекинг истории
            table.insert(Performance.fpsHistory, Performance.fps)
            while #Performance.fpsHistory > 10 do
                table.remove(Performance.fpsHistory, 1)
            end

            -- автовключение low mode при низком FPS
            if not Performance.lowMode and Performance.fps < Performance.lowModeThreshold then
                Performance.lowMode = true
                Performance:ApplyLowMode()
            elseif Performance.lowMode and Performance.fps > Performance.lowModeThreshold + 10 then
                Performance.lowMode = false
                Performance:RestoreNormalMode()
            end
        end
    end
end)

-- включить low mode
function Performance:ApplyLowMode()
    NL.Settings.ReducedMotion = true
    NL.Settings.Animations = false
    NL:Notify("Performance", "Low mode включён (FPS: " .. self.fps .. ")", 3, "warning")
end

-- восстановить
function Performance:RestoreNormalMode()
    NL.Settings.ReducedMotion = false
    NL.Settings.Animations = true
    NL:Notify("Performance", "Normal mode восстановлен", 2, "info")
end

-- средний FPS
function Performance:AvgFPS()
    if #self.fpsHistory == 0 then return self.fps end
    local sum = 0
    for _, v in ipairs(self.fpsHistory) do
        sum = sum + v
    end
    return math.floor(sum / #self.fpsHistory)
end

NL.Performance = Performance

