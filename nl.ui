        Parent = SidebarFrame,
    })

    -- ─── СКРОЛЛ ВКЛАДОК ──────────────────────────────────────────
    local TabScroll = New("ScrollingFrame", {
        Name = "TabScroll",
        Position = UDim2.new(0, 0, 0, 56),
        Size = UDim2.new(1, 0, 1, -56),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 2,
        ScrollBarImageColor3 = Theme.Accent,
        ScrollBarImageTransparency = 0.6,
        ScrollingDirection = Enum.ScrollingDirection.Y,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        ZIndex = 1,
        Parent = SidebarFrame,
    })
    refs.TabScroll = TabScroll

    -- контейнер вкладок
    local TabHolder = New("Frame", {
        Size = UDim2.new(1, -4, 0, 0),
        BackgroundTransparency = 1,
        Parent = TabScroll,
    })
    VLayout(TabHolder, 2)
    Padding(TabHolder, 0, 2, 12, 4)
    refs.TabHolder = TabHolder

    return refs
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §25 · CONTENT AREA · РАБОЧАЯ ЗОНА
--// ═══════════════════════════════════════════════════════════════════════

local ContentAreaBuilder = {}

function ContentAreaBuilder.Build(Window)
    local Body = Window._body

    local ContentArea = New("Frame", {
        Name = "ContentArea",
        Position = UDim2.new(0, NL.Settings.SidebarWidth, 0, 0),
        Size = UDim2.new(1, -NL.Settings.SidebarWidth, 1, 0),
        BackgroundColor3 = Theme.Content,
        BorderSizePixel = 0,
        Parent = Body,
    })
    Round(ContentArea, Theme.RadiusWindow)

    -- маска слева (убрать скругление)
    New("Frame", {
        Position = UDim2.new(0, 0, 0, 0),
        Size = UDim2.new(0, 8, 1, 0),
        BackgroundColor3 = Theme.Content,
        BorderSizePixel = 0,
        ZIndex = 5,
        Parent = ContentArea,
    })

    return ContentArea
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §26 · WINDOW HEADER · контрольные кнопки
--// ═══════════════════════════════════════════════════════════════════════

local WindowControls = {}

function WindowControls.Build(Header, Window)
    local refs = {}

    local function HeaderButton(iconName, xOffset, hoverColor)
        local btn = New("TextButton", {
            Text = "",
            BackgroundTransparency = 1,
            AutoButtonColor = false,
            AnchorPoint = Vector2.new(1, 0.5),
            Position = UDim2.new(1, xOffset, 0.5, 0),
            Size = UDim2.new(0, 28, 0, 28),
            ZIndex = 4,
            Parent = Header,
        })
        local ic = Icon.new(iconName, btn, 14, Theme.TextSub)
        ic.Position = UDim2.new(0.5, -7, 0.5, -7)

        btn.MouseEnter:Connect(function()
            Icon.TweenTint(ic, hoverColor or Theme.Text, 0.1)
        end)
        btn.MouseLeave:Connect(function()
            Icon.TweenTint(ic, Theme.TextSub, 0.1)
        end)
        return btn, ic
    end

    refs.Minimize = HeaderButton("Minimize", -40, Theme.Text)
    refs.Close    = HeaderButton("Close",    -10, Theme.Red)

    return refs
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §27 · WINDOW API · ГЛАВНЫЙ КОНСТРУКТОР
--// ═══════════════════════════════════════════════════════════════════════

function NL:CreateWindow(cfg)
    cfg = cfg or {}

    -- читаем параметры
    local width  = cfg.Width  or NL.Settings.WindowDefaultWidth
    local height = cfg.Height or NL.Settings.WindowDefaultHeight
    local title  = cfg.Title  or NL.Settings.WMCheatName or "neverlose"

    -- защита от повторного создания
    if NL._window and NL._window._screen then
        pcall(function() NL._window._screen:Destroy() end)
    end

    -- ─── ScreenGui ───────────────────────────────────────────────
    local ScreenGui = New("ScreenGui", {
        Name = "NeverloseUI",
        ResetOnSpawn = false,
        IgnoreGuiInset = true,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        DisplayOrder = 999,
    })

    if NL.Environment.HasProtectGUI then
        pcall(function() syn.protect_gui(ScreenGui) end)
    end

    -- вставляем в root
    local ok = pcall(function()
        local root = (gethui and gethui()) or CoreGui
        ScreenGui.Parent = root
    end)
    if not ok or not ScreenGui.Parent then
        if LocalPlayer then
            local pg = LocalPlayer:FindFirstChild("PlayerGui")
            if pg then ScreenGui.Parent = pg end
        end
    end

    -- ─── Root Frame ──────────────────────────────────────────────
    local Root = New("Frame", {
        Name = "Window",
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.5, 0, 0.5, 0),
        Size = UDim2.new(0, width, 0, height),
        BackgroundColor3 = Theme.StrokeLight,   -- 1px рамка через подложку
        BorderSizePixel = 0,
        Parent = ScreenGui,
    })
    Round(Root, Theme.RadiusWindow)

    -- мягкая внешняя тень
    if NL.Settings.EnableShadow then
        New("UIStroke", {
            Color = Color3.new(0, 0, 0),
            Thickness = 6,
            Transparency = 0.85,
            Parent = Root,
        })
    end

    -- ─── Inner Frame ─────────────────────────────────────────────
    local Inner = New("Frame", {
        Name = "Inner",
        Position = UDim2.new(0, 1, 0, 1),
        Size = UDim2.new(1, -2, 1, -2),
        BackgroundColor3 = Theme.Window,
        BorderSizePixel = 0,
        Parent = Root,
    })
    Round(Inner, Theme.RadiusWindow - 2)

    -- ─── Scale (для анимаций) ────────────────────────────────────
    local Scale = New("UIScale", { Scale = 1, Parent = Root })

    -- ─── Появление ───────────────────────────────────────────────
    if NL.Settings.Animations then
        Scale.Scale = 0.9
        Inner.BackgroundTransparency = 0.35
        Root.BackgroundTransparency = 0.35
        Tween(Scale, Theme.AnimSlow, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
        Tween(Inner, Theme.AnimSlow, { BackgroundTransparency = 0 })
        Tween(Root, Theme.AnimSlow, { BackgroundTransparency = 0 })
    end

    -- ─── Header ──────────────────────────────────────────────────
    local Header = New("Frame", {
        Name = "Header",
        Size = UDim2.new(1, 0, 0, Theme.HeaderHeight),
        BackgroundColor3 = Theme.Header,
        BorderSizePixel = 0,
        Parent = Inner,
    })
    Round(Header, Theme.RadiusWindow - 2)

    -- маска для шапки (убирает скругление снизу)
    New("Frame", {
        Position = UDim2.new(0, 0, 1, -8),
        Size = UDim2.new(1, 0, 0, 8),
        BackgroundColor3 = Theme.Header,
        BorderSizePixel = 0,
        ZIndex = 1,
        Parent = Header,
    })

    -- разделитель
    New("Frame", {
        Position = UDim2.new(0, 0, 1, -1),
        Size = UDim2.new(1, 0, 0, 1),
        BackgroundColor3 = Theme.Stroke,
        BorderSizePixel = 0,
        ZIndex = 2,
        Parent = Header,
    })

    -- ─── Body ────────────────────────────────────────────────────
    local Body = New("Frame", {
        Name = "Body",
        Position = UDim2.new(0, 0, 0, Theme.HeaderHeight),
        Size = UDim2.new(1, 0, 1, -Theme.HeaderHeight),
        BackgroundTransparency = 1,
        Parent = Inner,
    })

    -- ─── Объект окна ─────────────────────────────────────────────
    local Window = setmetatable({
        _screen      = ScreenGui,
        _root        = Root,
        _inner       = Inner,
        _scale       = Scale,
        _header      = Header,
        _body        = Body,
        _width       = width,
        _height      = height,
        _tabs        = {},
        _tabSections = {},
        _activeTab   = nil,
        _minimized   = false,
        _hidden      = false,
        _destroyed   = false,
    }, WindowMT)
    NL._window = Window

    -- ─── Сборка компонентов ──────────────────────────────────────
    Window._topBar = TopBar.Build(Header, Window, title)

    local sideRefs = Sidebar.Build(Window)
    Window._sidebar    = sideRefs.Frame
    Window._tabScroll  = sideRefs.TabScroll
    Window._tabHolder  = sideRefs.TabHolder

    Window._contentArea = ContentAreaBuilder.Build(Window)

    local ctrlRefs = WindowControls.Build(Header, Window)
    Window._minimizeBtn = ctrlRefs.Minimize
    Window._closeBtn    = ctrlRefs.Close

    -- ─── Drag окна ───────────────────────────────────────────────
    if NL.Settings.WindowDraggable then
        Window._dragHandle = MakeDraggable(Header, Root, {
            Clamp = NL.Settings.WindowClampToScreen,
            KeepX = 120,
            KeepY = 60,
            Inertia = false,
        })
    end

    -- ─── Resize окна ─────────────────────────────────────────────
    if NL.Settings.WindowResizable then
        local resizeHandle = New("Frame", {
            AnchorPoint = Vector2.new(1, 1),
            Position = UDim2.new(1, -2, 1, -2),
            Size = UDim2.new(0, 16, 0, 16),
            BackgroundColor3 = Theme.Accent,
            BackgroundTransparency = 0.9,
            BorderSizePixel = 0,
            ZIndex = 10,
            Parent = Root,
        })
        Round(resizeHandle, 3)

        Window._resizeHandle = MakeResizable(resizeHandle, Root, {
            MinWidth  = NL.Settings.WindowMinWidth,
            MinHeight = NL.Settings.WindowMinHeight,
            MaxWidth  = 1920,
            MaxHeight = 1080,
            OnResizeEnd = function(w, h)
                Window._width = w
                Window._height = h
            end,
        })
    end

    -- ─── Кнопки ──────────────────────────────────────────────────
    Window._minimizeBtn.MouseButton1Click:Connect(function()
        PlaySound()
        Window:ToggleMinimize()
    end)

    Window._closeBtn.MouseButton1Click:Connect(function()
        PlaySound(NL.Settings.SoundClose, NL.Settings.SoundVolume)
        NL:Destroy()
    end)

    -- ─── Горячая клавиша ─────────────────────────────────────────
    local menuKey = cfg.MenuKey or NL.Settings.MenuKey
    if menuKey then
        Connect(UserInputService.InputBegan, function(input, processed)
            if processed then return end
            if input.KeyCode == menuKey then
                NL:Toggle()
            end
        end)
    end

    return Window
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §28 · WINDOW METHODS · minimize, restore, toggle, destroy
--// ═══════════════════════════════════════════════════════════════════════

function WindowMethods:ToggleMinimize()
    self._minimized = not self._minimized

    if self._minimized then
        self._body.Visible = false
        Tween(self._root, Theme.AnimSlow, {
            Size = UDim2.new(0, self._width, 0, Theme.HeaderHeight + 2),
        }, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
    else
        self._body.Visible = true
        Tween(self._root, Theme.AnimSlow, {
            Size = UDim2.new(0, self._width, 0, self._height),
        }, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
    end
end

function WindowMethods:Hide()
    if self._hidden then return end
    self._hidden = true

    if NL.Settings.Animations then
        Tween(self._scale, 0.14, { Scale = 0.94 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
        task.delay(0.15, function()
            if self._hidden and self._root then
                self._root.Visible = false
            end
        end)
    else
        self._root.Visible = false
    end
end

function WindowMethods:Show()
    if not self._hidden then return end
    self._hidden = false
    self._root.Visible = true

    if NL.Settings.Animations then
        self._scale.Scale = 0.92
        Tween(self._scale, Theme.AnimNormal, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
    else
        self._scale.Scale = 1
    end
end

function WindowMethods:Toggle()
    if self._hidden then
        self:Show()
    else
        self:Hide()
    end
end

function WindowMethods:SetTitle(txt)
    if self._topBar and self._topBar.TitleLabel then
        self._topBar.TitleLabel.Text = tostring(txt or "")
    end
end

function WindowMethods:GetSize()
    return self._root.AbsoluteSize
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §29 · TAB METHODS · создание, выбор, переключение
--// ═══════════════════════════════════════════════════════════════════════

-- создать секцию (заголовок группы вкладок в сайдбаре)
function WindowMethods:CreateSection(name)
    local section = New("Frame", {
        Name = "Section_" .. name,
        Size = UDim2.new(1, 0, 0, Theme.TabSectionHeight),
        BackgroundTransparency = 1,
        LayoutOrder = #self._tabSections * 10000 + 1,
        Parent = self._tabHolder,
    })

    New("TextLabel", {
        Text = string.upper(name),
        Font = Theme.FontBold,
        TextSize = 9,
        TextColor3 = Theme.TextDim,
        TextXAlignment = Enum.TextXAlignment.Left,
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, 12, 0.5, 0),
        Size = UDim2.new(1, -20, 0, 12),
        BackgroundTransparency = 1,
        Parent = section,
    })

    table.insert(self._tabSections, { name = name, frame = section })
    return section
end

-- выбрать вкладку
function WindowMethods:SelectTab(tab)
    if not tab or self._activeTab == tab then return end
    self._activeTab = tab

    -- закрываем все попапы
    if NL._activeDropdown then
        pcall(NL._activeDropdown.Close)
        NL._activeDropdown = nil
    end

    for i, t in ipairs(self._tabs) do
        local active = (t == tab)
        t._scroll.Visible = active

        if active then
            Icon.TweenTint(t._icon, Theme.Accent, Theme.AnimNormal)
            Tween(t._label, Theme.AnimNormal, { TextColor3 = Theme.Text })
            Tween(t._button, Theme.AnimNormal, { BackgroundColor3 = Theme.Element })
            t._indicator.BackgroundTransparency = 1
            Tween(t._indicator, Theme.AnimNormal, { BackgroundTransparency = 0 })
        else
            Icon.TweenTint(t._icon, Theme.TextSub, Theme.AnimNormal)
            Tween(t._label, Theme.AnimNormal, { TextColor3 = Theme.TextSub })
            Tween(t._button, Theme.AnimNormal, { BackgroundColor3 = Theme.Sidebar })
            Tween(t._indicator, Theme.AnimNormal, { BackgroundTransparency = 1 })
        end
    end

    -- легкая анимация контента
    if NL.Settings.Animations then
        tab._content.Position = UDim2.new(0, 0, 0, 6)
        Tween(tab._content, Theme.AnimNormal, {
            Position = UDim2.new(0, 0, 0, 0),
        }, Enum.EasingStyle.Quint)
    end
end

-- создать вкладку
function WindowMethods:CreateTab(name, tabCfg)
    tabCfg = tabCfg or {}
    local columns = math.clamp(tabCfg.Columns or 2, 1, 4)
    local iconName = ResolveTabIcon(name, tabCfg.Icon)

    -- кнопка вкладки
    local btn = New("TextButton", {
        Name = name,
        Text = "",
        BackgroundColor3 = Theme.Sidebar,
        AutoButtonColor = false,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, Theme.TabHeight),
        LayoutOrder = #self._tabs + 1,
        Parent = self._tabHolder,
    })
    Round(btn, 6)

    -- индикатор активной вкладки (полоска слева)
    local indicator = New("Frame", {
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, 0, 0.5, 0),
        Size = UDim2.new(0, 3, 0, 16),
        BackgroundColor3 = Theme.Accent,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ZIndex = 3,
        Parent = btn,
    })
    Round(indicator, 2)

    -- иконка
    local icon = Icon.new(iconName, btn, 16, Theme.TextSub)
    icon.Position = UDim2.new(0, 14, 0.5, -8)
    icon.ZIndex = 2

    -- текст
    local label = New("TextLabel", {
        Text = name,
        Font = Theme.Font,
        TextSize = 12,
        TextColor3 = Theme.TextSub,
        TextXAlignment = Enum.TextXAlignment.Left,
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, 40, 0.5, 0),
        Size = UDim2.new(1, -46, 0, 14),
        BackgroundTransparency = 1,
        ZIndex = 2,
        Parent = btn,
    })

    -- скролл контента
    local scroll = New("ScrollingFrame", {
        Name = "Content_" .. name,
        Position = UDim2.new(0, CONTENT_PAD, 0, CONTENT_PAD),
        Size = UDim2.new(1, -CONTENT_PAD * 2, 1, -CONTENT_PAD * 2),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = Theme.ScrollBarSize,
        ScrollBarImageColor3 = Theme.Accent,
        ScrollBarImageTransparency = 0.3,
        ScrollingDirection = Enum.ScrollingDirection.Y,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        Visible = false,
        Parent = self._contentArea,
    })

    -- контейнер с колонками
    local content = New("Frame", {
        Size = UDim2.new(1, -6, 0, 0),
        BackgroundTransparency = 1,
        Parent = scroll,
    })
    HLayout(content, SPACING)

    -- объект вкладки
    local tab = setmetatable({
        Name     = name,
        _window  = self,
        _button  = btn,
        _icon    = icon,
        _label   = label,
        _scroll  = scroll,
        _content = content,
        _columns = {},
        _indicator = indicator,
    }, TabMT)

    -- колонки
    for i = 1, columns do
        local colWidth = (1 / columns)
        local col = New("Frame", {
            Size = UDim2.new(
                colWidth,
                -(SPACING * (columns - 1)) / columns,
                0,
                0
            ),
            BackgroundTransparency = 1,
            LayoutOrder = i,
            Parent = content,
        })
        VLayout(col, SPACING)
        tab._columns[i] = { frame = col, groups = {} }
    end

    -- hover
    btn.MouseEnter:Connect(function()
        if self._activeTab ~= tab then
            Tween(btn, Theme.AnimFast, { BackgroundColor3 = Theme.Element })
            Icon.TweenTint(icon, Theme.Text, Theme.AnimFast)
            Tween(label, Theme.AnimFast, { TextColor3 = Theme.Text })
        end
    end)
    btn.MouseLeave:Connect(function()
        if self._activeTab ~= tab then
            Tween(btn, Theme.AnimFast, { BackgroundColor3 = Theme.Sidebar })
            Icon.TweenTint(icon, Theme.TextSub, Theme.AnimFast)
            Tween(label, Theme.AnimFast, { TextColor3 = Theme.TextSub })
        end
    end)
    btn.MouseButton1Click:Connect(function()
        PlaySound()
        self:SelectTab(tab)
    end)

    -- регистрация
    table.insert(self._tabs, tab)

    -- первая вкладка → автоматически активна
    if #self._tabs == 1 then
        self:SelectTab(tab)
    end

    return tab
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §30 · GROUP METHODS · создание групп
--// ═══════════════════════════════════════════════════════════════════════

function TabMethods:CreateGroup(title)
    if not self._columns or #self._columns == 0 then
        warn("[NL] Нет колонок для создания группы")
        return nil
    end

    -- выбираем самую короткую колонку
    local best, bestH = 1, math.huge
    for i, col in ipairs(self._columns) do
        local h = 0
        for _, g in ipairs(col.groups) do
            h += (g._frame.Size.Y.Offset or 0) + SPACING
        end
        if h < bestH then best, bestH = i, h end
    end
    local colData = self._columns[best]

    -- основной Frame группы
    local frame = New("Frame", {
        BackgroundColor3 = Theme.Group,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, Theme.GroupHeaderHeight),
        LayoutOrder = #colData.groups + 1,
        Parent = colData.frame,
    })
    Round(frame, Theme.RadiusGroup)
    Stroke(frame, Theme.Stroke)

    -- шапка группы
    local header = New("TextButton", {
        Text = "",
        BackgroundColor3 = Theme.GroupHeader,
        AutoButtonColor = false,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, Theme.GroupHeaderHeight),
        ZIndex = 2,
        Parent = frame,
    })
    Round(header, Theme.RadiusGroup)

    -- маска снизу для шапки
    New("Frame", {
        Position = UDim2.new(0, 0, 1, -6),
        Size = UDim2.new(1, 0, 0, 6),
        BackgroundColor3 = Theme.GroupHeader,
        BorderSizePixel = 0,
        ZIndex = 3,
        Parent = header,
    })

    -- заголовок
    New("TextLabel", {
        Text = string.upper(title),
        Font = Theme.FontBold,
        TextSize = 10,
        TextColor3 = Theme.TextSub,
        TextXAlignment = Enum.TextXAlignment.Left,
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, 14, 0.5, 0),
        Size = UDim2.new(1, -44, 0, 12),
        BackgroundTransparency = 1,
        ZIndex = 4,
        Parent = header,
    })

    -- стрелка
    local arrow = Icon.new("ChevronDown", header, 14, Theme.TextDim)
    arrow.Position = UDim2.new(1, -22, 0.5, -7)
    arrow.ZIndex = 4

    -- тело группы
    local body = New("Frame", {
        Position = UDim2.new(0, 0, 0, Theme.GroupHeaderHeight),
        Size = UDim2.new(1, 0, 0, 0),
        BackgroundTransparency = 1,
        ClipsDescendants = true,
        ZIndex = 2,
        Parent = frame,
    })
    VLayout(body, 4)
    Padding(body, 8, 8, 8, 8)

    -- объект группы
    local group = setmetatable({
        _frame    = frame,
        _header   = header,
        _body     = body,
        _arrow    = arrow,
        _elements = {},
        _open     = true,
        _height   = 0,
        _tab      = self,
        Name      = title,
    }, GroupMT)

    -- пересчёт высоты
    function group:_updateHeight()
        local h = 16
        for _, el in ipairs(self._elements) do
            h += (el._height or 30) + 4
        end
        self._height = h
        if self._open then
            body.Size = UDim2.new(1, 0, 0, h)
            frame.Size = UDim2.new(1, 0, 0, Theme.GroupHeaderHeight + h)
        end
    end

    -- открытие/закрытие
    local function setOpen(open)
        group._open = open
        local h = group._height

        if NL.Settings.Animations then
            Tween(body, Theme.AnimNormal, { Size = UDim2.new(1, 0, 0, open and h or 0) })
            Tween(frame, Theme.AnimNormal, {
                Size = UDim2.new(1, 0, 0, Theme.GroupHeaderHeight + (open and h or 0)),
            })
        else
            body.Size = UDim2.new(1, 0, 0, open and h or 0)
            frame.Size = UDim2.new(1, 0, 0, Theme.GroupHeaderHeight + (open and h or 0))
        end

        Tween(arrow, Theme.AnimNormal, { Rotation = open and 0 or -90 })
        task.delay(0.18, function()
            NL._recalcTab(group._tab)
        end)
    end

    header.MouseButton1Click:Connect(function()
        PlaySound()
        setOpen(not group._open)
    end)

    -- регистрация
    table.insert(colData.groups, group)
    table.insert(NL.Groups, group)
    NL._recalcTab(self)

    return group
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §31 · TOOLTIP SYSTEM
--// ═══════════════════════════════════════════════════════════════════════

local Tooltip = {
    frame = nil,
    label = nil,
    visible = false,
    queueToken = 0,
}

local function EnsureTooltip()
    if Tooltip.frame and Tooltip.frame.Parent then
        return Tooltip
    end
    local win = NL._window
    if not win then return nil end

    local f = New("Frame", {
        Name = "Tooltip",
        Size = UDim2.new(0, 200, 0, 28),
        BackgroundColor3 = Theme.Popout,
        BorderSizePixel = 0,
        Visible = false,
        ZIndex = 200,
        Parent = win._screen,
    })
    Round(f, 6)
    Stroke(f, Theme.StrokeLight)
    -- легкая тень
    New("UIStroke", {
        Color = Color3.new(0, 0, 0),
        Thickness = 4,
        Transparency = 0.8,
        Parent = f,
    })

    local label = New("TextLabel", {
        Text = "",
        Font = Theme.Font,
        TextSize = 11,
        TextColor3 = Theme.Text,
        TextWrapped = true,
        Position = UDim2.new(0, 10, 0, 6),
        Size = UDim2.new(1, -20, 1, -12),
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
        BackgroundTransparency = 1,
        ZIndex = 201,
        Parent = f,
    })

    Tooltip.frame = f
    Tooltip.label = label

    -- следим за позицией мыши
    Connect(UserInputService.InputChanged, function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseMovement then return end
        if not f.Visible then return end
        local vp = NL._util.Cache.GetViewport()
        local x = math.clamp(input.Position.X + 16, 6, vp.X - f.AbsoluteSize.X - 6)
        local y = math.clamp(input.Position.Y + 18, 6, vp.Y - f.AbsoluteSize.Y - 6)
        f.Position = UDim2.new(0, x, 0, y)
    end)

    return Tooltip
end

local function ShowTooltip(text)
    if not text or text == "" then return end
    local t = EnsureTooltip()
    if not t then return end

    t.label.Text = tostring(text)

    -- авто-размер
    local bounds = t.label.TextBounds
    local w = math.clamp(bounds.X + 22, 80, 300)
    local h = math.clamp(bounds.Y + 14, 28, 110)
    t.frame.Size = UDim2.new(0, w, 0, h)

    if not t.frame.Visible then
        t.frame.Visible = true
        t.frame.BackgroundTransparency = 0.15
        Tween(t.frame, Theme.AnimFast, { BackgroundTransparency = 0 })
    end
    t.visible = true
end

local function HideTooltip()
    local t = Tooltip
    if not t.frame then return end
    if not t.visible then return end
    t.visible = false
    Tween(t.frame, Theme.AnimFast, { BackgroundTransparency = 1 })
    task.delay(Theme.AnimFast + 0.02, function()
        if t.frame and not t.visible then
            t.frame.Visible = false
        end
    end)
end

local function BindTooltip(frame, opts)
    if not frame or not opts or not opts.Tooltip then return end

    local token = 0

    frame.MouseEnter:Connect(function()
        token = Tooltip.queueToken + 1
        Tooltip.queueToken = token
        local myToken = token
        task.delay(0.4, function()
            if Tooltip.queueToken == myToken then
                ShowTooltip(opts.Tooltip)
            end
        end)
    end)

    frame.MouseLeave:Connect(function()
        Tooltip.queueToken = Tooltip.queueToken + 1
        HideTooltip()
    end)
end

NL._util.ShowTooltip = ShowTooltip
NL._util.HideTooltip = HideTooltip
NL._util.BindTooltip = BindTooltip

--// ═══════════════════════════════════════════════════════════════════════
--//  §32 · NOTIFICATION SYSTEM
--// ═══════════════════════════════════════════════════════════════════════

local Notify = {
    holder = nil,
    count = 0,
}

local Theme = NL.Theme
local Settings = NL.Settings

local NOTIFY_COLORS = {
    info    = Theme.Accent,
    success = Theme.Success,
    error   = Theme.Error,
    warning = Theme.Warning,
}

local NOTIFY_ICONS = {
    info    = "Dot",
    success = "Check",
    error   = "Close",
    warning = "Bell",
}

local function EnsureNotifyHolder()
    if Notify.holder and Notify.holder.Parent then
        return Notify.holder
    end
    local win = NL._window
    if not win then return nil end

    local holder = New("Frame", {
        Name = "Notifications",
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, -16, 0, 16),
        Size = UDim2.new(0, 280, 0, 0),
        BackgroundTransparency = 1,
        ZIndex = 250,
        Parent = win._screen,
    })
    VLayout(holder, 8)
    -- выравнивание по правому краю
    local layout = holder:FindFirstChildOfClass("UIListLayout")
    if layout then
        layout.HorizontalAlignment = Enum.HorizontalAlignment.Right
    end

    Notify.holder = holder
    return holder
end

function NL:Notify(title, text, duration, ntype)
    local holder = EnsureNotifyHolder()
    if not holder then return end

    duration = math.max(1, duration or NL.Settings.NotificationDuration)
    ntype = ntype or "info"
    local accent = NOTIFY_COLORS[ntype] or Theme.Accent
    local iconName = NOTIFY_ICONS[ntype] or "Dot"

    -- лимит уведомлений
    local shown = {}
    for _, c in ipairs(holder:GetChildren()) do
        if c:IsA("Frame") and c:GetAttribute("NL_Notify") then
            table.insert(shown, c)
        end
    end
    if #shown >= NL.Settings.MaxNotifications then
        pcall(function() shown[1]:Destroy() end)
    end

    -- высота карточки
    local cardH = (#tostring(text) > 40) and 66 or 52

    local wrapper = New("Frame", {
        Size = UDim2.new(1, 0, 0, cardH),
        BackgroundTransparency = 1,
        LayoutOrder = -os.clock(),
        Parent = holder,
    })
    wrapper:SetAttribute("NL_Notify", true)

    local card = New("Frame", {
        Position = UDim2.new(0, 320, 0, 0),
        Size = UDim2.new(1, 0, 0, cardH),
        BackgroundColor3 = Theme.Popout,
        BorderSizePixel = 0,
        ClipsDescendants = true,
        Parent = wrapper,
    })
    Round(card, Theme.RadiusGroup)
    Stroke(card, Theme.StrokeLight)

    -- акцентная полоска
    New("Frame", {
        Position = UDim2.new(0, 0, 0, 8),
        Size = UDim2.new(0, 3, 1, -16),
        BackgroundColor3 = accent,
        BorderSizePixel = 0,
        ZIndex = 3,
        Parent = card,
    })

    -- иконка
    local iconHolder = New("Frame", {
        Position = UDim2.new(0, 12, 0, 12),
        Size = UDim2.new(0, 20, 0, 20),
        BackgroundColor3 = accent,
        BackgroundTransparency = 0.85,
        BorderSizePixel = 0,
        ZIndex = 3,
        Parent = card,
    })
    Round(iconHolder, 10)
    local ic = Icon.new(iconName, iconHolder, 12, accent)
    ic.Position = UDim2.new(0.5, -6, 0.5, -6)

    -- заголовок
    New("TextLabel", {
        Text = tostring(title or ""),
        Font = Theme.FontBold,
        TextSize = 12,
        TextColor3 = Theme.Text,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Position = UDim2.new(0, 42, 0, 10),
        Size = UDim2.new(1, -52, 0, 14),
        BackgroundTransparency = 1,
        ZIndex = 3,
        Parent = card,
    })

    -- текст
    New("TextLabel", {
        Text = tostring(text or ""),
        Font = Theme.Font,
        TextSize = 11,
        TextColor3 = Theme.TextSub,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        Position = UDim2.new(0, 42, 0, 26),
        Size = UDim2.new(1, -52, 0, cardH - 34),
        BackgroundTransparency = 1,
        ZIndex = 3,
        Parent = card,
    })

    -- прогресс-бар
    local progress = New("Frame", {
        Position = UDim2.new(0, 0, 1, -2),
        Size = UDim2.new(1, 0, 0, 2),
        BackgroundColor3 = accent,
        BackgroundTransparency = 0.35,
        BorderSizePixel = 0,
        ZIndex = 4,
        Parent = card,
    })

    -- dismiss
    local dismissed = false
    local function dismiss()
        if dismissed then return end
        dismissed = true
        Tween(card, 0.25, {
            Position = UDim2.new(0, 320, 0, 0),
        }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
        task.delay(0.27, function()
            pcall(function() wrapper:Destroy() end)
        end)
    end

    card.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dismiss()
        end
    end)

    Tween(card, 0.3, { Position = UDim2.new(0, 0, 0, 0) }, Enum.EasingStyle.Quint)
    Tween(progress, duration, { Size = UDim2.new(0, 0, 0, 2) }, Enum.EasingStyle.Linear)
    PlaySound(NL.Settings.SoundNotify, 0.25)
    task.delay(duration, dismiss)
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §33 · WATERMARK (пилюля FPS + BETA + PING)
--// ═══════════════════════════════════════════════════════════════════════

local Watermark = {
    frame = nil,
    _fpsLabel = nil,
    _pingLabel = nil,
    _nameLabel = nil,
    _tagLabel = nil,
    _conns = {},
}

-- позиции вотермарки
local WM_POSITIONS = {
    ["top-left"]      = { Anchor = Vector2.new(0, 0),   Pos = UDim2.new(0, 10, 0, 10) },
    ["top-right"]     = { Anchor = Vector2.new(1, 0),   Pos = UDim2.new(1, -10, 0, 10) },
    ["top-center"]    = { Anchor = Vector2.new(0.5, 0), Pos = UDim2.new(0.5, 0, 0, 10) },
    ["bottom-center"] = { Anchor = Vector2.new(0.5, 1), Pos = UDim2.new(0.5, 0, 1, -10) },
    ["bottom-left"]   = { Anchor = Vector2.new(0, 1),   Pos = UDim2.new(0, 10, 1, -10) },
    ["bottom-right"]  = { Anchor = Vector2.new(1, 1),   Pos = UDim2.new(1, -10, 1, -10) },
}

local function PingColor(ms)
    if ms < 60 then return Theme.TextGreen end
    if ms < 120 then return Theme.Warning end
    return Theme.Error
end

function NL:CreateWatermark(prefix)
    if not NL.Settings.Watermark then return end
    local win = NL._window
    if not win then return end
    prefix = prefix or NL.Settings.WMCheatName or "neverlose"

    -- сносим старый
    if Watermark.frame and Watermark.frame.Parent then
        Watermark.frame:Destroy()
    end

    -- пилюля
    local holder = New("Frame", {
        Name = "Watermark",
        Size = UDim2.new(0, 260, 0, 30),
        BackgroundColor3 = Theme.Background,
        BackgroundTransparency = NL.Settings.WMBackground,
        BorderSizePixel = 0,
        ZIndex = 300,
        Parent = win._screen,
    })
    Round(holder, 15)
    local holderStroke = Stroke(holder, Theme.StrokeLight, 1, 0.35)

    -- контейнер с горизонтальным layout
    local row = New("Frame", {
        Position = UDim2.new(0, 6, 0, 0),
        Size = UDim2.new(1, -32, 1, 0),
        BackgroundTransparency = 1,
        Parent = holder,
    })
    local rowLayout = New("UIListLayout", {
        FillDirection = Enum.FillDirection.Horizontal,
        Padding = UDim.new(0, 6),
        VerticalAlignment = Enum.VerticalAlignment.Center,
        SortOrder = Enum.SortOrder.LayoutOrder,
        Parent = row,
    })

    -- логотип
    local logoBox = New("Frame", {
        Size = UDim2.new(0, 20, 0, 20),
        BackgroundColor3 = Theme.Accent,
        BorderSizePixel = 0,
        LayoutOrder = 1,
        ZIndex = 302,
        Parent = row,
    })
    Round(logoBox, 10)
    Gradient(logoBox, Theme.Accent, Theme.AccentBright, 135)
    New("TextLabel", {
        Text = NL.Settings.WMCheatLogo or "N",
        Font = Theme.FontBold,
        TextSize = 11,
        TextColor3 = Color3.fromRGB(255, 255, 255),
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        ZIndex = 303,
        Parent = logoBox,
    })

    -- название чита
    local nameLabel = New("TextLabel", {
        Text = prefix,
        Font = Theme.FontBold,
        TextSize = 11,
        TextColor3 = Theme.Text,
        TextXAlignment = Enum.TextXAlignment.Left,
        AutomaticSize = Enum.AutomaticSize.X,
        Size = UDim2.new(0, 0, 0, 14),
        BackgroundTransparency = 1,
        LayoutOrder = 2,
        ZIndex = 302,
        Parent = row,
    })
    Watermark._nameLabel = nameLabel

    -- тег BETA
    local tagLabel = New("TextLabel", {
        Text = NL.Settings.WMCheatTag or "BETA",
        Font = Theme.Font,
        TextSize = 9,
        TextColor3 = Theme.TextDim,
        TextXAlignment = Enum.TextXAlignment.Left,
        AutomaticSize = Enum.AutomaticSize.X,
        Size = UDim2.new(0, 0, 0, 12),
        BackgroundTransparency = 1,
        LayoutOrder = 3,
        ZIndex = 302,
        Parent = row,
    })
    Watermark._tagLabel = tagLabel

    -- FPS
    local fpsLabel = New("TextLabel", {
        Text = "0 FPS",
        Font = Theme.Font,
        TextSize = 10,
        TextColor3 = Theme.TextSub,
        TextXAlignment = Enum.TextXAlignment.Left,
        AutomaticSize = Enum.AutomaticSize.X,
        Size = UDim2.new(0, 0, 0, 12),
        BackgroundTransparency = 1,
        LayoutOrder = 4,
        ZIndex = 302,
        Parent = row,
    })
    Watermark._fpsLabel = fpsLabel

    -- PING
    local pingLabel = New("TextLabel", {
        Text = "0 ms",
        Font = Theme.Font,
        TextSize = 10,
        TextColor3 = Theme.TextSub,
        TextXAlignment = Enum.TextXAlignment.Left,
        AutomaticSize = Enum.AutomaticSize.X,
        Size = UDim2.new(0, 0, 0, 12),
        BackgroundTransparency = 1,
        LayoutOrder = 5,
        ZIndex = 302,
        Parent = row,
    })
    Watermark._pingLabel = pingLabel

    -- сигнал (иконка-полоски)
    local signalHolder = New("Frame", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -8, 0.5, 0),
        Size = UDim2.new(0, 16, 0, 12),
        BackgroundTransparency = 1,
        ZIndex = 302,
        Parent = holder,
    })
    local signalIcon = Icon.new("Signal", signalHolder, 14, Theme.Accent)
    signalIcon.Position = UDim2.new(0, 0, 0, 0)

    -- позиция
    local function applyPosition()
        local p = WM_POSITIONS[NL.Settings.WMPosition] or WM_POSITIONS["top-left"]
        holder.AnchorPoint = p.Anchor
        holder.Position = p.Pos
    end
    applyPosition()

    -- авто-размер под контент
    local function updateSize()
        local totalW = 20 + 6 + nameLabel.AbsoluteSize.X + 6
            + tagLabel.AbsoluteSize.X + 6
            + (NL.Settings.WMShowFPS and fpsLabel.AbsoluteSize.X + 6 or 0)
            + (NL.Settings.WMShowPing and pingLabel.AbsoluteSize.X + 6 or 0)
            + 28
        holder.Size = UDim2.new(0, math.max(160, totalW), 0, 30)
    end

    -- FPS-счётчик
    local frames = 0
    local lastTime = os.clock()
    local conn1 = RunService.RenderStepped:Connect(function()
        frames = frames + 1
    end)
    table.insert(Watermark._conns, conn1)

    -- ping + fps обновление раз в 0.5 сек
    local conn2 = task.spawn(function()
        while holder.Parent do
            task.wait(0.5)
            local now = os.clock()
            local fps = math.floor(frames / math.max(now - lastTime, 0.001))
            frames = 0
            lastTime = now

            if NL.Settings.WMShowFPS then
                fpsLabel.Visible = true
                fpsLabel.Text = tostring(fps) .. " FPS"
            else
                fpsLabel.Visible = false
            end

            if NL.Settings.WMShowPing then
                pingLabel.Visible = true
                local ping = 0
                pcall(function()
                    local item = Stats.Network.ServerStatsItem:FindFirstChild("Data Ping")
                    if item then ping = math.floor(item:GetValue()) end
                end)
                pingLabel.Text = tostring(ping) .. " ms"
                pingLabel.TextColor3 = PingColor(ping)
            else
                pingLabel.Visible = false
            end

            updateSize()
        end
    end)
    table.insert(Watermark._conns, conn2)

    -- плавное появление
    holder.BackgroundTransparency = 1
    Tween(holder, 0.5, { BackgroundTransparency = NL.Settings.WMBackground }, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)

    Watermark.frame = holder

    -- экспорт метода смены позиции
    NL._wmApplyPosition = applyPosition

    return holder
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §34 · CONTEXT MENU
--// ═══════════════════════════════════════════════════════════════════════

function NL:ShowContextMenu(items, screenPos)
    local win = NL._window
    if not win or type(items) ~= "table" or #items == 0 then return end

    -- закрываем старые
    if NL._activeContext then
        pcall(NL._activeContext.Close)
        NL._activeContext = nil
    end
    if NL._activeDropdown then
        pcall(NL._activeDropdown.Close)
        NL._activeDropdown = nil
    end

    local itemH = 26
    local longest = 0
    for _, item in ipairs(items) do
        if item.Text and item.Text ~= "-" then
            longest = math.max(longest, #tostring(item.Text))
        end
    end
    local width = math.clamp(longest * 6.5 + 46, 140, 260)
    local height = #items * itemH + 8

    local menu = New("Frame", {
        Size = UDim2.new(0, width, 0, height),
        BackgroundColor3 = Theme.Popout,
        BorderSizePixel = 0,
        ZIndex = 400,
        Parent = win._screen,
    })
    Round(menu, Theme.RadiusGroup)
    Stroke(menu, Theme.StrokeLight)
    New("UIStroke", {
        Color = Color3.new(0, 0, 0),
        Thickness = 4,
        Transparency = 0.8,
        Parent = menu,
    })

    local ctx = {}
    local outConn

    local function close()
        if outConn then outConn:Disconnect(); outConn = nil end
        if menu.Parent then menu:Destroy() end
        if NL._activeContext == ctx then NL._activeContext = nil end
    end
    ctx.Close = close

    for i, item in ipairs(items) do
        local isDivider = (item.Text == nil or item.Text == "" or item.Text == "-")

        if isDivider then
            New("Frame", {
                Position = UDim2.new(0, 8, 0, 4 + (i - 1) * itemH + 12),
                Size = UDim2.new(1, -16, 0, 1),
                BackgroundColor3 = Theme.Divider,
                BorderSizePixel = 0,
                ZIndex = 401,
                Parent = menu,
            })
        else
            local row = New("TextButton", {
                Text = "",
                Position = UDim2.new(0, 4, 0, 4 + (i - 1) * itemH),
                Size = UDim2.new(1, -8, 0, itemH - 2),
                BackgroundColor3 = Theme.Popout,
                AutoButtonColor = false,
                BorderSizePixel = 0,
                ZIndex = 401,
                Parent = menu,
            })
            Round(row, 5)

            local textX = 12
            local ico
            if item.Icon then
                ico = Icon.new(item.Icon, row, 13, item.Color or Theme.TextSub)
                ico.Position = UDim2.new(0, 9, 0.5, -6.5)
                ico.ZIndex = 402
                textX = 30
            end

            New("TextLabel", {
                Text = tostring(item.Text),
                Font = Theme.Font,
                TextSize = 11,
                TextColor3 = item.Color or Theme.Text,
                TextXAlignment = Enum.TextXAlignment.Left,
                AnchorPoint = Vector2.new(0, 0.5),
                Position = UDim2.new(0, textX, 0.5, 0),
                Size = UDim2.new(1, -textX - 8, 0, 12),
                BackgroundTransparency = 1,
                ZIndex = 402,
                Parent = row,
            })

            row.MouseEnter:Connect(function()
                Tween(row, Theme.AnimFast, { BackgroundColor3 = Theme.ElementHover })
                if ico then Icon.TweenTint(ico, item.Color or Theme.Text, Theme.AnimFast) end
            end)
            row.MouseLeave:Connect(function()
                Tween(row, Theme.AnimFast, { BackgroundColor3 = Theme.Popout })
                if ico then Icon.TweenTint(ico, item.Color or Theme.TextSub, Theme.AnimFast) end
            end)
            row.MouseButton1Click:Connect(function()
                PlaySound()
                local cb = item.Callback
                close()
                if cb then
                    SafeCall(cb)
                end
            end)
        end
    end

    -- позиционирование
    local vp = NL._util.Cache.GetViewport()
    local px = math.clamp(screenPos.X, 6, vp.X - width - 6)
    local py = math.clamp(screenPos.Y, 6, vp.Y - height - 6)
    menu.Position = UDim2.new(0, px, 0, py)

    -- следим за кликом вне
    outConn = Connect(UserInputService.InputBegan, function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
        and input.UserInputType ~= Enum.UserInputType.MouseButton2 then
            return
        end
        local p = input.Position
        local lp, ls = menu.AbsolutePosition, menu.AbsoluteSize
        if p.X < lp.X or p.X > lp.X + ls.X or p.Y < lp.Y or p.Y > lp.Y + ls.Y then
            close()
        end
    end)

    NL._activeContext = ctx
    return ctx
end

function NL:BindContextMenu(frame, itemsFn)
    if not frame or type(itemsFn) ~= "function" then return end
    frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton2 then
            local items = itemsFn()
            if items then
                NL:ShowContextMenu(items, Vector2.new(input.Position.X, input.Position.Y))
            end
        end
    end)
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §35 · SEARCH OVERLAY
--// ═══════════════════════════════════════════════════════════════════════

local Search = {
    frame = nil,
    input = nil,
    header = nil,
    listScroll = nil,
    visible = false,
}

local function BuildSearchOverlay(Window)
    local overlay = New("Frame", {
        Name = "SearchOverlay",
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundColor3 = Theme.Content,
        BorderSizePixel = 0,
        Visible = false,
        ZIndex = 60,
        Parent = Window._contentArea,
    })
    Round(overlay, Theme.RadiusWindow)

    New("Frame", {
        Size = UDim2.new(0, 8, 1, 0),
        BackgroundColor3 = Theme.Content,
        BorderSizePixel = 0,
        ZIndex = 61,
        Parent = overlay,
    })

    local inputBox = New("TextBox", {
        Text = "",
        PlaceholderText = "Поиск по функциям...",
        Font = Theme.Font,
        TextSize = 12,
        TextColor3 = Theme.Text,
        PlaceholderColor3 = Theme.TextDim,
        TextXAlignment = Enum.TextXAlignment.Left,
        ClearTextOnFocus = false,
        BackgroundColor3 = Theme.List,
        Position = UDim2.new(0, 12, 0, 12),
        Size = UDim2.new(1, -24, 0, 32),
        ZIndex = 62,
        Parent = overlay,
    })
    Round(inputBox, 6)
    Stroke(inputBox, Theme.Stroke)
    Padding(inputBox, 0, 36, 0, 12)

    local searchIco = Icon.new("Search", inputBox, 13, Theme.TextDim)
    searchIco.Position = UDim2.new(1, -26, 0.5, -6.5)
    searchIco.ZIndex = 63

    local header = New("TextLabel", {
        Text = "Введите запрос",
        Font = Theme.Font,
        TextSize = 10,
        TextColor3 = Theme.TextDim,
        TextXAlignment = Enum.TextXAlignment.Left,
        Position = UDim2.new(0, 14, 0, 50),
        Size = UDim2.new(1, -28, 0, 12),
        BackgroundTransparency = 1,
        ZIndex = 62,
        Parent = overlay,
    })

    local listScroll = New("ScrollingFrame", {
        Position = UDim2.new(0, 10, 0, 68),
        Size = UDim2.new(1, -20, 1, -80),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = Theme.Accent,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        ZIndex = 62,
        Parent = overlay,
    })
    VLayout(listScroll, 4)

    Search.frame = overlay
    Search.input = inputBox
    Search.header = header
    Search.listScroll = listScroll

    -- переход к элементу
    local function goToElement(el)
        inputBox.Text = ""
        overlay.Visible = false
        Search.visible = false
        HideTooltip()

        local tab = el._tab
        if not tab or not tab._window then return end
        tab._window:SelectTab(tab)
        if el._group and not el._group._open then
            -- открыть группу
            local group = el._group
            group._open = true
            Tween(group._body, 0.16, { Size = UDim2.new(1, 0, 0, group._height) })
            Tween(group._frame, 0.16, { Size = UDim2.new(1, 0, 0, Theme.GroupHeaderHeight + group._height) })
            Tween(group._arrow, 0.16, { Rotation = 0 })
            task.delay(0.18, function() NL._recalcTab(group._tab) end)
        end

        task.delay(0.1, function() Effects.Highlight(el._frame, Theme.Accent, 0.6) end)
        task.delay(0.24, function()
            -- прокрутка к элементу
            local target = el._frame.AbsolutePosition.Y - tab._scroll.AbsolutePosition.Y
                + tab._scroll.CanvasPosition.Y - 40
            local maxScroll = math.max(0, tab._scroll.CanvasSize.Y.Offset - tab._scroll.AbsoluteSize.Y)
            target = math.clamp(target, 0, maxScroll)
            Tween(tab._scroll, 0.3, { CanvasPosition = Vector2.new(0, target) }, Enum.EasingStyle.Quint)
        end)
    end

    -- фильтрация
    local function refreshResults()
        for _, c in ipairs(listScroll:GetChildren()) do
            if c:IsA("GuiObject") then c:Destroy() end
        end

        local query = string.lower(inputBox.Text)
        if query == "" then
            header.Text = "Введите запрос"
            overlay.Visible = false
            Search.visible = false
            return
        end

        local total, results = 0, {}
        for _, el in ipairs(NL.Elements) do
            if el.Name then
                local n = string.lower(tostring(el.Name))
                if string.find(n, query, 1, true) then
                    total += 1
                    if #results < 60 then
                        table.insert(results, el)
                    end
                end
            end
        end

        if #results == 0 then
            header.Text = "Поиск: «" .. inputBox.Text .. "» — ничего не найдено"
        elseif total > 60 then
            header.Text = string.format("Поиск: «%s» — %d (показаны 60)", inputBox.Text, total)
        else
            header.Text = string.format("Поиск: «%s» — %d", inputBox.Text, total)
        end

        for i, el in ipairs(results) do
            local row = New("TextButton", {
                Text = "",
                BackgroundColor3 = Theme.Element,
                AutoButtonColor = false,
                BorderSizePixel = 0,
                Size = UDim2.new(1, -4, 0, 30),
                LayoutOrder = i,
                ZIndex = 63,
                Parent = listScroll,
            })
            Round(row, 5)

            New("TextLabel", {
                Text = tostring(el.Name),
                Font = Theme.Font,
                TextSize = 11,
                TextColor3 = Theme.Text,
                TextXAlignment = Enum.TextXAlignment.Left,
                TextTruncate = Enum.TextTruncate.AtEnd,
                AnchorPoint = Vector2.new(0, 0.5),
                Position = UDim2.new(0, 12, 0.5, 0),
                Size = UDim2.new(0.55, 0, 0, 12),
                BackgroundTransparency = 1,
                ZIndex = 64,
                Parent = row,
            })

            local where = "?"
            if el._tab and el._group then
                where = el._tab.Name .. " · " .. tostring(el._group.Name or "")
            elseif el._tab then
                where = el._tab.Name
            end

            New("TextLabel", {
                Text = where,
                Font = Theme.Font,
                TextSize = 9,
                TextColor3 = Theme.TextDim,
                TextXAlignment = Enum.TextXAlignment.Right,
                TextTruncate = Enum.TextTruncate.AtEnd,
                AnchorPoint = Vector2.new(1, 0.5),
                Position = UDim2.new(1, -12, 0.5, 0),
                Size = UDim2.new(0.4, 0, 0, 10),
                BackgroundTransparency = 1,
                ZIndex = 64,
                Parent = row,
            })

            row.MouseEnter:Connect(function()
                Tween(row, Theme.AnimFast, { BackgroundColor3 = Theme.ElementHover })
            end)
            row.MouseLeave:Connect(function()
                Tween(row, Theme.AnimFast, { BackgroundColor3 = Theme.Element })
            end)
            row.MouseButton1Click:Connect(function()
                PlaySound()
                goToElement(el)
            end)
        end

        listScroll.CanvasSize = UDim2.new(0, 0, 0, #results * 34 + 4)
        overlay.Visible = true
        Search.visible = true
    end

    inputBox:GetPropertyChangedSignal("Text"):Connect(refreshResults)

    inputBox.Focused:Connect(function()
        Tween(inputBox, Theme.AnimFast, { BackgroundColor3 = Theme.ElementHover })
    end)
    inputBox.FocusLost:Connect(function()
        Tween(inputBox, Theme.AnimFast, { BackgroundColor3 = Theme.List })
    end)

    -- Esc закрывает
    Connect(UserInputService.InputBegan, function(input, processed)
        if processed then return end
        if input.KeyCode == Enum.KeyCode.Escape and Search.visible then
            inputBox.Text = ""
            overlay.Visible = false
            Search.visible = false
        end
    end)

    return overlay
end

-- хук на топбар-поиск
local function HookSearch(Window)
    local topBar = Window._topBar
    if not topBar or not topBar.SearchChip then return end

    local overlay = BuildSearchOverlay(Window)
    Window._searchOverlay = overlay

    topBar.SearchChip.MouseButton1Click:Connect(function()
        overlay.Visible = true
        Search.visible = true
        PlaySound()
        pcall(function() Search.input:CaptureFocus() end)
    end)
end

NL._util.HookSearch = HookSearch
NL._util.Search = Search

--// ═══════════════════════════════════════════════════════════════════════
--//  §36 · WINDOW EVENTS · destroy + toggle + hotkey
--// ═══════════════════════════════════════════════════════════════════════

function NL:Toggle()
    local win = NL._window
    if not win then return end
    if win._hidden then
        win:Show()
    else
        win:Hide()
    end
end

function NL:Destroy()
    local win = NL._window

    -- закрываем попапы
    if NL._activeContext then pcall(NL._activeContext.Close); NL._activeContext = nil end
    if NL._activeDropdown then pcall(NL._activeDropdown.Close); NL._activeDropdown = nil end
    pcall(HideTooltip)

    -- анимация закрытия
    if win and win._screen then
        if NL.Settings.Animations and win._root then
            Tween(win._scale, 0.14, { Scale = 0.9 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
            task.delay(0.15, function()
                if win._screen then pcall(function() win._screen:Destroy() end) end
            end)
        else
            pcall(function() win._screen:Destroy() end)
        end
    end

    -- отключаем все соединения
    for _, c in ipairs(NL._connections) do
        pcall(function() c:Disconnect() end)
    end
    table.clear(NL._connections)

    -- сбрасываем состояние
    NL._window = nil
    NL._activeDropdown = nil
    NL._activeColorPicker = nil
    NL._activeContext = nil

    -- вотермарка
    if Watermark.frame then
        pcall(function() Watermark.frame:Destroy() end)
        Watermark.frame = nil
    end
    for _, c in ipairs(Watermark._conns) do
        pcall(function()
            if type(c) == "userdata" and c.Disconnect then
                c:Disconnect()
            end
        end)
    end
    table.clear(Watermark._conns)
end

-- хук: CreateWindow автоматически подключает поиск
local BaseCreateWindow = NL.CreateWindow
NL.CreateWindow = function(self, cfg)
    local win = BaseCreateWindow(self, cfg)
    task.defer(function()
        pcall(function() HookSearch(win) end)
    end)
    return win
end

