-- мета-таблицы для window/tab/group
local WindowMT = { __index = {} }
local TabMT    = { __index = {} }
local GroupMT  = { __index = {} }

local WindowMethods = WindowMT.__index
local TabMethods    = TabMT.__index
local GroupMethods  = GroupMT.__index

-- константы отступов
local SPACING       = 8     -- отступ между группами
local CONTENT_PAD   = 12    -- отступ от края контента
local SIDEBAR_PAD   = 8     -- отступ от края сайдбара

-- иконки вкладок по умолчанию
local DEFAULT_TAB_ICONS = {
    rage         = "Crosshair",
    legit        = "Legit",
    combat       = "Crosshair",
    visuals      = "Eye",
    render       = "Eye",
    inventory    = "Box",
    skins        = "Box",
    movement     = "Move",
    misc         = "Cog",
    miscellaneous = "Cog",
    config       = "List",
    configs      = "List",
    interface    = "Cog",
    settings     = "Cog",
    players      = "Person",
    self         = "Mic",
    lua          = "Code",
    scripts      = "Code",
    search       = "Search",
    removals     = "Trash",
    protection   = "Shield",
}

-- безопасное извлечение иконки
local function ResolveTabIcon(name, explicit)
    if explicit and explicit ~= "" then return explicit end
    local lower = string.lower(tostring(name or ""))
    return DEFAULT_TAB_ICONS[lower] or "List"
end

-- пересчёт высоты контента вкладки
-- вызывается при любом изменении состава групп
function NL._recalcTab(tab)
    if not tab or not tab._columns then return end

    local maxHeight = 0

    for _, colData in ipairs(tab._columns) do
        local h = 0
        for _, g in ipairs(colData.groups) do
            h += (g._frame.Size.Y.Offset or 0) + SPACING
        end
        colData.frame.Size = UDim2.new(
            colData.frame.Size.X.Scale,
            colData.frame.Size.X.Offset,
            0,
            h
        )
        if h > maxHeight then maxHeight = h end
    end

    tab._content.Size = UDim2.new(1, -8, 0, maxHeight)
    tab._scroll.CanvasSize = UDim2.new(0, 0, 0, maxHeight + 16)
end

