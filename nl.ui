    -- ─── ПОИСК (по центру) ───────────────────────────────────────
    if NL.Settings.ShowSearch then
        local SearchChip = New("TextButton", {
            Text = "",
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.new(0.5, 40, 0.5, 0),
            Size = UDim2.new(0, 220, 0, 30),
            BackgroundColor3 = Theme.Chip,
            AutoButtonColor = false,
            BorderSizePixel = 0,
            ZIndex = 3,
            Parent = Header,
