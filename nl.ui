--// ═══════════════════════════════════════════════════════════════════════
--//  §164 · DEV CONSOLE · ЯДРО
--// ═══════════════════════════════════════════════════════════════════════

local DevConsole = {
    entries = {},
    maxEntries = 300,
    visible = false,
    frame = nil,
    commands = {},
    history = {},
    historyIndex = 0,
    _refresh = nil,
}

function DevConsole:Log(level, message)
    level = level or "info"
    table.insert(self.entries, {
        level = level,
        text = tostring(message or ""),
        time = os.date("%H:%M:%S"),
    })
    while #self.entries > self.maxEntries do
        table.remove(self.entries, 1)
    end
    if self.visible and self._refresh then self._refresh() end
end

function DevConsole:Info(msg) self:Log("info", msg) end
function DevConsole:Warn(msg) self:Log("warn", msg) end
function DevConsole:Error(msg) self:Log("error", msg) end
function DevConsole:Success(msg) self:Log("success", msg) end
function DevConsole:Command(msg) self:Log("cmd", msg) end

function DevConsole:Register(name, fn, description)
    self.commands[name] = { fn = fn, desc = description or "" }
end

function DevConsole:Execute(line)
    if not line or line == "" then return end

    table.insert(self.history, line)
    self.historyIndex = #self.history + 1

    local parts = {}
    for p in string.gmatch(line, "%S+") do table.insert(parts, p) end

    local cmd = parts[1]
    if not cmd then return end

    local entry = self.commands[cmd]
    if entry then
        local args = {}
        for i = 2, #parts do table.insert(args, parts[i]) end
        self:Command("> " .. line)
        local ok, err = pcall(entry.fn, unpack(args))
        if not ok then self:Error("Ошибка: " .. tostring(err)) end
    else
        self:Error("Неизвестная команда: " .. cmd)
    end
end

NL.DevConsole = DevConsole

--// ═══════════════════════════════════════════════════════════════════════
--//  §165 · DEV CONSOLE · UI
