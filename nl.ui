--//  §76 · FEATURE REGISTRY · ЦЕНТРАЛЬНЫЙ РЕЕСТР
--// ═══════════════════════════════════════════════════════════════════════

local FeatureRegistry = {
    _features = {},   -- {name -> {stop=fn, enabled=bool}}
}

function FeatureRegistry:Register(name, stopFn)
    self._features[name] = {
        stop = stopFn,
        enabled = false,
    }
end

function FeatureRegistry:Unregister(name)
    self._features[name] = nil
end

function FeatureRegistry:SetEnabled(name, on)
    local f = self._features[name]
    if f then f.enabled = on end
end

function FeatureRegistry:IsEnabled(name)
    local f = self._features[name]
    return f and f.enabled or false
end

function FeatureRegistry:StopAll()
    for name, f in pairs(self._features) do
        if f.stop then
            pcall(f.stop)
        end
        f.enabled = false
    end
end

-- перехватываем NL:Destroy для авто-очистки
local BaseDestroy5 = NL.Destroy
NL.Destroy = function(self, ...)
    FeatureRegistry:StopAll()
    return BaseDestroy5(self, ...)
end

NL.Features = FeatureRegistry

--// ═══════════════════════════════════════════════════════════════════════
--//  §77 · DRAW FOV · ОБЩИЙ МОДУЛЬ
--// ═══════════════════════════════════════════════════════════════════════

local DrawFOV = {
    _circle = nil,
    _conn = nil,
    _radius = 200,
    _visible = false,
    _color = nil,
}

-- создать круг (ленивая инициализация)
local function EnsureFOVCircle()
    if DrawFOV._circle then return DrawFOV._circle end
    if not NL.Environment.HasDrawing then return nil end

    local ok, circle = pcall(function()
        local c = Drawing.new("Circle")
        c.Thickness    = 1.5
        c.NumSides     = 180
        c.Filled       = false
        c.Transparency = 0.75
        c.Color        = NL.Theme.Accent
        c.Radius       = 0
        c.Visible      = false
        return c
    end)

    if ok and circle then
        DrawFOV._circle = circle
        return circle
    end

    return nil
end

-- обновить позицию/радиус
local function UpdateFOVCircle()
    local c = DrawFOV._circle
    if not c then return end

    if not DrawFOV._visible then
        c.Visible = false
        return
    end

    local cam = Workspace.CurrentCamera
    if not cam then
        c.Visible = false
        return
    end

    c.Position = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
    c.Radius = DrawFOV._radius
    c.Color = DrawFOV._color or NL.Theme.Accent
    c.Visible = true
end

-- включить круг
local function EnableFOVCircle(radius)
    local c = EnsureFOVCircle()
    if not c then return end

    DrawFOV._radius = radius
    DrawFOV._visible = true
    DrawFOV._color = NL.Theme.Accent

    -- обновление через RenderStepped
    if DrawFOV._conn then
        DrawFOV._conn:Disconnect()
    end
    DrawFOV._conn = RunService.RenderStepped:Connect(UpdateFOVCircle)
    UpdateFOVCircle()
end

-- выключить
local function DisableFOVCircle()
    DrawFOV._visible = false
    if DrawFOV._conn then
        DrawFOV._conn:Disconnect()
        DrawFOV._conn = nil
    end
    if DrawFOV._circle then
        pcall(function() DrawFOV._circle.Visible = false end)
    end
end

-- обновить радиус
local function SetFOVRadius(radius)
    DrawFOV._radius = radius
    if DrawFOV._circle then
        DrawFOV._circle.Radius = radius
    end
end

-- линейная шкала: 1° = точка, 180° = весь экран
local function FovRadiusFromDegrees(deg)
    local cam = Workspace.CurrentCamera
    if not cam then return 100 end
    local vp = math.min(cam.ViewportSize.X, cam.ViewportSize.Y)
    return (deg / 180) * (vp / 2)
end

NL._util.DrawFOV = {
    Enable   = EnableFOVCircle,
    Disable  = DisableFOVCircle,
    SetRadius = SetFOVRadius,
    ToPixels = FovRadiusFromDegrees,
    State    = DrawFOV,
}

--// ═══════════════════════════════════════════════════════════════════════
--//  §78 · WALLHACK · ЯДРО
--// ═══════════════════════════════════════════════════════════════════════

local WallHack = {
    _enabled = false,
    _fill    = 0.5,     -- прозрачность заливки
    _outline = 0.35,    -- прозрачность обводки
    _aliveOnly = true,  -- показывать только живых
    _data    = {},      -- [Humanoid] = {hl, char}
    _loop    = nil,
    _tick    = 0,
    _scanInterval = 0.25,
}

-- применить стиль к highlight
local function StyleHighlight(hl)
    if not hl or not hl.Parent then return end
    local c = NL.Theme.Accent
    hl.FillColor           = c
    hl.OutlineColor        = c
    hl.FillTransparency    = WallHack._fill
    hl.OutlineTransparency = WallHack._outline
    hl.DepthMode           = Enum.HighlightDepthMode.AlwaysOnTop
end

-- повесить highlight
local function AttachHighlight(hum)
    if WallHack._data[hum] then return end
    if WallHack._aliveOnly and hum.Health <= 0 then return end

    local char = hum.Parent
    if not char then return end

    local hl = Instance.new("Highlight")
    hl.Name = "NL_WH_HL"
    hl.Adornee = char
    StyleHighlight(hl)
    hl.Parent = char

    WallHack._data[hum] = { hl = hl, char = char }
end

-- убрать highlight
local function RemoveHighlight(hum)
    local e = WallHack._data[hum]
    if not e then return end
    pcall(function() e.hl:Destroy() end)
    WallHack._data[hum] = nil
end

-- скан Workspace на Humanoid
local function ScanHumanoids()
    if not WallHack._enabled then return end

    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Humanoid") and not WallHack._data[obj] then
            AttachHighlight(obj)
        end
    end

    -- чистим мёртвых/удалённых
    for hum, e in pairs(WallHack._data) do
        if not hum.Parent or not e.char or not e.char.Parent then
            RemoveHighlight(hum)
        elseif WallHack._aliveOnly and hum.Health <= 0 then
            RemoveHighlight(hum)
        end
    end
end

-- основной цикл
local function WallHackLoop()
    if not WallHack._enabled then return end

    -- периодический скан
    local now = os.clock()
    if now - WallHack._tick > WallHack._scanInterval then
        WallHack._tick = now
        ScanHumanoids()
    end

    -- обновление цвета под тему
    local c = NL.Theme.Accent
    for _, e in pairs(WallHack._data) do
        if e.hl and e.hl.Parent and e.hl.FillColor ~= c then
            e.hl.FillColor = c
            e.hl.OutlineColor = c
        end
    end
end

-- остановка
local function StopWallHack()
    WallHack._enabled = false
    if WallHack._loop then
        WallHack._loop:Disconnect()
        WallHack._loop = nil
    end

    -- снести все
    for hum, _ in pairs(WallHack._data) do
        RemoveHighlight(hum)
    end
    WallHack._data = {}

    -- на всякий — sweep по workspace
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj.Name == "NL_WH_HL" then
            pcall(function() obj:Destroy() end)
        end
    end
end

-- запуск
local function StartWallHack()
    StopWallHack()
    WallHack._enabled = true
    WallHack._tick = 0
    ScanHumanoids()
    WallHack._loop = RunService.Heartbeat:Connect(WallHackLoop)
end

-- обновить стиль на лету
local function RefreshWHStyle()
    for _, e in pairs(WallHack._data) do
        StyleHighlight(e.hl)
    end
end

-- регистрация
FeatureRegistry:Register("WallHack", StopWallHack)
NL.WallHack = {
    Start = StartWallHack,
    Stop = StopWallHack,
    State = WallHack,
    Refresh = RefreshWHStyle,
}

--// ═══════════════════════════════════════════════════════════════════════
--//  §79 · WALLHACK · UI
--// ═══════════════════════════════════════════════════════════════════════

local function BuildWallHackUI(group)
    if not group then return end

    group:AddToggle("Enabled", {
        Flag = "wh_enabled",
        Default = false,
        Tooltip = "Подсветка всех Humanoid в игре сквозь стены",
        Callback = function(on)
            if on then
                StartWallHack()
                NL:Notify("WallHack", "Активен", 2, "success")
            else
                StopWallHack()
            end
        end,
    })

    group:AddSlider("Заливка", {
        Flag = "wh_fill",
        Min = 0,
        Max = 1,
        Default = 0.5,
        Decimals = 2,
        Tooltip = "Прозрачность заливки (0 — плотный)",
        Callback = function(v)
            WallHack._fill = v
            RefreshWHStyle()
        end,
    })

    group:AddSlider("Обводка", {
        Flag = "wh_outline",
        Min = 0,
        Max = 1,
        Default = 0.35,
        Decimals = 2,
        Tooltip = "Прозрачность обводки",
        Callback = function(v)
            WallHack._outline = v
            RefreshWHStyle()
        end,
    })

    group:AddToggle("Только живые", {
        Flag = "wh_alive",
        Default = true,
        Tooltip = "Не подсвечивать мёртвых",
        Callback = function(on)
            WallHack._aliveOnly = on
        end,
    })

    group:AddButton("Пересканировать", {
        Tooltip = "Принудительно пересобрать подсветки",
        Callback = function()
            if WallHack._enabled then
                for hum, _ in pairs(WallHack._data) do
                    RemoveHighlight(hum)
                end
                WallHack._data = {}
                ScanHumanoids()
            end
        end,
    })
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §80 · AIM HOLD · ЯДРО
--// ═══════════════════════════════════════════════════════════════════════

local AimHold = {
    _enabled  = false,
    _fov      = 180,
    _hitbox   = "Head",
    _smooth   = 1,
    _minHP    = 20,
    _wallCheck = true,
    _drawFov  = false,
    _debug    = false,

    _loop     = nil,
    _savedType = nil,
    _lastTarget = nil,
    _lastLog  = 0,
}

-- получить позицию hitbox'а
local function GetHitboxPosition(char, hitbox)
    if not char then return nil end

    if hitbox == "Head" then
        local p = char:FindFirstChild("Head")
        return p and p.Position
    elseif hitbox == "Torso" then
        local p = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
        return p and p.Position
    elseif hitbox == "LowerTorso" then
        local p = char:FindFirstChild("LowerTorso")
        return p and p.Position
    elseif hitbox == "HumanoidRootPart" then
        local p = char:FindFirstChild("HumanoidRootPart")
        return p and p.Position
    elseif hitbox == "Random" then
        local parts = { "Head", "UpperTorso", "LowerTorso", "HumanoidRootPart" }
        local pick = parts[math.random(1, #parts)]
        local p = char:FindFirstChild(pick)
        return p and p.Position
    end

    return nil
end

-- проверка видимости (raycast от камеры до цели)
local function IsCharVisible(char, hitPos)
    if not char or not hitPos then return false end

    local cam = Workspace.CurrentCamera
    if not cam then return false end

    local filter = { }
    if LocalPlayer and LocalPlayer.Character then
        table.insert(filter, LocalPlayer.Character)
    end

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Blacklist
    params.FilterDescendantsInstances = filter
    params.IgnoreWater = true

    local origin = cam.CFrame.Position
    local dir = hitPos - origin

    local result = Workspace:Raycast(origin, dir, params)
    if not result then return true end
    return result.Instance:IsDescendantOf(char)
end

-- поиск ближайшей цели к центру экрана
local function FindClosestTarget(fovDeg, hitbox, minHP, useWallCheck)
    local cam = Workspace.CurrentCamera
    if not cam then return nil end

    local center = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
    local maxPix = FovRadiusFromDegrees(fovDeg)

    local best, bestDist, bestPos = nil, maxPix, nil

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local char = plr.Character
            if char and char.Parent then
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 and hum.Health >= minHP then
                    local pos = GetHitboxPosition(char, hitbox)
                    if pos then
                        local sp, onScreen = cam:WorldToViewportPoint(pos)
                        if onScreen and sp.Z > 0 then
                            local dx = sp.X - center.X
                            local dy = sp.Y - center.Y
                            local dist = math.sqrt(dx * dx + dy * dy)
                            if dist < bestDist then
                                local visible = true
                                if useWallCheck then
                                    visible = IsCharVisible(char, pos)
                                end
                                if visible then
                                    best = plr
                                    bestDist = dist
                                    bestPos = pos
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    return best, bestDist, bestPos
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §81 · AIM HOLD · УПРАВЛЕНИЕ КАМЕРОЙ
--// ═══════════════════════════════════════════════════════════════════════

local function AimHoldLog(text)
    if not AimHold._debug then return end
    local now = os.clock()
    if now - AimHold._lastLog < 0.3 then return end
    AimHold._lastLog = now
    print("[AimHold] " .. text)
end

local function AimHoldLoop()
    if not AimHold._enabled then return end

    local cam = Workspace.CurrentCamera
    if not cam then return end

    local target, dist, hitPos = FindClosestTarget(
        AimHold._fov,
        AimHold._hitbox,
        AimHold._minHP,
        AimHold._wallCheck
    )

    if target and hitPos then
        -- лог
        if AimHold._lastTarget ~= target then
            local hp = 0
            if target.Character and target.Character:FindFirstChildOfClass("Humanoid") then
                hp = target.Character:FindFirstChildOfClass("Humanoid").Health
            end
            AimHoldLog(string.format("Target: %s · hp=%d · dist=%.1f", target.Name, hp, dist))
            AimHold._lastTarget = target
        end

        -- переключаемся в Scriptable
        if cam.CameraType ~= Enum.CameraType.Scriptable then
            AimHold._savedType = cam.CameraType
            cam.CameraType = Enum.CameraType.Scriptable
        end

        -- наводимся
        local cur = cam.CFrame
        local tgt = CFrame.new(cur.Position, hitPos)

        if AimHold._smooth <= 1 then
            cam.CFrame = tgt
        else
            local alpha = 1 / AimHold._smooth
            cam.CFrame = cur:Lerp(tgt, alpha)
        end
        return
    end

    -- цели нет
    if AimHold._lastTarget then
        AimHoldLog("Target lost")
        AimHold._lastTarget = nil
    end

    -- возвращаем управление
    if cam.CameraType == Enum.CameraType.Scriptable and AimHold._savedType then
        cam.CameraType = AimHold._savedType
        AimHold._savedType = nil
    end
end

local function StopAimHold()
    AimHold._enabled = false

    if AimHold._loop then
        AimHold._loop:Disconnect()
        AimHold._loop = nil
    end

    -- возвращаем камеру
    local cam = Workspace.CurrentCamera
    if cam and cam.CameraType == Enum.CameraType.Scriptable and AimHold._savedType then
        cam.CameraType = AimHold._savedType
    end
    AimHold._savedType = nil
    AimHold._lastTarget = nil

    DisableFOVCircle()
end

local function StartAimHold()
    StopAimHold()
    AimHold._enabled = true
    AimHold._loop = RunService.RenderStepped:Connect(AimHoldLoop)

    if AimHold._drawFov then
        EnableFOVCircle(FovRadiusFromDegrees(AimHold._fov))
    end
end

FeatureRegistry:Register("AimHold", StopAimHold)
NL.AimHold = {
    Start = StartAimHold,
    Stop  = StopAimHold,
    State = AimHold,
}

