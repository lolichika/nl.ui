--// ═══════════════════════════════════════════════════════════════════════
--//  §187 · ПРОВЕРКА ЦЕЛОСТНОСТИ
--// ═══════════════════════════════════════════════════════════════════════

-- какие части должны быть загружены
local REQUIRED_MODULES = {
    { name = "Ядро",           check = function() return NL._util ~= nil end },
    { name = "Window API",     check = function() return NL.WindowMethods ~= nil end },
    { name = "Виджеты",        check = function() return NL._widgets ~= nil end },
    { name = "Config",         check = function() return NL.Config ~= nil end },
    { name = "Themes",         check = function() return NL.Themes ~= nil end },
    { name = "Search",         check = function() return NL.Search ~= nil end },
    { name = "Game Features",  check = function() return NL.GameFeatures ~= nil end },
    { name = "Effects",        check = function() return NL.EffectsAdv ~= nil end },
    { name = "Layout",         check = function() return NL.LayoutPolish ~= nil end },
    { name = "UI Presets",     check = function() return NL.UIPreset ~= nil end },
    { name = "Builders",       check = function() return NL.Demo ~= nil end },
    { name = "Dev Tools",      check = function() return NL.DevTools ~= nil end },
}

local function VerifyModules()
    local failed = {}
    for _, mod in ipairs(REQUIRED_MODULES) do
        local ok, res = pcall(mod.check)
        if not ok or not res then
            table.insert(failed, mod.name)
        end
    end
    return failed
end

local failedModules = VerifyModules()
if #failedModules > 0 then
    warn("[NL] Не загружены модули: " .. table.concat(failedModules, ", "))
    warn("[NL] Убедись, что все части 1..9 склеены по порядку")
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §188 · AUTO-INITIALIZATION
--// ═══════════════════════════════════════════════════════════════════════

local AutoInit = {
    done = false,
    steps = {},
}

-- шаг инициализации
local function InitStep(name, fn)
    table.insert(AutoInit.steps, { name = name, fn = fn })
end

-- шаги
InitStep("Чистка старых GUI", function()
    pcall(function()
        local root = (gethui and gethui()) or game:GetService("CoreGui")
        if root then
            for _, name in ipairs({ "NeverloseUI", "NL_Interface" }) do
                local old = root:FindFirstChild(name)
                if old then old:Destroy() end
            end
        end
    end)
end)

InitStep("Прогрев кэшей", function()
    Cache.GetViewport()
    Cache.GetCenter()
end)

InitStep("Прогрев иконок", function()
    -- рендер всех иконок в offscreen, чтобы не было фризов
    pcall(function()
        local testHolder = New("Frame", {
            BackgroundTransparency = 1,
            Size = UDim2.new(0, 1, 0, 1),
            Position = UDim2.new(0, -1000, 0, -1000),
            Parent = (NL._window and NL._window._screen) or game:GetService("CoreGui"),
        })
        for name in pairs(Icon) do
            if type(Icon[name]) == "function" then
                pcall(function() Icon[name](testHolder, 16, NL.Theme.Accent) end)
            end
        end
        task.delay(0.1, function()
            pcall(function() testHolder:Destroy() end)
        end)
    end)
end)

InitStep("Загрузка настроек", function()
    pcall(function()
        local settings = NL.Config.LoadSettings()
        if settings.UIScale then
            NL.Settings.UIScale = settings.UIScale
        end
        if settings.WindowOpacity then
            NL.Settings.WindowOpacity = settings.WindowOpacity
        end
        if settings.SidebarMode then
            NL.Settings.SidebarMode = settings.SidebarMode
        end
        if settings.Theme and settings.Theme ~= "default" then
            NL.Themes:Apply(settings.Theme, false)
        end
    end)
end)

InitStep("Старт телеметрии", function()
    if NL.Telemetry and NL.Telemetry.Start then
        NL.Telemetry:Start()
    end
end)

-- запуск всех шагов
local function RunAutoInit()
    if AutoInit.done then return end

    for _, step in ipairs(AutoInit.steps) do
        local ok, err = pcall(step.fn)
        if not ok then
            warn("[NL] InitStep failed (" .. step.name .. "): " .. tostring(err))
        end
    end

    AutoInit.done = true
end

NL.AutoInit = AutoInit

--// ═══════════════════════════════════════════════════════════════════════
--//  §189 · DEMO LAUNCHER
--// ═══════════════════════════════════════════════════════════════════════

-- запустить демо-меню (с опциональной задержкой)
function NL:LaunchDemo(delay)
    delay = tonumber(delay) or 0

    task.delay(delay, function()
        pcall(function()
            RunAutoInit()
            self:BuildDemo()
        end)
    end)
end

-- быстрый запуск без демо (только API)
function NL:LaunchEmpty()
    task.defer(function()
        pcall(function() RunAutoInit() end)
    end)
end

