--//  §95 · ЭКСПОРТ API
--// ═══════════════════════════════════════════════════════════════════════

NL.GameFeatures = {
    WallHack     = NL.WallHack,
    AimHold      = NL.AimHold,
    TriggerBot   = NL.TriggerBot,
    NightMode    = NL.NightMode,
    ShakeRemover = NL.ShakeRemover,
    Optimize     = NL.Optimize,
    DrawFOV      = NL._util.DrawFOV,
    Registry     = FeatureRegistry,
}

print(string.format(
    "[NL v%s] §76-§95 загружено · фич: %d · draw FOV: %s",
    NL.Version,
    (function()
        local c = 0
        for _ in pairs(FeatureRegistry._features) do c = c + 1 end
        return c
    end)(),
    NL.Environment.HasDrawing and "да" or "нет"
))

