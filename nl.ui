function WM:SetSidebarMode(mode)
    SidebarControl:SetMode(mode)
end

function WM:ToggleSidebar()
    SidebarControl:Toggle()
end

function WM:SnapTo(position)
    Docking:Apply(position)
end

function WM:SetSizePreset(name)
    WindowPresets:Apply(name)
end

function WM:ToggleFullscreen()
