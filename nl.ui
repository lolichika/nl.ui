--//  §72 · HOTKEYS · ЦЕНТРАЛЬНЫЙ РЕЕСТР
--// ═══════════════════════════════════════════════════════════════════════

local HotkeyRegistry = {
    entries = {},

    Add = function(name, key, mode)
        table.insert(HotkeyRegistry.entries, {
            name = name,
            key  = key,
            mode = mode or "toggle",
        })
    end,

    Remove = function(name)
        for i, e in ipairs(HotkeyRegistry.entries) do
            if e.name == name then
                table.remove(HotkeyRegistry.entries, i)
                return
            end
        end
    end,

    Clear = function()
        HotkeyRegistry.entries = {}
    end,

    Get = function()
        local copy = {}
        for _, e in ipairs(HotkeyRegistry.entries) do
            table.insert(copy, e)
        end
        return copy
    end,
}

NL.Hotkeys = HotkeyRegistry

--// ═══════════════════════════════════════════════════════════════════════
--//  §73 · SESSION · АПТАЙМ И СЧЁТЧИКИ
--// ═══════════════════════════════════════════════════════════════════════

local Session = {
    startTime    = tick(),
    notifications = 0,
    actions      = 0,
    configSaves  = 0,
    configLoads  = 0,
}

function Session:Uptime()
    local up = tick() - self.startTime
    local min = math.floor(up / 60)
    local sec = math.floor(up % 60)
    return string.format("%d:%02d", min, sec)
end

function Session:ToTable()
    return {
        uptime        = self:Uptime(),
        notifications = self.notifications,
        actions       = self.actions,
        configSaves   = self.configSaves,
        configLoads   = self.configLoads,
    }
end

-- оборачиваем Notify для счётчика
local BaseNotify = NL.Notify
NL.Notify = function(self, ...)
    Session.notifications = Session.notifications + 1
    return BaseNotify(self, ...)
end

-- оборачиваем конфиг-операции
local BaseSaveConfig = SaveConfig
SaveConfig = function(name)
    Session.configSaves = Session.configSaves + 1
    return BaseSaveConfig(name)
end
NL.Config.Save = SaveConfig

local BaseLoadConfig = LoadConfig
LoadConfig = function(name)
    Session.configLoads = Session.configLoads + 1
    return BaseLoadConfig(name)
end
NL.Config.Load = LoadConfig

NL.Session = Session

--// ═══════════════════════════════════════════════════════════════════════
--//  §74 · АВТОЗАГРУЗКА ПРИ СТАРТЕ
--// ═══════════════════════════════════════════════════════════════════════

task.defer(function()
    if not NL.Settings.AutoLoad then return end

    local settings = LoadSettingsFile()

    -- тема
    if settings.Theme == "custom" and settings.CustomAccent then
        ApplySavedCustom(settings)
    elseif settings.Theme and settings.Theme ~= "default" then
        ApplyThemeByKey(settings.Theme, false)
    end

    -- конфиг
    if settings.AutoLoad then
        local name = settings.AutoLoad
        local content = ReadConfig(name)
        if content then
            local data = DecodeConfig(content)
            if data then
                local applied = ApplyConfigData(data)
                Config.selected = name
                if Config.rebuildFn then Config.rebuildFn() end
                if applied > 0 then
                    NL:Notify(
                        NL.Settings.WMCheatName,
                        "Автозагрузка «" .. name .. "» · " .. applied,
                        6, "success"
                    )
                end
            end
        end
    end
end)

