end

-- экспорт
NL.LayoutPolish = {
    Layout          = LayoutManager,
    Sidebar         = SidebarControl,
    HoverReveal     = HoverReveal,
    WindowSnap      = WindowSnap,
    Docking         = Docking,
    WindowPresets   = WindowPresets,
    Zoom            = Zoom,
    WindowOpacity   = WindowOpacity,
    Fullscreen      = FullscreenMode,
    CompactMode     = CompactMode,
    LayoutPresets   = LayoutPresets,
    TabReorder      = TabReorder,
    DragGhost       = DragGhost,
    ResizeHandles   = ResizeHandles,
    AutoHide        = AutoHide,
    Performance     = Performance,
}

-- привязать автозум
Zoom:BindWheel()

-- применить сохранённые настройки
task.defer(function()
    if NL.Settings.UIScale then
        Zoom:Set(NL.Settings.UIScale)
    end
    if NL.Settings.WindowOpacity then
        WindowOpacity:Set(NL.Settings.WindowOpacity)
    end
    if NL.Settings.SidebarMode then
        SidebarControl:SetMode(NL.Settings.SidebarMode)
    end
    if NL.Settings.Docked then
        Docking:Apply(NL.Settings.Docked)
    end
end)

-- хук на создание окна
local BaseCreateWindow7 = NL.CreateWindow
NL.CreateWindow = function(self, cfg)
    local win = BaseCreateWindow7(self, cfg)

    -- инициализация snap-зон
    task.defer(function()
        WindowSnap:Init()
    end)

    -- ресайз-хук
    task.defer(function()
        Connect(win._root:GetPropertyChangedSignal("AbsoluteSize"), function()
            LayoutManager:Update(win._root.AbsoluteSize.X, win._root.AbsoluteSize.Y)
            ApplyAdaptiveLayout(win._root.AbsoluteSize.X)
        end)
    end)

    return win
end

print(string.format(
    "[NL v%s] §120-§140 загружено · layout manager · sidebar · zoom · docking",
    NL.Version
))

