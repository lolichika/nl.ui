--// ═══════════════════════════════════════════════════════════════════════
--//  §07 · ЗАЩИТА ОТ ПОВТОРНОЙ ЗАГРУЗКИ
--// ═══════════════════════════════════════════════════════════════════════

do
    local names = {
        "NeverloseUI",
        "NeverloseUI_v2",
        "NeverloseUI_v3",
        "NL_Interface",
        "NL_Interface_v2",
        "NL_Interface_v3",
        "HvH_UI",
    }

    -- чистим CoreGui
    pcall(function()
        local root = (gethui and gethui()) or CoreGui
        if root then
            for _, guiName in ipairs(names) do
                local old = root:FindFirstChild(guiName)
                if old then
                    pcall(function() old:Destroy() end)
                end
            end
        end
    end)

    -- чистим PlayerGui
    if LocalPlayer then
        pcall(function()
            local pg = LocalPlayer:FindFirstChild("PlayerGui")
            if pg then
                for _, guiName in ipairs(names) do
                    local old = pg:FindFirstChild(guiName)
                    if old then
                        pcall(function() old:Destroy() end)
                    end
                end
            end
        end)
    end
end

