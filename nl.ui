--// ═══════════════════════════════════════════════════════════════════════
--//  §38 · GROUP · РЕГИСТРАЦИЯ ЭЛЕМЕНТОВ
--// ═══════════════════════════════════════════════════════════════════════

function GroupMethods:_register(el)
    if not el or not el._frame then return el end

    el._frame.Parent = self._body
    el._frame.LayoutOrder = #self._elements + 1
    el._group = self
    el._tab = self._tab

    table.insert(self._elements, el)
    if el.Flag then
        table.insert(NL.Elements, el)
    end

    self:_updateHeight()
    NL._recalcTab(self._tab)

    return el
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §39 · TOGGLE
--// ═══════════════════════════════════════════════════════════════════════

local function MakeToggle(name, opts)
    opts = opts or {}
    local flag = opts.Flag or name
    local state = (opts.Default == true)
    NL.Flags[flag] = state

    -- контейнер
    local frame = New("TextButton", {
        Text = "",
        BackgroundColor3 = Theme.Element,
        AutoButtonColor = false,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 30),
    })
    Round(frame, Theme.RadiusElement)

    -- название
    New("TextLabel", {
        Text = name,
        Font = Theme.Font,
        TextSize = 12,
        TextColor3 = Theme.Text,
        TextXAlignment = Enum.TextXAlignment.Left,
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, 10, 0.5, 0),
        Size = UDim2.new(1, -60, 0, 14),
        BackgroundTransparency = 1,
        ZIndex = 2,
        Parent = frame,
    })

    -- свитч
    local switch = New("Frame", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -8, 0.5, 0),
        Size = UDim2.new(0, 34, 0, 18),
        BackgroundColor3 = state and Theme.Accent or Theme.List,
        BorderSizePixel = 0,
        ZIndex = 2,
        Parent = frame,
    })
    Circle(switch)

    -- knob
    local knob = New("Frame", {
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, state and 19 or 2, 0.5, 0),
        Size = UDim2.new(0, 14, 0, 14),
        BackgroundColor3 = state and Color3.fromRGB(255, 255, 255) or Theme.TextSub,
        BorderSizePixel = 0,
        ZIndex = 3,
        Parent = switch,
    })
    Circle(knob)

    -- объект
    local el = {
        _frame = frame,
        _height = 30,
        _type = "Toggle",
        Flag = flag,
        Name = name,
    }

    -- установка значения
    local function set(value, silent)
        state = (value == true)
        NL.Flags[flag] = state

        Tween(switch, Theme.AnimNormal, {
            BackgroundColor3 = state and Theme.Accent or Theme.List,
        })
        Tween(knob, Theme.AnimNormal, {
            Position = UDim2.new(0, state and 19 or 2, 0.5, 0),
            BackgroundColor3 = state and Color3.fromRGB(255, 255, 255) or Theme.TextSub,
        })

        if not silent and opts.Callback then
            SafeCall(opts.Callback, state)
        end
    end

    -- hover
    frame.MouseEnter:Connect(function()
        Tween(frame, Theme.AnimFast, { BackgroundColor3 = Theme.ElementHover })
    end)
    frame.MouseLeave:Connect(function()
        Tween(frame, Theme.AnimFast, { BackgroundColor3 = Theme.Element })
    end)

    -- клик
    frame.MouseButton1Click:Connect(function()
        PlaySound()
        set(not state)
    end)

    -- ripple
    frame.MouseButton1Down:Connect(function()
        Effects.Ripple(frame, Theme.AccentBright)
    end)

    BindTooltip(frame, opts)

    el.Set = set
    el.Get = function() return state end
    el.Toggle = function() set(not state) end

    return el
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §40 · SLIDER
--// ═══════════════════════════════════════════════════════════════════════

local function MakeSlider(name, opts)
    opts = opts or {}
    local flag = opts.Flag or name
    local minv = opts.Min or 0
    local maxv = opts.Max or 100
    if maxv <= minv then maxv = minv + 1 end

    local decimals = opts.Decimals or 0
    local suffix = opts.Suffix or ""
    local step = opts.Step
    local value = math.clamp(opts.Default or minv, minv, maxv)
    NL.Flags[flag] = value

    -- контейнер
    local frame = New("Frame", {
        BackgroundColor3 = Theme.Element,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 46),
    })
    Round(frame, Theme.RadiusElement)

    -- название
    New("TextLabel", {
        Text = name,
        Font = Theme.Font,
        TextSize = 12,
        TextColor3 = Theme.Text,
        TextXAlignment = Enum.TextXAlignment.Left,
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, 10, 0, 14),
        Size = UDim2.new(1, -80, 0, 14),
        BackgroundTransparency = 1,
        ZIndex = 2,
        Parent = frame,
    })

    -- значение
    local valLabel = New("TextLabel", {
        Text = "",
        Font = Theme.Font,
        TextSize = 11,
        TextColor3 = Theme.Accent,
        TextXAlignment = Enum.TextXAlignment.Right,
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -10, 0, 14),
        Size = UDim2.new(0, 68, 0, 12),
        BackgroundTransparency = 1,
        ZIndex = 2,
        Parent = frame,
    })

    -- трек
    local track = New("Frame", {
        Position = UDim2.new(0, 10, 0, 32),
        Size = UDim2.new(1, -20, 0, 4),
        BackgroundColor3 = Theme.List,
        BorderSizePixel = 0,
        ZIndex = 2,
        Parent = frame,
    })
    Circle(track)

    -- заполнение
    local fill = New("Frame", {
        Size = UDim2.new(0, 0, 1, 0),
        BackgroundColor3 = Theme.Accent,
        BorderSizePixel = 0,
        ZIndex = 3,
        Parent = track,
    })
    Circle(fill)
    Gradient(fill, Theme.Accent, Theme.AccentBright, 0)

    -- knob (шарик на конце)
    local knob = New("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Size = UDim2.new(0, 11, 0, 11),
        Position = UDim2.new(0, 0, 0.5, 0),
        BackgroundColor3 = Theme.TextBright,
        BorderSizePixel = 0,
        ZIndex = 4,
        Parent = track,
    })
    Circle(knob)
    -- обводка knob'а
    Stroke(knob, Theme.Accent, 2, 0)

    local el = { _frame = frame, _height = 46, _type = "Slider", Flag = flag, Name = name }

    -- формат значения
    local function formatValue(v)
        local s
        if decimals <= 0 then
            s = tostring(math.floor(v + 0.5))
        else
            s = string.format("%." .. decimals .. "f", v)
        end
        return s .. suffix
    end

    -- установка
    local function set(v, silent)
        v = math.clamp(v, minv, maxv)
        if step and step > 0 then
            v = math.clamp(minv + math.floor((v - minv) / step + 0.5) * step, minv, maxv)
        end
        value = v
        NL.Flags[flag] = v

        local frac = (v - minv) / (maxv - minv)
        fill.Size = UDim2.new(frac, 0, 1, 0)
        knob.Position = UDim2.new(frac, 0, 0.5, 0)
        valLabel.Text = formatValue(v)

        if not silent and opts.Callback then
            SafeCall(opts.Callback, v)
        end
    end

    -- ввод с клика
    local dragging = false

    local function updateFromInput(inputPos)
        if track.AbsoluteSize.X <= 0 then return end
        local rel = math.clamp(inputPos.X - track.AbsolutePosition.X, 0, track.AbsoluteSize.X)
        local newV = minv + (rel / track.AbsoluteSize.X) * (maxv - minv)
        set(newV)
    end

    -- хитбокс
    local hitbox = New("Frame", {
        BackgroundTransparency = 1,
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, -8, 0.5, 0),
        Size = UDim2.new(1, 16, 0, 24),
        ZIndex = 5,
        Parent = track,
    })

    hitbox.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            updateFromInput(input.Position)
        end
    end)

    Connect(UserInputService.InputChanged, function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch) then
            updateFromInput(input.Position)
        end
    end)

    Connect(UserInputService.InputEnded, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            if dragging then
                dragging = false
                if opts.Finished then SafeCall(opts.Finished, value) end
            end
        end
    end)

    -- hover
    frame.MouseEnter:Connect(function()
        Tween(frame, Theme.AnimFast, { BackgroundColor3 = Theme.ElementHover })
        Tween(knob, Theme.AnimFast, { Size = UDim2.new(0, 13, 0, 13) })
    end)
    frame.MouseLeave:Connect(function()
        Tween(frame, Theme.AnimFast, { BackgroundColor3 = Theme.Element })
        Tween(knob, Theme.AnimFast, { Size = UDim2.new(0, 11, 0, 11) })
    end)

    BindTooltip(frame, opts)

    -- начальная установка
    set(value, true)

    el.Set = set
    el.Get = function() return value end

    return el
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §41 · BUTTON
--// ═══════════════════════════════════════════════════════════════════════

local function MakeButton(name, opts)
    opts = opts or {}
    local frame = New("TextButton", {
        Text = name,
        Font = Theme.Font,
        TextSize = 12,
        TextColor3 = Theme.Text,
        BackgroundColor3 = Theme.Element,
        AutoButtonColor = false,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 30),
    })
    Round(frame, Theme.RadiusElement)

    frame.MouseEnter:Connect(function()
        Tween(frame, Theme.AnimFast, {
            BackgroundColor3 = Theme.Accent,
            TextColor3 = Color3.fromRGB(255, 255, 255),
        })
    end)
    frame.MouseLeave:Connect(function()
        Tween(frame, Theme.AnimFast, {
            BackgroundColor3 = Theme.Element,
            TextColor3 = Theme.Text,
        })
    end)
    frame.MouseButton1Down:Connect(function()
        Effects.Ripple(frame, Theme.AccentBright)
    end)
    frame.MouseButton1Click:Connect(function()
        PlaySound()
        if opts.Callback then
            SafeCall(opts.Callback)
        end
    end)

    BindTooltip(frame, opts)

    return {
        _frame = frame,
        _height = 30,
        _type = "Button",
        Name = name,
    }
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §42 · LABEL
--// ═══════════════════════════════════════════════════════════════════════

local function MakeLabel(text, opts)
    opts = opts or {}
    local frame = New("TextLabel", {
        Text = text or "",
        Font = Theme.Font,
        TextSize = 11,
        TextColor3 = opts.Color or Theme.TextSub,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextWrapped = opts.Wrap == true,
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, 10, 0, 10),
        Size = UDim2.new(1, -16, 0, 14),
        BackgroundTransparency = 1,
    })

    local h = 22
    if opts.Wrap then
        h = 30
    end

    BindTooltip(frame, opts)

    return {
        _frame = frame,
        _height = h,
        _type = "Label",
        Name = text,
        SetText = function(t)
            frame.Text = tostring(t or "")
        end,
    }
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §43 · DIVIDER
--// ═══════════════════════════════════════════════════════════════════════

local function MakeDivider()
    local frame = New("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 12),
    })

    New("Frame", {
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, 8, 0.5, 0),
        Size = UDim2.new(1, -16, 0, 1),
        BackgroundColor3 = Theme.Divider,
        BorderSizePixel = 0,
        Parent = frame,
    })

    return {
        _frame = frame,
        _height = 12,
        _type = "Divider",
        Name = "Divider",
    }
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §44 · SEPARATOR
--// ═══════════════════════════════════════════════════════════════════════

local function MakeSeparator(text, opts)
    opts = opts or {}
    local frame = New("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 22),
    })

    -- линия слева
    New("Frame", {
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, 10, 0.5, 0),
        Size = UDim2.new(0.15, -10, 0, 1),
        BackgroundColor3 = Theme.Divider,
        BorderSizePixel = 0,
        Parent = frame,
    })

    -- текст
    New("TextLabel", {
        Text = string.upper(text or ""),
        Font = Theme.FontBold,
        TextSize = 9,
        TextColor3 = Theme.TextDim,
        TextXAlignment = Enum.TextXAlignment.Left,
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0.15, 4, 0.5, 0),
        Size = UDim2.new(0.5, 0, 0, 12),
        BackgroundTransparency = 1,
        Parent = frame,
    })

    -- линия справа
    New("Frame", {
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0.65, 4, 0.5, 0),
        Size = UDim2.new(0.35, -10, 0, 1),
        BackgroundColor3 = Theme.Divider,
        BorderSizePixel = 0,
        Parent = frame,
    })

    return {
        _frame = frame,
        _height = 22,
        _type = "Separator",
        Name = text,
    }
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §45 · INFO · WARNING
--// ═══════════════════════════════════════════════════════════════════════

local function MakeInfoBlock(text, color, iconName)
    color = color or Theme.TextSub
    iconName = iconName or "Dot"

    local frame = New("Frame", {
        BackgroundColor3 = Theme.Element,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 36),
    })
    Round(frame, Theme.RadiusElement)

    -- акцентная полоска
    New("Frame", {
        Position = UDim2.new(0, 0, 0, 6),
        Size = UDim2.new(0, 3, 1, -12),
        BackgroundColor3 = color,
        BorderSizePixel = 0,
        Parent = frame,
    })

    -- иконка
    local iconHolder = New("Frame", {
        Position = UDim2.new(0, 12, 0.5, -8),
        Size = UDim2.new(0, 16, 0, 16),
        BackgroundTransparency = 1,
        Parent = frame,
    })
    local ic = Icon.new(iconName, iconHolder, 14, color)
    ic.Position = UDim2.new(0.5, -7, 0.5, -7)

    -- текст
    New("TextLabel", {
        Text = text or "",
        Font = Theme.Font,
        TextSize = 11,
        TextColor3 = color,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextWrapped = true,
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, 34, 0.5, 0),
        Size = UDim2.new(1, -42, 1, -8),
        BackgroundTransparency = 1,
    })

    return {
        _frame = frame,
        _height = 36,
        _type = "Info",
        Name = text,
    }
end

local function MakeWarningBlock(text)
    return MakeInfoBlock(text, Theme.Warning, "Bell")
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §46 · BUTTONROW
--// ═══════════════════════════════════════════════════════════════════════

local function MakeButtonRow(buttons, opts)
    opts = opts or {}
    local frame = New("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 30),
    })

    local count = #buttons
    if count == 0 then
        return { _frame = frame, _height = 30, _type = "ButtonRow", Name = "EmptyRow" }
    end

    local gap = 6
    local eachW = 1 / count

    for i, btn in ipairs(buttons) do
        local b = New("TextButton", {
            Text = btn.Text or "Button",
            Font = Theme.Font,
            TextSize = 11,
            TextColor3 = Theme.Text,
            BackgroundColor3 = Theme.Element,
            AutoButtonColor = false,
            BorderSizePixel = 0,
            AnchorPoint = Vector2.new(0, 0),
            Position = UDim2.new(eachW * (i - 1), 0, 0, 0),
            Size = UDim2.new(eachW, -(gap * (count - 1)) / count, 0, 30),
            Parent = frame,
        })
        Round(b, Theme.RadiusElement)

        b.MouseEnter:Connect(function()
            Tween(b, Theme.AnimFast, {
                BackgroundColor3 = btn.Color or Theme.Accent,
                TextColor3 = Color3.fromRGB(255, 255, 255),
            })
        end)
        b.MouseLeave:Connect(function()
            Tween(b, Theme.AnimFast, {
                BackgroundColor3 = Theme.Element,
                TextColor3 = Theme.Text,
            })
        end)
        b.MouseButton1Down:Connect(function()
            Effects.Ripple(b, Theme.AccentBright)
        end)
        b.MouseButton1Click:Connect(function()
            PlaySound()
            if btn.Callback then SafeCall(btn.Callback) end
        end)
    end

    return {
        _frame = frame,
        _height = 30,
        _type = "ButtonRow",
        Name = "ButtonRow",
    }
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §47 · CHECKBOX
--// ═══════════════════════════════════════════════════════════════════════

local function MakeCheckbox(name, opts)
    opts = opts or {}
    local flag = opts.Flag or name
    local state = (opts.Default == true)
    NL.Flags[flag] = state

    local frame = New("TextButton", {
        Text = "",
        BackgroundColor3 = Theme.Element,
        AutoButtonColor = false,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 30),
    })
    Round(frame, Theme.RadiusElement)

    -- чекбокс
    local box = New("Frame", {
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, 10, 0.5, 0),
        Size = UDim2.new(0, 16, 0, 16),
        BackgroundColor3 = state and Theme.Accent or Theme.List,
        BorderSizePixel = 0,
        ZIndex = 2,
        Parent = frame,
    })
    Round(box, 4)
    local boxStroke = Stroke(box, state and Theme.Accent or Theme.Stroke)

    -- галочка
    local checkIcon = Icon.new("Check", box, 11, Color3.fromRGB(255, 255, 255))
    checkIcon.Position = UDim2.new(0.5, -5.5, 0.5, -5.5)
    checkIcon.ZIndex = 3
    checkIcon.Visible = state

    -- название
    New("TextLabel", {
        Text = name,
        Font = Theme.Font,
        TextSize = 12,
        TextColor3 = Theme.Text,
        TextXAlignment = Enum.TextXAlignment.Left,
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, 34, 0.5, 0),
        Size = UDim2.new(1, -44, 0, 14),
        BackgroundTransparency = 1,
        ZIndex = 2,
        Parent = frame,
    })

    local el = { _frame = frame, _height = 30, _type = "Checkbox", Flag = flag, Name = name }

    local function set(v, silent)
        state = (v == true)
        NL.Flags[flag] = state

        Tween(box, Theme.AnimNormal, { BackgroundColor3 = state and Theme.Accent or Theme.List })
        Tween(boxStroke, Theme.AnimNormal, { Color = state and Theme.Accent or Theme.Stroke })
        checkIcon.Visible = state

        if not silent and opts.Callback then SafeCall(opts.Callback, state) end
    end

    frame.MouseEnter:Connect(function()
        Tween(frame, Theme.AnimFast, { BackgroundColor3 = Theme.ElementHover })
    end)
    frame.MouseLeave:Connect(function()
        Tween(frame, Theme.AnimFast, { BackgroundColor3 = Theme.Element })
    end)
    frame.MouseButton1Click:Connect(function()
        PlaySound()
        set(not state)
    end)
    frame.MouseButton1Down:Connect(function()
        Effects.Ripple(frame, Theme.AccentBright)
    end)

    BindTooltip(frame, opts)

    el.Set = set
    el.Get = function() return state end
    return el
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §48 · TEXTINPUT
--// ═══════════════════════════════════════════════════════════════════════

local function MakeTextInput(name, opts)
    opts = opts or {}
    local flag = opts.Flag or name
    local value = opts.Default or ""
    NL.Flags[flag] = value

    local frame = New("Frame", {
        BackgroundColor3 = Theme.Element,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 46),
    })
    Round(frame, Theme.RadiusElement)

    -- название
    New("TextLabel", {
        Text = name,
        Font = Theme.Font,
        TextSize = 12,
        TextColor3 = Theme.Text,
        TextXAlignment = Enum.TextXAlignment.Left,
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, 10, 0, 12),
        Size = UDim2.new(1, -20, 0, 14),
        BackgroundTransparency = 1,
        ZIndex = 2,
        Parent = frame,
    })

    -- поле
    local box = New("TextBox", {
        Text = value,
        PlaceholderText = opts.Placeholder or "",
        Font = Theme.Font,
        TextSize = 11,
        TextColor3 = Theme.Text,
        PlaceholderColor3 = Theme.TextPlaceholder,
        TextXAlignment = Enum.TextXAlignment.Left,
        ClearTextOnFocus = false,
        BackgroundColor3 = Theme.List,
        Position = UDim2.new(0, 8, 0, 26),
        Size = UDim2.new(1, -16, 0, 26),
        ClipsDescendants = true,
        ZIndex = 2,
        Parent = frame,
    })
    Round(box, Theme.RadiusElement - 2)
    local boxStroke = Stroke(box, Theme.Stroke)
    Padding(box, 0, 10, 0, 10)

    local el = { _frame = frame, _height = 46, _type = "TextInput", Flag = flag, Name = name }

    box.Focused:Connect(function()
        Tween(box, Theme.AnimFast, { BackgroundColor3 = Theme.ElementHover })
        Tween(boxStroke, Theme.AnimFast, { Color = Theme.Accent })
    end)
    box.FocusLost:Connect(function(enterPressed)
        Tween(box, Theme.AnimFast, { BackgroundColor3 = Theme.List })
        Tween(boxStroke, Theme.AnimFast, { Color = Theme.Stroke })

        value = box.Text
        NL.Flags[flag] = value

        if opts.FocusLost then SafeCall(opts.FocusLost, value, enterPressed) end
        if not opts.Live and opts.Callback then SafeCall(opts.Callback, value) end
    end)

    if opts.Live then
        box:GetPropertyChangedSignal("Text"):Connect(function()
            value = box.Text
            NL.Flags[flag] = value
            if opts.Callback then SafeCall(opts.Callback, value) end
        end)
    end

    BindTooltip(frame, opts)

    el.Set = function(v, silent)
        value = tostring(v or "")
        box.Text = value
        NL.Flags[flag] = value
        if not silent and opts.Callback then SafeCall(opts.Callback, value) end
    end
    el.Get = function() return value end
    el.Clear = function()
        box.Text = ""
        value = ""
        NL.Flags[flag] = ""
    end

    return el
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §49 · NUMBERINPUT (текстовый, но с валидацией чисел)
--// ═══════════════════════════════════════════════════════════════════════

local function MakeNumberInput(name, opts)
    opts = opts or {}
    local flag = opts.Flag or name
    local minv = opts.Min or -math.huge
    local maxv = opts.Max or math.huge
    local decimals = opts.Decimals or 0
    local value = opts.Default or minv ~= -math.huge and minv or 0
    value = math.clamp(tonumber(value) or 0, minv, maxv)
    NL.Flags[flag] = value

    local frame = New("Frame", {
        BackgroundColor3 = Theme.Element,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 46),
    })
    Round(frame, Theme.RadiusElement)

    New("TextLabel", {
        Text = name,
        Font = Theme.Font,
        TextSize = 12,
        TextColor3 = Theme.Text,
        TextXAlignment = Enum.TextXAlignment.Left,
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, 10, 0, 12),
        Size = UDim2.new(1, -20, 0, 14),
        BackgroundTransparency = 1,
        ZIndex = 2,
        Parent = frame,
    })

    local box = New("TextBox", {
        Text = string.format("%." .. decimals .. "f", value),
        PlaceholderText = "0",
        Font = Theme.Font,
        TextSize = 11,
        TextColor3 = Theme.Text,
        PlaceholderColor3 = Theme.TextPlaceholder,
        TextXAlignment = Enum.TextXAlignment.Left,
        ClearTextOnFocus = false,
        BackgroundColor3 = Theme.List,
        Position = UDim2.new(0, 8, 0, 26),
        Size = UDim2.new(1, -16, 0, 26),
        ZIndex = 2,
        Parent = frame,
    })
    Round(box, Theme.RadiusElement - 2)
    Stroke(box, Theme.Stroke)
    Padding(box, 0, 10, 0, 10)

    local el = { _frame = frame, _height = 46, _type = "NumberInput", Flag = flag, Name = name }

    local function parseValue(str)
        local num = tonumber(str)
        if not num then return nil end
        return math.clamp(num, minv, maxv)
    end

    box.Focused:Connect(function()
        Tween(box, Theme.AnimFast, { BackgroundColor3 = Theme.ElementHover })
    end)
    box.FocusLost:Connect(function()
        Tween(box, Theme.AnimFast, { BackgroundColor3 = Theme.List })

        local num = parseValue(box.Text)
        if num then
            value = num
            NL.Flags[flag] = value
            box.Text = string.format("%." .. decimals .. "f", value)
            if opts.Callback then SafeCall(opts.Callback, value) end
        else
            -- откат
            box.Text = string.format("%." .. decimals .. "f", value)
        end
    end)

    el.Set = function(v, silent)
        local num = tonumber(v)
        if num then
            value = math.clamp(num, minv, maxv)
            box.Text = string.format("%." .. decimals .. "f", value)
            NL.Flags[flag] = value
            if not silent and opts.Callback then SafeCall(opts.Callback, value) end
        end
    end
    el.Get = function() return value end

    return el
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §50 · DROPDOWN (single + multi)
--// ═══════════════════════════════════════════════════════════════════════

local function RegisterPopup(popup)
    if NL._activeDropdown and NL._activeDropdown ~= popup then
        pcall(NL._activeDropdown.Close)
    end
    NL._activeDropdown = popup
end

local function MakeDropdown(name, options, opts, group)
    opts = opts or {}
    local multi = opts.Multi == true
    local flag = opts.Flag or name

    -- items
    local items = {}
    for i, v in ipairs(options or {}) do items[i] = tostring(v) end

    -- selected
    local selected
    if multi then
        selected = {}
        for _, d in ipairs(opts.Default or {}) do
            table.insert(selected, tostring(d))
        end
        NL.Flags[flag] = selected
    else
        selected = (opts.Default ~= nil and tostring(opts.Default)) or items[1] or ""
        NL.Flags[flag] = selected
    end

    -- контейнер
    local frame = New("Frame", {
        BackgroundColor3 = Theme.Element,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 30),
    })
    Round(frame, Theme.RadiusElement)

    -- название
    New("TextLabel", {
        Text = name,
        Font = Theme.Font,
        TextSize = 12,
        TextColor3 = Theme.Text,
        TextXAlignment = Enum.TextXAlignment.Left,
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, 10, 0.5, 0),
        Size = UDim2.new(1, -130, 0, 14),
        BackgroundTransparency = 1,
        ZIndex = 2,
        Parent = frame,
    })

    -- функция отображения
    local function displayText()
        if multi then
            local n = #selected
            if n == 0 then return "none" end
            if n == 1 then return selected[1] end
            if n == 2 then return selected[1] .. ", " .. selected[2] end
            return selected[1] .. " +" .. (n - 1)
        end
        if selected == "" then return "none" end
        return selected
    end

    -- box (кнопка-открывашка)
    local box = New("TextButton", {
        Text = displayText(),
        Font = Theme.Font,
        TextSize = 10,
        TextColor3 = Theme.TextSub,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -8, 0.5, 0),
        Size = UDim2.new(0, 110, 0, 22),
        BackgroundColor3 = Theme.List,
        AutoButtonColor = false,
        BorderSizePixel = 0,
        ZIndex = 2,
        Parent = frame,
    })
    Round(box, Theme.RadiusElement - 2)
    Stroke(box, Theme.Stroke)
    Padding(box, 0, 22, 0, 10)

    local arrow = Icon.new("ChevronDown", box, 12, Theme.TextDim)
    arrow.Position = UDim2.new(1, -16, 0.5, -6)
    arrow.ZIndex = 3

    local el = { _frame = frame, _height = 30, _type = "Dropdown", Flag = flag, Name = name }

    local list, followConn, outConn
    local lastClose = 0

    local function closeList()
        lastClose = os.clock()
        if followConn then followConn:Disconnect(); followConn = nil end
        if outConn then outConn:Disconnect(); outConn = nil end
        if list then list:Destroy(); list = nil end
        if NL._activeDropdown == el then NL._activeDropdown = nil end
        Tween(arrow, Theme.AnimFast, { Rotation = 0 })
    end
    el.Close = closeList

    local function isSelected(v)
        if multi then return table.find(selected, v) ~= nil end
        return v == selected
    end

    local function openList()
        if #items == 0 then return end
        RegisterPopup(el)

        local root = group._tab._window._root
        local itemH = 26
        local longest = 0
        for _, opt in ipairs(items) do
            longest = math.max(longest, #opt)
        end
        local width = math.clamp(longest * 7 + (multi and 50 or 30), 130, 260)
        local visible = math.min(#items, opts.MaxVisible or 8)
        local listH = visible * itemH + 8

        list = New("Frame", {
            Size = UDim2.new(0, width, 0, listH),
            BackgroundColor3 = Theme.Popout,
            BorderSizePixel = 0,
            ZIndex = 300,
            Parent = root,
        })
        Round(list, Theme.RadiusGroup)
        Stroke(list, Theme.StrokeLight)

        local listScroll = New("ScrollingFrame", {
            Position = UDim2.new(0, 4, 0, 4),
            Size = UDim2.new(1, -8, 1, -8),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            ScrollBarThickness = 2,
            ScrollBarImageColor3 = Theme.Accent,
            CanvasSize = UDim2.new(0, 0, 0, #items * itemH),
            ZIndex = 301,
            Parent = list,
        })
        VLayout(listScroll, 0)
        Padding(listScroll, 0, 4, 0, 0)

        for i, opt in ipairs(items) do
            local item = New("TextButton", {
                Text = "",
                BackgroundColor3 = isSelected(opt) and Theme.ElementHover or Theme.Popout,
                AutoButtonColor = false,
                BorderSizePixel = 0,
                Size = UDim2.new(1, 0, 0, itemH),
                LayoutOrder = i,
                ZIndex = 302,
                Parent = listScroll,
            })
            Round(item, 5)

            local checkbox, itemLabel
            if multi then
                checkbox = New("Frame", {
                    AnchorPoint = Vector2.new(0, 0.5),
                    Position = UDim2.new(0, 8, 0.5, 0),
                    Size = UDim2.new(0, 14, 0, 14),
                    BackgroundColor3 = isSelected(opt) and Theme.Accent or Theme.List,
                    BorderSizePixel = 0,
                    ZIndex = 303,
                    Parent = item,
                })
                Round(checkbox, 4)
                local cbStroke = Stroke(checkbox, isSelected(opt) and Theme.Accent or Theme.Stroke)
                local mark = New("TextLabel", {
                    Text = isSelected(opt) and "✓" or "",
                    Font = Theme.FontBold,
                    TextSize = 10,
                    TextColor3 = Color3.fromRGB(255, 255, 255),
                    Size = UDim2.new(1, 0, 1, 0),
                    BackgroundTransparency = 1,
                    ZIndex = 304,
                    Parent = checkbox,
                })
                itemLabel = New("TextLabel", {
                    Text = opt,
                    Font = Theme.Font,
                    TextSize = 11,
                    TextColor3 = isSelected(opt) and Theme.Text or Theme.TextSub,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    AnchorPoint = Vector2.new(0, 0.5),
                    Position = UDim2.new(0, 30, 0.5, 0),
                    Size = UDim2.new(1, -36, 0, 12),
                    BackgroundTransparency = 1,
                    ZIndex = 303,
                    Parent = item,
                })

                item.MouseButton1Click:Connect(function()
                    PlaySound()
                    local idx = table.find(selected, opt)
                    if idx then
                        table.remove(selected, idx)
                    else
                        table.insert(selected, opt)
                    end
                    local sel = isSelected(opt)

                    Tween(item, Theme.AnimFast, { BackgroundColor3 = sel and Theme.ElementHover or Theme.Popout })
                    Tween(checkbox, Theme.AnimNormal, { BackgroundColor3 = sel and Theme.Accent or Theme.List })
                    Tween(cbStroke, Theme.AnimNormal, { Color = sel and Theme.Accent or Theme.Stroke })
                    mark.Text = sel and "✓" or ""
                    Tween(itemLabel, Theme.AnimFast, { TextColor3 = sel and Theme.Text or Theme.TextSub })

                    box.Text = displayText()
                    NL.Flags[flag] = selected
                    if opts.Callback then SafeCall(opts.Callback, selected) end
                end)
            else
                itemLabel = New("TextLabel", {
                    Text = opt,
                    Font = Theme.Font,
                    TextSize = 11,
                    TextColor3 = isSelected(opt) and Theme.Text or Theme.TextSub,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    AnchorPoint = Vector2.new(0, 0.5),
                    Position = UDim2.new(0, 10, 0.5, 0),
                    Size = UDim2.new(1, -16, 0, 12),
                    BackgroundTransparency = 1,
                    ZIndex = 303,
                    Parent = item,
                })

                item.MouseButton1Click:Connect(function()
                    PlaySound()
                    selected = opt
                    NL.Flags[flag] = selected
                    box.Text = selected
                    closeList()
                    if opts.Callback then SafeCall(opts.Callback, selected) end
                end)
            end

            item.MouseEnter:Connect(function()
                if not isSelected(opt) then
                    Tween(item, Theme.AnimFast, { BackgroundColor3 = Theme.ElementHover })
                end
            end)
            item.MouseLeave:Connect(function()
                if not isSelected(opt) then
                    Tween(item, Theme.AnimFast, { BackgroundColor3 = Theme.Popout })
                end
            end)
        end

        -- следование за box
        followConn = RunService.RenderStepped:Connect(function()
            if not list or not box.Parent then closeList() return end
            local win = NL._window
            if not win or win._minimized or win._hidden then closeList() return end
            local pos = box.AbsolutePosition - root.AbsolutePosition
            local vp = Cache.GetViewport()
            local px = pos.X
            if root.AbsolutePosition.X + px + width > vp.X - 8 then
                px = vp.X - 8 - width - root.AbsolutePosition.X
            end
            local absY = pos.Y + root.AbsolutePosition.Y + 28
            if absY + listH > vp.Y - 8 then
                list.Position = UDim2.new(0, px, 0, pos.Y - listH - 4)
            else
                list.Position = UDim2.new(0, px, 0, pos.Y + 28)
            end
        end)

        -- закрытие по клику вне
        outConn = Connect(UserInputService.InputBegan, function(input)
            if input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
            if not list then return end
            local p = input.Position
            local lp, ls = list.AbsolutePosition, list.AbsoluteSize
            if p.X < lp.X or p.X > lp.X + ls.X or p.Y < lp.Y or p.Y > lp.Y + ls.Y then
                closeList()
            end
        end)

        Tween(arrow, Theme.AnimFast, { Rotation = 180 })
    end

    box.MouseButton1Click:Connect(function()
        PlaySound()
        if list then
            closeList()
        elseif os.clock() - lastClose > 0.25 then
            openList()
        end
    end)

    frame.MouseEnter:Connect(function()
        Tween(frame, Theme.AnimFast, { BackgroundColor3 = Theme.ElementHover })
    end)
    frame.MouseLeave:Connect(function()
        Tween(frame, Theme.AnimFast, { BackgroundColor3 = Theme.Element })
    end)

    BindTooltip(frame, opts)

    el.Set = function(value, silent)
        if multi then
            selected = {}
            if type(value) == "table" then
                for _, v in ipairs(value) do
                    local sv = tostring(v)
                    if table.find(items, sv) then
                        table.insert(selected, sv)
                    end
                end
            end
            NL.Flags[flag] = selected
            box.Text = displayText()
            if not silent and opts.Callback then SafeCall(opts.Callback, selected) end
        else
            local sv = tostring(value)
            if sv == "" or table.find(items, sv) then
                selected = sv
                NL.Flags[flag] = sv
                box.Text = sv ~= "" and sv or "none"
                if not silent and opts.Callback then SafeCall(opts.Callback, sv) end
            end
        end
    end
    el.Get = function()
        if multi then
            local copy = {}
            for i, v in ipairs(selected) do copy[i] = v end
            return copy
        end
        return selected
    end
    el.GetItems = function()
        local copy = {}
        for i, v in ipairs(items) do copy[i] = v end
        return copy
    end

    return el
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §51 · KEYBIND
--// ═══════════════════════════════════════════════════════════════════════

local KEYBIND_MODES = { "always", "hold", "toggle" }
local KEYBIND_MODE_NAMES = {
    always = "Всегда",
    hold   = "Удержание",
    toggle = "Переключение",
}

local function MakeKeybind(name, opts, group)
    opts = opts or {}
    local flag = opts.Flag or name
    local key = opts.Default
    if key and not key.Name then key = nil end

    local mode = opts.Mode
    if not table.find(KEYBIND_MODES, mode) then mode = "toggle" end

    local active = (mode == "always")
    NL.Flags[flag] = key and key.Name or "none"

    -- контейнер
    local frame = New("Frame", {
        BackgroundColor3 = Theme.Element,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 30),
    })
    Round(frame, Theme.RadiusElement)

    -- название
    New("TextLabel", {
        Text = name,
        Font = Theme.Font,
        TextSize = 12,
        TextColor3 = Theme.Text,
        TextXAlignment = Enum.TextXAlignment.Left,
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, 10, 0.5, 0),
        Size = UDim2.new(1, -110, 0, 14),
        BackgroundTransparency = 1,
        ZIndex = 2,
        Parent = frame,
    })

    -- кнопка с клавишей
    local box = New("TextButton", {
        Text = key and key.Name or "none",
        Font = Theme.Font,
        TextSize = 10,
        TextColor3 = Theme.TextSub,
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -8, 0.5, 0),
        Size = UDim2.new(0, 92, 0, 22),
        BackgroundColor3 = Theme.List,
        AutoButtonColor = false,
        BorderSizePixel = 0,
        ZIndex = 2,
        Parent = frame,
    })
    Round(box, Theme.RadiusElement - 2)
    Stroke(box, Theme.Stroke)

    -- иконка режима
    local modeIc = Icon.new("ChevronDown", box, 10, Theme.TextDim)
    modeIc.AnchorPoint = Vector2.new(1, 0.5)
    modeIc.Position = UDim2.new(1, -6, 0.5, -5)
    modeIc.ZIndex = 3

    local el = { _frame = frame, _height = 30, _type = "Keybind", Flag = flag, Name = name }
    local listening = false

    -- режим
    local function setMode(m)
        if mode == m then return end
        mode = m
        local target
        if m == "always" then target = true end
        if m == "hold" then target = false end

        if target ~= nil and target ~= active then
            active = target
            if opts.Callback then SafeCall(opts.Callback, active) end
        end
        if opts.ModeChanged then SafeCall(opts.ModeChanged, m) end
    end

    -- меню выбора режима
    local modeMenu, modeFollow, modeOut

    local function closeModeMenu()
        if modeFollow then modeFollow:Disconnect(); modeFollow = nil end
        if modeOut then modeOut:Disconnect(); modeOut = nil end
        if modeMenu then modeMenu:Destroy(); modeMenu = nil end
        if NL._activeDropdown == el then NL._activeDropdown = nil end
    end
    el.Close = closeModeMenu

    local function openModeMenu()
        if modeMenu then closeModeMenu(); return end
        RegisterPopup(el)

        local root = group._tab._window._root
        local menuH = #KEYBIND_MODES * 26 + 8

        modeMenu = New("Frame", {
            Size = UDim2.new(0, 130, 0, menuH),
            BackgroundColor3 = Theme.Popout,
            BorderSizePixel = 0,
            ZIndex = 305,
            Parent = root,
        })
        Round(modeMenu, Theme.RadiusGroup)
        Stroke(modeMenu, Theme.StrokeLight)

        for i, m in ipairs(KEYBIND_MODES) do
            local item = New("TextButton", {
                Text = "",
                Position = UDim2.new(0, 4, 0, 4 + (i - 1) * 26),
                Size = UDim2.new(1, -8, 0, 24),
                BackgroundColor3 = (m == mode) and Theme.ElementHover or Theme.Popout,
                AutoButtonColor = false,
                BorderSizePixel = 0,
                ZIndex = 306,
                Parent = modeMenu,
            })
            Round(item, 4)

            New("TextLabel", {
                Text = KEYBIND_MODE_NAMES[m] or m,
                Font = Theme.Font,
                TextSize = 10,
                TextColor3 = (m == mode) and Theme.Accent or Theme.TextSub,
                TextXAlignment = Enum.TextXAlignment.Left,
                AnchorPoint = Vector2.new(0, 0.5),
                Position = UDim2.new(0, 10, 0.5, 0),
                Size = UDim2.new(1, -34, 0, 11),
                BackgroundTransparency = 1,
                ZIndex = 307,
                Parent = item,
            })

            if m == mode then
                local check = Icon.new("Check", item, 12, Theme.Accent)
                check.Position = UDim2.new(1, -20, 0.5, -6)
                check.ZIndex = 307
            end

            item.MouseEnter:Connect(function()
                Tween(item, Theme.AnimFast, { BackgroundColor3 = Theme.ElementHover })
            end)
            item.MouseLeave:Connect(function()
                if m ~= mode then
                    Tween(item, Theme.AnimFast, { BackgroundColor3 = Theme.Popout })
                end
            end)
            item.MouseButton1Click:Connect(function()
                PlaySound()
                setMode(m)
                closeModeMenu()
            end)
        end

        modeFollow = RunService.RenderStepped:Connect(function()
            if not modeMenu or not box.Parent then closeModeMenu() return end
            local win = NL._window
            if not win or win._minimized or win._hidden then closeModeMenu() return end
            local pos = box.AbsolutePosition - win._root.AbsolutePosition
            modeMenu.Position = UDim2.new(0, pos.X, 0, pos.Y + 26)
        end)

        modeOut = Connect(UserInputService.InputBegan, function(input)
            if input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
            if not modeMenu then return end
            local p = input.Position
            local lp, ls = modeMenu.AbsolutePosition, modeMenu.AbsoluteSize
            if p.X < lp.X or p.X > lp.X + ls.X or p.Y < lp.Y or p.Y > lp.Y + ls.Y then
                closeModeMenu()
            end
        end)
    end

    -- ЛКМ — назначить, ПКМ — режим
    box.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            listening = true
            box.Text = "..."
            Tween(box, Theme.AnimNormal, { BackgroundColor3 = Theme.AccentDim, TextColor3 = Theme.Text })

            local conn
            conn = UserInputService.InputBegan:Connect(function(inp, processed)
                if processed then return end
                if inp.UserInputType ~= Enum.UserInputType.Keyboard then return end
                if inp.KeyCode == Enum.KeyCode.Unknown then return end

                conn:Disconnect()
                listening = false

                if inp.KeyCode == Enum.KeyCode.Backspace then
                    key = nil
                    active = false
                    NL.Flags[flag] = "none"
                    box.Text = "none"
                else
                    key = inp.KeyCode
                    NL.Flags[flag] = key.Name
                    box.Text = key.Name
                end

                Tween(box, Theme.AnimNormal, { BackgroundColor3 = Theme.List, TextColor3 = Theme.TextSub })
                if opts.Changed then SafeCall(opts.Changed, key) end
            end)
        elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
            if not listening then
                openModeMenu()
            end
        end
    end)

    -- обработка нажатий
    Connect(UserInputService.InputBegan, function(input, processed)
        if processed or listening or not key then return end
        if input.KeyCode ~= key then return end

        if mode == "hold" then
            if not active then
                active = true
                if opts.Callback then SafeCall(opts.Callback, true) end
            end
        elseif mode == "toggle" then
            active = not active
            if opts.Callback then SafeCall(opts.Callback, active) end
        end
    end)

    Connect(UserInputService.InputEnded, function(input)
        if not key or mode ~= "hold" or not active then return end
        if input.KeyCode ~= key then return end
        active = false
        if opts.Callback then SafeCall(opts.Callback, false) end
    end)

    -- hover
    frame.MouseEnter:Connect(function()
        Tween(frame, Theme.AnimFast, { BackgroundColor3 = Theme.ElementHover })
    end)
    frame.MouseLeave:Connect(function()
        Tween(frame, Theme.AnimFast, { BackgroundColor3 = Theme.Element })
    end)

    -- tooltip
    local tip = (opts.Tooltip and (opts.Tooltip .. "\n") or "")
        .. "ЛКМ — назначить · ПКМ — режим · Backspace — сброс"
    BindTooltip(frame, { Tooltip = tip })

    el.Set = function(v, silent)
        if type(v) == "table" then
            key = v.Key
            if v.Mode and table.find(KEYBIND_MODES, v.Mode) then
                mode = v.Mode
            end
        else
            key = v
        end
        if key and not key.Name then key = nil end
        NL.Flags[flag] = key and key.Name or "none"
        box.Text = key and key.Name or "none"
        if not silent and opts.Changed then SafeCall(opts.Changed, key) end
    end
    el.Get = function() return key end
    el.GetMode = function() return mode end
    el.GetName = function() return name end
    el.IsActive = function() return active end

    return el
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §52 · COLORPICKER
--// ═══════════════════════════════════════════════════════════════════════

local PRESET_COLORS = {
    Color3.fromRGB(255, 255, 255),
    Color3.fromRGB(20, 20, 20),
    Color3.fromRGB(236, 90, 90),
    Color3.fromRGB(98, 196, 133),
    Color3.fromRGB(96, 165, 235),
    Color3.fromRGB(236, 192, 100),
    Color3.fromRGB(130, 100, 255),
    Color3.fromRGB(160, 135, 255),
    Color3.fromRGB(255, 105, 180),
    Color3.fromRGB(80, 220, 180),
}

local function MakeColorPicker(name, opts, group)
    opts = opts or {}
    local flag = opts.Flag or name
    local color = opts.Default or Theme.Accent
    local alpha = (opts.Alpha ~= nil) and opts.Alpha or 1
    local h, s, v = Color3.toHSV(color)
    NL.Flags[flag] = color

    -- контейнер
    local frame = New("Frame", {
        BackgroundColor3 = Theme.Element,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 30),
    })
    Round(frame, Theme.RadiusElement)

    -- название
    New("TextLabel", {
        Text = name,
        Font = Theme.Font,
        TextSize = 12,
        TextColor3 = Theme.Text,
        TextXAlignment = Enum.TextXAlignment.Left,
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, 10, 0.5, 0),
        Size = UDim2.new(1, -60, 0, 14),
        BackgroundTransparency = 1,
        ZIndex = 2,
        Parent = frame,
    })

    -- swatch
    local swatch = New("TextButton", {
        Text = "",
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -8, 0.5, 0),
        Size = UDim2.new(0, 40, 0, 18),
        BackgroundColor3 = color,
        AutoButtonColor = false,
        BorderSizePixel = 0,
        ZIndex = 2,
        Parent = frame,
    })
    Round(swatch, 5)
    local swatchStroke = Stroke(swatch, Theme.StrokeLight)

    local el = { _frame = frame, _height = 30, _type = "ColorPicker", Flag = flag, Name = name }

    local popup, followConn, outConn
    local lastClose = 0
    local activeDrag = nil

    local function applyOutput(silent)
        color = Color3.fromHSV(h, s, v)
        NL.Flags[flag] = color
        swatch.BackgroundColor3 = color
        if not silent and opts.Callback then
            SafeCall(opts.Callback, color, alpha)
        end
    end

    local function closePopup()
        lastClose = os.clock()
        activeDrag = nil
        if followConn then followConn:Disconnect(); followConn = nil end
        if outConn then outConn:Disconnect(); outConn = nil end
        if popup then popup:Destroy(); popup = nil end
        if NL._activeDropdown == el then NL._activeDropdown = nil end
    end
    el.Close = closePopup

    local function openPopup()
        if os.clock() - lastClose < 0.25 then return end
        RegisterPopup(el)

        local root = group._tab._window._root
        local POP_W, POP_H = 240, 260

        popup = New("Frame", {
            Size = UDim2.new(0, POP_W, 0, POP_H),
            BackgroundColor3 = Theme.Popout,
            BorderSizePixel = 0,
            ZIndex = 310,
            Parent = root,
        })
        Round(popup, Theme.RadiusGroup)
        Stroke(popup, Theme.StrokeLight)

        -- SV-квадрат
        local svFrame = New("Frame", {
            Position = UDim2.new(0, 8, 0, 8),
            Size = UDim2.new(1, -16, 0, 140),
            BackgroundColor3 = Color3.fromHSV(h, 1, 1),
            BorderSizePixel = 0,
            ZIndex = 311,
            Parent = popup,
        })
        Round(svFrame, 6)

        -- белый градиент (насыщенность)
        local whiteFrame = New("Frame", {
            Size = UDim2.new(1, 0, 1, 0),
            BackgroundColor3 = Color3.new(1, 1, 1),
            BorderSizePixel = 0,
            ZIndex = 312,
            Parent = svFrame,
        })
        Gradient(whiteFrame, Color3.fromHSV(h, 1, 1), Color3.new(1, 1, 1), 0)

        -- черный градиент (яркость)
        local blackFrame = New("Frame", {
            Size = UDim2.new(1, 0, 1, 0),
            BackgroundColor3 = Color3.new(0, 0, 0),
            BorderSizePixel = 0,
            ZIndex = 313,
            Parent = svFrame,
        })
        New("UIGradient", {
            Transparency = NumberSequence.new(1, 0),
            Rotation = 90,
            Parent = blackFrame,
        })

        -- knob на SV
        local svKnob = New("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5),
            Size = UDim2.new(0, 12, 0, 12),
            Position = UDim2.new(s, 0, 1 - v, 0),
            BackgroundColor3 = Color3.new(1, 1, 1),
            BorderSizePixel = 0,
            ZIndex = 314,
            Parent = svFrame,
        })
        Circle(svKnob)
        Stroke(svKnob, Color3.new(0, 0, 0), 1.5, 0.3)

        -- hue bar
        local hueBar = New("Frame", {
            Position = UDim2.new(0, 8, 0, 156),
            Size = UDim2.new(1, -16, 0, 12),
            BackgroundColor3 = Color3.new(1, 1, 1),
            BorderSizePixel = 0,
            ZIndex = 311,
            Parent = popup,
        })
        Round(hueBar, 6)

        -- раскраска hue через сегменты
        for i = 0, 60 do
            local t = i / 60
            local c = Color3.fromHSV(t, 1, 1)
            New("Frame", {
                Position = UDim2.new(t, 0, 0, 0),
                Size = UDim2.new(1 / 60 + 0.01, 0, 1, 0),
                BackgroundColor3 = c,
                BorderSizePixel = 0,
                ZIndex = 312,
                Parent = hueBar,
            })
        end

        -- knob hue
        local hueKnob = New("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5),
            Size = UDim2.new(0, 4, 0, 16),
            Position = UDim2.new(h, 0, 0.5, 0),
            BackgroundColor3 = Color3.new(1, 1, 1),
            BorderSizePixel = 0,
            ZIndex = 314,
            Parent = hueBar,
        })
        Round(hueKnob, 2)

        -- alpha bar
        local alphaBar = New("Frame", {
            Position = UDim2.new(0, 8, 0, 176),
            Size = UDim2.new(1, -16, 0, 12),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            ZIndex = 311,
            Parent = popup,
        })
        Round(alphaBar, 6)

        -- шахматный фон
        for i = 0, 11 do
            New("Frame", {
                Position = UDim2.new(i / 12, 0, 0, 0),
                Size = UDim2.new(1 / 12 + 0.01, 0, 1, 0),
                BackgroundColor3 = (i % 2 == 0) and Color3.fromRGB(190, 190, 190) or Color3.fromRGB(140, 140, 140),
                BorderSizePixel = 0,
                ZIndex = 311,
                Parent = alphaBar,
            })
        end

        local alphaColorFrame = New("Frame", {
            Size = UDim2.new(1, 0, 1, 0),
            BackgroundColor3 = color,
            BorderSizePixel = 0,
            ZIndex = 312,
            Parent = alphaBar,
        })
        Round(alphaColorFrame, 6)
        New("UIGradient", {
            Transparency = NumberSequence.new(1, 0),
            Parent = alphaColorFrame,
        })

        local alphaKnob = New("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5),
            Size = UDim2.new(0, 4, 0, 16),
            Position = UDim2.new(alpha, 0, 0.5, 0),
            BackgroundColor3 = Color3.new(1, 1, 1),
            BorderSizePixel = 0,
            ZIndex = 314,
            Parent = alphaBar,
        })
        Round(alphaKnob, 2)

        -- HEX-поле
        local hexBox = New("TextBox", {
            Text = Color.ToHex(color),
            Font = Theme.Font,
            TextSize = 11,
            TextColor3 = Theme.Text,
            TextXAlignment = Enum.TextXAlignment.Left,
            ClearTextOnFocus = false,
            BackgroundColor3 = Theme.List,
            Position = UDim2.new(0, 8, 0, 194),
            Size = UDim2.new(0, 100, 0, 26),
            ZIndex = 311,
            Parent = popup,
        })
        Round(hexBox, 5)
        Stroke(hexBox, Theme.Stroke)
        Padding(hexBox, 0, 8, 0, 10)

        -- rgb-подпись
        local rgbLabel = New("TextLabel", {
            Text = string.format("%d, %d, %d",
                math.floor(color.R * 255 + 0.5),
                math.floor(color.G * 255 + 0.5),
                math.floor(color.B * 255 + 0.5)),
            Font = Theme.Font,
            TextSize = 10,
            TextColor3 = Theme.TextDim,
            TextXAlignment = Enum.TextXAlignment.Left,
            Position = UDim2.new(0, 116, 0, 194),
            Size = UDim2.new(1, -150, 0, 26),
            BackgroundTransparency = 1,
            ZIndex = 311,
            Parent = popup,
        })

        -- preview
        local preview = New("Frame", {
            AnchorPoint = Vector2.new(1, 0),
            Position = UDim2.new(1, -8, 0, 194),
            Size = UDim2.new(0, 30, 0, 26),
            BackgroundColor3 = color,
            BorderSizePixel = 0,
            ZIndex = 311,
            Parent = popup,
        })
        Round(preview, 5)
        Stroke(preview, Theme.StrokeLight)

        -- пресеты
        for i, pc in ipairs(PRESET_COLORS) do
            if i <= 10 then
                local col = (i - 1) % 5
                local row = math.floor((i - 1) / 5)
                local ps = New("TextButton", {
                    Text = "",
                    Position = UDim2.new(0, 8 + col * 46, 0, 228 + row * 24),
                    Size = UDim2.new(0, 42, 0, 20),
                    BackgroundColor3 = pc,
                    AutoButtonColor = false,
                    BorderSizePixel = 0,
                    ZIndex = 311,
                    Parent = popup,
                })
                Round(ps, 4)
                Stroke(ps, Theme.Stroke)

                ps.MouseButton1Click:Connect(function()
                    PlaySound()
                    h, s, v = Color3.toHSV(pc)
                    applyOutput(false)

                    svKnob.Position = UDim2.new(s, 0, 1 - v, 0)
                    hueKnob.Position = UDim2.new(h, 0, 0.5, 0)
                    hexBox.Text = Color.ToHex(pc)
                    rgbLabel.Text = string.format("%d, %d, %d",
                        math.floor(pc.R * 255 + 0.5),
                        math.floor(pc.G * 255 + 0.5),
                        math.floor(pc.B * 255 + 0.5))
                    preview.BackgroundColor3 = pc
                end)
            end
        end

        -- drag-setter: SV
        local function setSV(pos)
            local rel = pos - svFrame.AbsolutePosition
            s = math.clamp(rel.X / math.max(svFrame.AbsoluteSize.X, 1), 0, 1)
            v = 1 - math.clamp(rel.Y / math.max(svFrame.AbsoluteSize.Y, 1), 0, 1)
            applyOutput(false)

            svKnob.Position = UDim2.new(s, 0, 1 - v, 0)
            hexBox.Text = Color.ToHex(Color3.fromHSV(h, s, v))
            rgbLabel.Text = string.format("%d, %d, %d",
                math.floor(color.R * 255 + 0.5),
                math.floor(color.G * 255 + 0.5),
                math.floor(color.B * 255 + 0.5))
            preview.BackgroundColor3 = color
        end

        local function setHue(pos)
            local rel = pos - hueBar.AbsolutePosition
            h = math.clamp(rel.X / math.max(hueBar.AbsoluteSize.X, 1), 0, 1)
            applyOutput(false)

            hueKnob.Position = UDim2.new(h, 0, 0.5, 0)
            svFrame.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
            whiteFrame.UIGradient.Color = ColorSequence.new(Color3.fromHSV(h, 1, 1), Color3.new(1, 1, 1))
            hexBox.Text = Color.ToHex(Color3.fromHSV(h, s, v))
            rgbLabel.Text = string.format("%d, %d, %d",
                math.floor(color.R * 255 + 0.5),
                math.floor(color.G * 255 + 0.5),
                math.floor(color.B * 255 + 0.5))
            preview.BackgroundColor3 = color
        end

        local function setAlpha(pos)
            local rel = pos - alphaBar.AbsolutePosition
            alpha = math.clamp(rel.X / math.max(alphaBar.AbsoluteSize.X, 1), 0, 1)
            alphaKnob.Position = UDim2.new(alpha, 0, 0.5, 0)
            if opts.Callback then SafeCall(opts.Callback, color, alpha) end
        end

        local function bindDrag(area, setter)
            area.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                    activeDrag = setter
                    setter(input.Position)
                end
            end)
        end

        bindDrag(svFrame, setSV)
        bindDrag(svKnob, setSV)
        bindDrag(hueBar, setHue)
        bindDrag(hueKnob, setHue)
        bindDrag(alphaBar, setAlpha)
        bindDrag(alphaKnob, setAlpha)

        -- HEX ввод
        hexBox.FocusLost:Connect(function()
            local txt = tostring(hexBox.Text):gsub("#", "")
            if #txt == 6 and txt:match("^%x%x%x%x%x%x$") then
                local newColor = Color.FromHex(txt, color)
                h, s, v = Color3.toHSV(newColor)
                applyOutput(false)

                svKnob.Position = UDim2.new(s, 0, 1 - v, 0)
                hueKnob.Position = UDim2.new(h, 0, 0.5, 0)
                svFrame.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
                whiteFrame.UIGradient.Color = ColorSequence.new(Color3.fromHSV(h, 1, 1), Color3.new(1, 1, 1))
                rgbLabel.Text = string.format("%d, %d, %d",
                    math.floor(newColor.R * 255 + 0.5),
                    math.floor(newColor.G * 255 + 0.5),
                    math.floor(newColor.B * 255 + 0.5))
                preview.BackgroundColor3 = newColor
            else
                hexBox.Text = Color.ToHex(color)
            end
        end)

        -- follow
        followConn = RunService.RenderStepped:Connect(function()
            if not popup or not swatch.Parent then closePopup() return end
            local win = NL._window
            if not win or win._minimized or win._hidden then closePopup() return end
            local pos = swatch.AbsolutePosition - root.AbsolutePosition
            local vp = Cache.GetViewport()
            local px = pos.X
            if root.AbsolutePosition.X + px + POP_W > vp.X - 8 then
                px = vp.X - 8 - POP_W - root.AbsolutePosition.X
            end
            local absY = pos.Y + root.AbsolutePosition.Y + 30
            if absY + POP_H > vp.Y - 8 then
                popup.Position = UDim2.new(0, px, 0, pos.Y - POP_H - 4)
            else
                popup.Position = UDim2.new(0, px, 0, pos.Y + 30)
            end
        end)

        -- close on outside click
        outConn = Connect(UserInputService.InputBegan, function(input)
            if input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
            if not popup then return end
            local p = input.Position
            local lp, ls = popup.AbsolutePosition, popup.AbsoluteSize
            if p.X < lp.X or p.X > lp.X + ls.X or p.Y < lp.Y or p.Y > lp.Y + ls.Y then
                closePopup()
            end
        end)
    end

    swatch.MouseButton1Click:Connect(function()
        PlaySound()
        if popup then
            closePopup()
        elseif os.clock() - lastClose > 0.25 then
            openPopup()
        end
    end)

    Connect(UserInputService.InputChanged, function(input)
        if activeDrag and (input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch) then
            activeDrag(input.Position)
        end
    end)
    Connect(UserInputService.InputEnded, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            activeDrag = nil
        end
    end)

    frame.MouseEnter:Connect(function()
        Tween(frame, Theme.AnimFast, { BackgroundColor3 = Theme.ElementHover })
        Tween(swatch, Theme.AnimFast, { Size = UDim2.new(0, 44, 0, 20) })
    end)
    frame.MouseLeave:Connect(function()
        Tween(frame, Theme.AnimFast, { BackgroundColor3 = Theme.Element })
        Tween(swatch, Theme.AnimFast, { Size = UDim2.new(0, 40, 0, 18) })
    end)

    BindTooltip(frame, opts)

    el.Set = function(value, silent)
        local c = value
        if typeof(c) ~= "Color3" then
            c = Color.FromHex(tostring(c), color)
        end
        if typeof(c) == "Color3" then
            color = c
            h, s, v = Color3.toHSV(c)
            applyOutput(silent)
        end
    end
    el.SetAlpha = function(a)
        alpha = math.clamp(a, 0, 1)
    end
    el.Get = function() return color end
    el.GetAlpha = function() return alpha end

    return el
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §53 · CONFIGLIST
--// ═══════════════════════════════════════════════════════════════════════

local function MakeConfigList(group, opts)
    opts = opts or {}
    local listH = opts.Height or 220

    local frame = New("Frame", {
        BackgroundColor3 = Theme.Element,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, listH),
    })
    Round(frame, Theme.RadiusElement)

    local el = { _frame = frame, _height = listH, _type = "ConfigList", Name = "Список конфигов" }

    local scroll = New("ScrollingFrame", {
        Position = UDim2.new(0, 4, 0, 4),
        Size = UDim2.new(1, -8, 1, -8),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = Theme.Accent,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        ZIndex = 2,
        Parent = frame,
    })
    VLayout(scroll, 3)

    -- тут будет взаимодействие с config-системой из части 6
    -- заглушка с сообщением
    New("TextLabel", {
        Text = "Список конфигов\n(загружается в части 6)",
        Font = Theme.Font,
        TextSize = 11,
        TextColor3 = Theme.TextDim,
        TextWrapped = true,
        Size = UDim2.new(1, -20, 0, 40),
        Position = UDim2.new(0, 10, 0, 10),
        BackgroundTransparency = 1,
        Parent = scroll,
    })

    return el
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §54 · HOTKEYLIST
--// ═══════════════════════════════════════════════════════════════════════

local function MakeHotkeyList(group, opts)
    opts = opts or {}
    local listH = opts.Height or 180

    local frame = New("Frame", {
        BackgroundColor3 = Theme.Element,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, listH),
    })
    Round(frame, Theme.RadiusElement)

    local el = { _frame = frame, _height = listH, _type = "HotkeyList", Name = "Активные клавиши" }

    local scroll = New("ScrollingFrame", {
        Position = UDim2.new(0, 4, 0, 4),
        Size = UDim2.new(1, -8, 1, -8),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = Theme.Accent,
        Parent = frame,
    })
    VLayout(scroll, 3)

    local function rebuild()
        for _, c in ipairs(scroll:GetChildren()) do
            if c:IsA("GuiObject") then c:Destroy() end
        end

        local entries = {}
        for _, element in ipairs(NL.Elements) do
            if element._type == "Keybind" then
                local key = element.Get and element.Get()
                if key then
                    table.insert(entries, {
                        name = element.Name,
                        key = key.Name,
                        mode = element.GetMode and element.GetMode() or "toggle",
                    })
                end
            end
        end

        if #entries == 0 then
            New("TextLabel", {
                Text = "Нет активных клавиш",
                Font = Theme.Font,
                TextSize = 11,
                TextColor3 = Theme.TextDim,
                TextXAlignment = Enum.TextXAlignment.Left,
                Size = UDim2.new(1, -20, 0, 20),
                BackgroundTransparency = 1,
                Parent = scroll,
            })
        else
            for i, e in ipairs(entries) do
                local row = New("Frame", {
                    BackgroundColor3 = Theme.List,
                    BorderSizePixel = 0,
                    Size = UDim2.new(1, 0, 0, 28),
                    LayoutOrder = i,
                    Parent = scroll,
                })
                Round(row, Theme.RadiusElement - 2)

                New("TextLabel", {
                    Text = e.name,
                    Font = Theme.Font,
                    TextSize = 11,
                    TextColor3 = Theme.Text,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    AnchorPoint = Vector2.new(0, 0.5),
                    Position = UDim2.new(0, 10, 0.5, 0),
                    Size = UDim2.new(0.6, 0, 0, 12),
                    BackgroundTransparency = 1,
                    Parent = row,
                })

                local chip = New("Frame", {
                    AnchorPoint = Vector2.new(1, 0.5),
                    Position = UDim2.new(1, -6, 0.5, 0),
                    Size = UDim2.new(0, 80, 0, 20),
                    BackgroundColor3 = Theme.Popout,
                    BorderSizePixel = 0,
                    Parent = row,
                })
                Round(chip, 4)
                Stroke(chip, Theme.StrokeLight)

                New("TextLabel", {
                    Text = e.key .. " · " .. e.mode,
                    Font = Theme.FontBold,
                    TextSize = 9,
                    TextColor3 = Theme.Accent,
                    Size = UDim2.new(1, 0, 1, 0),
                    BackgroundTransparency = 1,
                    Parent = chip,
                })
            end
        end

        scroll.CanvasSize = UDim2.new(0, 0, 0, math.max(#entries, 1) * 31)
    end

    el.Rebuild = rebuild
    rebuild()

    return el
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §55 · AddXXX МЕТОДЫ ГРУППЫ
--// ═══════════════════════════════════════════════════════════════════════

function GroupMethods:AddToggle(name, opts)
    return self:_register(MakeToggle(name, opts))
end

function GroupMethods:AddSlider(name, opts)
    return self:_register(MakeSlider(name, opts))
end

function GroupMethods:AddButton(name, opts)
    return self:_register(MakeButton(name, opts))
end

function GroupMethods:AddLabel(text, opts)
    return self:_register(MakeLabel(text, opts))
end

function GroupMethods:AddDivider()
    return self:_register(MakeDivider())
end

function GroupMethods:AddSeparator(text, opts)
    return self:_register(MakeSeparator(text, opts))
end

function GroupMethods:AddInfo(text, color, iconName)
    return self:_register(MakeInfoBlock(text, color, iconName))
end

function GroupMethods:AddWarning(text)
    return self:_register(MakeWarningBlock(text))
end

function GroupMethods:AddButtonRow(buttons, opts)
    return self:_register(MakeButtonRow(buttons, opts))
end

function GroupMethods:AddCheckbox(name, opts)
    return self:_register(MakeCheckbox(name, opts))
end

function GroupMethods:AddTextInput(name, opts)
    return self:_register(MakeTextInput(name, opts))
end

function GroupMethods:AddNumberInput(name, opts)
    return self:_register(MakeNumberInput(name, opts))
end

function GroupMethods:AddDropdown(name, options, opts)
    return self:_register(MakeDropdown(name, options, opts or {}, self))
end

function GroupMethods:AddMultiDropdown(name, options, opts)
    opts = opts or {}
    opts.Multi = true
    return self:_register(MakeDropdown(name, options, opts, self))
end

function GroupMethods:AddKeybind(name, opts)
    return self:_register(MakeKeybind(name, opts or {}, self))
end

function GroupMethods:AddColorPicker(name, opts)
    return self:_register(MakeColorPicker(name, opts or {}, self))
end

function GroupMethods:AddConfigList(opts)
    return self:_register(MakeConfigList(self, opts))
end

function GroupMethods:AddHotkeyList(opts)
    return self:_register(MakeHotkeyList(self, opts))
end

