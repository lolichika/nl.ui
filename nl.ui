--// ═══════════════════════════════════════════════════════════════════════
--//  §141 · UI PRESET SYSTEM · ПОЛНОЕ СОСТОЯНИЕ UI
--// ═══════════════════════════════════════════════════════════════════════

local UIPreset = {
    slots    = {},       -- [1..9] = пресет
    folder   = "NLUI_Configs/UI_Presets",
    autoSaveSlot = 1,
}

-- получить путь
local function GetPresetPath(slot)
    return UIPreset.folder .. "/slot_" .. tostring(slot) .. ".json"
end

-- обеспечить папку
local function EnsurePresetFolder()
    if not NL.Config.HAS_FILES then return end
    pcall(function()
        if type(isfolder) == "function" and type(makefolder) == "function" then
            if not isfolder("NLUI_Configs") then
                makefolder("NLUI_Configs")
            end
            if not isfolder(UIPreset.folder) then
                makefolder(UIPreset.folder)
            end
        end
    end)
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §142 · UI PRESET · СБОРКА/ПРИМЕНЕНИЕ
--// ═══════════════════════════════════════════════════════════════════════

-- захватить текущее состояние UI
local function CaptureUIPreset()
    local win = NL._window
    if not win or not win._root then return nil end

    local preset = {
        _meta = {
            version = NL.Version,
            saved   = os.date("%Y-%m-%d %H:%M:%S"),
        },

        -- размер и позиция окна
        windowSize = {
            width  = win._root.AbsoluteSize.X,
            height = win._root.AbsoluteSize.Y,
        },
        windowPos = {
            x = win._root.AbsolutePosition.X,
            y = win._root.AbsolutePosition.Y,
        },

        -- состояние сайдбара
        sidebarMode = NL.LayoutPolish.Sidebar.mode,

        -- зум и прозрачность
        zoom = NL.LayoutPolish.Zoom.current,
        opacity = NL.LayoutPolish.WindowOpacity.current,

        -- докинг
        docked = NL.LayoutPolish.Docking.currentDock,

        -- компактный режим
        compact = NL.LayoutPolish.CompactMode.active,

        -- тема
        theme = NL.Settings.Theme or "default",

        -- активная вкладка
        activeTab = win._activeTab and win._activeTab.Name or nil,

        -- состояние групп (открыты/закрыты)
        groups = {},
    }

    -- пройтись по всем вкладкам и группам
    for _, tab in ipairs(win._tabs) do
        for _, col in ipairs(tab._columns) do
            for _, group in ipairs(col.groups) do
                local key = tab.Name .. "/" .. (group.Name or "?")
                preset.groups[key] = group._open == true
            end
        end
    end

    return preset
end

-- применить пресет
local function ApplyUIPreset(preset)
    if type(preset) ~= "table" then return false end
    local win = NL._window
    if not win then return false end

    -- размер окна
    if preset.windowSize then
        Tween(win._root, 0.3, {
            Size = UDim2.new(0, preset.windowSize.width or 780, 0, preset.windowSize.height or 520),
        }, Enum.EasingStyle.Quint)
        win._width = preset.windowSize.width or 780
        win._height = preset.windowSize.height or 520
    end

    -- позиция
    if preset.windowPos then
        win._root.AnchorPoint = Vector2.new(0, 0)
        Tween(win._root, 0.3, {
            Position = UDim2.new(0, preset.windowPos.x or 100, 0, preset.windowPos.y or 100),
        }, Enum.EasingStyle.Quint)
    end

    -- сайдбар
    if preset.sidebarMode then
        NL.LayoutPolish.Sidebar:SetMode(preset.sidebarMode)
    end

    -- зум
    if preset.zoom then
        NL.LayoutPolish.Zoom:Set(preset.zoom)
    end

    -- прозрачность
    if preset.opacity then
        NL.LayoutPolish.WindowOpacity:Set(preset.opacity)
    end

    -- докинг
    if preset.docked then
        NL.LayoutPolish.Docking:Apply(preset.docked)
    end

    -- тема
    if preset.theme and preset.theme ~= "default" then
        NL.Themes:Apply(preset.theme, false)
    end

    -- активная вкладка
    if preset.activeTab then
        for _, tab in ipairs(win._tabs) do
            if tab.Name == preset.activeTab then
                win:SelectTab(tab)
                break
            end
        end
    end

    -- состояние групп
    if preset.groups then
        for _, tab in ipairs(win._tabs) do
            for _, col in ipairs(tab._columns) do
                for _, group in ipairs(col.groups) do
                    local key = tab.Name .. "/" .. (group.Name or "?")
                    local shouldBeOpen = preset.groups[key]
                    if shouldBeOpen ~= nil and shouldBeOpen ~= group._open then
                        group._open = shouldBeOpen
                        local h = shouldBeOpen and group._height or 0
                        group._body.Size = UDim2.new(1, 0, 0, h)
                        group._frame.Size = UDim2.new(1, 0, 0, Theme.GroupHeaderHeight + h)
                        group._arrow.Rotation = shouldBeOpen and 0 or -90
                    end
                end
            end
        end

        -- пересчёт
        for _, tab in ipairs(win._tabs) do
            NL._recalcTab(tab)
        end
    end

    return true
end

-- сохранить пресет в слот
local function SaveUIPreset(slot)
    slot = tonumber(slot) or 1
    local preset = CaptureUIPreset()
    if not preset then return false end

    UIPreset.slots[slot] = preset

    -- на диск
    if NL.Config.HAS_FILES then
        EnsurePresetFolder()
        local json = HttpService:JSONEncode(preset)
        pcall(function()
            writefile(GetPresetPath(slot), json)
        end)
    end

    return true
end

-- загрузить из слота
local function LoadUIPreset(slot)
    slot = tonumber(slot) or 1
    local preset = UIPreset.slots[slot]

    -- с диска
    if not preset and NL.Config.HAS_FILES then
        pcall(function()
            local path = GetPresetPath(slot)
            if isfile(path) then
                local json = readfile(path)
                preset = HttpService:JSONDecode(json)
            end
        end)
    end

    if not preset then return false end

    UIPreset.slots[slot] = preset
    return ApplyUIPreset(preset)
end

-- удалить слот
local function DeleteUIPreset(slot)
    slot = tonumber(slot) or 1
    UIPreset.slots[slot] = nil

    if NL.Config.HAS_FILES then
        pcall(function()
            local path = GetPresetPath(slot)
            if isfile(path) then delfile(path) end
        end)
    end
end

-- список занятых слотов
local function ListUIPresets()
    local list = {}
    for i = 1, 9 do
        if UIPreset.slots[i] then
            table.insert(list, i)
        elseif NL.Config.HAS_FILES then
            local ok, exists = pcall(function()
                return isfile(GetPresetPath(i))
            end)
            if ok and exists then
                table.insert(list, i)
            end
        end
    end
    return list
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §143 · UI PRESET · БЫСТРЫЕ СЛОТЫ 1-9
--// ═══════════════════════════════════════════════════════════════════════

-- быстрые методы
UIPreset.Capture = CaptureUIPreset
UIPreset.Apply   = ApplyUIPreset
UIPreset.Save    = SaveUIPreset
UIPreset.Load    = LoadUIPreset
UIPreset.Delete  = DeleteUIPreset
UIPreset.List    = ListUIPresets

NL.UIPreset = UIPreset

--// ═══════════════════════════════════════════════════════════════════════
--//  §144 · QUICK ACTIONS · CTRL + 1..9
--// ═══════════════════════════════════════════════════════════════════════

-- Ctrl+Shift+1..9 = сохранить слот
-- Ctrl+1..9       = загрузить слот
Connect(UserInputService.InputBegan, function(input, processed)
    if processed then return end
    if not UserInputService:IsKeyDown(Enum.KeyCode.LeftControl)
       and not UserInputService:IsKeyDown(Enum.KeyCode.RightControl) then return end

    -- получаем число 1-9
    local numberKeys = {
        [Enum.KeyCode.One]   = 1,
        [Enum.KeyCode.Two]   = 2,
        [Enum.KeyCode.Three] = 3,
        [Enum.KeyCode.Four]  = 4,
        [Enum.KeyCode.Five]  = 5,
        [Enum.KeyCode.Six]   = 6,
        [Enum.KeyCode.Seven] = 7,
        [Enum.KeyCode.Eight] = 8,
        [Enum.KeyCode.Nine]  = 9,
    }

    local slot = numberKeys[input.KeyCode]
    if not slot then return end

    local isShift = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift)
        or UserInputService:IsKeyDown(Enum.KeyCode.RightShift)

    if isShift then
        -- сохранить
        if SaveUIPreset(slot) then
            NL:Notify("UI Preset", "Слот " .. slot .. " сохранён", 2, "success")
        end
    else
        -- загрузить
        if LoadUIPreset(slot) then
            NL:Notify("UI Preset", "Слот " .. slot .. " загружен", 2, "success")
        else
            NL:Notify("UI Preset", "Слот " .. slot .. " пуст", 2, "warning")
        end
    end
end)

--// ═══════════════════════════════════════════════════════════════════════
--//  §145 · BUILDER · MOVEMENT TAB
--// ═══════════════════════════════════════════════════════════════════════

function NL:BuildMovementTab(tab)
    if not tab then return end

    local base = tab:CreateGroup("Base")
    base:AddToggle("Enabled", {
        Flag = "mv_enabled",
        Tooltip = "Главный тумблер движения",
    })
    base:AddKeybind("Toggle Key", {
        Flag = "mv_key",
        Default = Enum.KeyCode.X,
        Mode = "toggle",
    })

    local bhop = tab:CreateGroup("Bhop")
    bhop:AddToggle("Auto Jump", {
        Flag = "mv_bhop_auto",
        Tooltip = "Автоматический прыжок при приземлении",
    })
    bhop:AddSlider("Jump Boost", {
        Flag = "mv_bhop_boost",
        Min = 0, Max = 50, Default = 10,
        Tooltip = "Дополнительная скорость в воздухе",
    })
    bhop:AddToggle("Remove Delay", {
        Flag = "mv_bhop_nodelay",
        Tooltip = "Убрать задержку между прыжками",
    })

    local speed = tab:CreateGroup("Speed")
    speed:AddToggle("Enabled", { Flag = "mv_speed_enabled" })
    speed:AddSlider("Speed", {
        Flag = "mv_speed_value",
        Min = 16, Max = 100, Default = 32,
    })
    speed:AddDropdown("Mode", { "Walk", "Velocity", "CFrame" }, {
        Flag = "mv_speed_mode",
        Default = "Walk",
    })

    return tab
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §146 · BUILDER · COMBAT TAB (РАСШИРЕННЫЙ)
--// ═══════════════════════════════════════════════════════════════════════

function NL:BuildFullCombatTab(tab)
    if not tab then return end

    -- ─── AIM HOLD ──────────────────────────────────────────────────
    local aimGroup = tab:CreateGroup("Aim Hold")

    aimGroup:AddToggle("Enabled", {
        Flag = "combat_aim_enabled",
        Default = false,
        Tooltip = "Автоматическое наведение на ближайшего к центру экрана",
        Callback = function(on)
            if on then
                NL.AimHold:Start()
                NL:Notify("Aim Hold", "Активен", 2, "success")
            else
                NL.AimHold:Stop()
            end
        end,
    })

    aimGroup:AddSlider("FOV", {
        Flag = "combat_aim_fov",
        Min = 1, Max = 180, Default = 180,
        Suffix = "°",
        Callback = function(v)
            NL.AimHold.State._fov = v
            if NL.AimHold.State._drawFov then
                NL._util.DrawFOV.SetRadius(NL._util.DrawFOV.ToPixels(v))
            end
        end,
    })

    aimGroup:AddDropdown("Hitbox", {
        "Head", "Torso", "LowerTorso", "HumanoidRootPart", "Random",
    }, {
        Flag = "combat_aim_hitbox",
        Default = "Head",
        Callback = function(v) NL.AimHold.State._hitbox = v end,
    })

    aimGroup:AddSlider("Smooth", {
        Flag = "combat_aim_smooth",
        Min = 1, Max = 20, Default = 1,
        Callback = function(v) NL.AimHold.State._smooth = v end,
    })

    aimGroup:AddSlider("Min HP", {
        Flag = "combat_aim_minhp",
        Min = 0, Max = 100, Default = 20,
        Suffix = " hp",
        Callback = function(v) NL.AimHold.State._minHP = v end,
    })

    aimGroup:AddToggle("WallCheck", {
        Flag = "combat_aim_wall",
        Default = true,
        Callback = function(on) NL.AimHold.State._wallCheck = on end,
    })

    aimGroup:AddToggle("Draw FOV", {
        Flag = "combat_aim_drawfov",
        Default = false,
        Callback = function(on)
            NL.AimHold.State._drawFov = on
            if on and NL.AimHold.State._enabled then
                NL._util.DrawFOV.Enable(NL._util.DrawFOV.ToPixels(NL.AimHold.State._fov))
            else
                NL._util.DrawFOV.Disable()
            end
        end,
    })

    aimGroup:AddToggle("Debug", {
        Flag = "combat_aim_debug",
        Default = false,
        Callback = function(on) NL.AimHold.State._debug = on end,
    })

    -- ─── TRIGGER BOT ───────────────────────────────────────────────
    local tbGroup = tab:CreateGroup("Trigger Bot")

    tbGroup:AddToggle("Enabled", {
        Flag = "combat_tb_enabled",
        Default = false,
        Callback = function(on)
            if on then
                NL.TriggerBot:Start()
                NL:Notify("Trigger Bot", "Активен", 2, "success")
            else
                NL.TriggerBot:Stop()
            end
        end,
    })

    tbGroup:AddSlider("Delay", {
        Flag = "combat_tb_delay",
        Min = 0, Max = 500, Default = 50,
        Suffix = " мс",
        Callback = function(v) NL.TriggerBot.State._delay = v end,
    })

    tbGroup:AddSlider("Min HP", {
        Flag = "combat_tb_minhp",
        Min = 0, Max = 100, Default = 20,
        Suffix = " hp",
        Callback = function(v) NL.TriggerBot.State._minHP = v end,
    })

    tbGroup:AddToggle("WallCheck", {
        Flag = "combat_tb_wall",
        Default = true,
        Callback = function(on) NL.TriggerBot.State._wallCheck = on end,
    })

    tbGroup:AddToggle("Debug", {
        Flag = "combat_tb_debug",
        Default = false,
        Callback = function(on) NL.TriggerBot.State._debug = on end,
    })

    -- ─── SILENT AIM (заглушка) ─────────────────────────────────────
    local silent = tab:CreateGroup("Silent Aim")

    silent:AddToggle("Enabled", {
        Flag = "combat_silent_enabled",
        Default = false,
        Tooltip = "Отправляет выстрелы в цель без наведения камеры",
        Callback = function(on)
            if on then
                NL:Notify("Silent Aim", "Требует настройки RemoteEvent", 3, "warning")
            end
        end,
    })

    silent:AddSlider("FOV", {
        Flag = "combat_silent_fov",
        Min = 1, Max = 360, Default = 180,
        Suffix = "°",
    })

    silent:AddDropdown("Hitbox", {
        "Head", "Torso", "Nearest", "Random",
    }, {
        Flag = "combat_silent_hitbox",
        Default = "Head",
    })

    return tab
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §147 · BUILDER · VISUALS TAB (РАСШИРЕННЫЙ)
--// ═══════════════════════════════════════════════════════════════════════

function NL:BuildFullVisualsTab(tab)
    if not tab then return end

    -- ─── WALLHACK ──────────────────────────────────────────────────
    local whGroup = tab:CreateGroup("WallHack")

    whGroup:AddToggle("Enabled", {
        Flag = "vis_wh_enabled",
        Default = false,
        Tooltip = "Подсветка всех Humanoid сквозь стены",
        Callback = function(on)
            if on then
                NL.WallHack:Start()
                NL:Notify("WallHack", "Активен", 2, "success")
            else
                NL.WallHack:Stop()
            end
        end,
    })

    whGroup:AddSlider("Заливка", {
        Flag = "vis_wh_fill",
        Min = 0, Max = 1, Default = 0.5, Decimals = 2,
        Callback = function(v)
            NL.WallHack.State._fill = v
            NL.WallHack:Refresh()
        end,
    })

    whGroup:AddSlider("Обводка", {
        Flag = "vis_wh_outline",
        Min = 0, Max = 1, Default = 0.35, Decimals = 2,
        Callback = function(v)
            NL.WallHack.State._outline = v
            NL.WallHack:Refresh()
        end,
    })

    whGroup:AddToggle("Только живые", {
        Flag = "vis_wh_alive",
        Default = true,
        Callback = function(on) NL.WallHack.State._aliveOnly = on end,
    })

    whGroup:AddToggle("Team Check", {
        Flag = "vis_wh_teamcheck",
        Default = false,
        Tooltip = "Не подсвечивать союзников",
    })

    -- ─── ESP ───────────────────────────────────────────────────────
    local espGroup = tab:CreateGroup("ESP")

    espGroup:AddToggle("Boxes", { Flag = "vis_esp_boxes" })
    espGroup:AddToggle("Names", { Flag = "vis_esp_names" })
    espGroup:AddToggle("Health Bars", { Flag = "vis_esp_health" })
    espGroup:AddToggle("Distance", { Flag = "vis_esp_distance" })
    espGroup:AddToggle("Skeleton", { Flag = "vis_esp_skeleton" })

    espGroup:AddColorPicker("Box Color", {
        Flag = "vis_esp_box_color",
        Default = Color3.fromRGB(255, 100, 100),
    })

    espGroup:AddColorPicker("Name Color", {
        Flag = "vis_esp_name_color",
        Default = Color3.fromRGB(255, 255, 255),
    })

    -- ─── CHAMS ─────────────────────────────────────────────────────
    local chamsGroup = tab:CreateGroup("Chams")

    chamsGroup:AddToggle("Enabled", { Flag = "vis_chams_enabled" })
    chamsGroup:AddDropdown("Material", { "ForceField", "Neon", "Glass", "Plastic" }, {
        Flag = "vis_chams_material",
        Default = "ForceField",
    })
    chamsGroup:AddColorPicker("Visible", {
        Flag = "vis_chams_visible",
        Default = Color3.fromRGB(130, 100, 255),
    })
    chamsGroup:AddColorPicker("Occluded", {
        Flag = "vis_chams_occluded",
        Default = Color3.fromRGB(88, 62, 184),
    })

    -- ─── NIGHT MODE ────────────────────────────────────────────────
    local nightGroup = tab:CreateGroup("Night Mode")

    nightGroup:AddToggle("Enabled", {
        Flag = "vis_night_enabled",
        Default = false,
        Callback = function(on)
            if on then NL.NightMode:Start() else NL.NightMode:Stop() end
        end,
    })

    nightGroup:AddSlider("Яркость", {
        Flag = "vis_night_percent",
        Min = 0, Max = 100, Default = 50,
        Suffix = "%", Decimals = 0,
        Callback = function(v)
            NL.NightMode.State._percent = v
            if NL.NightMode.State._enabled then
                NL.NightMode:Apply(true)
            end
        end,
    })

    nightGroup:AddButtonRow({
        { Text = "30%", Callback = function()
            NL.NightMode.State._percent = 30
            if NL.NightMode.State._enabled then NL.NightMode:Apply(true) end
        end },
        { Text = "50%", Callback = function()
            NL.NightMode.State._percent = 50
            if NL.NightMode.State._enabled then NL.NightMode:Apply(true) end
        end },
        { Text = "100%", Callback = function()
            NL.NightMode.State._percent = 100
            if NL.NightMode.State._enabled then NL.NightMode:Apply(true) end
        end },
    })

    -- ─── WORLD ─────────────────────────────────────────────────────
    local worldGroup = tab:CreateGroup("World")

    worldGroup:AddToggle("Fullbright", { Flag = "vis_world_fullbright" })
    worldGroup:AddToggle("Remove Fog", { Flag = "vis_world_nofog" })
    worldGroup:AddSlider("FOV", {
        Flag = "vis_world_fov",
        Min = 70, Max = 120, Default = 90,
    })

    -- ─── GLOW ──────────────────────────────────────────────────────
    local glowGroup = tab:CreateGroup("Glow")

    glowGroup:AddToggle("Enabled", { Flag = "vis_glow_enabled" })
    glowGroup:AddColorPicker("Color", {
        Flag = "vis_glow_color",
        Default = Color3.fromRGB(130, 100, 255),
    })
    glowGroup:AddSlider("Intensity", {
        Flag = "vis_glow_intensity",
        Min = 0, Max = 100, Default = 50,
    })

    return tab
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §148 · BUILDER · REMOVALS TAB (РАСШИРЕННЫЙ)
--// ═══════════════════════════════════════════════════════════════════════

function NL:BuildFullRemovalsTab(tab)
    if not tab then return end

    -- ─── SCREEN SHAKE ──────────────────────────────────────────────
    local shakeGroup = tab:CreateGroup("Screen Shake")

    shakeGroup:AddToggle("Enabled", {
        Flag = "rm_shake_enabled",
        Default = false,
        Tooltip = "Убирает тряску камеры через BindToRenderStep",
        Callback = function(on)
            if on then
                NL.ShakeRemover:Start()
                NL:Notify("Shake Remover", "Активен", 2, "success")
            else
                NL.ShakeRemover:Stop()
            end
        end,
    })

    shakeGroup:AddSlider("Sensitivity", {
        Flag = "rm_shake_sens",
        Min = 0.001, Max = 0.05, Default = 0.003, Decimals = 3,
        Tooltip = "Меньше = строже",
        Callback = function(v) NL.ShakeRemover.State._sensitivity = v end,
    })

    shakeGroup:AddToggle("Position Filter", {
        Flag = "rm_shake_pos",
        Default = false,
        Callback = function(on) NL.ShakeRemover.State._positionFilter = on end,
    })

    shakeGroup:AddButton("Статистика", {
        Callback = function()
            NL:Notify("Shake Remover",
                "Заблокировано: " .. NL.ShakeRemover.State._blockCount, 3, "info")
        end,
    })

    -- ─── OPTIMIZATION ──────────────────────────────────────────────
    local optGroup = tab:CreateGroup("Optimization")

    optGroup:AddToggle("Particles", {
        Flag = "rm_opt_particles",
        Default = false,
        Callback = function(on)
            if on then NL.Optimize.DisableParticles()
            else NL.Optimize.EnableParticles() end
        end,
    })

    optGroup:AddToggle("Smoke / Fire / Sparkles", {
        Flag = "rm_opt_legacyfx",
        Default = false,
        Callback = function(on)
            if on then NL.Optimize.DisableLegacyFx()
            else NL.Optimize.EnableLegacyFx() end
        end,
    })

    optGroup:AddToggle("Decals & Textures", {
        Flag = "rm_opt_decals",
        Default = false,
        Callback = function(on)
            if on then NL.Optimize.DisableDecals()
            else NL.Optimize.EnableDecals() end
        end,
    })

    optGroup:AddToggle("Sounds", {
        Flag = "rm_opt_sounds",
        Default = false,
        Callback = function(on)
            if on then NL.Optimize.DisableSounds()
            else NL.Optimize.EnableSounds() end
        end,
    })

    optGroup:AddToggle("Post-Processing", {
        Flag = "rm_opt_postfx",
        Default = false,
        Callback = function(on)
            if on then NL.Optimize.DisablePostFx()
            else NL.Optimize.EnablePostFx() end
        end,
    })

    optGroup:AddToggle("Shadows", {
        Flag = "rm_opt_shadows",
        Default = false,
        Callback = function(on)
            if on then NL.Optimize.DisableShadows()
            else NL.Optimize.EnableShadows() end
        end,
    })

    optGroup:AddToggle("Render Distance", {
        Flag = "rm_opt_renderdist",
        Default = false,
        Callback = function(on)
            if on then NL.Optimize.SetRenderDistance(NL.Optimize.State._renderDistVal)
            else NL.Optimize.ResetRenderDistance() end
        end,
    })

    optGroup:AddSlider("Distance", {
        Flag = "rm_opt_renderdistval",
        Min = 100, Max = 1000, Default = 500,
        Suffix = " st",
        Callback = function(v)
            NL.Optimize.State._renderDistVal = v
            if NL.Optimize.State._renderDist then
                NL.Optimize.SetRenderDistance(v)
            end
        end,
    })

    optGroup:AddButtonRow({
        {
            Text = "MAX FPS",
            Callback = function()
                NL.Optimize.DisableParticles()
                NL.Optimize.DisableLegacyFx()
                NL.Optimize.DisableDecals()
                NL.Optimize.DisableSounds()
                NL.Optimize.DisablePostFx()
                NL.Optimize.DisableShadows()
                NL.Optimize.SetRenderDistance(300)
                NL:Notify("Optimize", "MAX FPS применён", 3, "success")
            end,
        },
        {
            Text = "Откатить",
            Callback = function()
                NL.Optimize.EnableParticles()
                NL.Optimize.EnableLegacyFx()
                NL.Optimize.EnableDecals()
                NL.Optimize.EnableSounds()
                NL.Optimize.EnablePostFx()
                NL.Optimize.EnableShadows()
                NL.Optimize.ResetRenderDistance()
                NL:Notify("Optimize", "Откат завершён", 2, "info")
            end,
        },
    })

    -- ─── FPS BOOST ─────────────────────────────────────────────────
    local fpsGroup = tab:CreateGroup("FPS Boost")

    fpsGroup:AddToggle("Disable All Terrain", {
        Flag = "rm_fps_terrain",
        Default = false,
    })

    fpsGroup:AddToggle("Disable Baseplate", {
        Flag = "rm_fps_baseplate",
        Default = false,
    })

    fpsGroup:AddSlider("Max FPS", {
        Flag = "rm_fps_max",
        Min = 30, Max = 240, Default = 60,
        Callback = function(v)
            pcall(function()
                setfpscap(v)
            end)
        end,
    })

    return tab
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §149 · BUILDER · INTERFACE TAB (РАСШИРЕННЫЙ)
--// ═══════════════════════════════════════════════════════════════════════

function NL:BuildFullInterfaceTabAdvanced(tab)
    if not tab then return end

    -- ─── GENERAL ───────────────────────────────────────────────────
    local general = tab:CreateGroup("Общие")

    general:AddToggle("Звуки", {
        Flag = "if_sounds",
        Default = NL.Settings.Sounds,
        Callback = function(on) NL.Settings.Sounds = on end,
    })

    general:AddToggle("Анимации", {
        Flag = "if_animations",
        Default = NL.Settings.Animations,
        Callback = function(on) NL.Settings.Animations = on end,
    })

    general:AddSlider("Громкость", {
        Flag = "if_volume",
        Min = 0, Max = 1, Default = 0.2, Decimals = 2,
        Callback = function(v) NL.Settings.SoundVolume = v end,
    })

    -- ─── WINDOW ────────────────────────────────────────────────────
    local winGroup = tab:CreateGroup("Окно")

    winGroup:AddDropdown("Размер", { "S", "M", "L", "XL" }, {
        Flag = "if_window_size",
        Default = "M",
        Callback = function(v)
            NL.LayoutPolish.WindowPresets:Apply(v)
        end,
    })

    winGroup:AddSlider("Прозрачность", {
        Flag = "if_window_opacity",
        Min = 0, Max = 0.6, Default = 0, Decimals = 2,
        Callback = function(v) NL.LayoutPolish.WindowOpacity:Set(v) end,
    })

    winGroup:AddSlider("Масштаб (Zoom)", {
        Flag = "if_window_zoom",
        Min = 0.7, Max = 1.5, Default = 1.0, Decimals = 2,
        Callback = function(v) NL.LayoutPolish.Zoom:Set(v) end,
    })

    winGroup:AddToggle("Полноэкранный", {
        Flag = "if_window_fullscreen",
        Default = false,
        Callback = function(on)
            if on then NL.LayoutPolish.Fullscreen:Toggle() end
        end,
    })

    winGroup:AddToggle("Компактный режим", {
        Flag = "if_window_compact",
        Default = false,
        Callback = function(on)
            if on then NL.LayoutPolish.CompactMode:Toggle() end
        end,
    })

    winGroup:AddDropdown("Докинг", {
        "Нет", "Верх-лево", "Верх-центр", "Верх-право",
        "Центр", "Низ-лево", "Низ-центр", "Низ-право",
    }, {
        Flag = "if_window_dock",
        Default = "Нет",
        Callback = function(v)
            local map = {
                ["Нет"]         = nil,
                ["Верх-лево"]   = "top-left",
                ["Верх-центр"]  = "top-center",
                ["Верх-право"]  = "top-right",
                ["Центр"]       = "center",
                ["Низ-лево"]    = "bottom-left",
                ["Низ-центр"]   = "bottom-center",
                ["Низ-право"]   = "bottom-right",
            }
            local dock = map[v]
            if dock then
                NL.LayoutPolish.Docking:Apply(dock)
            else
                NL.LayoutPolish.Docking:Clear()
            end
        end,
    })

    -- ─── SIDEBAR ───────────────────────────────────────────────────
    local sidebarGroup = tab:CreateGroup("Сайдбар")

    sidebarGroup:AddDropdown("Режим", {
        "Полный", "Компактный", "Скрытый", "Авто-показ",
    }, {
        Flag = "if_sidebar_mode",
        Default = "Полный",
        Callback = function(v)
            if v == "Полный" then
                NL.LayoutPolish.Sidebar:SetMode("full")
            elseif v == "Компактный" then
                NL.LayoutPolish.Sidebar:SetMode("compact")
            elseif v == "Скрытый" then
                NL.LayoutPolish.Sidebar:SetMode("collapsed")
            elseif v == "Авто-показ" then
                NL.LayoutPolish.HoverReveal:Enable()
            end
        end,
    })

    -- ─── UI PRESETS ────────────────────────────────────────────────
    local presetGroup = tab:CreateGroup("UI Presets")

    presetGroup:AddInfo("Ctrl+1..9 — загрузить слот · Ctrl+Shift+1..9 — сохранить", NL.Theme.Accent, "Dot")

    for i = 1, 3 do
        presetGroup:AddButtonRow({
            {
                Text = "Save " .. i,
                Callback = function()
                    if NL.UIPreset.Save(i) then
                        NL:Notify("UI Preset", "Слот " .. i .. " сохранён", 2, "success")
                    end
                end,
            },
            {
                Text = "Load " .. i,
                Callback = function()
                    if NL.UIPreset.Load(i) then
                        NL:Notify("UI Preset", "Слот " .. i .. " загружен", 2, "success")
                    else
                        NL:Notify("UI Preset", "Слот пуст", 2, "warning")
                    end
                end,
            },
            {
                Text = "Del " .. i,
                Color = NL.Theme.Error,
                Callback = function()
                    NL.UIPreset.Delete(i)
                    NL:Notify("UI Preset", "Слот " .. i .. " удалён", 2, "info")
                end,
            },
        })
    end

    -- ─── WATERMARK ─────────────────────────────────────────────────
    local wm = tab:CreateGroup("Вотермарка")

    wm:AddToggle("Показывать", {
        Flag = "if_wm_show",
        Default = NL.Settings.Watermark,
        Callback = function(on)
            NL.Settings.Watermark = on
            if NL._watermark and NL._watermark.frame then
                NL._watermark.frame.Visible = on
            end
        end,
    })

    wm:AddTextInput("Название", {
        Flag = "if_wm_name",
        Default = NL.Settings.WMCheatName,
        Live = true,
        Callback = function(v)
            NL.Settings.WMCheatName = v
            if NL._watermark and NL._watermark._nameLabel then
                NL._watermark._nameLabel.Text = v
            end
        end,
    })

    wm:AddTextInput("Тег", {
        Flag = "if_wm_tag",
        Default = NL.Settings.WMCheatTag,
        Live = true,
        Callback = function(v)
            NL.Settings.WMCheatTag = v
            if NL._watermark and NL._watermark._tagLabel then
                NL._watermark._tagLabel.Text = v
            end
        end,
    })

    wm:AddDropdown("Позиция", {
        "Слева сверху", "Справа сверху", "По центру", "Снизу по центру",
    }, {
        Flag = "if_wm_pos",
        Default = "Слева сверху",
        Callback = function(v)
            local map = {
                ["Слева сверху"]   = "top-left",
                ["Справа сверху"]  = "top-right",
                ["По центру"]      = "top-center",
                ["Снизу по центру"]= "bottom-center",
            }
            NL.Settings.WMPosition = map[v] or "top-left"
            if NL._wmApplyPosition then NL._wmApplyPosition() end
        end,
    })

    wm:AddToggle("Показывать FPS", {
        Flag = "if_wm_fps",
        Default = true,
        Callback = function(on) NL.Settings.WMShowFPS = on end,
    })

    wm:AddToggle("Показывать Ping", {
        Flag = "if_wm_ping",
        Default = true,
        Callback = function(on) NL.Settings.WMShowPing = on end,
    })

    -- ─── NOTIFICATIONS ─────────────────────────────────────────────
    local notifGroup = tab:CreateGroup("Уведомления")

    notifGroup:AddDropdown("Позиция", {
        "Слева сверху", "Справа сверху", "Слева снизу", "Справа снизу",
    }, {
        Flag = "if_notif_pos",
        Default = "Справа сверху",
        Callback = function(v)
            local map = {
                ["Слева сверху"]  = "top-left",
                ["Справа сверху"] = "top-right",
                ["Слева снизу"]   = "bottom-left",
                ["Справа снизу"]  = "bottom-right",
            }
            NL:SetNotifyPosition(map[v] or "top-right")
        end,
    })

    notifGroup:AddToggle("Группировка", {
        Flag = "if_notif_group",
        Default = true,
        Tooltip = "Склеивать одинаковые уведомления",
        Callback = function(on) NL:SetNotifyGrouping(on) end,
    })

    notifGroup:AddToggle("Звук", {
        Flag = "if_notif_sound",
        Default = true,
        Callback = function(on) NL.NotifyAdvanced:SetSound(on) end,
    })

    notifGroup:AddButton("Тест уведомления", {
        Callback = function()
            NL:Notify("Тест", "Это тестовое уведомление", 3, "info")
        end,
    })

    notifGroup:AddButtonRow({
        {
            Text = "Success",
            Callback = function() NL:NotifySuccess("Успех", "Операция выполнена", 3) end,
        },
        {
            Text = "Warning",
            Callback = function() NL:NotifyWarning("Внимание", "Проверьте настройки", 3) end,
        },
        {
            Text = "Error",
            Callback = function() NL:NotifyError("Ошибка", "Что-то пошло не так", 3) end,
        },
    })

    -- ─── INFO ──────────────────────────────────────────────────────
    local info = tab:CreateGroup("Информация")

    info:AddInfo("Neverlose UI · v" .. NL.Version .. " · build " .. NL.Build, NL.Theme.Accent, "Dot")
    info:AddLabel("Элементов: " .. tostring(#NL.Elements))
    info:AddLabel("Файловая система: " .. (NL.Config.HAS_FILES and "есть" or "нет"))
    info:AddLabel("Drawing: " .. (NL.Environment.HasDrawing and "да" or "нет"))

    info:AddDivider()

    info:AddButton("Выгрузить интерфейс", {
        Tooltip = "Полностью закрыть меню",
        Callback = function() NL:Destroy() end,
    })

    return tab
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §150 · BUILDER · CONFIG TAB (РАСШИРЕННЫЙ)
--// ═══════════════════════════════════════════════════════════════════════

function NL:BuildFullConfigTab(tab)
    if not tab then return end

    -- используем встроенный билдер из части 4
    NL:BuildConfigTab(tab)

    -- добавляем UI Presets
    local presetGroup = tab:CreateGroup("UI Presets")

    local presetNames = {}
    for i = 1, 9 do
        table.insert(presetNames, "Слот " .. i)
    end

    presetGroup:AddDropdown("Слот", presetNames, {
        Flag = "cfg_preset_slot",
        Default = "Слот 1",
    })

    presetGroup:AddButtonRow({
        {
            Text = "Сохранить UI",
            Callback = function()
                local slot = tonumber(string.match(
                    NL.Flags["cfg_preset_slot"] or "Слот 1", "%d+"
                )) or 1
                NL.UIPreset.Save(slot)
                NL:Notify("UI Preset", "Слот " .. slot .. " сохранён", 2, "success")
            end,
        },
        {
            Text = "Загрузить UI",
            Callback = function()
                local slot = tonumber(string.match(
                    NL.Flags["cfg_preset_slot"] or "Слот 1", "%d+"
                )) or 1
                NL.UIPreset.Load(slot)
            end,
        },
    })

    return tab
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §151 · BUILDER · INFO TAB
--// ═══════════════════════════════════════════════════════════════════════

function NL:BuildInfoTab(tab)
    if not tab then return end

    local about = tab:CreateGroup("О читах")

    about:AddLabel("Neverlose UI · v" .. NL.Version)
    about:AddLabel("Build: " .. NL.Build)
    about:AddLabel("Channel: " .. tostring(NL.Meta.Channel))
    about:AddDivider()
    about:AddLabel("Сессия: " .. NL.Session:Uptime())
    about:AddLabel("Уведомлений: " .. NL.Session.notifications)
    about:AddLabel("Конфигов сохранено: " .. NL.Session.configSaves)
    about:AddDivider()
    about:AddButton("Обновить статистику", {
        Callback = function()
            NL:Notify("Info", "Сессия: " .. NL.Session:Uptime(), 3, "info")
        end,
    })

    local features = tab:CreateGroup("Активные фичи")

    local featureList = New("Frame", {
        BackgroundColor3 = NL.Theme.Element,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 140),
    })
    Round(featureList, NL.Theme.RadiusElement)

    local scroll = New("ScrollingFrame", {
        Position = UDim2.new(0, 4, 0, 4),
        Size = UDim2.new(1, -8, 1, -8),
        BackgroundTransparency = 1,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = NL.Theme.Accent,
        Parent = featureList,
    })
    VLayout(scroll, 2)

    -- функция обновления
    local function refresh()
        for _, c in ipairs(scroll:GetChildren()) do
            if c:IsA("GuiObject") then c:Destroy() end
        end

        local anyActive = false
        for name, f in pairs(NL.Features._features) do
            if f.enabled then
                anyActive = true
                local row = New("Frame", {
                    BackgroundColor3 = NL.Theme.List,
                    BorderSizePixel = 0,
                    Size = UDim2.new(1, 0, 0, 24),
                    Parent = scroll,
                })
                Round(row, 4)

                New("TextLabel", {
                    Text = name,
                    Font = NL.Theme.Font,
                    TextSize = 10,
                    TextColor3 = NL.Theme.Success,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    Position = UDim2.new(0, 8, 0, 0),
                    Size = UDim2.new(1, -16, 1, 0),
                    BackgroundTransparency = 1,
                    Parent = row,
                })

                New("Frame", {
                    AnchorPoint = Vector2.new(1, 0.5),
                    Position = UDim2.new(1, -8, 0.5, 0),
                    Size = UDim2.new(0, 6, 0, 6),
                    BackgroundColor3 = NL.Theme.Success,
                    BorderSizePixel = 0,
                    Parent = row,
                }).Parent = row
                Circle(row:FindFirstChildOfClass("Frame"))
            end
        end

        if not anyActive then
            New("TextLabel", {
                Text = "Нет активных функций",
                Font = NL.Theme.Font,
                TextSize = 10,
                TextColor3 = NL.Theme.TextDim,
                Size = UDim2.new(1, 0, 0, 20),
                BackgroundTransparency = 1,
                Parent = scroll,
            })
        end
    end

    about:AddButton("Обновить список", { Callback = refresh })
    refresh()

    return tab
end

--// ═══════════════════════════════════════════════════════════════════════
--//  §152 · MAIN MENU BUILDER · ВСЁ В ОДНОМ
--// ═══════════════════════════════════════════════════════════════════════

function NL:BuildStandardMenu(opts)
    opts = opts or {}

    local title = opts.Title or NL.Settings.WMCheatName or "neverlose"
    local width = opts.Width or NL.Settings.WindowDefaultWidth
    local height = opts.Height or NL.Settings.WindowDefaultHeight

    -- создать окно
    local Window = self:CreateWindow({
        Title  = title,
        Width  = width,
        Height = height,
    })

    -- вотермарка
    self:CreateWatermark()

    -- вкладки по опциям
    if opts.Movement ~= false then
        local moveTab = Window:CreateTab("Movement", { Columns = 1, Icon = "Move" })
        self:BuildMovementTab(moveTab)
    end

    if opts.Combat ~= false then
        local combatTab = Window:CreateTab("Combat", { Columns = 2, Icon = "Crosshair" })
        self:BuildFullCombatTab(combatTab)
    end

    if opts.Visuals ~= false then
        local visTab = Window:CreateTab("Visuals", { Columns = 2, Icon = "Eye" })
        self:BuildFullVisualsTab(visTab)
    end

    if opts.Removals ~= false then
        local remTab = Window:CreateTab("Removals", { Columns = 2, Icon = "Trash" })
        self:BuildFullRemovalsTab(remTab)
    end

    if opts.Config ~= false then
        local cfgTab = Window:CreateTab("Config", { Icon = "List" })
        self:BuildFullConfigTab(cfgTab)
    end

    if opts.Interface ~= false then
        local ifcTab = Window:CreateTab("Interface", { Columns = 1, Icon = "Cog" })
        self:BuildFullInterfaceTabAdvanced(ifcTab)
    end

    if opts.Info ~= false then
        local infoTab = Window:CreateTab("Info", { Icon = "Person" })
        self:BuildInfoTab(infoTab)
    end

    NL:Notify(title, "Меню готово · " .. tostring(#self.Elements) .. " элементов", 4, "success")

    return Window
end

