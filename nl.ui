--//  §196 · WARMUP
--// ═══════════════════════════════════════════════════════════════════════

local function Warmup()
    -- твины, чтобы ускорить первые анимации
    pcall(function()
        local test = New("Frame", {
            BackgroundTransparency = 1,
            Size = UDim2.new(0, 1, 0, 1),
            Position = UDim2.new(0, -100, 0, -100),
            Parent = (NL._window and NL._window._screen) or game:GetService("CoreGui"),
        })
        Tween(test, 0.01, { BackgroundTransparency = 0.5 })
        task.delay(0.05, function()
            pcall(function() test:Destroy() end)
        end)
    end)
end

